Table acc_opening_run {
  aorId String [pk]
  aorCompanyId String [not null]
  aorBranchId String [note: 'NULL = the run covered the company as a whole, matching opBranchId.']
  aorFromAccYear String [not null, note: 'The year read from, and the year written into. ck_aor_year_order: a
carry-forward moves strictly forward.']
  aorToAccYear String [not null]
  aorRunAt DateTime [default: `now()`, not null]
  aorRunBy String
  aorCreated Int [not null, default: 0]
  aorUpdated Int [not null, default: 0]
  aorSkippedManual Int [not null, default: 0, note: 'Openings left alone because opSource was MANUAL or MIGRATION — those are
owned by a human and are never overwritten by a regenerate.']
  aorTotalDebit Decimal [not null, default: 0]
  aorTotalCredit Decimal [not null, default: 0]
  aorDifference Decimal [not null, note: 'GENERATED ALWAYS AS (debit - credit) STORED — read-only. The one number
everybody reads off this table is the one nobody can write incorrectly.
Non-zero means the carried trial balance did not agree.

dbgenerated() is the closest Prisma has to a generated column: it has no
attribute for one, and this at least keeps the field out of the create
input and the schema free of drift. Postgres rejects a write to it.']
  aorOverwriteManual Boolean [not null, default: false, note: 'Whether this run was allowed to overwrite MANUAL openings. The single
most important thing to know about a run after the fact.']
  aorRemarks String
  company companys [not null]
  branch branch_master
  aorSyncDate DateTime [note: 'NULL = changed since the last push to the cloud DB (see src/modules/cloud-sync).']

  Note: 'One row per carry-forward run, never updated — the history that
fiscal_years overwrites. fyIsCarriedForward / fyCarriedForwardAt record
THAT a year was carried forward and WHEN, once; a regenerate overwrites the
timestamp, and the numbers that say whether the run was sound — rows
created, manual openings stepped around, the Dr/Cr totals and the
difference between them — were returned to the caller and then lost.

Deliberately NOT partitioned by accounting year: a run is keyed by the two
years it spans rather than living inside either, and it grows by a handful
of rows a year. Added by migration 20260915090000 (DECISION 11).'
}

