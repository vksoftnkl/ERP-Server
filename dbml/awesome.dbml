Table company_aato {
  caaId String [pk]
  caaCompanyId String [not null]
  caaFinYear String [not null, note: 'The year the turnover BELONGS to, not the year it was computed in.']
  caaAatoAmount Decimal [not null, default: 0]
  caaSource String [not null, default: 'COMPUTED', note: 'COMPUTED | DECLARED']
  caaDeclaredBy String
  caaDeclaredOn DateTime
  caaRemarks String
  caaIsDeleted Boolean [not null, default: false]
  caaCreatedOn DateTime [default: `now()`, not null]
  caaCreatedBy String
  caaModifiedOn DateTime
  caaModifiedBy String
  company companys [not null]
  caaSyncDate DateTime [note: 'NULL = changed since the last push to the cloud DB (see src/modules/cloud-sync).']

  indexes {
    (caaCompanyId, caaFinYear) [unique]
  }

  Note: 'Aggregate annual turnover per company per financial year.

The figure e-invoice applicability (₹5 crore since 2023-08-01) and the AATO
class are read from. Kept by the year-end job and editable by the
accountant — a figure somebody SIGNS, not a running total, which is why
caaSource distinguishes COMPUTED from DECLARED.'
}

