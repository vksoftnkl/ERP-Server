  tdAmount Decimal [not null, default: 0]
  tdSurchargePerc Decimal [not null, default: 0]
  tdSurchargeAmt Decimal [not null, default: 0]
  tdSurchargeLedgerId String
  tdTotalAmt Decimal [not null, default: 0]
  tdReceivedAmt Decimal [not null, default: 0]
  tdChangeAmt Decimal [not null, default: 0]
  tdUnitsUsed Decimal [not null, default: 0]
  tdConversionRate Decimal [not null, default: 1]
  tdRefNo String
  tdAuthCode String
  tdCardLast4 String
  tdBankName String
  tdPayerVpa String
  tdInstrumentDate DateTime
  tdIsPdc Boolean [not null, default: false]
  tdSettleStatus String [not null, default: 'NA']
  tdSettleLedgerId String
  tdExpectedSettleOn DateTime
  tdSettledOn DateTime
  tdSettleAmount Decimal
  tdMdrAmt Decimal [not null, default: 0]
  tdSettleRefNo String
  tdSettleVoucherId String
  tdSessionId String
  tdDeviceId String
  tdUserId String [not null]
  tdNotes String
  tdIsDeleted Boolean [not null, default: false]
  tdSyncDate DateTime
  tdCreatedOn DateTime [default: `now()`, not null]
  tdCreatedBy String [not null]
  tdModifiedOn DateTime
  tdModifiedBy String
  company companys [not null]
  branch branch_master [not null]
  user user_master [not null]
  tender acc_tender_master [not null]
  tenderType acc_tender_types [not null]
  ledger acc_ledger_master [not null]
  settleLedger acc_ledger_master
  partyLedger acc_ledger_master [not null]
  surchargeLedger acc_ledger_master
  billAdjustments acc_bill_adjustment [not null]
  loyaltyLedgerRows loyalty_ledger [not null]
  couponTxns loyalty_coupon_txn [not null]
  tempCredits acc_temp_credit [not null]
  tdIsVoided Boolean [not null, default: false, note: 'This tender did NOT happen — the UPI failed, the card was declined. The
row STAYS so a till review can see it: tdIsDeleted would say "keyed
wrong" when the truth is "payment failed", and the difference is exactly
what is worth reviewing. Every till and day-book report filters
NOT tdIsVoided; audit reads both halves.']
  tdVoidReason String [note: 'UPI_FAILED | CARD_DECLINED | CHEQUE_REFUSED | KEYED_WRONG |
CUSTOMER_CHANGED | OTHER. ck_td_void_pair: a voided row must say WHEN
and WHY, a live row must say neither.']
  tdVoidedOn DateTime
  tdVoidedBy String
  tdReplacesId String [note: 'On the REPLACEMENT row: the tdId it stands in for. Gives the pair
without a join through the voucher. No FK — the pair may span
partitions and the replacement is written before anything validates it.']

  indexes {
    (tdId, tdAccYear) [pk]
  }
}

