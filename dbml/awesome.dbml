Table user_menus {
  umId String [pk]
  umUserId String [not null]
  umMenuId Int [not null]
  umCanView Boolean [not null, default: true]
  umCanCreate Boolean [not null, default: false]
  umCanEdit Boolean [not null, default: false]
  umCanDelete Boolean [not null, default: false]
  umCanPrint Boolean [not null, default: false]
  umCanExport Boolean [not null, default: false]
  umCanPost Boolean [not null, default: false]
  umCanCancel Boolean [not null, default: false]
  umCanAmend Boolean [not null, default: false]
  umCanOverride Boolean [not null, default: false, note: 'Passes a WARN-level guard: discount cap, credit limit, back-date, rate
below minimum.']
  umCanRetender Boolean [not null, default: false, note: 'May change how a POSTED bill was paid. Separate from umCanAmend: the
sale is not being edited, only the tender — but it moves money between
ledgers, so it is grantable on its own.']
