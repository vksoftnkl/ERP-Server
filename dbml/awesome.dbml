Table acc_voucher_doc_einvoice {
  gdeId String [not null]
  gdeGdrId String [not null]
  gdeVoucherId String [not null]
  gdeAccYear String [not null]
  gdeCompanyId String [not null]
  gdeBranchId String [not null]
  gdeStatus GdeStatus [not null, default: 'NA']
  gdeIrn String
  gdeAckNo String
  gdeAckOn DateTime
  gdeQrcode String
  gdeSignedInvoice String
  gdeSignedQrcode String
  gdeCancelReason String
  gdeCancelledOn DateTime [note: 'TWO l\'s, as of 20260922020000. The deployed table used to spell it
with one while every other table in this schema used two; a rename
here is also a DATA change in gst_provider_field_map, which stores
this name as a target column.']
  gdeLastErrorCode String
  gdeLastMessage String
  gdeGccId String [note: 'public.gst_company_credential that generated this IRN. A cancellation
must be sent through the same provider and GSTIN, and with two providers
configured there is no way to work out which one it was after the fact.
No FK: the credential is a master that may legitimately be retired while
old documents keep pointing at it.']
  gdeGpvCode String [note: 'Frozen snapshot beside the id, the way the doc register freezes party
name and GSTIN next to theirs: an id pointing at a row somebody deleted
answers no questions at all.']
  gdeIrpCode String [note: 'The Invoice Registration Portal that issued the IRN (NIC1, NIC2, CLEAR,
CYGNET, EY, IRIS) — NOT the same thing as the GSP. A cancellation must
reach this portal; the GSP used to reach it may differ. On a NIC-style
reply the first character of AckNo gives it away: 1 = NIC1, 2 = NIC2.']
  gdeNextAttemptOn DateTime [note: 'When to try again. Without it a failed IRN either retries in a tight
loop against a portal that is rate limiting us, or waits for a person to
notice. Drives the ix_gde_retry worklist.']
  gdeIsActive Boolean [not null, default: true]
  gdeIsDeleted Boolean [not null, default: false]
  gdeSyncDate DateTime
  gdeCreatedOn DateTime [default: `now()`, not null]
  gdeCreatedBy String
  gdeModifiedOn DateTime
  gdeModifiedBy String
  gdeTenantId String
  gdeAttemptCount Int [not null, default: 0, note: 'How many times the IRP has been asked for this IRN, and when last.']
  gdeLastAttemptOn DateTime
  gdeRequestPayload Json [note: 'Exactly what was sent to the IRP, and exactly what it said back. Once
the document has been amended these two are the ONLY answer to "what
did we declare on that date".']
  gdeResponsePayload Json
  docRegister acc_voucher_doc_register [not null]

  indexes {
    (gdeId, gdeAccYear) [pk]
    (gdeGdrId, gdeAccYear) [unique]
  }
}

