  sbBillType String [not null, default: 'CASH']
  sbCategoryId String
  sbPriceLevel Int [not null]
  sbBillSlno BigInt
  sbBillRefno String
  sbUsrRefno String
  sbBillDate DateTime [not null]
  sbBillDatetime DateTime [default: `now()`, not null]
  sbDueDays Int
  sbDueDate DateTime
  sbSrcDocType String
  sbSrcDocId String
  sbSrcDocRefno String
  sbSrcDocDate DateTime
  sbSrcDocYear String
  sbCustId String
  sbCustName String [not null]
  sbCustAddr String
  sbCustPlace String
  sbCustPin String
  sbCustPhone String
  sbCustGstin String
  sbCustGstType String
  sbCustStcd String
  sbPosStcd String
  sbStateName String
  sbHasLoad Boolean [not null, default: false]
  sbHasUnload Boolean [not null, default: false]
  sbHasFreight Boolean [not null, default: false]
  sbHasPromo Boolean [not null, default: false]
  sbHasComm Boolean [not null, default: false]
  sbHasLoyalty Boolean [not null, default: false]
  sbBillMode String [not null, default: 'WHOLESALE', note: 'POS | WHOLESALE. The MODE owns the number series: POS draws from the
device series, WHOLESALE from the branch MAIN series.']
  sbUsrRefdate DateTime
  sbHasDc Boolean [not null, default: false, note: 'How much of this bill came in under a challan. Stock and COGS for that
part were posted AT THE DC; the bill posts them only for direct lines.']
  sbDcTaxableAmt Decimal [not null, default: 0]
  sbCogsAmt Decimal [not null, default: 0, note: 'What THIS bill posted as COGS.']
  sbDeliveryStatus String [not null, default: 'NA', note: 'NA | PENDING | PACKED | DISPATCHED | DELIVERED | RETURNED. A CACHE —
the events themselves are TxnStatusLog rows.']
  sbDeliveredOn DateTime
  sbCustPan String [note: 'The identity stamp on a cash sale over the rule 114B limit: what was
shown at the counter, kept WITH the bill and never re-derived.']
  sbForm60Ref String
  sbTcsPerc Decimal [not null, default: 0, note: 'TCS infrastructure, rate 0 today — 206C(1H) was removed 2025-04-01.']
  sbTcsAmt Decimal [not null, default: 0]
  sbLoyaltyMemberId String [note: 'Loyalty caches; the detail is the LoyaltyLedger rows keyed by this bill.']
  sbLoyaltyEarned Decimal [not null, default: 0]
  sbLoyaltyRedeemed Decimal [not null, default: 0]
  sbRevisionNo Int [not null, default: 1]
  sbDocRegisterId String [note: 'The doc-register row this bill owns. Server-owned, like
sbPostedVoucherId — the DTO never carries either.']
  sbLscId String
  sbLoyaltyEarnPoints Decimal [not null, default: 0]
  sbLoyaltyRedeemPoints Decimal [not null, default: 0]
  sbUserId String [not null]
  sbSalesmanId String[] [not null]
  sbAgentId String
  sbAgentCommPerc Decimal
  sbAgentCommAmt Decimal
  sbDriverId String
  sbLoadmanId String[] [not null]
  sbPackedId String[] [not null]
  sbSupervisorId String
  sbVehicleId String
  sbVehicleNo String
  sbTotItems Int [not null, default: 0]
  sbTotWeight Decimal [not null, default: 0]
  sbTotBags Decimal [not null, default: 0]
  sbGrossAmt Decimal [not null, default: 0]
  sbItemDisc Decimal [not null, default: 0]
  sbSplDisc Decimal [not null, default: 0]
  sbSchDisc Decimal [not null, default: 0]
  sbBillSchDisc Decimal [not null, default: 0]
  sbAddlDisc1 Decimal [not null, default: 0]
  sbAddlDisc2 Decimal [not null, default: 0]
  sbCashDisc Decimal [not null, default: 0]
  sbTaxableAmt Decimal [not null, default: 0]
  sbCgstAmt Decimal [not null, default: 0]
  sbSgstAmt Decimal [not null, default: 0]
  sbIgstAmt Decimal [not null, default: 0]
  sbCessAmt Decimal [not null, default: 0]
  sbTaxAmt Decimal [not null, default: 0]
  sbFreightAmt Decimal [not null, default: 0]
  sbLoadAmt Decimal [not null, default: 0]
  sbUnloadAmt Decimal [not null, default: 0]
  sbOtherAmt1 Decimal [not null, default: 0]
  sbOtherAmt2 Decimal [not null, default: 0]
  sbRoundOff Decimal [not null, default: 0]
  sbBillAmt Decimal [not null, default: 0]
  sbTotalCost Decimal
  sbMarginAmt Decimal
  sbMarginAmtWot Decimal
  sbMarginPerc Decimal
  sbMrpSavings Decimal [default: 0]
  sbMrpSavingsPerc Decimal [default: 0]
  sbPayMode String
  sbCreditAmt Decimal [not null, default: 0]
  sbSurchargeAmt Decimal [not null, default: 0]
  sbTenderAmt Decimal [not null, default: 0]
  sbRefundAmt Decimal [not null, default: 0]
  sbAdvanceAmt Decimal [not null, default: 0, note: 'ADVANCE set-offs only — order and receipt advances (acc_bill_adjustment
ADVANCE_ADJUST). A credit note is a different liability; see sbNoteAdjAmt.']
  sbNoteAdjAmt Decimal [not null, default: 0, note: 'CREDIT-NOTE set-offs only — sale-return credit notes (NOTE_ADJUST).
sbAdvanceAmt + sbNoteAdjAmt is everything the bill\'s set-offs settle.']
  sbPaidAmt Decimal [not null, default: 0]
  sbBalanceAmt Decimal [not null, default: 0]
  sbPayStatus String [not null, default: 'UNPAID']
  sbReturnedAmt Decimal [not null, default: 0]
  sbReturnStatus String
  sbPaymentTerms String
  sbDeliveryTerms String
  sbTermsConditions String
  sbRemarks String
  sbFreightCalcType String
  sbLoadingCalcType String
  sbDiscAlterBase Boolean
  sbRoundOffStep Decimal [not null, default: 1]
  sbStatus String [not null, default: 'DRAFT', note: 'DRAFT | POSTED | CANCELLED (ck_sb_status).

WHEN, WHO and WHY it changed are NOT here any more. TxnStatusLog holds
every transition — changed-on, changed-by, the cancel reason, the
from-status, the device and the session — one appended row per step.
A second copy on the header meant the reason was written twice and the
two could disagree, and an amendment overwrote the previous cancel
instead of leaving a trail. It matters for the offline push too: two
devices APPENDING cannot conflict the way two UPDATEing one header row
can. sbPostedVoucherId stays because it is a RELATIONSHIP, not an event.']
  sbPostedVoucherId String
  sbDraftCheques Json [note: 'notes (48) — a DRAFT\'s cheque details (drawer, bank branch, IFSC, MICR),
keyed by td_id: acc_tender_detail has no columns for them and the
cheque register row is not written until /bills/post. Scratch space, like
the receipt\'s avh_draft_lines: /post copies it into acc_pdc_register and
clears it to NULL. Nothing else reads it.']
  sbApprovedOn DateTime
  sbApprovedBy String
  sbVersionNo Int [not null, default: 1]
  sbPrintCount Int [not null, default: 0]
  sbIsDeleted Boolean [not null, default: false]
  sbSyncDate DateTime
  sbCreatedOn DateTime [default: `now()`, not null]
  sbCreatedBy String [not null]
  sbModifiedOn DateTime
  sbModifiedBy String
  items sale_bill_item [not null]
  customer customers
  posState state_codes
  priceLevel item_price_levels [not null]
  returns sale_return [not null]
  driver employee_master
  supervisor employee_master
  vehicle vehicle_master
  tempCredits acc_temp_credit [not null]

  indexes {
    (sbId, sbAccYear) [pk]
  }
}

