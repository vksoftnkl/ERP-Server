Table gst_api_log {
  galId String [not null]
  galCompanyId String [not null]
  galBranchId String
  galTenantId String
  galAccYear String [not null]
  galGccId String [note: 'Which credential (hence which provider) served the attempt. Nullable
because a call can fail before a credential is even resolved.']
  galGpvId String
  galService String [not null]
  galAction String [not null]
  galEnvironment String [not null]
  galSrcModule String
  galSrcDocType String
  galSrcDocId String
  galGdrId String
  galIdempotencyKey String [note: 'Our key for the attempt. A retry after a timeout reuses it, so a
generate that already succeeded upstream cannot mint a second IRN.']
  galAttemptNo Int [not null, default: 1]
  galRequestUrl String [note: 'Headers are stored REDACTED per gpeRedactPaths: an auth token in a log
is a credential with a longer life than the session that issued it.']
  galRequestHeaders Json
  galRequestPayload Json
  galHttpStatus Int
  galResponsePayload Json
  galProviderCode String [note: 'Their code, and what GstProviderErrorMap turned it into.']
  galOurCode String
  galIsSuccess Boolean [not null]
  galMessage String
  galStartedOn DateTime [default: `now()`, not null]
  galFinishedOn DateTime
  galDurationMs Int
  galIsDeleted Boolean [not null, default: false]
  galSyncDate DateTime
  galCreatedOn DateTime [default: `now()`, not null]
  galCreatedBy String

  indexes {
    (galId, galAccYear) [pk]
  }

  Note: 'Append-only call log: one row per HTTP attempt at a GSP, including the
ones that failed.

This is a transaction table, not configuration, so it lives in `public`
(like TxnStatusLog) and is LIST-partitioned by galAccYear — which is why
the primary key is the composite (galId, galAccYear). Partitions
(public.gst_api_log_2026_2027) are created by
public.ensure_acc_year_partitions(\'YYYY-YYYY\'), which
20260921120000_add_gst_provider_integration taught about this table. Run
it whenever a fiscal year is opened, or every insert fails with
"no partition of relation ...".

This is the only record of what crossed the wire. It holds EVERY exchange,
for every document and for the calls that belong to no document at all
(auth, GSTIN lookup). The per-document summary lives on
acc_voucher_doc_register itself; accounts.acc_voucher_doc_api_log, which
used to hold the LAST exchange per document, was dropped unused by
20260922080000.

Rows are written once — no modifiedOn/By, same as TxnStatusLog.'
}

Table gst_auth_session {
  gasId String [pk]
  gasGccId String [not null]
  gasAuthTokenEnc String [not null, note: 'Encrypted with the same application key as the credential\'s secrets. A
bearer token in a readable column is a password with a shorter life, not
something less than one.']
  gasSessionKeyEnc String [note: 'NIC\'s Sek — the AES session key every subsequent payload is encrypted
with. Without a column for it the NIC_SEK scheme cannot work at all,
which is why the token column alone was not enough in the first draft.']
  gasRefreshTokenEnc String
  gasKeyVersion Int [not null, default: 1]
  gasTokenType String [not null, default: 'AuthToken']
  gasIssuedOn DateTime [default: `now()`, not null]
  gasExpiresOn DateTime [not null]
  gasExpiryRaw String [note: 'What the provider literally sent. NIC returns TokenExpiry as IST local
time with no zone on it; keeping the raw string is the only way to prove
clock skew later.']
  gasLockBy String [note: 'Four tills notice the same expiry in the same second. Without a lease
all four call /auth, which NIC rate-limits hard and the e-way portal
answers by blocking the account. A LEASE and not an advisory lock,
because the auth call is external HTTP and no transaction should be held
open across one: claim in a short transaction, call outside any
transaction, write the result in a second short transaction.

UPDATE public.gst_auth_session
SET gas_lock_by = :worker, gas_lock_upto = now() + interval \'60 seconds\'
WHERE gas_gcc_id = :cred
AND gas_expires_on <= now() + make_interval(secs => :margin)
AND (gas_lock_upto IS NULL OR gas_lock_upto < now())
RETURNING gas_id, gas_token_version;

One row back and you are the refresher; none and somebody else is, so
wait and re-read. gasLockUpto expiring is what stops a worker that died
mid-call from freezing every counter behind it.']
  gasLockOn DateTime
  gasLockUpto DateTime
  gasTokenVersion Int [not null, default: 0, note: 'Bumped on every successful refresh. Workers cache the token in memory; a
rejection means "re-read", and a version higher than the cached one
means somebody already fixed it — retry rather than refresh again. This
is also what keeps the Sek from tearing: a payload encrypted with the
previous session key is detectable instead of merely rejected.']
  gasIsActive Boolean [not null, default: true]
  gasIsDeleted Boolean [not null, default: false]
  gasSyncDate DateTime
  gasCreatedOn DateTime [default: `now()`, not null]
  gasCreatedBy String [not null]
  credential gst_company_credential [not null]

  Note: 'The live session with a provider.

Separate from the credential on purpose. A token rotates every six hours;
writing it back onto the credential row would churn a master\'s audit trail
four times a day, and would put a live bearer token in the same SELECT the
configuration screen runs. Nothing in this model is ever returned to the
client.

Rows are written once and never edited, so there is no modifiedOn/By — the
same reasoning as TxnStatusLog. Renewal inserts a new row and retires the
old one.'
}

Table gst_company_credential {
  gccId String [pk]
  gccCompanyId String [not null]
  gccBranchId String [note: 'NULL = every branch that files under this GSTIN. A branch is named only
when it holds its own registration.']
  gccGpvId String [not null]
  gccService String [note: 'NULL is the common case for a commercial GSP: ONE login covering every
service they sell you, on one token. Direct NIC is the "set" case —
e-invoice and e-way bill are separate API registrations on the portal
and their tokens are not interchangeable. Forcing this NOT NULL would
have made every gateway provider look like NIC.']
  gccEnvironment String [not null, note: 'SANDBOX | PRODUCTION']
  gccPriority Int [not null, default: 1, note: '1 = primary, 2+ = failover order.']
  gccLoginId String [not null, note: 'The API user of the taxpayer\'s portal registration. Deliberately NOT
encrypted: it is not a secret, and support has to be able to see WHICH
login is failing without holding the decryption key — the same reason a
database user name is not hashed while its password is.']
  gccPasswordEnc String [not null]
  gccClientIdEnc String [note: 'Normally NULL. OAuth-style app credentials at the TAXPAYER level, which
only some GSPs issue — a reseller that bills per GSTIN may hand you a
client id and secret for each one. For every other provider the app
credentials belong to the installation and live on GstProviderAccount,
and the more specific one wins:
client_id = COALESCE(gcc_client_id_enc, gpa_client_id_enc)
Filling only one of the pair is meaningless, so ck_gcc_client_pair
refuses it rather than letting a half-configured login reach the gateway.']
  gccClientSecretEnc String
  gccAppKeyEnc String [note: 'NIC\'s AppKey: 32 random bytes, RSA-encrypted with the IRP public key at
auth time and used to unwrap the Sek that comes back.']
  gccPublicKeyRef String [note: 'Which IRP/GSP public key or certificate the payload encryption uses.
They rotate, and a stale one fails with an opaque decrypt error.']
  gccKeyVersion Int [not null, default: 1, note: 'Which application key encrypted the _enc columns above.']
  gccWhitelistedIps String[] [not null, note: 'The static IPs registered with the GSP / on the e-invoice portal for
this GSTIN. OURS, not the provider\'s — the first draft had a single inet
on the PROVIDER row, where it described nothing. An array because a
chain files one GSTIN from many outlets, each on its own broadband: the
portal whitelist is a list, and so is this.']
  gccValidFrom DateTime [note: 'Portal passwords expire. A credential that silently went stale at
midnight is otherwise discovered by a queue of failed bills.']
  gccValidUpto DateTime
  gccPasswordChangedOn DateTime
  gccLastVerifiedOn DateTime [note: 'Stamped by the master screen\'s Test Connection button and by the first
successful call of the day.']
  gccLastErrorMessage String
  gccRemarks String
  gccIsActive Boolean [not null, default: true]
  gccIsDeleted Boolean [not null, default: false]
  gccSyncDate DateTime
  gccCreatedOn DateTime [default: `now()`, not null]
  gccCreatedBy String [not null]
  gccModifiedOn DateTime
  gccModifiedBy String
  company companys [not null]
  branch branch_master
  provider gst_provider [not null, note: 'The foreign key the first draft simply did not have.']
  sessions gst_auth_session [not null]

  Note: 'The taxpayer\'s login — per company, or per branch that files its own
return. CREDENTIAL #2 of two.

GstProviderAccount holds the GSP\'s own account (this ERP → their gateway).
This model holds the taxpayer\'s portal user (that GSTIN → the IRP, through
the GSP). Most GSPs need both, and they rotate on different schedules,
which is why they are not on one row.

The GSTIN is NOT stored here. Company.compGstinNo is already UNIQUE, so a
company row IS a registration; a branch with its own registration carries
it on BranchMaster.brGstinNo. It resolves as
COALESCE(branch GSTIN, comp_gstin_no) at call time, which is also what
makes gccBranchId meaningful rather than decorative:
NULL -> files under the company\'s own registration
set  -> files under that branch\'s registration
Repeating the number here would be a second copy free to drift from the
first, and a credential silently authenticating as a GSTIN the company no
longer has is worse than any join. public.vw_gst_credential does the
COALESCE once so no caller has to remember which table it came from.

How MANY rows a company needs is decided by the provider\'s auth model, not
by how many services it uses:
gateway GSP (one token for everything) -> ONE row, gccService NULL
direct NIC (token per registration)    -> one row per service
GstAuthSession hangs off this row, so that choice also decides how many
live tokens exist and how many calls to /auth get made.

gccPriority is the answer to "what happens when there are two providers".
Priority 1 is the primary and there may be only one per
company/branch/service/environment (ux_gcc_primary). Priority 2+ are
failovers, tried in order when the primary maps to UPSTREAM_DOWN or
RATE_LIMITED. Which one actually served a document is recorded on the
document (gdeGccId) and on every attempt (galGccId), so a failover is
auditable rather than mysterious.

Secrets are application-encrypted ciphertext (_enc), not plaintext and not
pgcrypto — a key that lives in the same database as the data it protects
is decoration. gccKeyVersion records which application key wrapped the
values so rotation does not require a flag day.'
}

Table gst_provider {
  gpvId String [pk]
  gpvCode String [unique, not null, note: 'Short stable handle used in seeds, logs and support calls: \'NIC\',
\'CYGNET\', \'CLEARTAX\'. Never renamed — retire the row instead, which is
why this is a real UNIQUE constraint and not a partial index.']
  gpvName String [not null]
  gpvPortalUrl String
  gpvSupportEmail String
  gpvSupportPhone String
  gpvTimeoutMs Int [not null, default: 30000]
  gpvMaxRetries Int [not null, default: 2]
  gpvRateLimitPerMin Int [note: 'Calls per minute the contract allows, NULL = unmetered. A shop with four
tills can trip a limit that no single till would notice.']
  gpvRemarks String
  gpvIsActive Boolean [not null, default: true]
  gpvIsDeleted Boolean [not null, default: false]
  gpvSyncDate DateTime
  gpvCreatedOn DateTime [default: `now()`, not null]
  gpvCreatedBy String [not null]
  gpvModifiedOn DateTime
  gpvModifiedBy String
  services gst_provider_service [not null]
  accounts gst_provider_account [not null]
  errorMaps gst_provider_error_map [not null]
  credentials gst_company_credential [not null]

  Note: 'One row per GST Suvidha Provider, and nothing that varies per company, per
service or per environment. In particular NO base url and NO credentials:
the first draft (fixed.gsp_provider_master) put both here, and both are
wrong at this grain — a provider serves several services from several
hosts, and its credentials belong to the GSTIN that logs in, not to the
provider.

Adding a SECOND provider must be an INSERT, not a deployment. That is the
constraint the whole gst_* family is shaped by: the route of every call
(GstProviderEndpoint), the shape of every reply (GstProviderFieldMap) and
the meaning of every error code (GstProviderErrorMap) are rows, not code.'
}

Table gst_provider_account {
  gpaId String [pk]
  gpaGpvId String [not null]
  gpaEnvironment String [not null, note: 'SANDBOX | PRODUCTION']
  gpaService String [note: 'NULL = every service this provider offers.']
  gpaAccountRef String [note: 'Your customer / account number with the GSP. Not a secret, and the first
thing their support desk asks for.']
  gpaClientIdEnc String
  gpaClientSecretEnc String
  gpaApiKeyEnc String
  gpaKeyVersion Int [not null, default: 1]
  gpaValidFrom DateTime [note: 'Contract window. A GSP contract lapses on a date somebody agreed to a
year ago; without this the first anybody knows is bills not printing.']
  gpaValidUpto DateTime
  gpaCreditBalance Decimal [note: 'Most GSPs sell IRNs in blocks. Running the balance down mid-morning
stops every counter at once, so it is worth a column and an alert rather
than a phone call from the shop floor. Refreshed by GET_API_BALANCE.']
  gpaBalanceCheckedOn DateTime
  gpaLastVerifiedOn DateTime
  gpaRemarks String
  gpaIsActive Boolean [not null, default: true]
  gpaIsDeleted Boolean [not null, default: false]
  gpaSyncDate DateTime
  gpaCreatedOn DateTime [default: `now()`, not null]
  gpaCreatedBy String [not null]
  gpaModifiedOn DateTime
  gpaModifiedBy String
  provider gst_provider [not null]

  Note: 'The GSP\'s own account — CREDENTIAL #1 of two.

This is the API credential the GSP (Chartered, Cygnet, ClearTax …) issues
to identify THIS ERP INSTALLATION to their gateway. The second — the
taxpayer\'s own portal user, per GSTIN — is GstCompanyCredential. Most GSPs
need both, and they rotate on different schedules, which is the whole
reason they are not one row.

Grain is provider × ENVIRONMENT, not per service. A GSP that sells
e-invoice, e-way bill and returns issues ONE account for all of it; the
sandbox account is a different one. Keying it per service would copy the
same secret across four rows and make rotation a hunt.

gpaService is nevertheless present and NULLABLE, because a few providers
do issue separate accounts per service:
NULL -> covers every service this provider offers   (the norm)
set  -> overrides the NULL row for that one service (the exception)
Resolution is most-specific-wins:

ORDER BY gpa_service NULLS LAST LIMIT 1

A direct-to-NIC provider has NO row here at all: there is no middleman to
authenticate to, only the per-GSTIN AppKey on GstCompanyCredential.'
}

Table gst_provider_endpoint {
  gpeId String [pk]
  gpeGpsId String [not null]
  gpeAction String [not null, note: 'AUTH | GENERATE_IRN | CANCEL_IRN | GET_IRN | … — see ck_gpe_action for
the full, finite vocabulary (e-invoice, the whole e-way bill surface,
the lookups, the returns, and the two housekeeping calls).']
  gpeHttpMethod String [not null, default: 'POST']
  gpePathTemplate String [not null, note: 'Appended to gpsBaseUrl. May carry {placeholders} filled from the request
context: {irn}, {gstin}, {ewbNo}, {period}.']
  gpeQueryTemplate String
  gpeContentType String [not null, default: 'application/json']
  gpeHeaders Json [note: 'Static/templated headers, e.g.
{"Gstin":"{gstin}","user_name":"{loginId}","AuthToken":"{authToken}"}
Json because the header SET differs per provider, not just the values.']
  gpeRequestWrapper String [note: 'The key the body is nested under, if any: \'Data\' for NIC-style
wrappers, NULL when the body is posted bare.']
  gpeRedactPaths Json [note: 'JSONPaths blanked before the exchange is written to GstApiLog. The AUTH
request body literally contains the portal password, and the headers of
every other call carry a live AuthToken — logged verbatim they become
credentials with a longer life than the session that issued them.
Redaction is a config row and not a code branch precisely so that adding
a provider cannot forget it.']
  gpeResponseRootPath String
  gpeSuccessPath String
  gpeSuccessValue String
  gpeErrorCodePath String
  gpeErrorMessagePath String
  gpeTimeoutMs Int
  gpeMaxRetries Int
  gpeIsIdempotent Boolean [not null, default: false, note: 'Safe to send again after a timeout. FALSE for GENERATE_IRN: a reply that
never arrived may still have minted an IRN, and the correct recovery is
GET_IRN_BY_DOC, not a second generate.']
  gpeRemarks String
  gpeIsActive Boolean [not null, default: true]
  gpeIsDeleted Boolean [not null, default: false]
  gpeSyncDate DateTime
  gpeCreatedOn DateTime [default: `now()`, not null]
  gpeCreatedBy String [not null]
  gpeModifiedOn DateTime
  gpeModifiedBy String
  service gst_provider_service [not null]
  fieldMaps gst_provider_field_map [not null]

  Note: 'One row per CALL. This is what the first draft\'s single `gsp_route` column
was trying to be.

gpeAction is the vocabulary the application speaks — the sale bill asks
for GENERATE_IRN and does not know, or care, what path that is on this
provider. Adding a provider must never add an action; adding a CAPABILITY
may.

The envelope columns are the other half of provider independence. Every
GSP wraps the same NIC payload differently: {"Status":1,"Data":{…}} here,
{"success":true,"result":{…}} there. Describing the envelope as four paths
means the dispatcher can find the payload, decide success and read an
error code without knowing whose reply it is holding.'
}

Table gst_provider_error_map {
  gemId String [pk]
  gemGpvId String [not null]
  gemService String [note: 'NULL = applies to every service of this provider.']
  gemTheirCode String [not null, note: 'The provider\'s own code: \'2150\', \'GSP022\', \'429\'.']
  gemOurCode String [not null, note: 'Our vocabulary — DUPLICATE_IRN, TOKEN_EXPIRED, CREDIT_EXHAUSTED,
ENV_MISMATCH, … The application branches on THESE, never on a
provider\'s number.']
  gemMessage String [note: 'Shown to the counter operator. Deliberately not the provider\'s text,
which is written for a developer.']
  gemTreatAs String [not null, default: 'ERROR', note: 'ERROR | SUCCESS | WARNING — what this code MEANS to us, which is not
always "a failure". NIC\'s 2150 refuses a duplicate and hands back the
IRN it issued the first time: treated as an error it strands a printed
bill at the counter, treated as SUCCESS it completes the document with
the IRN that already exists.']
  gemExtractPath String [note: 'Where that already-issued value hides in the ERROR payload, and which
canonical field it becomes. Without these, gemTreatAs = \'SUCCESS\' would
complete a document with no IRN at all — which ck_gem_extract_pair
refuses outright.']
  gemCanonicalField String
  gemIsRetryable Boolean [not null, default: false]
  gemRetryAfterSeconds Int
  gemShouldReauth Boolean [not null, default: false, note: 'Open a fresh session and replay once. Distinct from retryable: the same
request with the same dead token will fail forever.']
  gemRecoveryAction String [not null, default: 'NONE', note: 'NONE | REAUTH | BACKOFF | FETCH_BY_DOC | FAILOVER | MANUAL — what to do
next, so the handler branches on our word and not on a provider\'s
number. FETCH_BY_DOC is the safe recovery after an ambiguous timeout on
a generate: ask what exists before making more.']
  gemSeverity String [not null, default: 'ERROR', note: 'INFO | WARN | ERROR']
  gemIsDeleted Boolean [not null, default: false]
  gemSyncDate DateTime
  gemCreatedOn DateTime [default: `now()`, not null]
  gemCreatedBy String [not null]
  gemModifiedOn DateTime
  gemModifiedBy String
  provider gst_provider [not null]

  Note: 'Error mapping.

Provider error codes are the other thing that changes when the provider
does, and the one place where guessing is expensive. NIC\'s 2150 means
"duplicate IRN" and carries the EXISTING IRN in the error payload — the
correct response is to store that IRN and carry on, not to show a red
dialog to a person holding a printed bill.

gemShouldReauth is what turns an expired token into a silent retry.
gemIsRetryable is what keeps a validation error from being retried three
times before failing anyway.'
}

Table gst_provider_field_map {
  gfmId String [pk]
  gfmGpeId String [not null]
  gfmDirection String [not null, note: 'REQUEST | RESPONSE']
  gfmOurField String [not null, note: 'Our canonical name, the contract between the mapping engine and the rest
of the server: \'irn\', \'ack_no\', \'ack_on\', \'signed_invoice\',
\'signed_qrcode\', \'ewb_no\', \'ewb_valid_upto\', \'auth_token\',
\'session_key\', \'expires_on\', \'legal_name\', \'state_code\'.']
  gfmTheirPath String [not null, note: 'JSONPath into the reply, evaluated from gpeResponseRootPath when that is
set: \'$.Irn\', \'$.AckDt\', \'$.data.result.irn\'.']
  gfmDataType String [not null, default: 'TEXT', note: 'TEXT | INT | DECIMAL | BOOL | DATE | DATETIME | JSON']
  gfmTransform String [not null, default: 'NONE', note: 'Applied after extraction. NIC dates arrive as \'dd/MM/yyyy HH:mm:ss\', the
signed invoice is a JWT whose payload holds the real object, and the QR
is base64 — none of which a path expression can undo. DATETIME_MASK
parses using gfmFormatMask, which exists because one provider is not
internally consistent: Chartered\'s e-invoice returns AckDt on a 24-hour
clock while its e-way bill returns \'16/09/2017 10:30:00 AM\'.']
  gfmFormatMask String
  gfmIsRequired Boolean [not null, default: false, note: 'A required field that does not arrive fails the call loudly rather than
writing a half-populated e-invoice row — which is why a required field
may not also carry a default (ck_gfm_required_default): the default
would silence exactly the absence the flag exists to catch.']
  gfmDefaultValue String
  gfmTargetColumn String [note: 'The physical destination, when this field is persisted: \'gde_irn\',
\'gde_ack_no\', \'gdw_no\', … NULL for values that are only used in-flight
(auth_token, session_key).']
  gfmSortOrder Int [not null, default: 0]
  gfmIsDeleted Boolean [not null, default: false]
  gfmSyncDate DateTime
  gfmCreatedOn DateTime [default: `now()`, not null]
  gfmCreatedBy String [not null]
  gfmModifiedOn DateTime
  gfmModifiedBy String
  endpoint gst_provider_endpoint [not null]

  Note: 'Field mapping — the half that fills our columns.

RESPONSE rows are the point of this model. They say: whatever this
provider calls the IRN, and wherever it buries it, put it in gde_irn. That
is what makes provider #2 an INSERT.

REQUEST rows exist but are deliberately narrow — headers, auth
substitution, per-provider wrapper quirks. The invoice body itself is
built in code from one canonical DTO, because the NIC schema is ~140
nested, conditional, arithmetic-checked fields; expressing that as a flat
path map would move a validation problem into data, where nothing can
type-check it. Providers differ in how they wrap and encrypt the body.
They do not differ in the body: that one belongs to the government.

gfmTargetColumn is what closes the loop to the ERP. It names the actual
destination — gde_irn, gde_ack_no, gdw_no, gdw_valid_upto — so the write
back into AccVoucherDocEinvoice / AccVoucherDocEwaybill is data-driven
too, not a switch statement that has to be edited per provider. It is a
physical column name, spelled exactly as the table spells it. A schema
rename is therefore a DATA change here too — see
20260922020000_reconcile_doc_einvoice_ewaybill, which renamed
gde_canceled_on to gde_cancelled_on and repointed the seeded rows.'
}

Table gst_provider_service {
  gpsId String [pk]
  gpsGpvId String [not null]
  gpsService String [not null, note: 'EINVOICE | EWAYBILL | GSTIN_VERIFY | GSTR | ASP_ADMIN. The last is the
provider\'s own account surface (/aspapi/…) — not a statutory service,
but it has its own host and endpoints, so it is a service row like any
other.']
  gpsEnvironment String [not null, note: 'SANDBOX | PRODUCTION']
  gpsBaseUrl String [not null, note: 'Scheme + host, no trailing slash. Paths come from the endpoint rows,
version included — Chartered versions eivital (v1.04) and eicore (v1.03)
independently, so the version cannot live up here.']
  gpsFallbackUrls String[] [not null, note: 'Alternate hosts the GSP publishes for the SAME service — Chartered\'s
Mumbai and Delhi clusters, say. Trying them in order is cheaper than a
failover to a different PROVIDER, which is what gccPriority does; this
is the same provider, another door.']
  gpsAuthScheme String [not null, note: 'NIC_SEK | OAUTH2 | API_KEY | BASIC | BEARER_STATIC | CUSTOM.
NIC_SEK is the government\'s own scheme (AppKey encrypted with the IRP
public key, reply carries AuthToken plus a Sek session key); the rest
are ordinary API styles a wrapper GSP puts in front of it.']
  gpsTokenTtlMinutes Int [not null, default: 360, note: 'How long a token lives when the reply does not say. NIC issues six
hours. The margin is how early to renew — renewing exactly at expiry
races every in-flight request against the clock.']
  gpsRefreshMarginMinutes Int [not null, default: 15]
  gpsPayloadEncryption String [not null, default: 'NONE', note: 'NONE | AES_SEK | RSA — whether WE encrypt the payload or the GSP does it
for us. The single biggest behavioural difference between talking to NIC
directly and talking to a wrapper, and not derivable from anything else.']
  gpsTimeoutMs Int
  gpsMaxRetries Int
  gpsRemarks String
  gpsIsActive Boolean [not null, default: true]
  gpsIsDeleted Boolean [not null, default: false]
  gpsSyncDate DateTime
  gpsCreatedOn DateTime [default: `now()`, not null]
  gpsCreatedBy String [not null]
  gpsModifiedOn DateTime
  gpsModifiedBy String
  provider gst_provider [not null]
  endpoints gst_provider_endpoint [not null]

  Note: 'Provider × service × environment — one row per (GSP, service, SANDBOX or
PRODUCTION).

This model exists because a base url is NOT a property of a provider. NIC
serves e-invoice from einvapi and e-way bill from ewaybillapi — two hosts,
one provider — and every GSP publishes a sandbox host beside the
production one. Three facts vary together, so they are one row.

Switching a company from sandbox to production is therefore a credential
edit, not a config rewrite: the sandbox rows stay exactly where they are.

There is deliberately no gpsAuthPath. Authenticating is a call like any
other, so it is described where every other call is described: the AUTH
row in GstProviderEndpoint, which also carries the headers, the envelope
descriptors and the redact-before-logging paths that an auth call needs
more than most.'
}

Table printer_profile {
  prfId String [pk]
  prfCompanyId String [not null]
  prfBranchId String [note: 'NULL = available at every branch.']
  prfDeviceId String [note: 'The counter this printer hangs off. NULL = a shared/server-side queue.']
  prfCode String [not null]
  prfName String [not null]
  prfConnKind String [not null, default: 'CUPS']
  prfQueueName String [note: 'The OS print queue, share name, or device path.']
  prfHost String
  prfPort Int
  prfEmulation String [not null, default: 'ESCPOS']
  prfCodepage String
  prfPaperCode String [not null, default: 'A4']
  prfWidthMm Decimal
  prfHeightMm Decimal
  prfColumns Int [note: 'Characters per line. The text-engine counterpart of ptv_columns.']
  prfDpi Int
  prfSupportsCut Boolean [not null, default: false]
  prfSupportsDrawer Boolean [not null, default: false]
  prfSupportsColor Boolean [not null, default: false]
  prfInitSequence String [note: 'Raw escape sequences, hex or the printer\'s own notation.']
  prfCutSequence String
  prfSortOrder Int [not null, default: 100]
  prfRemarks String
  prfIsActive Boolean [not null, default: true]
  prfIsDeleted Boolean [not null, default: false]
  prfSyncDate DateTime
  prfCreatedOn DateTime [default: `now()`, not null]
  prfCreatedBy String
  prfModifiedOn DateTime
  prfModifiedBy String
  company companys [not null]
  branch branch_master
  device device_master
  createdByUser user_master
  modifiedByUser user_master
  assignments print_template_assignment [not null]
  printLogs print_log [not null]

  Note: 'public.printer_profile — §6, the physical device.

┌─────────────────────────────────────────────────────────────────────────┐
