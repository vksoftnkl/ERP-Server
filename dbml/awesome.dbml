  asdDefaultValue String [note: 'NULL = no value; fn_app_settings omits the key entirely.']
  asdAllowedValues Json [note: 'JSON array of legal values for an enum-ish TEXT setting. NULL = free text.']
  asdMinValue Decimal
  asdMaxValue Decimal
  asdMaxScope String [not null, default: 'COMPANY', note: 'GLOBAL | COMPANY | BRANCH | DEVICE | USER  (ck_asd_max_scope)']
