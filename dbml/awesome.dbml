Table app_setting_def {
  asdId String [pk]
  asdKey String [unique, not null, note: 'Dotted, lowercase, module-prefixed: \'sales.allow_bill_over_order_qty\'.
Never renamed — retire the row (asdIsActive = false) and add a new key.']
  asdModule String [not null]
  asdGroup String [not null, default: 'General']
