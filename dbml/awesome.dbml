  sdiLineNo Int [not null]
  sdiSplitNo Int [not null, default: 1]
  sdiSrcDocType String
  sdiSrcDocId String
  sdiSrcDocAccYear String
  sdiSrcDocRefno String
  sdiSrcLineNo Int
  sdiSrcItemId String [note: 'sale_order_item.soi_id. No FK: polymorphic with sdiSrcDocType.']
  sdiItemId String [not null]
  sdiItemUnitId String [not null]
  sdiToBaseFactor Decimal [not null, default: 0]
  sdiHsnCode String
  sdiTaxId String
  sdiPriceLevel Int
  sdiEanCode String
  sdiSize String
  sdiSizeUom String
  sdiGodownId String [not null]
  sdiLotId String
  sdiBucket String [not null, default: 'SALEABLE', note: 'SALEABLE | DAMAGED | QUARANTINE | EXPIRED | SAMPLE']
  sdiBatchNo String
  sdiBatchDate DateTime
  sdiExpiryDate DateTime
  sdiSerialNo String
  sdiIsFree Boolean [not null, default: false]
  sdiFreeType String
  sdiIsService Boolean [not null, default: false]
