  sdcAccYear String [not null]
  sdcSessionId String
  sdcCounterId String [not null]
  sdcDeviceType String
  sdcDeviceId String
  sdcDocType String [not null, default: 'DELIVERY_CHALLAN']
  sdcPurpose String [not null, default: 'SUPPLY', note: 'SUPPLY | JOB_WORK | APPROVAL | EXHIBITION | OWN_USE | LINE_SALES | OTHER']
  sdcDcSlno BigInt [not null]
  sdcDcRefno String [not null]
  sdcUsrRefno String
  sdcUsrRefdate DateTime
  sdcDcDate DateTime [not null]
  sdcDcDatetime DateTime [default: `now()`, not null]
  sdcPriceLevel Int [not null, default: 1]
  sdcSrcDocType String
  sdcSrcDocId String
  sdcSrcDocAccYear String
  sdcSrcDocRefno String
  sdcSrcDocDate DateTime
  sdcCustId String [not null]
  sdcCustName String [not null]
  sdcCustAddr String
  sdcCustPlace String
  sdcCustPin String
  sdcCustPhone String
  sdcCustGstin String
  sdcCustGstType String
  sdcCustStcd String
  sdcPosStcd String
  sdcStateName String
  sdcDriverId String
  sdcSupervisorId String
  sdcLoadmanId String[] [not null]
  sdcVehicleId String
  sdcVehicleNo String
  sdcUserId String [not null]
  sdcSalesmanId String[] [not null, note: 'uuid[] — no FK on array elements; the service validates each id.']
  sdcAgentId String
  sdcTotItems Int [not null, default: 0]
  sdcTotWeight Decimal [not null, default: 0]
  sdcTotBags Decimal [not null, default: 0]
  sdcGrossAmt Decimal [not null, default: 0]
  sdcDiscAmt Decimal [not null, default: 0]
  sdcTaxableAmt Decimal [not null, default: 0]
  sdcCgstAmt Decimal [not null, default: 0]
  sdcSgstAmt Decimal [not null, default: 0]
  sdcIgstAmt Decimal [not null, default: 0]
  sdcCessAmt Decimal [not null, default: 0]
  sdcTaxAmt Decimal [not null, default: 0]
  sdcOtherAmt Decimal [not null, default: 0]
  sdcRoundOff Decimal [not null, default: 0]
  sdcDcAmt Decimal [not null, default: 0]
  sdcTotalCost Decimal [not null, default: 0, note: 'The COGS posted AT the challan, under perpetual costing.']
  sdcBilledAmt Decimal [not null, default: 0]
  sdcReturnedAmt Decimal [not null, default: 0]
  sdcFulfilStatus String [not null, default: 'OPEN', note: 'OPEN | PARTIAL | BILLED | RETURNED | CLOSED']
  sdcHasLoad Boolean [not null, default: false]
  sdcHasUnload Boolean [not null, default: false]
  sdcHasFreight Boolean [not null, default: false]
  sdcHasPromo Boolean [not null, default: false]
  sdcPackedId String[] [not null]
  sdcItemDisc Decimal [not null, default: 0]
  sdcSplDisc Decimal [not null, default: 0]
  sdcSchDisc Decimal [not null, default: 0]
  sdcFreightAmt Decimal [not null, default: 0]
  sdcLoadAmt Decimal [not null, default: 0]
  sdcUnloadAmt Decimal [not null, default: 0]
  sdcFreightCalcType String
  sdcLoadingCalcType String
  sdcDiscAlterBase Boolean
  sdcRoundOffStep Decimal [not null, default: 1]
  sdcPaymentTerms String
  sdcDeliveryTerms String
  sdcRemarks String
  sdcStatus String [not null, default: 'DRAFT', note: 'DRAFT | POSTED | CANCELLED. WHEN / WHO / WHY a status changed is NOT
here: TxnStatusLog holds every transition, one row per step, appended
and never updated — which is also the only shape that survives an
offline push, because two devices appending cannot conflict the way two
devices UPDATEing one header row can.']
  sdcPostedVoucherId String [note: 'The COGS voucher. No FK: SERVER-owned and written long after an offline
counter created this row.']
  sdcRevisionNo Int [not null, default: 1]
  sdcPrintCount Int [not null, default: 0]
  sdcIsDeleted Boolean [not null, default: false]
  sdcSyncDate DateTime
  sdcCreatedOn DateTime [default: `now()`, not null]
  sdcCreatedBy String [not null]
  sdcModifiedOn DateTime
  sdcModifiedBy String
  customer customers [not null]
  posState state_codes
  driver employee_master
  supervisor employee_master
  vehicle vehicle_master
  items sale_dc_item [not null]
  dcReturns sale_dc_return [not null]

  indexes {
    (sdcId, sdcAccYear) [pk]
    (sdcCompanyId, sdcBranchId, sdcAccYear, sdcDcRefno) [unique]
    (sdcCompanyId, sdcBranchId, sdcAccYear, sdcCounterId, sdcDcSlno) [unique]
  }

  Note: 'Delivery challan: goods OUT before the invoice.

* a STOCK document — posting writes DC_ISSUE stock rows and, under
perpetual costing, DR COGS / CR INVENTORY at cost;
* a GST document with NO TAX LIABILITY. It carries prices and GST columns
only because rule 138(1) reads the VALUE of the goods for the e-way
bill, and because the challan has to print. Never an IRN;
* the SOURCE of a bill — a bill against a DC consumes sdiBilledQty and
posts revenue only, because the stock already left. Many DCs to one
bill, one DC to many bills, and mixed DC + direct lines on one bill are
all allowed.

sdcPurpose decides its GST reading: SUPPLY converts into a bill; the others
(JOB_WORK, APPROVAL, EXHIBITION, OWN_USE, LINE_SALES, OTHER) may only come
back via a DC return or be converted after the fact.

LIST-partitioned by sdcAccYear, PK (sdcId, sdcAccYear).'
}

Table sale_dc_item {
  sdiId String [not null]
  sdiDcId String [not null]
