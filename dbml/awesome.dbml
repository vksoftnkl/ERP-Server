Table acc_voucher_header {
  avhVoucherId String [not null]
  avhCompanyId String [not null]
  avhBranchId String [not null]
  avhTenantId String
  avhAccYear String [not null]
  avhVoucherTypeId Int [not null]
  avhVoucherNo BigInt
  avhVoucherSlno BigInt
  avhVoucherRefno String
  avhVoucherDate DateTime [not null]
  avhSrcModule String
  avhSrcDocType String
  avhSrcDocId String
  avhUsrRefno String
  avhDocRefno String
  avhDocDate DateTime
  avhDocAmount Decimal [not null, default: 0]
  avhAdjustAmount Decimal [not null, default: 0]
  avhRoundOff Decimal [not null, default: 0]
  avhTotalDebit Decimal [not null, default: 0, note: 'DERIVED by tr_av_refresh_totals from accounts.acc_vouchers — never
written by an application. ck_avh_balanced compares the two on a POSTED
header, so a stamped value would make that check compare a writer\'s own
claim with itself (migration 20260915120000, §2.4).']
  avhTotalCredit Decimal [not null, default: 0]
  avhPartyId String [not null]
  avhOppositeLedgerId String
  avhEmployeeId String[] [not null]
  avhRemarks String
  avhDraftLines Json [note: 'The other-ledger lines of a DRAFT / APPROVED receipt, held as the
request\'s own otherLines[] until they become acc_vouchers legs at post.
R10 keeps a draft off the bill tables and off the voucher tables, so
without this a re-opened draft would have lost them. Cleared to NULL at
post; nothing reads it but /receipts/get.']
  avhAgainstVoucherId String
  avhAgainstAccYear String
  avhReversalVoucherId String
  avhReversalAccYear String
  avhVoucherStatus String [not null, default: 'DRAFT']
  avhStatusOn DateTime
  avhStatusBy String
  avhPostedOn DateTime
  avhCancelReason String
  avhRevisionNo Int [not null, default: 0]
  avhUserId String [not null]
  avhSessionId String
  avhDeviceType String
  avhDeviceId String
  avhPrintCount Int [not null, default: 0]
  avhWhatsappStatus String [not null, default: 'NA']
  avhSmsStatus String [not null, default: 'NA']
  avhTallyExportStatus String [not null, default: 'PENDING']
  avhTallyExportedOn DateTime
  avhTallyGuid String
  avhTallyErrorMsg String
  avhIsActive Boolean [not null, default: true]
  avhIsDeleted Boolean [not null, default: false]
  avhSyncDate DateTime
  avhCreatedOn DateTime [default: `now()`, not null]
  avhCreatedBy String
  avhModifiedOn DateTime
  avhModifiedBy String
  company companys [not null]
  branch branch_master [not null]
  voucherType acc_voucher_types [not null]
  party acc_ledger_master [not null]
  oppositeLedger acc_ledger_master
  user user_master [not null]
  againstVoucher acc_voucher_header
  againstVouchers acc_voucher_header [not null]
  reversalVoucher acc_voucher_header
  reversalVouchers acc_voucher_header [not null]
  vouchers acc_vouchers [not null]
  bills acc_bill_balance [not null]
  billAdjustments acc_bill_adjustment [not null]
  pdcReceipts acc_pdc_register [not null]
  pdcClearings acc_pdc_register [not null]
  pdcBounces acc_pdc_register [not null]
  pdcCharges acc_pdc_register [not null]

  indexes {
    (avhVoucherId, avhAccYear) [pk]
  }

  Note: 'Voucher head. Partitioned by acc_year, so the primary key is the
composite (avhVoucherId, avhAccYear) and every FK into this table must
carry both columns.

Status / device / message / tally values are VARCHAR + CHECK in the DB,
not PG enums — the app layer owns the value sets.

Lifecycle: DRAFT -> APPROVED -> POSTED, or -> CANCELLED. A DRAFT holds no
voucher number and contributes nothing to any balance.'
}

Table acc_vouchers {
  avId String [not null]
  avVoucherId String [not null]
  avCompanyId String [not null]
  avBranchId String [not null]
  avTenantId String
  avAccYear String [not null]
  avVoucherTypeId Int [not null]
  avVoucherNo BigInt [not null]
  avRowNo Int [not null]
  avVoucherDate DateTime [not null]
  avVoucherRefno String
  avDocDate DateTime
  avDocRefno String
  avDocId String
  avDocAccYear String
  avDrCr String [not null]
  avLedgerId String [not null]
  avOppLedgerId String [note: 'Two-leg vouchers only. NULL on a multi-leg voucher such as a sale:
there is no single opposite side to name.']
  avAmount Decimal [not null, default: 0]
  avSignedAmount Decimal
  avCostCentreId String
  avRole String [note: 'accounts.acc_ledger_role.alr_role — WHY this leg exists, not merely
which ledger it hit. NULL on the party leg and on every instrument leg:
those are the party and the money, not roles. Set on every other-ledger
leg, so "TDS deducted this quarter" is a WHERE clause rather than a
lookup of whichever ledger the role happens to point at today.']
  avRemarks String
  avSessionId String
  avUserId String [not null]
  avReconDate DateTime
  avReconRefno String
  avIsReconciled Boolean
  avIsActive Boolean [not null, default: true]
  avIsDeleted Boolean [not null, default: false]
  avSyncDate DateTime
  avCreatedOn DateTime [default: `now()`, not null]
  avCreatedBy String
  avModifiedOn DateTime
  avModifiedBy String
  voucherHeader acc_voucher_header [not null]
  ledger acc_ledger_master [not null]
  oppositeLedger acc_ledger_master
  voucherType acc_voucher_types [not null]
  bill acc_bill_balance
  role acc_ledger_role

  indexes {
    (avId, avAccYear) [pk]
  }

  Note: 'Double-entry ledger rows. Partitioned by acc_year like the header, so the
primary key is the composite (avId, avAccYear) and the link back to the
header carries both columns.'
}

