  sdiSchemeName String
  sdiRemarks String
  sdiIsDeleted Boolean [not null, default: false]
  sdiSyncDate DateTime
  sdiCreatedOn DateTime [default: `now()`, not null]
  sdiCreatedBy String [not null]
  sdiModifiedOn DateTime
  sdiModifiedBy String
  dc sale_dc [not null]
  item item_master [not null]
  unit item_unit_conversion [not null]
  godown godown_locations [not null]
  lot stock_lot
  dcReturnItems sale_dc_return_item [not null]

  indexes {
    (sdiId, sdiAccYear) [pk]
  }

  Note: 'A challan line. The LOT leaves here, and the bill inherits it.

sdiItemUnitId is inventory.item_unit_conversion(iuc_id), exactly as
SaleBillItem.sbiItemUnitId — the bill line inherits this value unchanged,
so the two must share an id space.

Fulfilment is tracked on the LINE: sdiBilledQty and sdiReturnedQty are
written by OTHER documents (a bill and a DC return), which is why the
remainder is generated rather than guarded.'
}

Table sale_dc_return {
  sdrId String [not null]
  sdrCompanyId String [not null]
  sdrBranchId String [not null]
  sdrTenantId String
  sdrAccYear String [not null]
  sdrSessionId String
  sdrCounterId String [not null]
  sdrDeviceType String
  sdrDeviceId String
  sdrDocType String [not null, default: 'DC_RETURN']
  sdrReturnSlno BigInt [not null]
  sdrReturnRefno String [not null]
  sdrUsrRefno String
  sdrUsrRefdate DateTime
  sdrReturnDate DateTime [not null]
  sdrReturnDatetime DateTime [default: `now()`, not null]
  sdrDcId String [not null]
  sdrDcAccYear String [not null]
  sdrDcRefno String
  sdrDcDate DateTime
  sdrReasonId String
  sdrReturnReason String
  sdrCustId String [not null]
  sdrCustName String [not null]
  sdrCustGstin String
  sdrCustStcd String
  sdrPosStcd String
  sdrDriverId String
  sdrSupervisorId String
  sdrLoadmanId String[] [not null]
  sdrVehicleId String
  sdrVehicleNo String
  sdrUserId String [not null]
  sdrSalesmanId String[] [not null, note: 'The challan this reverses carries sdcSalesmanId, so the return of it
carries the same team — otherwise a delivery and its reversal cannot be
put side by side in any salesman report. uuid[], no FK on elements.']
  sdrTotItems Int [not null, default: 0]
  sdrTotWeight Decimal [not null, default: 0]
  sdrGrossAmt Decimal [not null, default: 0]
  sdrTaxableAmt Decimal [not null, default: 0]
  sdrTaxAmt Decimal [not null, default: 0]
  sdrReturnAmt Decimal [not null, default: 0]
  sdrTotalCost Decimal [not null, default: 0, note: 'The COGS reversed.']
  sdrRemarks String
  sdrStatus String [not null, default: 'DRAFT', note: 'DRAFT | POSTED | CANCELLED. Transitions live in TxnStatusLog.']
  sdrPostedVoucherId String [note: 'No FK: SERVER-owned, written after an offline counter created this row.']
  sdrPrintCount Int [not null, default: 0]
  sdrIsDeleted Boolean [not null, default: false]
  sdrSyncDate DateTime
  sdrCreatedOn DateTime [default: `now()`, not null]
  sdrCreatedBy String [not null]
  sdrModifiedOn DateTime
  sdrModifiedBy String
  dc sale_dc [not null]
  customer customers [not null]
  reason stock_reason_master
  driver employee_master
  supervisor employee_master
  vehicle vehicle_master
  items sale_dc_return_item [not null]

  indexes {
    (sdrId, sdrAccYear) [pk]
    (sdrCompanyId, sdrBranchId, sdrAccYear, sdrReturnRefno) [unique]
  }

  Note: 'Un-billed goods coming back off a challan.

Only the DC\'s OPEN quantity (sdiOpenQty) may return here; BILLED goods come
back through a SaleReturn. Posting writes DC_RETURN stock rows, reverses
COGS at the DC line\'s cost, writes an INWARD challan register row and an
e-way bill when the goods travel by a transporter.

NO party leg — nothing was ever owed, so there is nothing to credit.

ONE challan per DC return, which is why sdrDcId is a plain NOT NULL pair
rather than a per-line reference.'
}

Table sale_dc_return_item {
  sdriId String [not null]
  sdriReturnId String [not null]
  sdriCompanyId String [not null]
  sdriBranchId String [not null]
  sdriTenantId String
  sdriAccYear String [not null]
  sdriLineNo Int [not null]
  sdriDcItemId String [not null]
  sdriDcAccYear String [not null]
  sdriDcLineNo Int
  sdriItemId String [not null]
  sdriItemUnitId String [not null, note: 'item_unit_conversion, matching the DC line it reverses.']
  sdriToBaseFactor Decimal [not null, default: 0]
  sdriHsnCode String
  sdriGodownId String [not null]
  sdriLotId String [note: 'The DC line\'s lot: it goes back where it came from.']
  sdriCondition String [not null, default: 'RESTOCK', note: 'RESTOCK | DAMAGED | EXPIRED | SCRAP']
  sdriBucket String [not null, default: 'SALEABLE', note: 'SALEABLE | DAMAGED | QUARANTINE | EXPIRED | SAMPLE']
  sdriBatchNo String
  sdriExpiryDate DateTime
  sdriSerialNo String
  sdriReturnQty Decimal [not null, default: 0]
  sdriFreeQty Decimal [not null, default: 0]
  sdriNetQty Decimal [not null, default: 0]
  sdriWeightQty Decimal [default: 0]
  sdriRate Decimal [not null, default: 0]
  sdriCostPrice Decimal [note: 'The DC line\'s cost: what COGS reverses at.']
  sdriTaxableAmt Decimal [not null, default: 0]
  sdriTaxPerc Decimal [not null, default: 0]
  sdriTaxAmt Decimal [not null, default: 0]
  sdriNetAmt Decimal [not null, default: 0]
  sdriPriceLevel Int [not null]
  sdriEanCode String
  sdriIsTaxIncl Boolean [not null, default: false]
  sdriIsService Boolean [not null, default: false]
  sdriRatePreTax Decimal [not null, default: 0]
  sdriMaxPrice Decimal
  sdriItemDiscPerc Decimal [not null, default: 0]
  sdriItemDiscAmt Decimal [not null, default: 0]
  sdriSchDiscAmt Decimal [not null, default: 0]
  sdriGrossAmt Decimal [not null, default: 0]
  sdriCgstPerc Decimal [not null, default: 0]
  sdriCgstAmt Decimal [not null, default: 0]
  sdriSgstPerc Decimal [not null, default: 0]
  sdriSgstAmt Decimal [not null, default: 0]
  sdriIgstPerc Decimal [not null, default: 0]
  sdriIgstAmt Decimal [not null, default: 0]
  sdriCessPerc Decimal [not null, default: 0]
  sdriCessPerUnit Decimal [not null, default: 0]
  sdriCessAmt Decimal [not null, default: 0]
  sdriSize String
  sdriSizeUom String
  sdriTaxId String
  sdriRemarks String
  sdriIsDeleted Boolean [not null, default: false]
  sdriSyncDate DateTime
  sdriCreatedOn DateTime [default: `now()`, not null]
  sdriCreatedBy String [not null]
  sdriModifiedOn DateTime
  sdriModifiedBy String
  dcReturn sale_dc_return [not null]
  dcItem sale_dc_item [not null]
  item item_master [not null]
  unit item_unit_conversion [not null]
  godown godown_locations [not null]
  lot stock_lot

  indexes {
    (sdriId, sdriAccYear) [pk]
  }

  Note: 'A DC-return line. The DC line is MANDATORY — a DC return is never free, so
unlike SaleReturnItem there is no nullable source.

The lot goes back where it came from, which is why sdriLotId is the DC
line\'s lot rather than a fresh one.

The money columns are the DC line\'s figures, carried for the INWARD e-way
bill: goods coming back still have a value the portal wants.'
}

