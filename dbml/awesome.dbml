  sdiWeightQty Decimal [default: 0]
  sdiBilledQty Decimal [not null, default: 0]
  sdiReturnedQty Decimal [not null, default: 0]
  sdiOpenQty Decimal [note: 'GENERATED ALWAYS ... STORED: dcQty - billedQty - returnedQty. Read-only —
never send it on a create or update.

Allowed to go NEGATIVE. The challan\'s own quantities may be guarded, but
billed and returned are written by other documents — a bill and a DC
return, either of which may have been raised offline — so an over-draw
is RECORDED (ix_sdi_overdrawn) rather than refused, because refusing it
would abort a sync batch for goods that already moved.']
  sdiLineStatus String [not null, default: 'OPEN', note: 'OPEN | PARTIAL | BILLED | RETURNED | CLOSED']
  sdiRate Decimal [not null, default: 0]
  sdiRatePreTax Decimal [not null, default: 0]
  sdiMaxPrice Decimal
  sdiCostPrice Decimal [note: 'Resolved lot cost at post: the COGS rate.']
  sdiIsTaxIncl Boolean [not null, default: false]
  sdiDiscPerc Decimal [not null, default: 0]
  sdiDiscAmt Decimal [not null, default: 0]
  sdiGrossAmt Decimal [not null, default: 0]
  sdiTaxableAmt Decimal [not null, default: 0]
  sdiTaxPerc Decimal [not null, default: 0]
  sdiCgstPerc Decimal [not null, default: 0]
  sdiCgstAmt Decimal [not null, default: 0]
  sdiSgstPerc Decimal [not null, default: 0]
  sdiSgstAmt Decimal [not null, default: 0]
