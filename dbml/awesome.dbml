  sdiCessPerc Decimal [not null, default: 0]
  sdiCessAmt Decimal [not null, default: 0]
  sdiTaxAmt Decimal [not null, default: 0]
  sdiNetAmt Decimal [not null, default: 0]
  sdiIsPromo Boolean [not null, default: false]
  sdiActPrice Decimal
  sdiMinPrice Decimal
  sdiItemDiscPerc Decimal [not null, default: 0]
  sdiItemDiscAmt Decimal [not null, default: 0]
  sdiSplDiscPerc Decimal [not null, default: 0]
  sdiSplDiscAmt Decimal [not null, default: 0]
  sdiSchDiscPerc Decimal [not null, default: 0]
  sdiSchDiscAmt Decimal [not null, default: 0]
  sdiChrgBeforeTax Decimal
