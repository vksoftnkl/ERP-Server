  atdQuarter String [not null]
  atdDirection String [not null]
  atdPartyId String [not null]
  atdPan String
  atdPartyName String [not null]
  atdDeducteeType String
  atdSection String [not null]
  atdRate Decimal [not null]
  atdRateSource String [not null]
  atdBaseAmount Decimal [not null]
  atdTaxAmount Decimal [not null]
  atdVoucherId String
  atdVoucherAccYear String
  atdDocRefno String
  atdDocDate DateTime [not null]
  atdBillId String
  atdBillAccYear String
  atdReversalOfId String
  atdChallanNo String
  atdChallanDate DateTime
  atdChallanBsr String
  atdCertificateNo String
  atdCertificateDate DateTime
  atdRemarks String
  atdIsActive Boolean [not null, default: true]
  atdIsDeleted Boolean [not null, default: false]
  atdCreatedOn DateTime [default: `now()`, not null]
  atdCreatedBy String
  atdModifiedOn DateTime
  atdModifiedBy String
  party acc_ledger_master [not null]
  reversalOf acc_tds_register
  reversals acc_tds_register [not null]
  atdSyncDate DateTime [note: 'NULL = changed since the last push to the cloud DB (see src/modules/cloud-sync).']

  Note: 'The 26Q side. Same shape, same rules, different form — see the header
comment on `AccTcsRegister` above, which covers both.

The one structural difference is `atdDeducteeType`: 26Q reports a company
and a non-company deductee under different codes, and
`acc_ledger_master.led_tds_deductee_type` is where that comes from. TCS has
no equivalent, which is why it is here and not on both.'
}

Table acc_temp_credit {
  atcId String [not null]
  atcCompanyId String [not null]
  atcBranchId String [not null]
  atcTenantId String
  atcAccYear String [not null]
  atcPartyId String [not null, note: 'The ledger the sales screen chose — the walk-in one, usually, which is
exactly why this table has to exist.']
  atcSrcDocType String [not null, default: 'SALE_BILL']
  atcSrcDocId String [not null]
  atcBillRefno String
  atcBillDate DateTime [not null]
  atcBillAmount Decimal [not null, default: 0]
  atcAblId String [not null, note: 'The bill\'s AccBillBalance row: where the outstanding actually lives.']
  atcAblAccYear String [not null]
  atcTenderId String [note: 'The TEMP_CR AccTenderDetail row (tender type 8).']
  atcTenderAccYear String
  atcName String [not null]
  atcMobile String [not null, note: 'How the counter finds them again (ix_atc_mobile). NOT NULL and
shape-checked: a loan to somebody you cannot ring is not a loan.']
  atcPlace String
  atcAddr String
  atcIdRef String [note: 'Any id shown at the counter. Optional.']
  atcDays Int [not null, default: 0]
  atcDueDate DateTime [not null]
  atcCreditAmount Decimal [not null, note: 'What was lent. Set once, when the tender is taken, and guarded.']
  atcBalanceAmount Decimal [not null, note: 'A MAINTAINED copy of AccBillBalance.ablPendingAmount — itself a GENERATED
column — refreshed by BillBalanceRecomputeService whenever the balance row
moves: a receipt allocation, a write-off, a credit-note set-off. Never
written by hand.

It carries no non-negativity guard: a receipt raised on another device may
move the balance before this row syncs, so an over-draw is RECORDED and
found by ix_atc_overdrawn rather than refused.']
  atcStatus String [not null, default: 'OPEN', note: 'OPEN | PARTIAL | SETTLED | WRITTEN_OFF | CANCELLED. A cancelled bill sets
CANCELLED and KEEPS the row — a reversal, never a delete.']
  atcSettledOn DateTime
  atcLastReceiptId String
  atcPromiseDate DateTime [note: 'Re-promised on a follow-up call.']
  atcFollowupOn DateTime
  atcFollowupBy String
  atcReminderSentOn DateTime
  atcRemarks String
  atcUserId String
  atcCounterId String
  atcSessionId String
  atcIsDeleted Boolean [not null, default: false]
  atcSyncDate DateTime
  atcCreatedOn DateTime [default: `now()`, not null]
  atcCreatedBy String
  atcModifiedOn DateTime
  atcModifiedBy String
  party acc_ledger_master [not null]
  bill sale_bill [not null]
  billBalance acc_bill_balance [not null]
  tender acc_tender_detail

  indexes {
    (atcId, atcAccYear) [pk]
  }

  Note: 'TEMP CREDIT — a small loan at the counter to somebody who is NOT a credit
party.

A walk-in takes goods and pays part now, the rest "in a few days". The bill
is raised on the party the sales screen chose — the walk-in ledger, usually
— and the unpaid part is a TEMP_CR tender (acc_tender_types id 8). Like
CREDIT, that tender writes NO leg and leaves the bill\'s AccBillBalance row
OPEN for the amount.

So the OUTSTANDING is already where every receipt looks. What the ledger
cannot tell you is WHO: the walk-in ledger has a thousand bills against it.
THIS TABLE IS THE WHO — name, mobile, place, promise — one row per TEMP_CR
tender, riding on the bill\'s balance row.

LIST-partitioned by atcAccYear, which fk_atc_bill also uses as the BILL\'s
year: a temp credit belongs to the year of the bill that created it, so the
two cannot diverge.'
}

Table acc_tender_detail {
  tdId String [not null]
