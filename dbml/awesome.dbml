Table tax_rate_master {
  taxId String [pk]
  taxName String [not null]
  taxCode String
  taxSortOrder Int [not null, default: 0]
  taxTaxability String [not null, default: 'TAXABLE', note: 'Same vocabulary as accounts."VoucherDocDetailTaxability", minus MIXED — a
rate is never mixed; a DOCUMENT is, when its lines disagree.
TAXABLE | EXEMPT | NIL_RATED | NON_GST | ZERO_RATED (ck_tax_taxability)']
  taxIsReverseCharge Boolean [not null, default: false]
  taxRatePerc Decimal [not null, default: 0, note: 'The total GST rate: 18 means 18%, charged as 9+9 locally or 18 inter-state.']
  taxCgstPerc Decimal
  taxSgstPerc Decimal
  taxIgstPerc Decimal
  taxCessBasis String [not null, default: 'NONE', note: 'NONE | PERCENT (taxCessPerc) | PER_UNIT (taxCessPerUnit) | BOTH. Says
which figure is in play, so a zero is never ambiguous (ck_tax_cess_basis).']
  taxCessPerc Decimal [not null, default: 0]
  taxCessPerUnit Decimal [not null, default: 0]
  taxAcessBasis String [not null, default: 'NONE', note: 'A SECOND cess, because sale_bill_item (sbi_acess_*), acc_voucher_doc_register
(gdr_state_cess_value) and the \'State Cess\' duty head all expect one. Same
shape as the block above, so a line can carry both independently — Kerala
flood cess beside compensation cess is the standard example.']
  taxAcessPerc Decimal [not null, default: 0]
  taxAcessPerUnit Decimal [not null, default: 0]
  taxSupersedesId String [note: 'The rate this one replaced. A rate change makes a NEW row and re-points
items (see ItemTaxHistory); this keeps the chain followable. NULL on an
original rate.']
  taxIsActive Boolean [not null, default: true]
  taxIsDeleted Boolean [not null, default: false]
  taxSyncDate DateTime
  taxCreatedOn DateTime [default: `now()`, not null]
  taxCreatedBy String
  taxModifiedOn DateTime
  taxModifiedBy String
  supersedes tax_rate_master
  supersededBy tax_rate_master [not null]
  ledgerOverrides tax_rate_ledger [not null]
  defaultItems item_master [not null]
  itemTaxHistory item_tax_history [not null]
  ledgers acc_ledger_master [not null]
  billItems sale_bill_item [not null]
  orderItems sale_order_item [not null]
  quotationItems sale_quotation_item [not null]
  charges charge_master [not null]
  chargeLines txn_charge_detail [not null]

  Note: 'GST rate master. One row per rate, shared by every company — a rate is
statutory and national, so the ledgers it names must be global too.

Replaces the eighteen ledger columns of inventory.item_tax_master with rows
in TaxRateLedger; see that model.'
}

Table tax_rate_ledger {
  trlId String [pk]
  trlTaxId String [not null]
  trlRole String [not null]
  trlSupplyNature String [note: 'NULL = both natures. Only roles with alrBySupply may set it.
INTRA | INTER (ck_trl_supply_nature)']
  trlLedgerId String [not null]
  trlRemarks String
  trlIsActive Boolean [not null, default: true]
  trlIsDeleted Boolean [not null, default: false]
  trlSyncDate DateTime
  trlCreatedOn DateTime [default: `now()`, not null]
  trlCreatedBy String
  trlModifiedOn DateTime
  trlModifiedBy String
  taxRate tax_rate_master [not null]
  role acc_ledger_role [not null]
  ledger acc_ledger_master [not null]

  Note: 'Per-GST-rate ledger overrides. One row per (rate, role, supply nature) that
actually differs from the default — a rate that posts wherever
accounts.acc_ledger_map says has no rows here at all, which is a complete
configuration. Same (scope, role, nature) -> ledger shape as the map; the
map\'s scope is company and branch, this one\'s is the rate.'
}

Table app_setting_def {
  asdId String [pk]
  asdKey String [unique, not null, note: 'Dotted, lowercase, module-prefixed: \'sales.allow_bill_over_order_qty\'.
Never renamed — retire the row (asdIsActive = false) and add a new key.']
  asdModule String [not null]
  asdGroup String [not null, default: 'General']
  asdDataType String [not null, note: 'BOOL | INT | DECIMAL | TEXT | UUID | DATE | JSON  (ck_asd_data_type)']
  asdDefaultValue String [note: 'NULL = no value; fn_app_settings omits the key entirely.']
  asdAllowedValues Json [note: 'JSON array of legal values for an enum-ish TEXT setting. NULL = free text.']
  asdMinValue Decimal
  asdMaxValue Decimal
  asdMaxScope String [not null, default: 'COMPANY', note: 'GLOBAL | COMPANY | BRANCH | DEVICE | USER  (ck_asd_max_scope)']
  asdLabel String [not null]
  asdDescription String
  asdSortOrder Int [not null, default: 0]
  asdIsActive Boolean [not null, default: true]
  asdNeedsRelogin Boolean [not null, default: false]
  asdIsDeleted Boolean [not null, default: false]
  asdSyncDate DateTime
  asdCreatedOn DateTime [default: `now()`, not null]
  asdCreatedBy String [not null]
  asdModifiedOn DateTime
  asdModifiedBy String
  values app_setting_value [not null]

  Note: 'Catalog — one row per configurable setting, forever.
A new setting is an INSERT here; no DDL, no client release.'
}

Table app_setting_value {
  asvId String [pk]
  asvSettingKey String [not null]
  asvScope String [not null, note: 'GLOBAL | COMPANY | BRANCH | DEVICE | USER  (ck_asv_scope);
the id columns below must agree with it (ck_asv_scope_ids).']
  asvCompanyId String
  asvBranchId String
  asvDeviceId String
  asvUserId String
  asvValue String [note: 'Stored as text for every type; fn_app_settings casts on the way out.
NULL = "explicitly nothing", distinct from no row at all ("inherit").']
  asvRemarks String
  asvIsDeleted Boolean [not null, default: false]
  asvSyncDate DateTime
  asvCreatedOn DateTime [default: `now()`, not null]
  asvCreatedBy String [not null]
  asvModifiedOn DateTime
  asvModifiedBy String
  setting app_setting_def [not null]
  company companys
  branch branch_master
  device device_master
  user user_master

  Note: 'Overrides — one row per (setting, scope target).
A row exists only where somebody changed something. "Reset to default" is a
DELETE, never a write of the default value.'
}

