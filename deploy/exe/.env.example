# ERP server settings. Copy this file to ".env" in the same folder as the
# server (erp-server.exe on Windows, erp-server on Linux), then fill in every
# value marked CHANGE_ME.
# The server reads .env from the folder it is started in. start-erp-server.bat
# (Windows) and start-erp-server.sh (Linux) start it in its own folder.

# production = boot seeds run (DB_AUTO_SEED defaults to on).
NODE_ENV=production
HOST=0.0.0.0
PORT=3011
API_PREFIX=api
API_VERSION=1
CORS_ORIGINS=*
CORS_CREDENTIALS=false

# HTTPS: set true and put the certificate files in a "certs" folder next to the server.
HTTPS_ENABLED=false
HTTPS_CERT_PATH=certs/localhost.crt
HTTPS_KEY_PATH=certs/localhost.key

# PostgreSQL. The server cannot run Prisma migrations: the database must already be
# migrated (npm run prisma:migrate:deploy from the source tree).
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/ERP
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=ERP
DB_SSL=false
DB_SYNC=false
DB_LOGGING=false
DB_AUTO_MIGRATE=false

# At least 16 characters. Changing it logs every user out.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

THROTTLE_TTL=60
THROTTLE_LIMIT=1000000

# Redis is optional. Leave false unless Redis is installed on this PC.
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=3600
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_CONNECT_TIMEOUT_MS=5000

CLOUD_SYNC_ENABLED=false
CLOUD_DATABASE_URL=
CLOUD_SYNC_INTERVAL_SECONDS=60
CLOUD_SYNC_BATCH_SIZE=500

# Must be the SAME key that encrypted the GST credentials already in this
# database. A different key makes the saved GST provider passwords unreadable.
GST_CRED_KEY=CHANGE_ME
GST_CRED_KEY_VERSION=1

# Part B (app versioning). The updater / CI sets these for each backend build.
# APP_BUILD is the build number; a start on a NEW build logs every user out once
# and loads compat-manifest.json (beside this exe) into the build policy, so each
# frontend must then run the build that manifest names (else 426 UPDATE_REQUIRED).
# Unset APP_BUILD = no logout and no policy change. APP_COMPAT_MANIFEST overrides
# where the manifest is read from.
APP_VERSION=
APP_BUILD=
APP_COMMIT=
APP_COMPAT_MANIFEST=
