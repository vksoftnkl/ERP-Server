NODE_ENV=development
HOST=0.0.0.0
PORT=3010
API_PREFIX=api
CORS_ORIGINS=*
CORS_CREDENTIALS=false
REQUEST_BODY_LIMIT=10mb
LOG_FILE_PATH=logs/app.log
ERROR_LOG_FILE_PATH=logs/error.log
HTTPS_ENABLED=false
HTTPS_CERT_PATH=
HTTPS_KEY_PATH=
HTTPS_PASSPHRASE=

DATABASE_URL=postgresql://erp_app:erp_password@localhost:5432/erp_db?schema=public
DB_HOST=localhost
DB_PORT=5432
DB_USER=erp_app
DB_PASSWORD=erp_password
DB_NAME=erp_db
DB_SSL=false
DB_SYNC=false
DB_LOGGING=false

JWT_SECRET=replace-with-a-secure-secret

THROTTLE_TTL=60
THROTTLE_LIMIT=100
