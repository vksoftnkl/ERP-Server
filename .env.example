NODE_ENV=development
HOST=0.0.0.0
PORT=3010
API_PREFIX=api
CORS_ORIGINS=*
CORS_CREDENTIALS=false
REQUEST_BODY_LIMIT=10mb
LOG_FILE_PATH=logs/app.log
ERROR_LOG_FILE_PATH=logs/error.log
HTTPS_ENABLED=false
HTTPS_CERT_PATH=
HTTPS_KEY_PATH=
HTTPS_PASSPHRASE=

DATABASE_URL=postgresql://erp_app:erp_password@localhost:5432/erp_db?schema=public
DB_HOST=localhost
DB_PORT=5432
DB_USER=erp_app
DB_PASSWORD=erp_password
DB_NAME=erp_db
DB_SSL=false
DB_SYNC=false
DB_LOGGING=false

JWT_SECRET=replace-with-a-secure-secret
ACCESS_TOKEN_TTL_SECONDS=3600

THROTTLE_TTL=60
THROTTLE_LIMIT=100

REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_CONNECT_TIMEOUT_MS=5000
# REDIS_URL=redis://localhost:6379/0
