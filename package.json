{
  "name": "erp-server",
  "version": "1.0.0",
  "description": "Enterprise-grade NestJS boilerplate with PostgreSQL",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "release": "npm run build && pkg .",
    "release:linux": "npm run build && pkg . --targets node18-linux-x64 --output release/erp-server-linux",
    "postinstall": "npm run prisma:schema:build && prisma generate --schema prisma/schema.prisma",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "perf:load": "node scripts/perf/load-test.js",
    "perf:smoke": "node scripts/perf/load-test.js --scenario smoke",
    "perf:baseline": "node scripts/perf/load-test.js --scenario baseline",
    "perf:stress": "node scripts/perf/load-test.js --scenario stress",
    "perf:custom": "node scripts/perf/load-test.js --routes-file scripts/perf/routes.example.json",
    "seed:item-groups": "node scripts/seed-item-group-master.js",
    "seed:supermarket-items": "node scripts/seed-supermarket-items.js",
    "prisma:schema:build": "node scripts/build-prisma-schema.js",
    "prisma:generate": "npm run prisma:schema:build && prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:dev": "npm run prisma:schema:build && prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "npm run prisma:schema:build && prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:migrate:reset": "npm run prisma:schema:build && prisma migrate reset --schema prisma/schema.prisma",
    "prisma:repair:ui-table-drift": "node scripts/repair-ui-table-drift.js",
    "prisma:migrate:sync-checksums": "node scripts/sync-prisma-migration-checksums.js",
    "prisma:studio": "npm run prisma:schema:build && prisma studio --schema prisma/schema.prisma",
    "migration:run": "npm run prisma:migrate:deploy"
  },
  "bin": "dist/src/main.js",
  "pkg": {
    "assets": [
      "dist/**/*.js",
      "node_modules/.prisma/client/index.js",
      "node_modules/.prisma/client/client.js",
      "node_modules/.prisma/client/default.js",
      "node_modules/.prisma/client/edge.js",
      "node_modules/.prisma/client/wasm.js",
      "node_modules/.prisma/client/query_engine_bg.js",
      "node_modules/.prisma/client/query_engine_bg.wasm",
      "node_modules/.prisma/client/schema.prisma",
      "node_modules/.prisma/client/package.json",
      "node_modules/.prisma/client/libquery_engine-debian-openssl-3.0.x.so.node",
      "node_modules/@prisma/client/package.json",
      "node_modules/@prisma/client/runtime/library.js",
      "node_modules/@prisma/client/runtime/library.mjs",
      "node_modules/@prisma/client/runtime/binary.js",
      "node_modules/@prisma/client/runtime/binary.mjs",
      "node_modules/@prisma/client/runtime/client.js",
      "node_modules/@prisma/client/runtime/client.mjs",
      "node_modules/@prisma/client/runtime/edge.js",
      "node_modules/@prisma/client/runtime/edge-esm.js",
      "node_modules/@prisma/client/runtime/query_engine_bg.postgresql.js",
      "node_modules/@prisma/client/runtime/query_engine_bg.postgresql.mjs",
      "node_modules/@prisma/client/runtime/query_engine_bg.postgresql.wasm-base64.js",
      "node_modules/@prisma/client/runtime/query_engine_bg.postgresql.wasm-base64.mjs",
      "node_modules/@prisma/client/runtime/query_compiler_bg.postgresql.js",
      "node_modules/@prisma/client/runtime/query_compiler_bg.postgresql.mjs",
      "node_modules/@prisma/client/runtime/query_compiler_bg.postgresql.wasm-base64.js",
      "node_modules/@prisma/client/runtime/query_compiler_bg.postgresql.wasm-base64.mjs",
      "prisma/**/*",
      ".env"
    ],
    "targets": [
      "node18-win-x64",
      "node18-linux-x64"
    ],
    "outputPath": "release"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.0.5",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.3.0",
    "@prisma/client": "6.19.2",
    "bullmq": "^5.76.8",
    "cache-manager": "^7.2.8",
    "cache-manager-redis-store": "^3.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.5",
    "dotenv": "^16.4.7",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "pg": "^8.13.1",
    "redis": "^5.11.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "pkg": "^5.8.1",
    "prettier": "^3.4.2",
    "prisma": "6.19.2",
    "prisma-dbml-generator": "^0.12.0",
    "prisma-docs-generator": "^0.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    }
  },
  "prisma": {
    "seed": "tsx prisma/seed/Stock_Adjust_Reasons.ts"
  }
}