// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`Stock Summary SQL the pass: opening before from, period rows, internal pairs in scope, two valuations, three parts 1`] = `"WITH op AS ( SELECT l.sml_item_id AS item, l.sml_lot_id AS lot, l.sml_godown_id AS godown, l.sml_bucket::text AS bucket, SUM(l.sml_signed_base_qty) AS q, SUM(l.sml_direction * l.sml_cost_value_wot) AS v FROM stock.stock_ledger l WHERE l.sml_company_id = $1::uuid AND l.sml_branch_id = $2::uuid AND l.sml_is_deleted = false AND l.sml_doc_date < $3::date GROUP BY 1, 2, 3, 4), pr AS ( SELECT l.sml_item_id AS item, l.sml_lot_id AS lot, l.sml_godown_id AS godown, l.sml_bucket::text AS bucket, l.sml_signed_base_qty AS sq, l.sml_direction * l.sml_cost_value_wot AS sv, (CASE WHEN l.sml_is_reversal THEN -l.sml_direction ELSE l.sml_direction END)::int AS nat, l.sml_txn_type::text AS txn, l.sml_src_doc_id AS doc_id, COALESCE(l.sml_src_acc_year, l.sml_acc_year) AS src_year, l.sml_line_no AS line_no, l.sml_split_no AS split_no, l.sml_is_reversal AS is_rev, (true AND l.sml_bucket = $4) AS ins FROM stock.stock_ledger l WHERE l.sml_company_id = $5::uuid AND l.sml_branch_id = $6::uuid AND l.sml_is_deleted = false AND l.sml_doc_date BETWEEN $7::date AND $8::date ), mv AS ( SELECT item, doc_id, src_year, line_no, split_no, lot, is_rev FROM pr WHERE ins AND txn IN ('TRANSFER_OUT','TRANSFER_IN','BUCKET_OUT','BUCKET_IN') GROUP BY 1, 2, 3, 4, 5, 6, 7 HAVING COUNT(DISTINCT nat) = 2), prc AS ( SELECT pr.*, (mv.doc_id IS NOT NULL) AS internal FROM pr LEFT JOIN mv ON pr.ins AND pr.txn IN ('TRANSFER_OUT','TRANSFER_IN','BUCKET_OUT','BUCKET_IN') AND mv.item = pr.item AND mv.doc_id = pr.doc_id AND mv.src_year = pr.src_year AND mv.line_no = pr.line_no AND mv.split_no = pr.split_no AND mv.lot = pr.lot AND mv.is_rev = pr.is_rev), h AS ( SELECT item, lot, godown, bucket, COALESCE(SUM(oq), 0) AS oq, COALESCE(SUM(ov), 0) AS ov, COALESCE(SUM(sq), 0) AS pq, COALESCE(SUM(sv), 0) AS pv, COALESCE(SUM(sq) FILTER (WHERE nat = 1 AND NOT internal), 0) AS iq, COALESCE(-SUM(sq) FILTER (WHERE nat = -1 AND NOT internal), 0) AS xq, COALESCE(SUM(sv) FILTER (WHERE nat = 1 AND NOT internal), 0) AS iv, COALESCE(-SUM(sv) FILTER (WHERE nat = -1 AND NOT internal), 0) AS xv, COUNT(sq)::int AS n FROM (SELECT item, lot, godown, bucket, q AS oq, v AS ov, NULL::numeric AS sq, NULL::numeric AS sv, NULL::int AS nat, false AS internal FROM op UNION ALL SELECT item, lot, godown, bucket, NULL, NULL, sq, sv, nat, internal FROM prc) u GROUP BY 1, 2, 3, 4), ho AS ( SELECT $9::uuid AS branch, item, lot, godown, bucket, oq AS q, ov AS v FROM h), hc AS ( SELECT $10::uuid AS branch, item, lot, godown, bucket, oq + pq AS q, ov + pv AS v FROM h), vo_pol AS MATERIALIZED ( SELECT k.branch, k.item, COALESCE(stp.stp_valuation_method, 'WAVG')::text AS vm FROM (SELECT DISTINCT branch, item FROM ho) k JOIN inventory.item_master itm ON itm.item_id = k.item LEFT JOIN LATERAL ( SELECT p.* FROM stock.stock_track_policy p WHERE p.stp_is_active = true AND p.stp_is_deleted = false AND $11::date BETWEEN p.stp_effective_from AND p.stp_effective_to AND (p.stp_company_id IS NULL OR p.stp_company_id = $12::uuid) AND (p.stp_branch_id IS NULL OR p.stp_branch_id = k.branch) AND ( (p.stp_scope = 'ITEM' AND p.stp_scope_id = k.item) OR (p.stp_scope = 'GROUP' AND p.stp_scope_id = itm.item_group_id) OR p.stp_scope = 'COMPANY' ) ORDER BY CASE WHEN p.stp_scope = 'ITEM' AND p.stp_branch_id IS NOT NULL THEN 1 WHEN p.stp_scope = 'ITEM' THEN 2 WHEN p.stp_scope = 'GROUP' AND p.stp_branch_id IS NOT NULL THEN 3 WHEN p.stp_scope = 'GROUP' THEN 4 WHEN p.stp_branch_id IS NOT NULL THEN 5 ELSE 6 END, (p.stp_company_id IS NULL), p.stp_effective_from DESC LIMIT 1 ) stp ON true ), vo_rv AS MATERIALIZED ( SELECT r.scr_branch_id AS branch, r.scr_item_id AS item, CASE WHEN p.vm = 'LOT_ACTUAL' THEN r.scr_lot_id END AS pool_lot, SUM(r.scr_value_wot) AS v FROM stock.stock_cost_revaluation r JOIN vo_pol p ON p.branch = r.scr_branch_id AND p.item = r.scr_item_id WHERE r.scr_company_id = $13::uuid AND r.scr_is_deleted = false AND r.scr_doc_date <= $14::date GROUP BY 1, 2, 3), vo_hp AS MATERIALIZED ( SELECT x.branch, x.item, x.lot, x.godown, x.bucket, x.q, x.v, p.vm, CASE WHEN p.vm = 'LOT_ACTUAL' THEN x.lot END AS pool_lot FROM ho x JOIN vo_pol p ON p.branch = x.branch AND p.item = x.item), vo_pool AS MATERIALIZED ( SELECT branch, item, pool_lot, SUM(q) AS pq, bool_or(q <> 0) AS has_stock, SUM(v) AS hv FROM vo_hp GROUP BY 1, 2, 3), vo_rate AS MATERIALIZED ( SELECT pl.branch, pl.item, pl.pool_lot, CASE WHEN pl.pq > 0 THEN ROUND((pl.hv + COALESCE(r.v, 0)) / pl.pq, 6) WHEN NOT pl.has_stock THEN 0::numeric ELSE COALESCE(( SELECT x.sml_cost_rate_wot FROM stock.stock_ledger x WHERE x.sml_company_id = $15::uuid AND x.sml_branch_id = pl.branch AND x.sml_item_id = pl.item AND (pl.pool_lot IS NULL OR x.sml_lot_id = pl.pool_lot) AND x.sml_is_deleted = false AND x.sml_is_reversal = false AND x.sml_doc_date <= $16::date AND NOT EXISTS ( SELECT 1 FROM stock.stock_ledger y WHERE y.sml_reverses_id = x.sml_id AND y.sml_acc_year = x.sml_acc_year AND y.sml_is_reversal = true AND y.sml_is_deleted = false) ORDER BY x.sml_doc_datetime DESC, x.sml_id DESC LIMIT 1), 0::numeric) END AS r FROM vo_pool pl LEFT JOIN vo_rv r ON r.branch = pl.branch AND r.item = pl.item AND r.pool_lot IS NOT DISTINCT FROM pl.pool_lot), vo_val AS MATERIALIZED ( SELECT x.branch, x.item, x.lot, x.godown, x.bucket, x.q, x.v, x.vm, t.r AS rate, ROUND(x.q * t.r, 2) AS value FROM vo_hp x JOIN vo_rate t ON t.branch = x.branch AND t.item = x.item AND t.pool_lot IS NOT DISTINCT FROM x.pool_lot), vc_pol AS MATERIALIZED ( SELECT k.branch, k.item, COALESCE(stp.stp_valuation_method, 'WAVG')::text AS vm FROM (SELECT DISTINCT branch, item FROM hc) k JOIN inventory.item_master itm ON itm.item_id = k.item LEFT JOIN LATERAL ( SELECT p.* FROM stock.stock_track_policy p WHERE p.stp_is_active = true AND p.stp_is_deleted = false AND $17::date BETWEEN p.stp_effective_from AND p.stp_effective_to AND (p.stp_company_id IS NULL OR p.stp_company_id = $18::uuid) AND (p.stp_branch_id IS NULL OR p.stp_branch_id = k.branch) AND ( (p.stp_scope = 'ITEM' AND p.stp_scope_id = k.item) OR (p.stp_scope = 'GROUP' AND p.stp_scope_id = itm.item_group_id) OR p.stp_scope = 'COMPANY' ) ORDER BY CASE WHEN p.stp_scope = 'ITEM' AND p.stp_branch_id IS NOT NULL THEN 1 WHEN p.stp_scope = 'ITEM' THEN 2 WHEN p.stp_scope = 'GROUP' AND p.stp_branch_id IS NOT NULL THEN 3 WHEN p.stp_scope = 'GROUP' THEN 4 WHEN p.stp_branch_id IS NOT NULL THEN 5 ELSE 6 END, (p.stp_company_id IS NULL), p.stp_effective_from DESC LIMIT 1 ) stp ON true ), vc_rv AS MATERIALIZED ( SELECT r.scr_branch_id AS branch, r.scr_item_id AS item, CASE WHEN p.vm = 'LOT_ACTUAL' THEN r.scr_lot_id END AS pool_lot, SUM(r.scr_value_wot) AS v FROM stock.stock_cost_revaluation r JOIN vc_pol p ON p.branch = r.scr_branch_id AND p.item = r.scr_item_id WHERE r.scr_company_id = $19::uuid AND r.scr_is_deleted = false AND r.scr_doc_date <= $20::date GROUP BY 1, 2, 3), vc_hp AS MATERIALIZED ( SELECT x.branch, x.item, x.lot, x.godown, x.bucket, x.q, x.v, p.vm, CASE WHEN p.vm = 'LOT_ACTUAL' THEN x.lot END AS pool_lot FROM hc x JOIN vc_pol p ON p.branch = x.branch AND p.item = x.item), vc_pool AS MATERIALIZED ( SELECT branch, item, pool_lot, SUM(q) AS pq, bool_or(q <> 0) AS has_stock, SUM(v) AS hv FROM vc_hp GROUP BY 1, 2, 3), vc_rate AS MATERIALIZED ( SELECT pl.branch, pl.item, pl.pool_lot, CASE WHEN pl.pq > 0 THEN ROUND((pl.hv + COALESCE(r.v, 0)) / pl.pq, 6) WHEN NOT pl.has_stock THEN 0::numeric ELSE COALESCE(( SELECT x.sml_cost_rate_wot FROM stock.stock_ledger x WHERE x.sml_company_id = $21::uuid AND x.sml_branch_id = pl.branch AND x.sml_item_id = pl.item AND (pl.pool_lot IS NULL OR x.sml_lot_id = pl.pool_lot) AND x.sml_is_deleted = false AND x.sml_is_reversal = false AND x.sml_doc_date <= $22::date AND NOT EXISTS ( SELECT 1 FROM stock.stock_ledger y WHERE y.sml_reverses_id = x.sml_id AND y.sml_acc_year = x.sml_acc_year AND y.sml_is_reversal = true AND y.sml_is_deleted = false) ORDER BY x.sml_doc_datetime DESC, x.sml_id DESC LIMIT 1), 0::numeric) END AS r FROM vc_pool pl LEFT JOIN vc_rv r ON r.branch = pl.branch AND r.item = pl.item AND r.pool_lot IS NOT DISTINCT FROM pl.pool_lot), vc_val AS MATERIALIZED ( SELECT x.branch, x.item, x.lot, x.godown, x.bucket, x.q, x.v, x.vm, t.r AS rate, ROUND(x.q * t.r, 2) AS value FROM vc_hp x JOIN vc_rate t ON t.branch = x.branch AND t.item = x.item AND t.pool_lot IS NOT DISTINCT FROM x.pool_lot) SELECT 'H'::text AS part, h.item, h.lot, h.godown, h.bucket, h.oq, h.pq, h.iq, h.xq, h.iv, h.xv, h.n, NULL::numeric AS value, NULL::text AS vm FROM h UNION ALL SELECT 'O', item, lot, godown, bucket, NULL, NULL, NULL, NULL, NULL, NULL, NULL, value, vm FROM vo_val UNION ALL SELECT 'C', item, lot, godown, bucket, NULL, NULL, NULL, NULL, NULL, NULL, NULL, value, vm FROM vc_val"`;
