  poContact          String?        @db.VarChar(150) @map("po_contact")
  poCreditDays       Int?           @db.SmallInt @map("po_credit_days")
  poTermsText        String?        @map("po_terms_text")
  poApprovalStatus   String         @default("NOT_REQUIRED") @db.VarChar(15) @map("po_approval_status")
  poIsShortClosed    Boolean        @default(false) @map("po_is_short_closed")
  poShortCloseReason String?        @db.VarChar(250) @map("po_short_close_reason")
  poGrossAmt         Decimal        @default(0) @db.Decimal(15, 2) @map("po_gross_amt")
  poTaxableAmt       Decimal        @default(0) @db.Decimal(15, 2) @map("po_taxable_amt")
  poTaxAmt           Decimal        @default(0) @db.Decimal(15, 2) @map("po_tax_amt")
  poChargesAmt       Decimal        @default(0) @db.Decimal(15, 2) @map("po_charges_amt")
  poNetAmt           Decimal        @default(0) @db.Decimal(15, 2) @map("po_net_amt")
  poRemarks          String?        @db.VarChar(500) @map("po_remarks")
  poRevisionNo       Int            @default(1) @map("po_revision_no")
  poPrintCount       Int            @default(0) @map("po_print_count")
  poPostedVoucherId  String?        @db.Uuid @map("po_posted_voucher_id")
  poIsDeleted        Boolean        @default(false) @map("po_is_deleted")
  poSyncDate         DateTime?      @db.Timestamptz(6) @map("po_sync_date")
  poCreatedOn        DateTime       @default(now()) @db.Timestamptz(6) @map("po_created_on")
  poCreatedBy        String         @db.VarChar(50) @map("po_created_by")
  poModifiedOn       DateTime?      @db.Timestamptz(6) @map("po_modified_on")
  poModifiedBy       String?        @db.VarChar(50) @map("po_modified_by")
  /// pur_terms row the terms came from (NULL = typed); poTermsText keeps the PO's own copy. ix_po_terms is partial (DB-only).
  poTermsId          String?        @db.Uuid @map("po_terms_id")
  purAgent           PurAgent?      @relation(fields: [poAgentId], references: [pagId], onDelete: Restrict, map: "fk_po_agent")
  purTerms           PurTerms?      @relation(fields: [poTermsId], references: [pteId], onDelete: Restrict, map: "fk_po_terms")
  purOrderItem       PurOrderItem[]

  @@id([poId, poAccYear], map: "pk_pur_order")
  @@unique([poCompanyId, poBranchId, poAccYear, poDeviceId, poSlno], map: "ux_po_device_slno")
  @@unique([poCompanyId, poBranchId, poAccYear, poRefno], map: "ux_po_refno")
  @@map("pur_order")
  @@schema("purchase")
}

