  pcsGstReavailed      Decimal       @default(0) @db.Decimal(15, 2) @map("pcs_gst_reavailed")
  pcsCnNo              String?       @db.VarChar(60) @map("pcs_cn_no")
  pcsCnDate            DateTime?     @db.Date @map("pcs_cn_date")
  pcsReason            String?       @db.VarChar(250) @map("pcs_reason")
  pcsDocDate           DateTime      @db.Date @map("pcs_doc_date")
  pcsVoucherId         String?       @db.Uuid @map("pcs_voucher_id")
  pcsReversalOfId      String?       @db.Uuid @map("pcs_reversal_of_id")
  pcsIsDeleted         Boolean       @default(false) @map("pcs_is_deleted")
  pcsSyncDate          DateTime?     @db.Timestamptz(6) @map("pcs_sync_date")
  pcsCreatedOn         DateTime      @default(now()) @db.Timestamptz(6) @map("pcs_created_on")
  pcsCreatedBy         String        @db.VarChar(50) @map("pcs_created_by")
  pcsModifiedOn        DateTime?     @db.Timestamptz(6) @map("pcs_modified_on")
  pcsModifiedBy        String?       @db.VarChar(50) @map("pcs_modified_by")
  /// ix_pcs_shortage_close is partial (DB-only).
  pcsShortageCloseId      String?    @db.Uuid @map("pcs_shortage_close_id")
  pcsShortageCloseAccYear String?    @db.Char(9) @map("pcs_shortage_close_acc_year")
  purReturnItem        PurReturnItem? @relation(fields: [pcsReturnItemId, pcsReturnItemAccYear], references: [priId, priAccYear], onDelete: Restrict, map: "fk_pcs_return_item")
  purShortageClose     PurShortageClose? @relation(fields: [pcsShortageCloseId, pcsShortageCloseAccYear], references: [pscId, pscAccYear], onDelete: Restrict, map: "fk_pcs_shortage_close")

  @@id([pcsId, pcsAccYear], map: "pk_pur_claim_settlement")
  @@map("pur_claim_settlement")
  @@schema("purchase")
}

