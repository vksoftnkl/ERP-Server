  pcsReturnItemId      String?       @db.Uuid @map("pcs_return_item_id")
  pcsReturnItemAccYear String?       @db.Char(9) @map("pcs_return_item_acc_year")
  pcsAction            String        @db.VarChar(15) @map("pcs_action")
