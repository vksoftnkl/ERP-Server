  tatAccYear    String    @db.Char(9) @map("tat_acc_year")
  tatSrcModule  String    @db.VarChar(15) @map("tat_src_module")
  tatSrcDocType String    @db.VarChar(30) @map("tat_src_doc_type")
  tatSrcDocId   String    @db.Uuid @map("tat_src_doc_id")
  tatPageNo     Int       @default(1) @db.SmallInt @map("tat_page_no")
  tatFileName   String    @db.VarChar(200) @map("tat_file_name")
  tatMimeType   String    @db.VarChar(60) @map("tat_mime_type")
  tatSizeBytes  Int       @map("tat_size_bytes")
