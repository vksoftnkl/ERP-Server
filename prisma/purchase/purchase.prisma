/// Return / claim / replace — outcome per row.
model PurReturn {
  prId              String          @default(dbgenerated("uuidv7()")) @db.Uuid @map("pr_id")
  prCompanyId       String          @db.Uuid @map("pr_company_id")
  prBranchId        String          @db.Uuid @map("pr_branch_id")
  prTenantId        String?         @db.Uuid @map("pr_tenant_id")
  prAccYear         String          @db.Char(9) @map("pr_acc_year")
  prDeviceId        String          @db.Uuid @map("pr_device_id")
  prSessionId       String?         @db.Uuid @map("pr_session_id")
  prSlno            BigInt          @map("pr_slno")
  prRefno           String          @db.VarChar(40) @map("pr_refno")
  prDocDate         DateTime        @db.Date @map("pr_doc_date")
  prDocDatetime     DateTime        @default(now()) @db.Timestamptz(6) @map("pr_doc_datetime")
  prStatus          String          @default("DRAFT") @db.VarChar(20) @map("pr_status")
  prKind            String          @default("AGAINST_INVOICE") @db.VarChar(20) @map("pr_kind")
  prSrcDocId        String          @db.Uuid @map("pr_src_doc_id")
  prSrcAccYear      String          @db.Char(9) @map("pr_src_acc_year")
  prSupplierId      String          @db.Uuid @map("pr_supplier_id")
  prGodownId        String?         @db.Uuid @map("pr_godown_id")
  prSettlement      String          @default("ADJUST") @db.VarChar(10) @map("pr_settlement")
  prPosStcd         String?         @db.Char(2) @map("pr_pos_stcd")
  prSupplierCnNo    String?         @db.VarChar(60) @map("pr_supplier_cn_no")
  prSupplierCnDate  DateTime?       @db.Date @map("pr_supplier_cn_date")
  prEwbNo           String?         @db.VarChar(15) @map("pr_ewb_no")
  prEwbDate         DateTime?       @db.Date @map("pr_ewb_date")
  prVehicleNo       String?         @db.VarChar(20) @map("pr_vehicle_no")
  prDriverName      String?         @db.VarChar(100) @map("pr_driver_name")
  prOurRef          String?         @db.VarChar(60) @map("pr_our_ref")
  prReturnValue     Decimal         @default(0) @db.Decimal(15, 2) @map("pr_return_value")
  prClaimValue      Decimal         @default(0) @db.Decimal(15, 2) @map("pr_claim_value")
  prItcReversed     Decimal         @default(0) @db.Decimal(15, 2) @map("pr_itc_reversed")
  prReplaceQtyBase  Decimal         @default(0) @db.Decimal(18, 6) @map("pr_replace_qty_base")
  prRemarks         String?         @db.VarChar(500) @map("pr_remarks")
  prRevisionNo      Int             @default(1) @map("pr_revision_no")
  prPrintCount      Int             @default(0) @map("pr_print_count")
  prPostedVoucherId String?         @db.Uuid @map("pr_posted_voucher_id")
  prIsDeleted       Boolean         @default(false) @map("pr_is_deleted")
  prSyncDate        DateTime?       @db.Timestamptz(6) @map("pr_sync_date")
  prCreatedOn       DateTime        @default(now()) @db.Timestamptz(6) @map("pr_created_on")
  prCreatedBy       String          @db.VarChar(50) @map("pr_created_by")
  prModifiedOn      DateTime?       @db.Timestamptz(6) @map("pr_modified_on")
  prModifiedBy      String?         @db.VarChar(50) @map("pr_modified_by")
  /// "Our ref": free text typed on the return. prOurRef holds the source refno.
  prMemoRef         String?         @db.VarChar(60) @map("pr_memo_ref")
  purReturnItem     PurReturnItem[]

  @@id([prId, prAccYear], map: "pk_pur_return")
  @@unique([prCompanyId, prBranchId, prAccYear, prDeviceId, prSlno], map: "ux_pr_device_slno")
  @@unique([prCompanyId, prBranchId, prAccYear, prRefno], map: "ux_pr_refno")
  @@map("pur_return")
  @@schema("purchase")
}

