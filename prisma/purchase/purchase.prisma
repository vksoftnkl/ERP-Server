  pagCompanyId      String?      @db.Uuid @map("pag_company_id")
  pagBranchId       String?      @db.Uuid @map("pag_branch_id")
  pagGroupId        String?      @db.Uuid @map("pag_group_id")
  pagCode           String?      @db.VarChar(30) @map("pag_code")
  pagName           String       @db.VarChar(150) @map("pag_name")
  pagAlias          String?      @db.VarChar(150) @map("pag_alias")
  pagMobile1        String?      @db.VarChar(20) @map("pag_mobile1")
  pagMobile2        String?      @db.VarChar(20) @map("pag_mobile2")
  pagAddr1          String?      @db.VarChar(200) @map("pag_addr1")
  pagAddr2          String?      @db.VarChar(200) @map("pag_addr2")
  pagCity           String?      @db.VarChar(100) @map("pag_city")
  pagDistrict       String?      @db.VarChar(100) @map("pag_district")
  pagState          String?      @db.VarChar(100) @map("pag_state")
  pagPincode        String?      @db.VarChar(10) @map("pag_pincode")
  pagPanNo          String?      @db.VarChar(10) @map("pag_pan_no")
  pagGstin          String?      @db.VarChar(15) @map("pag_gstin")
  pagDefaultCommPct Decimal?     @db.Decimal(9, 4) @map("pag_default_comm_pct")
  pagRemarks        String?      @db.VarChar(250) @map("pag_remarks")
  pagIsActive       Boolean      @default(true) @map("pag_is_active")
  pagIsDeleted      Boolean      @default(false) @map("pag_is_deleted")
  pagSyncDate       DateTime?    @db.Timestamptz(6) @map("pag_sync_date")
  pagCreatedOn      DateTime     @default(now()) @db.Timestamptz(6) @map("pag_created_on")
  pagCreatedBy      String       @db.VarChar(50) @map("pag_created_by")
  pagModifiedOn     DateTime?    @db.Timestamptz(6) @map("pag_modified_on")
  pagModifiedBy     String?      @db.VarChar(50) @map("pag_modified_by")
  purInvoice        PurInvoice[]
  purOrder          PurOrder[]

  @@map("pur_agent")
  @@schema("purchase")
}

