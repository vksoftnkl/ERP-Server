  @@schema("public")
}

/// R13 — goods under reverse charge when bought from an UNREGISTERED supplier (notification 6/2024-CT(R)).
/// Company NULL = every company; an item HSN matches when it starts with rnhHsnPrefix.
/// ux_rnh_scope_prefix_from (COALESCE(company, zero uuid), prefix, from) is DB-only (expression index).
model PurRcmNotifiedHsn {
  rnhId            String    @id(map: "pk_pur_rcm_notified_hsn") @default(dbgenerated("uuidv7()")) @db.Uuid @map("rnh_id")
  rnhCompanyId     String?   @db.Uuid @map("rnh_company_id")
  rnhHsnPrefix     String    @db.VarChar(8) @map("rnh_hsn_prefix")
  rnhDescription   String    @db.VarChar(200) @map("rnh_description")
  rnhNotification  String?   @db.VarChar(60) @map("rnh_notification")
  rnhEffectiveFrom DateTime  @db.Date @map("rnh_effective_from")
  rnhEffectiveTo   DateTime? @db.Date @map("rnh_effective_to")
  rnhIsActive      Boolean   @default(true) @map("rnh_is_active")
  rnhCreatedOn     DateTime  @default(now()) @db.Timestamptz(6) @map("rnh_created_on")
  rnhCreatedBy     String    @default("SYSTEM") @db.VarChar(50) @map("rnh_created_by")

  @@map("pur_rcm_notified_hsn")
  @@schema("purchase")
}
