/// Supplier–item map (id = uuid v5 company+supplier+item). Last rate / bills are derived from posted bill lines.
model PurSupplierItem {
  psiId               String    @id(map: "pk_pur_supplier_item") @db.Uuid @map("psi_id")
  psiCompanyId        String?   @db.Uuid @map("psi_company_id")
  psiSupplierId       String    @db.Uuid @map("psi_supplier_id")
  psiItemId           String    @db.Uuid @map("psi_item_id")
  psiSupplierItemCode String?   @db.VarChar(60) @map("psi_supplier_item_code")
  psiSupplierBarcode  String?   @db.VarChar(60) @map("psi_supplier_barcode")
  psiBuyUomId         String?   @db.Uuid @map("psi_buy_uom_id")
  psiPackQty          Decimal   @default(1) @db.Decimal(18, 6) @map("psi_pack_qty")
  psiMoq              Decimal?  @db.Decimal(18, 6) @map("psi_moq")
  psiLeadDays         Int?      @db.SmallInt @map("psi_lead_days")
  psiIsPreferred      Boolean   @default(false) @map("psi_is_preferred")
  /// ENT-07 buy N get M: both set or both NULL (ck_psi_scheme)
  psiSchemeBuyQty     Decimal?  @db.Decimal(18, 3) @map("psi_scheme_buy_qty")
  psiSchemeFreeQty    Decimal?  @db.Decimal(18, 3) @map("psi_scheme_free_qty")
  psiSource           String    @default("TYPED") @db.VarChar(10) @map("psi_source")
  psiIsActive         Boolean   @default(true) @map("psi_is_active")
  psiIsDeleted        Boolean   @default(false) @map("psi_is_deleted")
  psiSyncDate         DateTime? @db.Timestamptz(6) @map("psi_sync_date")
  psiCreatedOn        DateTime  @default(now()) @db.Timestamptz(6) @map("psi_created_on")
  psiCreatedBy        String    @db.VarChar(50) @map("psi_created_by")
  psiModifiedOn       DateTime? @db.Timestamptz(6) @map("psi_modified_on")
  psiModifiedBy       String?   @db.VarChar(50) @map("psi_modified_by")

  @@map("pur_supplier_item")
  @@schema("purchase")
}

/// Purchase agent. pagId = ledger id (the agent IS its ledger).
