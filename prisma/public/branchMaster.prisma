model BranchMaster {
  brId                  String    @id @default(dbgenerated("uuidv7()")) @db.Uuid  @map("br_id")
  brCompId                String    @db.Uuid                                         @map("br_comp_id")
  // 1) Identity / Reference
  brCode                String?   @unique @db.VarChar(20)                          @map("br_code")
  brName                String    @db.VarChar(150)                                 @map("br_name")
  brMailingName         String?   @db.VarChar(150)                                 @map("br_mailing_name")
  brAlias               String?   @db.VarChar(100)                                 @map("br_alias")
  brShort               String?   @db.VarChar(50)                                  @map("br_short")
  brType                String?   @db.VarChar(30)                                  @map("br_type")
  brIsDefault           Boolean   @default(false)                                   @map("br_is_default")
  brIsActive            Boolean   @default(true)                                    @map("br_is_active")
  // 2) Address
  brAddr1               String?                                                     @map("br_addr1")
  brAddr2               String?                                                     @map("br_addr2")
  brAddr3               String?                                                     @map("br_addr3")
  brCity                String?   @db.VarChar(100)                                 @map("br_city")
  brDistrict            String?   @db.VarChar(100)                                 @map("br_district")
  brState               String?   @db.VarChar(100)                                 @map("br_state")
  brStateCode           String    @db.Char(2)                                      @map("br_state_code")
  brPin                 Int?                                  @map("br_pin")
  brCountry             String    @default("India") @db.VarChar(60)               @map("br_country")
  brLandmark            String?   @db.VarChar(150)                                 @map("br_landmark")
  // 4) Region Address
  brRegionAddr1         String?                                                     @map("br_region_addr1")
  brRegionAddr2         String?                                                     @map("br_region_addr2")
  brRegionAddr3         String?                                                     @map("br_region_addr3")
  brRegionCity          String?   @db.VarChar(100)                                 @map("br_region_city")
  brRegionDistrict      String?   @db.VarChar(100)                                 @map("br_region_district")
  brRegionState         String?                                                     @map("br_region_state")
  brRegionCountry       String?   @db.VarChar(60)                                  @map("br_region_country")
  // 3) Contact
  brContactPerson       String?   @db.VarChar(150)                                 @map("br_contact_person")
  brTel                 String?   @db.VarChar(20)                                  @map("br_tel")
  brPhone               String?   @db.VarChar(20)                                  @map("br_phone")
  brMail                String?   @db.VarChar(150)                                 @map("br_mail")
  // 4) Billing / Invoice Setup
  brBillPrefix          String?   @db.VarChar(20)                                  @map("br_bill_prefix")
  brInvoiceSeriesPrefix String?   @db.VarChar(20)                                  @map("br_invoice_series_prefix")
  brBillGreeting        String?   @db.VarChar(300)                                 @map("br_bill_greeting")
  brTerms               String?                                                     @map("br_terms")
  brRoundingMode        String?   @db.VarChar(20)                                  @map("br_rounding_mode")
  brRoundingValue       Decimal?  @db.Decimal                                       @map("br_rounding_value")
  // 5) Inventory / Operations
  brDefaultGodownId     String?   @db.Uuid                                          @map("br_default_godown_id")
  brPosType             String?   @db.VarChar(20)                                  @map("br_pos_type")
  brAllowNegativeStock  Boolean   @default(true)                                    @map("br_allow_negative_stock")
  brSmsApplicable       Boolean   @default(false)                                   @map("br_sms_applicable")
  brBankId              String?   @db.Uuid                                          @map("br_bank_id")
  // 6) Compliance / Licenses
  brFssaiNo             String?   @db.VarChar(20)                                  @map("br_fssai_no")
  brFssaiLicenseType    String?   @db.VarChar(20)                                  @map("br_fssai_license_type")
  brFssaiValidUpto      DateTime? @db.Date                                          @map("br_fssai_valid_upto")
  // 8) Audit / Sync
  brIsDeleted           Boolean   @default(false)                                   @map("br_is_deleted")
  brSyncDate            DateTime? @db.Timestamptz                                  @map("br_sync_date")
  brCreatedOn           DateTime  @default(now()) @db.Timestamp                    @map("br_created_on")
  brCreatedBy           String?   @db.VarChar(100)                                 @map("br_created_by")
  brModifiedOn          DateTime  @default(now()) @db.Timestamp                    @map("br_modified_on")
  brModifiedBy          String?   @db.VarChar(100)                                 @map("br_modified_by")
  brRegionName          String?   @db.Text                                        @map("br_region_name")
  brGstinNo             String?   @db.VarChar(15)                                  @map("br_gstin_no")
  brGstRegType          String?   @db.VarChar(30)                                  @map("br_gst_reg_type")
  brPanNo               String?   @db.VarChar(10)                                  @map("br_pan_no")
  // Relations
  company               Company   @relation(fields: [brCompId], references: [compId])
  accountLedgerMaster   AccLedgerMaster[]
  openingBalances       AccOpeningBalance[]
  openingRuns           AccOpeningRun[]
  shipAddrs             AccShipAddr[]
  voucherCheques        AccVoucherCheque[]
  voucherDocDetails     AccVoucherDocDetail[]
  voucherDocRegisters   AccVoucherDocRegister[]
  voucherSequences      AccVoucherSeq[]
  voucherHeaders        AccVoucherHeader[]
  itemPrices            ItemPriceMaster[] @relation("BranchItemPrices")
  itemQtyPrices         ItemQtyPrice[]    @relation("BranchItemQtyPrices")
  freightCharges        SaleFreightCharge[] @relation("BranchFreightCharges")
  loadingCharges        SaleLoadingCharge[] @relation("BranchLoadingCharges")
  deviceMasters         DeviceMaster[]
  saleAgents            SaleAgent[]       @relation("BranchSaleAgents")
  chargeDetails         TransactionChargeDetail[] @relation("BranchChargeDetails")
  tenderMasters         AccTenderMaster[]
  tenderDetails         AccTenderDetail[]
  appSettingValues      AppSettingValue[]
  promotionSchemes      PromotionScheme[]       @relation("PromotionSchemeBranchRef")
  promotionSchemeBranches PromotionSchemeBranch[] @relation("PromotionSchemeBranchBranch")
  loyaltySchemes        LoyaltyScheme[]         @relation("LoyaltySchemeBranchRef")
  loyaltySchemeBranches LoyaltySchemeBranch[]   @relation("LoyaltySchemeBranchBranch")
  stockTrackPolicies    StockTrackPolicy[]      @relation("StockTrackPolicyBranch")
  stockLotsFirstInward  StockLot[]              @relation("StockLotFirstInwardBranch")
  stockLedgerEntries    StockLedger[]           @relation("StockLedgerBranch")
  stockBalances         StockBalance[]          @relation("StockBalanceBranch")
  stockItemCosts        StockItemCost[]         @relation("StockItemCostBranch")
  stockVouchers         StockVoucher[]          @relation("StockVoucherBranch")
  stockVouchersInbound  StockVoucher[]          @relation("StockVoucherToBranch")
  stockReservations     StockReservation[]      @relation("StockReservationBranch")
  stockTransitsOut      StockTransit[]          @relation("StockTransitFromBranch")
  stockTransitsIn       StockTransit[]          @relation("StockTransitToBranch")
  stockValuationSnaps   StockValuationSnap[]    @relation("StockValuationSnapBranch")
  stockDemandDaily      StockDemandDaily[]      @relation("StockDemandDailyBranch")
  stockReorderPolicies  StockReorderPolicy[]    @relation("StockReorderPolicyBranch")
  stockForecasts        StockForecast[]         @relation("StockForecastBranch")
  stockMovementClasses  StockMovementClass[]    @relation("StockMovementClassBranch")

  // ── printing (17_printing.sql) ─────────────────────────────────────────
  printAssignments      PrintTemplateAssignment[] @relation("PrintTemplateAssignmentBranch")

  printerProfiles       PrinterProfile[]          @relation("PrinterProfileBranch")
  printLogs             PrintLog[]                @relation("PrintLogBranch")

  // ── GST provider integration ───────────────────────────────────────────
  // Only a branch that holds its OWN registration (br_gstin_no) is named on a
  // credential; the rest file under the company's.
  gstCredentials        GstCompanyCredential[]    @relation("GstCredentialBranch")

  @@index([brCompId],    name: "idx_branch_comp_id")
  @@index([brStateCode], name: "idx_branch_state_code")
  // ── Loyalty points engine (20260921140000) ─────────────────────────────
  // A wallet is company-scoped; a branch only ENROLS one. Every LEDGER row,
  // though, records the branch the event happened at — that is what makes
  // inter-branch settlement between franchisees answerable.
  loyaltyMembersEnrolled LoyaltyMember[]          @relation("LoyaltyMemberBranch")
  loyaltyLedgerRows     LoyaltyLedger[]           @relation("LoyaltyLedgerBranch")
  loyaltyGiftRedeems    LoyaltyGiftRedeem[]       @relation("LoyaltyGiftRedeemBranch")
  loyaltyGiftItems      LoyaltyGiftRedeemItem[]   @relation("LoyaltyGiftItemBranch")

  // ── Coupons and gift vouchers (20260921160000) ──────────────────────────
  // A batch may be branch-less (every branch) and so may a coupon; a
  // MOVEMENT always records the branch it was presented at.
  couponBatches         LoyaltyCouponBatch[]      @relation("CouponBatchBranch")
  couponsIssued         LoyaltyCoupon[]           @relation("CouponBranch")
  couponTxns            LoyaltyCouponTxn[]        @relation("CouponTxnBranch")

  // ── Promotion usage (20260921180000) ────────────────────────────────────
  promotionUsages       PromotionUsage[]          @relation("PromotionUsageBranch")

  @@map("branch_master")
  @@schema("public")
}