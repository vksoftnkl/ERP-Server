model Company {
  compId               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid  @map("comp_id")
  // 1) Identity / Codes
  compCode              String?   @unique @db.VarChar(20)                           @map("comp_code")
  compName              String    @unique                                           @map("comp_name")
  compShort             String?                                                     @map("comp_short")
  // 2) Statutory / Registration
  compLegalName         String?                                                     @map("comp_legal_name")
  compGstinNo           String?   @unique @db.VarChar(15)                           @map("comp_gstin_no")
  compGstRegType        String?   @db.VarChar(30)                                   @map("comp_gst_reg_type")
  compPanNo             String?   @db.VarChar(10)                                   @map("comp_pan_no")
  compFssaiNo           String?   @db.VarChar(20)                                   @map("comp_fssai_no")
  compDrugLicenseNo     String?   @db.Text                                          @map("comp_drug_license_no")
  // 3) Mailing Address
  compAddr1             String?                                                     @map("comp_addr1")
  compAddr2             String?                                                     @map("comp_addr2")
  compAddr3             String?                                                     @map("comp_addr3")
  compCity              String?   @db.VarChar(100)                                  @map("comp_city")
  compDistrict          String?   @db.VarChar(100)                                  @map("comp_district")
  compState             String?                                                     @map("comp_state")
  compStateCode         String    @db.Char(2)                                       @map("comp_state_code")
  compPin               Int?                                                        @map("comp_pin")
  compCountry           String    @default("India") @db.VarChar(60)                 @map("comp_country")
  // 4) Region Address
  compRegionAddr1       String?                                                     @map("comp_region_addr1")
  compRegionAddr2       String?                                                     @map("comp_region_addr2")
  compRegionAddr3       String?                                                     @map("comp_region_addr3")
  compRegionCity        String?   @db.VarChar(100)                                  @map("comp_region_city")
  compRegionDistrict    String?   @db.VarChar(100)                                  @map("comp_region_district")
  compRegionState       String?                                                     @map("comp_region_state")
  compRegionCountry     String?   @db.VarChar(60)                                   @map("comp_region_country")
  // 5) Contact
  compTel               String?   @db.VarChar(20)                                   @map("comp_tel")
  compPhone             String?   @db.VarChar(20)                                   @map("comp_phone")
  compMail              String?   @db.VarChar(150)                                  @map("comp_mail")
  compSupportEmail      String?   @db.VarChar(150)                                  @map("comp_support_email")
  compSupportPhone      String?   @db.VarChar(20)                                   @map("comp_support_phone")
  compWebsiteName       String?   @db.VarChar(200)                                  @map("comp_website_name")
  // 6) Fiscal Year / Books
  compFinYearFrom       DateTime? @db.Date                                          @map("comp_fin_year_from")
  compFinYearTo         DateTime? @db.Date                                          @map("comp_fin_year_to")
  compBooksBeginFrom    DateTime? @db.Date                                          @map("comp_books_begin_from")
  // 7) Features / Applicability flags
  compGstApplicable     Boolean   @default(true)                                    @map("comp_gst_applicable")
  compTcsApplicable     Boolean   @default(false)                                   @map("comp_tcs_applicable")
  compSmsApplicable     Boolean   @default(false)                                   @map("comp_sms_applicable")
  compEinvoiceApplicable Boolean  @default(false)                                   @map("comp_einvoice_applicable")
  compEwayApplicable    Boolean   @default(false)                                   @map("comp_eway_applicable")
  // 8) E-Way / E-Invoice Settings
  compEwayDate          DateTime? @db.Date                                          @map("comp_eway_date")
  compEwayInterLimit    Decimal?  @db.Decimal                                       @map("comp_eway_inter_limit")
  compEwayIntraApl      Boolean   @default(false)                                   @map("comp_eway_intra_apl")
  compEwayIntraLimit    Decimal   @default(0) @db.Decimal                           @map("comp_eway_intra_limit")
  compEinvoiceDate      DateTime? @db.Date                                          @map("comp_einvoice_date")
  compEinvoiceInclEway  Boolean?                                                    @map("comp_einvoice_incl_eway")
  // 9) System Settings
  compStylesheetId      Int?                                                        @map("comp_stylesheet_id")
  compBankId            String?   @db.Uuid                                          @map("comp_bank_id")
  compPriceFixing       String?   @db.VarChar(50)                                   @map("comp_price_fixing")
  compPrefixCode        String?   @db.VarChar(20)                                   @map("comp_prefix_code")
  compBillGreeting      String?                                                     @map("comp_bill_greeting")
  compNegStkApl         Boolean   @default(true)                                    @map("comp_negstk_apl")
  compDefault           Boolean   @default(false)                                   @map("comp_default")
  compIsActive          Boolean   @default(true)                                    @map("comp_is_active")
  compCurrencyCode      String    @default("INR") @db.Char(3)                       @map("comp_currency_code")
  compCurrencySymbol    String?   @db.VarChar(10)                                   @map("comp_currency_symbol")
  compLocaleCode        String    @default("en-IN") @db.VarChar(10)                 @map("comp_locale_code")
  compRemarks           String?   @default("")                                      @map("comp_remarks")
  // 10) Audit / Sync
  compIsDeleted         Boolean   @default(false)                                   @map("comp_is_deleted")
  compSyncDate          DateTime? @db.Timestamptz                                   @map("comp_sync_date")
  compCreatedOn         DateTime  @default(now()) @db.Timestamp                     @map("comp_created_on")
  compCreatedBy         String?   @db.VarChar(100)                                  @map("comp_created_by")
  compModifiedOn        DateTime  @default(now()) @db.Timestamp                     @map("comp_modified_on")
  compModifiedBy        String?   @db.VarChar(100)                                  @map("comp_modified_by")
  compTanNo             String?   @db.Text                                          @map("comp_tan_no")
  compCinNo             String?   @db.Text                                          @map("comp_cin_no")
  compRegionName        String?   @db.Text                                          @map("comp_region_name")
  compBooksLockDate     DateTime? @db.Date                                          @map("comp_books_lock_date")
  compAuthorizeSignature String?  @db.Text                                         @map("comp_authorize_signature")
  compTdsApplicable     String?   @db.Text                                    @map("comp_tds_applicable")
  // Relations
  branches              BranchMaster[]
  accountGroups         AccountGroup[]
  ledgers               AccLedgerMaster[]
  employees             EmpMaster[]
  ledgerBankAccounts    AccLedgerBankAccount[]
  gspCompanyServices    GspCompanyService[]
  shipAddrs             AccShipAddr[]
  custGroup             CustGroup[]
  itemMaster            ItemMaster[]
  itemPrices            ItemPriceMaster[] @relation("CompanyItemPrices")
  deviceMasters         DeviceMaster[]
  UserLoginSession      UserLoginSession[]
  customers             Customer[]
  voucherBills          AccVoucherBill[]
  voucherCheques        AccVoucherCheque[]
  voucherDocDetails     AccVoucherDocDetail[]
  voucherDocRegisters   AccVoucherDocRegister[]
  voucherHeaders        AccVoucherHeader[]
  voucherSequences      AccVoucherSeq[]
  vouchers              AccVoucher[]
  voucherTenders        AccVoucherTender[]
  openingStockHeaders   OpeningStockHeader[]
  openingStockDetails   OpeningStockDetail[]
  physicalStockHeaders  PhysicalStockHeader[] @relation("PhysicalStockHeaderCompany")
  physicalStockDetails  PhysicalStockDetail[] @relation("PhysicalStockDetailCompany")
  physicalStockBatchDetails PhysicalStockBatchDetail[] @relation("PhysicalStockBatchDetailCompany")
  ItemUnitConversions   ItemUnitConversion[] @relation("iucCompanyId")
  loyaltySchemes        LoyaltyScheme[]
  @@map("companys")
  @@schema("public")
}