enum WidgetPlatform {
  mobile
  desktop
  web
  @@schema("public")
}
model Widget {
  widgetNo            Int              @id @default(autoincrement()) @map("widget_no")
  widgetGroupId       Int              @map("widget_group_id")
  widgetName          String           @map("widget_name") @db.VarChar(255)
  widgetPosition      Int              @default(0) @map("widget_position")
  widgetVisibility    Boolean          @default(true) @map("widget_visibility")
  widgetGuiName       String?          @map("widget_gui_name") @db.VarChar(255)
  widgetType          WidgetPlatform   @map("widget_type")
  widgetSecondaryText String?          @map("widget_secondary_text")
  @@map("widget")
  @@schema("public")
}
