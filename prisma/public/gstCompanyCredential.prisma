/// The taxpayer's login — per company, or per branch that files its own
/// return. CREDENTIAL #2 of two.
///
/// GstProviderAccount holds the GSP's own account (this ERP → their gateway).
/// This model holds the taxpayer's portal user (that GSTIN → the IRP, through
/// the GSP). Most GSPs need both, and they rotate on different schedules,
/// which is why they are not on one row.
///
/// The GSTIN is NOT stored here. Company.compGstinNo is already UNIQUE, so a
/// company row IS a registration; a branch with its own registration carries
/// it on BranchMaster.brGstinNo. It resolves as
/// COALESCE(branch GSTIN, comp_gstin_no) at call time, which is also what
/// makes gccBranchId meaningful rather than decorative:
///     NULL -> files under the company's own registration
///     set  -> files under that branch's registration
/// Repeating the number here would be a second copy free to drift from the
/// first, and a credential silently authenticating as a GSTIN the company no
/// longer has is worse than any join. public.vw_gst_credential does the
/// COALESCE once so no caller has to remember which table it came from.
///
/// How MANY rows a company needs is decided by the provider's auth model, not
/// by how many services it uses:
///     gateway GSP (one token for everything) -> ONE row, gccService NULL
///     direct NIC (token per registration)    -> one row per service
/// GstAuthSession hangs off this row, so that choice also decides how many
/// live tokens exist and how many calls to /auth get made.
///
/// gccPriority is the answer to "what happens when there are two providers".
/// Priority 1 is the primary and there may be only one per
/// company/branch/service/environment (ux_gcc_primary). Priority 2+ are
/// failovers, tried in order when the primary maps to UPSTREAM_DOWN or
/// RATE_LIMITED. Which one actually served a document is recorded on the
/// document (gdeGccId) and on every attempt (galGccId), so a failover is
/// auditable rather than mysterious.
///
/// Secrets are application-encrypted ciphertext (_enc), not plaintext and not
/// pgcrypto — a key that lives in the same database as the data it protects
/// is decoration. gccKeyVersion records which application key wrapped the
/// values so rotation does not require a flag day.
model GstCompanyCredential {
  gccId                 String    @id(map: "pk_gst_company_credential") @default(dbgenerated("uuidv7()")) @db.Uuid @map("gcc_id")

  gccCompanyId          String    @db.Uuid                             @map("gcc_company_id")
  /// NULL = every branch that files under this GSTIN. A branch is named only
  /// when it holds its own registration.
  gccBranchId           String?   @db.Uuid                             @map("gcc_branch_id")
  gccGpvId              String    @db.Uuid                             @map("gcc_gpv_id")

  /// NULL is the common case for a commercial GSP: ONE login covering every
  /// service they sell you, on one token. Direct NIC is the "set" case —
  /// e-invoice and e-way bill are separate API registrations on the portal
  /// and their tokens are not interchangeable. Forcing this NOT NULL would
  /// have made every gateway provider look like NIC.
  gccService            String?   @db.VarChar(20)                      @map("gcc_service")
  /// SANDBOX | PRODUCTION
  gccEnvironment        String    @db.VarChar(10)                      @map("gcc_environment")

  /// 1 = primary, 2+ = failover order.
  gccPriority           Int       @default(1) @db.SmallInt             @map("gcc_priority")

  // ── Secrets ──────────────────────────────────────────────────────────
  /// The API user of the taxpayer's portal registration. Deliberately NOT
  /// encrypted: it is not a secret, and support has to be able to see WHICH
  /// login is failing without holding the decryption key — the same reason a
  /// database user name is not hashed while its password is.
  gccLoginId            String                                         @map("gcc_login_id")
  gccPasswordEnc        String                                         @map("gcc_password_enc")

  /// Normally NULL. OAuth-style app credentials at the TAXPAYER level, which
  /// only some GSPs issue — a reseller that bills per GSTIN may hand you a
  /// client id and secret for each one. For every other provider the app
  /// credentials belong to the installation and live on GstProviderAccount,
  /// and the more specific one wins:
  ///   client_id = COALESCE(gcc_client_id_enc, gpa_client_id_enc)
  /// Filling only one of the pair is meaningless, so ck_gcc_client_pair
  /// refuses it rather than letting a half-configured login reach the gateway.
  gccClientIdEnc        String?                                        @map("gcc_client_id_enc")
  gccClientSecretEnc    String?                                        @map("gcc_client_secret_enc")

  /// NIC's AppKey: 32 random bytes, RSA-encrypted with the IRP public key at
  /// auth time and used to unwrap the Sek that comes back.
  gccAppKeyEnc          String?                                        @map("gcc_app_key_enc")

  /// Which IRP/GSP public key or certificate the payload encryption uses.
  /// They rotate, and a stale one fails with an opaque decrypt error.
  gccPublicKeyRef       String?   @db.VarChar(100)                     @map("gcc_public_key_ref")

  /// Which application key encrypted the _enc columns above.
  gccKeyVersion         Int       @default(1) @db.SmallInt             @map("gcc_key_version")

  /// The static IPs registered with the GSP / on the e-invoice portal for
  /// this GSTIN. OURS, not the provider's — the first draft had a single inet
  /// on the PROVIDER row, where it described nothing. An array because a
  /// chain files one GSTIN from many outlets, each on its own broadband: the
  /// portal whitelist is a list, and so is this.
  gccWhitelistedIps     String[]  @db.Inet                             @map("gcc_whitelisted_ips")

  // ── Validity ─────────────────────────────────────────────────────────
  /// Portal passwords expire. A credential that silently went stale at
  /// midnight is otherwise discovered by a queue of failed bills.
  gccValidFrom          DateTime? @db.Date                             @map("gcc_valid_from")
  gccValidUpto          DateTime? @db.Date                             @map("gcc_valid_upto")
  gccPasswordChangedOn  DateTime? @db.Timestamptz(6)                   @map("gcc_password_changed_on")

  /// Stamped by the master screen's Test Connection button and by the first
  /// successful call of the day.
  gccLastVerifiedOn     DateTime? @db.Timestamptz(6)                   @map("gcc_last_verified_on")
  gccLastErrorMessage   String?   @db.VarChar(500)                     @map("gcc_last_error_message")

  gccRemarks            String?   @db.VarChar(500)                     @map("gcc_remarks")
  gccIsActive           Boolean   @default(true)                       @map("gcc_is_active")

  // ── Audit ────────────────────────────────────────────────────────────
  gccIsDeleted          Boolean   @default(false)                      @map("gcc_is_deleted")
  gccSyncDate           DateTime? @db.Timestamptz(6)                   @map("gcc_sync_date")
  gccCreatedOn          DateTime  @default(now()) @db.Timestamptz(6)   @map("gcc_created_on")
  gccCreatedBy          String    @db.VarChar(50)                      @map("gcc_created_by")
  gccModifiedOn         DateTime? @db.Timestamptz(6)                   @map("gcc_modified_on")
  gccModifiedBy         String?   @db.VarChar(50)                      @map("gcc_modified_by")

  // Relations
  company               Company       @relation("GstCredentialCompany",  fields: [gccCompanyId], references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_gcc_company")
  branch                BranchMaster? @relation("GstCredentialBranch",   fields: [gccBranchId],  references: [brId],   onUpdate: Cascade, onDelete: Restrict, map: "fk_gcc_branch")
  /// The foreign key the first draft simply did not have.
  provider              GstProvider   @relation("GstCredentialProvider", fields: [gccGpvId],     references: [gpvId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_gcc_provider")

  sessions              GstAuthSession[] @relation("GstCredentialSessions")

  // Partial indexes are DB-only — Prisma ignores WHERE predicates and
  // NULLS NOT DISTINCT, so declaring them here would produce phantom drift on
  // every migrate dev:
  //
  //   -- one primary per company/branch/service/environment
  //   CREATE UNIQUE INDEX ux_gcc_primary
  //       ON public.gst_company_credential
  //          (gcc_company_id, gcc_branch_id, gcc_service, gcc_environment)
  //       NULLS NOT DISTINCT
  //       WHERE gcc_priority = 1 AND gcc_is_active = true AND gcc_is_deleted = false;
  //
  //   -- failovers are unconstrained in count but unique in order
  //   CREATE UNIQUE INDEX ux_gcc_order
  //       ON public.gst_company_credential
  //          (gcc_company_id, gcc_branch_id, gcc_service, gcc_environment, gcc_priority)
  //       NULLS NOT DISTINCT
  //       WHERE gcc_is_deleted = false;
  //
  //   -- the dispatcher's own lookup: live credentials for this company and
  //   -- service, best first
  //   CREATE INDEX ix_gcc_lookup
  //       ON public.gst_company_credential
  //          (gcc_company_id, gcc_service, gcc_environment, gcc_priority)
  //       INCLUDE (gcc_branch_id, gcc_gpv_id, gcc_login_id)
  //       WHERE gcc_is_active = true AND gcc_is_deleted = false;
  //
  //   -- FK-covering
  //   CREATE INDEX ix_gcc_branch   ON public.gst_company_credential (gcc_branch_id)
  //       WHERE gcc_branch_id IS NOT NULL AND gcc_is_deleted = false;
  //   CREATE INDEX ix_gcc_provider ON public.gst_company_credential (gcc_gpv_id)
  //       WHERE gcc_is_deleted = false;
  //
  // CHECK constraints (DB-only): ck_gcc_service, ck_gcc_environment,
  //   ck_gcc_client_pair, ck_gcc_priority, ck_gcc_key_ver, ck_gcc_validity
  //
  // The read boundary public.vw_gst_credential is a VIEW and is not modelled
  // here (Prisma views are still a preview feature): it selects not one _enc
  // column, so a read-only role can be granted it and physically cannot
  // return ciphertext.

  @@map("gst_company_credential")
  @@schema("public")
}
