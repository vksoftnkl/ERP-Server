/// The transporter on an e-way bill.
///
/// sale_bill.sb_vehicle_id has existed in this database with NO referenced
/// table — and so have sb_driver_id, sb_supervisor_id and sb_loadman_id. This
/// master and VehicleMaster are what those columns should have pointed at.
///
/// trnGstin holds either a GSTIN or a 15-character transporter ENROLMENT id
/// (TRANSIN), which is why trnIsEnrolmentId exists: the two are the same
/// length and the portal treats them differently.
///
/// NULL trnCompanyId = shared by every company, the house convention for a
/// master that is not company-specific.
model TransporterMaster {
  trnId             String    @id(map: "pk_transporter_master") @default(dbgenerated("uuidv7()")) @db.Uuid @map("trn_id")
  /// NULL = every company.
  trnCompanyId      String?   @db.Uuid                                 @map("trn_company_id")
  trnCode           String?   @db.VarChar(30)                          @map("trn_code")
  trnName           String    @db.VarChar(200)                         @map("trn_name")
  /// GSTIN or 15-char enrolment id (TRANSIN) — ck_trn_gstin_len enforces the
  /// length either way.
  trnGstin          String?   @db.VarChar(15)                          @map("trn_gstin")
  trnIsEnrolmentId  Boolean   @default(false)                          @map("trn_is_enrolment_id")
  /// ROAD | RAIL | AIR | SHIP
  trnMode           String    @default("ROAD") @db.VarChar(10)         @map("trn_mode")
  /// The transporter's own account ledger (group Transporters, under Sundry
  /// Creditors), made on its first save — the same id as trnId, as a
  /// supplier's sup_id is its ledger's id (plan-vehicle-master D28-D31).
  trnLedgerId       String?   @db.Uuid                                 @map("trn_ledger_id")
  trnPhone          String?   @db.VarChar(20)                          @map("trn_phone")
  trnEmail          String?   @db.VarChar(150)                         @map("trn_email")
  trnAddr           String?   @db.VarChar(500)                         @map("trn_addr")
  trnPlace          String?   @db.VarChar(100)                         @map("trn_place")
  trnPin            String?   @db.VarChar(10)                          @map("trn_pin")
  trnStateCode      String?   @db.Char(2)                              @map("trn_state_code")
  trnRemarks        String?   @db.VarChar(250)                         @map("trn_remarks")
  trnIsActive       Boolean   @default(true)                           @map("trn_is_active")
  trnIsDeleted      Boolean   @default(false)                          @map("trn_is_deleted")
  trnSyncDate       DateTime? @db.Timestamptz(6)                       @map("trn_sync_date")
  trnCreatedOn      DateTime  @default(now()) @db.Timestamptz(6)       @map("trn_created_on")
  trnCreatedBy      String?   @db.VarChar(50)                          @map("trn_created_by")
  trnModifiedOn     DateTime? @db.Timestamptz(6)                       @map("trn_modified_on")
  trnModifiedBy     String?   @db.VarChar(50)                          @map("trn_modified_by")

  vehicles          VehicleMaster[] @relation("VehicleTransporter")

  // DB-only (expression key, partial) — NOT unique since 20261104130000 (offline
  // rule: two branches may add the same name; the service checks online,
  // TRN_NAME_TAKEN). It replaced UNIQUE ux_trn_name on the same key.
  //   CREATE INDEX ix_trn_name ON public.transporter_master
  //       (trn_company_id, lower(trn_name))
  //       WHERE trn_is_deleted = false;
  //
  // CHECK constraints (DB-only): ck_trn_mode, ck_trn_gstin_len
  //
  // FK (DB-only, no Prisma relation, so the accounts fragment is untouched;
  // 20261112120000_vehicle_transporter_masters):
  //   fk_trn_ledger (trn_ledger_id) -> accounts.acc_ledger_master (led_id)
  //       ON UPDATE CASCADE ON DELETE RESTRICT

  transportBands    TxnTransportDetail[] @relation("TransportBandTransporter")

  @@map("transporter_master")
  @@schema("public")
}
