model loyaltysch_list {
  ls_id                  Int       @id @default(autoincrement())
  ls_code                String?   @db.VarChar(30)
  ls_name                String    @db.VarChar(150)

  ls_type                String    @db.VarChar(20)
  ls_apply_on            String    @default("BILL_AMOUNT") @db.VarChar(20)
  ls_bill_type           String    @default("ALL") @db.VarChar(20)
  ls_cust_type           String    @default("ALL") @db.VarChar(20)
  ls_item_type           String    @default("ALL") @db.VarChar(20)

  ls_start_date          DateTime  @db.Date
  ls_end_date            DateTime  @db.Date

  ls_comp_id             Int
  ls_branch_id           Int?

  ls_points_per_inr      Decimal   @default(0) @db.Decimal(18, 4)
  ls_points_per_qty      Decimal   @default(0) @db.Decimal(18, 4)
  ls_min_bill_amount     Decimal   @default(0) @db.Decimal(18, 2)
  ls_max_points_per_bill Decimal   @default(0) @db.Decimal(18, 2)

  ls_recur_apl           Boolean   @default(false)
  ls_bal_apl             Boolean   @default(false)
  ls_allow_point_earn    Boolean   @default(true)
  ls_allow_point_redeem  Boolean   @default(false)
  ls_allow_gift_redeem   Boolean   @default(false)

  ls_is_active           Boolean   @default(true)
  ls_is_deleted          Boolean   @default(false)

  created_on             DateTime  @default(now()) @db.Timestamptz(6)
  created_by             Int?
  modified_on            DateTime? @db.Timestamptz(6)
  modified_by            Int?

  gifts                  loyaltysch_gift[]   @relation("LoyaltySchemeToGift")
  points                 loyaltysch_points[] @relation("LoyaltySchemeToPoints")

  @@unique([ls_code], map: "uq_loyaltysch_list_code")
  @@index([ls_comp_id, ls_branch_id, ls_is_active], map: "idx_loyaltysch_list_active")
  @@index([ls_start_date, ls_end_date], map: "idx_loyaltysch_list_dates")
  @@map("loyaltysch_list")
  @@schema("public")
}