model CustItemRate {
  csrId          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid @map("csr_id")
  csrBranchId    String?  @db.Uuid @map("csr_branch_id")
  // Customer + Item Rate Link
  csrCustomerId  String   @db.Uuid @map("csr_customer_id")
  csrUnitRateId  String   @db.Uuid @map("csr_unit_rate_id")
  // Pricing / Discount Override
  csrRateType    String   @default("FIXED") @db.VarChar(20) @map("csr_rate_type")
  csrItemRate    Decimal  @default(0) @db.Decimal(15, 4) @map("csr_item_rate")
  csrDiscPerc    Decimal  @default(0) @db.Decimal(7, 3)  @map("csr_disc_perc")
  csrDiscQty     Decimal  @default(0) @db.Decimal(15, 4) @map("csr_disc_qty")
  // Optional price level (A/B/C/D) — because your SQL CHECK mentions csr_price_level
  csrPriceLevel  String?  @db.Char(1) @map("csr_price_level")
  // Validity / Priority
  csrValidFrom   DateTime? @db.Date @map("csr_valid_from")
  csrValidTo     DateTime? @db.Date @map("csr_valid_to")
  csrPriority    Int       @default(0) @map("csr_priority")
  // Status / Audit
  csrIsActive    Boolean   @default(true)  @map("csr_is_active")
  csrIsDeleted   Boolean   @default(false) @map("csr_is_deleted")
  csrCreatedOn   DateTime  @default(now()) @db.Timestamptz(6) @map("csr_created_on")
  csrCreatedBy   String?   @db.VarChar(100) @map("csr_created_by")
  csrModifiedOn  DateTime  @default(now()) @db.Timestamptz(6) @map("csr_modified_on")
  csrModifiedBy  String?   @db.VarChar(100) @map("csr_modified_by")
  csrUploadedAt  DateTime? @db.Timestamptz(6) @map("csr_uploaded_at")
  csrUploadedBy  String?   @db.VarChar(100) @map("csr_uploaded_by")
  csrRemarks     String?   @db.VarChar(250) @map("csr_remarks")
  @@map("cust_item_rates")
  @@schema("public")
  @@index([csrCustomerId], map: "idx_csr_customer")
  @@index([csrUnitRateId], map: "idx_csr_unit_rate")
  @@index([csrBranchId], map: "idx_csr_branch")
  @@index([csrIsDeleted, csrIsActive], map: "idx_csr_active_deleted")
}
