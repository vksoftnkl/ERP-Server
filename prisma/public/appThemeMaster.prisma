model AppThemeMaster {
  thmId           Int    @id  @map("thm_id")
  thmName         String @db.VarChar(100) @map("thm_name") 
  thmIsActive     Boolean @default(true) @map("thm_is_active")
  thmIsDeleted    Boolean @default(false) @map("thm_is_deleted")
  company       Company[] @relation("CompanyStylesheet")
  /// NULL = changed since the last push to the cloud DB (see src/modules/cloud-sync).
  thmSyncDate DateTime? @db.Timestamptz(6) @map("thm_sync_date")
  @@map("app_theme_master")
  @@schema("public")
}