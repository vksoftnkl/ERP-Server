model DeviceMaster {
  devId           String    @id @default(dbgenerated("uuidv7()")) @map("dev_id")         @db.Uuid
  devCompanyId    String?   @map("dev_company_id")   @db.Uuid
  company         Company?  @relation(fields: [devCompanyId], references: [compId])
  devBranchId     String?   @map("dev_branch_id")    @db.Uuid
  branch          BranchMaster? @relation(fields: [devBranchId], references: [brId])
  devUserId       String?   @map("dev_user_id")      @db.Uuid
  user            UserMaster?   @relation(fields: [devUserId], references: [usrId])
  devDeviceUid    String    @unique @map("dev_device_uid")  @db.VarChar(120)
  devDeviceName   String?   @map("dev_device_name")  @db.VarChar(120)
  devDeviceType   String    @default("Desktop") @map("dev_device_type") @db.VarChar(30)
  devPlatform     String?   @map("dev_platform")     @db.VarChar(30)
  devMacAddress   String?   @map("dev_mac_address")  @db.VarChar(50)
  devIsBlocked    Boolean   @default(false) @map("dev_is_blocked")
  devBlockReason  String?   @map("dev_block_reason") @db.VarChar(250)
  devLastIp       String?   @map("dev_last_ip")      /// inet — store as text; cast in app layer
  devLastLogin    DateTime? @map("dev_last_login")   @db.Timestamptz(6)
  devIsActive     Boolean   @default(true)  @map("dev_is_active")
  devIsDeleted    Boolean   @default(false) @map("dev_is_deleted")
  devSyncDate     DateTime? @map("dev_sync_date")    @db.Timestamptz(6)
  devCreatedOn    DateTime  @default(now()) @map("dev_created_on")  @db.Timestamptz(6)
  devCreatedBy    String?   @map("dev_created_by")   @db.Uuid
  devModifiedOn   DateTime? @map("dev_modified_on")  @db.Timestamptz(6)
  devModifiedBy   String?   @map("dev_modified_by")  @db.Uuid

  txnStatusLogs   TxnStatusLog[]
  saleOrders      SaleOrder[]
  txnHolds        TxnHold[]     @relation("TxnHoldDevice")      // the till that parked the work
  txnHoldLocks    TxnHold[]     @relation("TxnHoldLockDevice")  // the till currently holding the lease
  appSettingValues AppSettingValue[]

  @@index([devDeviceUid], name: "idx_device_uid")
  @@map("device_master")
  @@schema("fixed")
}