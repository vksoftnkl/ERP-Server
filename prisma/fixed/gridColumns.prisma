
model GridColumn {
  gridColumnId              String    @id @default(dbgenerated("uuidv7()")) @map("grid_column_id")         @db.Uuid
  gridId                     BigInt   @map("grid_id")
  grid                      GridDetails @relation(fields: [gridId], references: [gridId], onDelete: Cascade, onUpdate: Cascade)
  gridColumnNumber          Int      @map("grid_column_number")
  gridColumnName            String   @db.Text @map("grid_column_name")
  gridColumnWidth           Decimal? @db.Decimal(12, 2) @map("grid_column_width")
  gridColumnAlignment       String?  @db.Text @map("grid_column_alignment")
  gridColumnVisibility      Boolean  @default(true)  @map("grid_column_visibility")
  gridColumnFilter          Boolean  @default(false) @map("grid_column_filter")
  gridColumnCondition       String?  @db.Text @map("grid_column_condition")
  gridColumnConditionColor  String?  @db.Text @map("grid_column_condition_color")
  gridColumnGroup           Boolean  @default(false) @map("grid_column_group")
  gridColumnTotal           Boolean  @default(false) @map("grid_column_total")
  gridColumnDataType        String?  @db.Text @map("grid_column_data_type")
  gridColumnColor           String?  @db.Text @map("grid_column_color")
  gridColumnNotes           String?  @db.Text @map("grid_column_notes")
  gridColumnIsDeleted       Boolean  @default(false) @map("grid_column_is_deleted")
  gridColumnPosition        Decimal? @db.Decimal(12, 2) @map("grid_column_position")
  gridColumnPx              String?  @db.Text @map("grid_column_px")
  gridColumnSqlFieldName    String?  @db.Text@map("grid_column_sql_field_name")
  gridColumnCreatedOn       DateTime @default(now()) @db.Timestamptz(6) @map("grid_column_created_on")
  gridColumnCreatedBy       String?  @db.Text @map("grid_column_created_by")
  gridColumnModifiedOn      DateTime? @updatedAt      @db.Timestamptz(6) @map("grid_column_modified_on")
  gridColumnModifiedBy      String?  @db.Text @map("grid_column_modified_by")
  gridColumnSyncOn          DateTime? @db.Timestamptz(6) @map("grid_column_sync_on")
  @@map("grid_columns")
  @@schema("fixed")
  @@index([gridId], map: "idx_grid_columns_grid_id")
  @@index([gridId, gridColumnFilter], map: "idx_grid_columns_filter")
  @@index([gridId, gridColumnIsDeleted], map: "idx_grid_columns_deleted")
}