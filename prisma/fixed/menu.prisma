model Menu {
  menuId       Int   @id @default(autoincrement()) @map("menu_id")
  // Self parent/child hierarchy
  menuParentId Int?  @map("menu_parent")
  parent       Menu? @relation("MenuHierarchy", fields: [menuParentId], references: [menuId], onDelete: SetNull, onUpdate: Cascade)
  children     Menu[] @relation("MenuHierarchy")
  menuName      String  @db.VarChar(200) @map("menu_name")
  menuAlias     String? @db.VarChar(200) @map("menu_alias")
  // Note: column name is "menu_visiblity" (typo kept as-is in @map)
  menuVisibility Boolean @default(true) @map("menu_visiblity")
  menuPosition  Decimal? @db.Decimal(12, 2) @map("menu_position")
  menuIconLocationDesktop String? @db.Text @map("menu_icon_location_desktop")
  menuIconLocationWeb     String? @db.Text @map("menu_icon_location_web")
  menuIconLocationMobile  String? @db.Text @map("menu_icon_location_mobile")
  menuSeparator Boolean  @default(false) @map("menu_separator")
  menuIsActive  Boolean  @default(true)  @map("menu_is_active")
  /// What this screen can DO (migration 20260922170000). The permissions grid
  /// renders a cell only for a verb listed here — no checkbox at all for one
  /// that is absent, because an unchecked box means DENIED and that is a
  /// different statement from "this screen has nothing to post".
  ///
  /// VIEW CREATE EDIT DELETE PRINT EXPORT · every screen
  /// POST CANCEL AMEND OVERRIDE           · documents that reach the ledger
  /// RETENDER                             · Sales Entry (12) alone
  menuVerbs     String[] @default(["VIEW", "CREATE", "EDIT", "DELETE", "PRINT", "EXPORT"]) @map("menu_verbs")
  menuCreatedOn  DateTime  @default(now()) @db.Timestamptz(6) @map("menu_created_on")
  menuModifiedOn DateTime? @updatedAt      @db.Timestamptz(6) @map("menu_modified_on")
  menuSyncDate   DateTime?               @db.Timestamptz(6) @map("menu_sync_date")
  userMenus              UserMenus[]
  sections               FormSection[]
  /// Voucher types whose rights are judged on this menu (acc_voucher_types.vchr_menu_id)
  voucherTypes           AccVoucherType[]
  @@index([menuParentId])
  @@index([menuPosition])
  @@map("menu_master")
  @@schema("fixed")
}