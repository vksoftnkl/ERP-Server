model UitableColumns {
  uiTblClmId               BigInt    @id @default(autoincrement())  @map("ui_tbl_clm_id")
  uiTblClmNo               BigInt?                                  @map("ui_tbl_clm_no")
  uiTblClmTableId          BigInt?                                  @map("ui_tbl_clm_table_id")
  uiTblClmName             String?   @db.Text                       @map("ui_tbl_clm_name")
  uiTblClmColumnWidth      Decimal?  @default(100) @db.Decimal      @map("ui_tbl_clm_column_width")
  uiTblClmColumnVisibility Boolean?  @default(true)                 @map("ui_tbl_clm_column_visibility")
  uiTblClmColumnFocus      Boolean?  @default(false)                @map("ui_tbl_clm_column_focus")
  uiTblClmColumnPosition   Int       @default(0)                    @map("ui_tbl_clm_column_position")
  uiTblClmColumnNecessity  Boolean   @default(false)                @map("ui_tbl_clm_column_necessity")
  uiTblClmNextColumn       Int?                                     @map("ui_tbl_clm_next_column")
  uiTblClmPreviousColumn   Int?                                     @map("ui_tbl_clm_previous_column")
  uiTblClmPx               String?   @db.Text                       @map("ui_tbl_clm_px")
  uiTblClmIsActive         Boolean   @default(true)                 @map("ui_tbl_clm_is_active")
  uiTblClmIsDeleted        Boolean   @default(false)                @map("ui_tbl_clm_is_deleted")
  uiTblClmSyncDate         DateTime? @db.Timestamptz(6)             @map("ui_tbl_clm_sync_date")
  uiTblClmCreatedOn        DateTime  @default(now()) @db.Timestamptz(6) @map("ui_tbl_clm_created_on")
  uiTblClmCreatedBy        String?   @db.VarChar(100)               @map("ui_tbl_clm_created_by")
  uiTblClmModifiedOn       DateTime  @default(now()) @db.Timestamptz(6) @map("ui_tbl_clm_modified_on")
  uiTblClmModifiedBy       String?   @db.VarChar(100)               @map("ui_tbl_clm_modified_by")
  uiTable                  Uitable?  @relation(fields: [uiTblClmTableId], references: [uiTblId], map: "fk_ui_tables")
  @@schema("fixed")
  @@map("ui_table_columns")
}
