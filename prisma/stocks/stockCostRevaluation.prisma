/// P13 — value-only stock movements (a bill priced off its GRN revalues the qty still on hand).
/// Summed by the cost rebuild with stock_ledger. Append-only: a cancel is a reversal row.
/// One writer: stock-voucher-posting.helper.ts (revalueOnHand / reverseCostRevaluation).
model StockCostRevaluation {
  scrId            String    @default(dbgenerated("uuidv7()")) @db.Uuid @map("scr_id")
  scrAccYear       String    @db.Char(9)                         @map("scr_acc_year")
  scrCompanyId     String    @db.Uuid                            @map("scr_company_id")
  scrBranchId      String    @db.Uuid                            @map("scr_branch_id")
  scrItemId        String    @db.Uuid                            @map("scr_item_id")
  scrLotId         String    @db.Uuid                            @map("scr_lot_id")
  scrValue         Decimal   @db.Decimal(18, 2)                  @map("scr_value")
  scrValueWot      Decimal   @db.Decimal(18, 2)                  @map("scr_value_wot")
  scrBasisBaseQty  Decimal   @db.Decimal(18, 6)                  @map("scr_basis_base_qty")
  scrDocDate       DateTime  @db.Date                            @map("scr_doc_date")
  scrDocDatetime   DateTime  @default(now()) @db.Timestamptz(6)  @map("scr_doc_datetime")
  scrSrcModule     String    @db.VarChar(20)                     @map("scr_src_module")
  scrSrcDocType    String    @db.VarChar(30)                     @map("scr_src_doc_type")
  scrSrcDocId      String    @db.Uuid                            @map("scr_src_doc_id")
  scrSrcAccYear    String    @db.Char(9)                         @map("scr_src_acc_year")
  scrSrcLineId     String    @db.Uuid                            @map("scr_src_line_id")
  scrSrcRefno      String?   @db.VarChar(100)                    @map("scr_src_refno")
  scrIsReversal    Boolean   @default(false)                     @map("scr_is_reversal")
  scrReversesId    String?   @db.Uuid                            @map("scr_reverses_id")
  scrNarration     String?   @db.Text                            @map("scr_narration")
  scrIsDeleted     Boolean   @default(false)                     @map("scr_is_deleted")
  scrSyncDate      DateTime? @db.Timestamptz(6)                  @map("scr_sync_date")
  scrCreatedOn     DateTime  @default(now()) @db.Timestamptz(6)  @map("scr_created_on")
  scrCreatedBy     String?   @db.Text                            @map("scr_created_by")

  branch           BranchMaster @relation("StockCostRevaluationBranch", fields: [scrBranchId], references: [brId],   onUpdate: Cascade, onDelete: Restrict, map: "fk_scr_branch")
  item             ItemMaster   @relation("StockCostRevaluationItem",   fields: [scrItemId],   references: [itemId], onUpdate: Cascade, onDelete: Restrict, map: "fk_scr_item")
  lot              StockLot     @relation("StockCostRevaluationLot",    fields: [scrLotId],    references: [sltId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_scr_lot")

  @@id([scrId, scrAccYear], map: "pk_stock_cost_revaluation")
  // Partial indexes - DB-only (WHERE NOT scr_is_deleted), Prisma would keep re-creating them:
  //   ix_scr_item (company, branch, item) · ix_scr_lot (lot) · ix_scr_source (src doc, type, year)
  //   ux_scr_source / ux_scr_reversal (unique, see the P13 migration)
  @@map("stock_cost_revaluation")
  @@schema("stock")
}
