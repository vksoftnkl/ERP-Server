model StockAdjReason {
  adjId            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid @map("sar_id")

  adjCode          String    @unique @db.VarChar(30)  @map("sar_code")
  adjName          String    @db.VarChar(150)         @map("sar_name")
  adjReason        String    @db.VarChar(30)          @map("sar_reason_kind")
  adjResolution    String    @db.VarChar(30)          @map("sar_default_resolution")

  adjAffectAcc     Boolean   @default(true)           @map("sar_affects_accounts")
  adjIsActive      Boolean   @default(true)           @map("sar_is_active")
  adjIsDeleted     Boolean   @default(false)          @map("sar_is_deleted")

  adjCreatedOn     DateTime  @default(now()) @db.Timestamptz(6) @map("sar_created_on")
  adjCreatedBy     String?   @db.Uuid                           @map("sar_created_by")
  adjModifiedOn    DateTime? @db.Timestamptz(6)                  @map("sar_modified_on")
  adjModifiedBy    String?   @db.Uuid                            @map("sar_modified_by")

  @@map("stock_adj_reasons")
  @@schema("fixed")
}