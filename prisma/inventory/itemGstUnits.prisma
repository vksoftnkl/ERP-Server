model ItemGstUnits {
    itemGstUnit Int @map("item_gst_unit_id") @id @default(autoincrement())
    itemGstUnitCode String? @db.Text @map("item_gst_unit_code")
    itemGstUnitName String? @db.Text @map("item_gst_unit_name")
    itemGstUnitCreatedOn DateTime @default(now()) @map("item_gst_unit_created_on")
    itemGstUnitCreatedBy String? @db.Text @map("item_gst_unit_created_by")
    itemGstUnitModifiedOn DateTime @default(now()) @map("item_gst_unit_modified_on")
    itemGstUnitModifiedBy String? @db.Text @map("item_gst_unit_modified_by")
    itemGstUnitSyncDate DateTime @default(now()) @map("item_gst_unit_sync_date")
    @@schema("inventory")
}