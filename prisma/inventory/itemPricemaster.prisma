model ItemPriceMaster {
  ipmId               String        @id @default(dbgenerated("uuidv7()")) @db.Uuid @map("ipm_id")
  ipmCompanyId        String?       @db.Uuid @map("ipm_company_id")
  ipmBranchId         String?       @db.Uuid @map("ipm_branch_id")
  ipmItemId           String        @db.Uuid @map("ipm_item_id")
  ipmUcUnitId         String        @db.Uuid @map("ipm_uc_unit_id")
  ipmGodownId         String?       @db.Uuid @map("ipm_godown_id") // NULL = price applies to every godown
  ipmSlNo             Int           @default(0) @db.Integer @map("ipm_sl_no")
  ipmCostPrice        Decimal       @default(0) @db.Decimal(18, 6) @map("ipm_cost_price")
  ipmCostWot          Decimal       @default(0) @db.Decimal(18, 6) @map("ipm_cost_wot")
  ipmSalesPriceA      Decimal       @default(0) @db.Decimal(18, 6) @map("ipm_sales_price_a")
  ipmSalesPriceB      Decimal       @default(0) @db.Decimal(18, 6) @map("ipm_sales_price_b")
  ipmSalesPriceC      Decimal       @default(0) @db.Decimal(18, 6) @map("ipm_sales_price_c")
  ipmSalesPriceD      Decimal       @default(0) @db.Decimal(18, 6) @map("ipm_sales_price_d")
  ipmPriceAWot        Decimal       @default(0) @db.Decimal(18, 6) @map("ipm_price_a_wot")
  ipmPriceBWot        Decimal       @default(0) @db.Decimal(18, 6) @map("ipm_price_b_wot")
  ipmPriceCWot        Decimal       @default(0) @db.Decimal(18, 6) @map("ipm_price_c_wot")
  ipmPriceDWot        Decimal       @default(0) @db.Decimal(18, 6) @map("ipm_price_d_wot")
  ipmPriceAMarkupPerc Decimal       @default(0) @db.Decimal(9, 3) @map("ipm_price_a_markup_perc")
  ipmPriceBMarkupPerc Decimal       @default(0) @db.Decimal(9, 3) @map("ipm_price_b_markup_perc")
  ipmPriceCMarkupPerc Decimal       @default(0) @db.Decimal(9, 3) @map("ipm_price_c_markup_perc")
  ipmPriceDMarkupPerc Decimal       @default(0) @db.Decimal(9, 3) @map("ipm_price_d_markup_perc")
  ipmMaxPrice         Decimal       @default(0) @db.Decimal(18, 6) @map("ipm_max_price")
  ipmMinPrice         Decimal       @default(0) @db.Decimal(18, 6) @map("ipm_min_price")
  ipmDiscPerc         Decimal       @default(0) @db.Decimal(9, 3) @map("ipm_disc_perc")
  ipmDiscQty          Decimal       @default(0) @db.Decimal(18, 6) @map("ipm_disc_qty")
  ipmAddlCess         Decimal       @default(0) @db.Decimal(18, 6) @map("ipm_addl_cess")
  ipmProfitType       String        @default("MANUAL") @db.VarChar(20) @map("ipm_profit_type")
  ipmRoundOff         Decimal       @default(0) @db.Decimal(10, 4) @map("ipm_round_off")
  ipmLoadingCharge    Decimal       @default(0) @db.Decimal(18, 6) @map("ipm_loading_charge")
  ipmFreightCharge    Decimal       @default(0) @db.Decimal(18, 6) @map("ipm_freight_charge")
  ipmLoyaltyPoints    Decimal       @default(0) @db.Decimal(18, 3) @map("ipm_loyalty_points")
  ipmUomRemarks       String?       @db.VarChar(250) @map("ipm_uom_remarks")
  ipmCostRemarks      String?       @db.VarChar(250) @map("ipm_cost_remarks")
  ipmIsActive         Boolean       @default(true) @map("ipm_is_active")
  ipmIsDeleted        Boolean       @default(false) @map("ipm_is_deleted")
  ipmSyncDate         DateTime?     @db.Timestamptz(6) @map("ipm_sync_date")
  ipmCreatedOn        DateTime      @default(now()) @db.Timestamptz(6) @map("ipm_created_on")
  ipmCreatedBy        String?       @db.Uuid @map("ipm_created_by")
  ipmUpdatedOn        DateTime?     @db.Timestamptz(6) @map("ipm_updated_on")
  ipmUpdatedBy        String?       @db.Uuid @map("ipm_updated_by")

  item                ItemMaster     @relation("ItemPrices", fields: [ipmItemId], references: [itemId], onUpdate: Cascade, onDelete: Restrict, map: "fk_ipm_item")
  company             Company?       @relation("CompanyItemPrices", fields: [ipmCompanyId], references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_ipm_company_id")
  branch              BranchMaster?  @relation("BranchItemPrices", fields: [ipmBranchId], references: [brId], onUpdate: Cascade, onDelete: Restrict, map: "fk_ipm_branch_id")
  itemUnitConversion ItemUnitConversion @relation("ItemPriceMasterUnitConversion", fields: [ipmUcUnitId], references: [iucId], onUpdate: Cascade, onDelete: Restrict, map: "fk_ipm_unit")
  godown              GodownLocation? @relation("GodownPrices", fields: [ipmGodownId], references: [gdlId], onUpdate: Cascade, onDelete: Restrict, map: "fk_ipm_godown_id")
  openingStockBaseUomDetails OpeningStockDetail[] @relation("OpeningStockDetailBaseUomPrice")

  @@index([ipmItemId, ipmUcUnitId], map: "idx_item_price_master_item")
  @@map("item_price_master")
  @@schema("inventory")
  // Partial unique index uq_item_price_master_scope is not expressible in Prisma
  // schema: (ipm_company_id, ipm_branch_id, ipm_item_id, ipm_uc_unit_id)
  // NULLS NOT DISTINCT WHERE ipm_is_deleted = false. It replaced
  // uq_item_price_master_branch and uq_item_price_master_item_unit_global.
  // ipm_godown_id is deliberately NOT part of the key, so two godowns cannot
  // hold different prices for the same item + unit + branch.
  // CHECK constraints are not expressible in Prisma schema.
}
