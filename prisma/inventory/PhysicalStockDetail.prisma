model PhysicalStockDetail {
  psdId                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid  @map("psd_id")

  // Header link
  psdPscId              String    @db.Uuid                                         @map("psd_psc_id")
  psdRowNo              Int       @default(1)                                      @map("psd_row_no")

  // Scope
  psdAccYear            String    @db.VarChar(9)                                   @map("psd_acc_year")
  psdCompanyId          String    @db.Uuid                                         @map("psd_company_id")
  psdBranchId           String    @db.Uuid                                         @map("psd_branch_id")
  psdGodownId           String    @db.Uuid                                         @map("psd_godown_id")

  // Item
  psdItemId             String    @db.Uuid                                         @map("psd_item_id")
  psdUnitId             String    @db.Uuid                                         @map("psd_unit_id")
  psdBaseUnitId         String    @db.Uuid                                         @map("psd_base_unit_id")
  psdToBaseFactor       Decimal   @default(1) @db.Decimal(18, 6)                   @map("psd_to_base_factor")

  // Quick identity / scan fields
  psdBarcode            String?   @db.VarChar(100)                                 @map("psd_barcode")
  psdMrp                Decimal   @default(0) @db.Decimal(18, 6)                   @map("psd_mrp")

  // Tracking
  psdTrackingType       String    @default("NONE") @db.VarChar(20)                 @map("psd_tracking_type")

  // Book stock
  psdBookQty            Decimal   @default(0) @db.Decimal(18, 6)                   @map("psd_book_qty")
  psdBookBaseQty        Decimal   @default(0) @db.Decimal(18, 6)                   @map("psd_book_base_qty")

  // Physical counted stock
  psdPhysicalQty        Decimal   @default(0) @db.Decimal(18, 6)                   @map("psd_physical_qty")
  psdPhysicalBaseQty    Decimal   @default(0) @db.Decimal(18, 6)                   @map("psd_physical_base_qty")

  // Difference (generated columns)
  psdDiffQty            Decimal?  @db.Decimal(18, 6)                               @map("psd_diff_qty")
  psdDiffBaseQty        Decimal?  @db.Decimal(18, 6)                               @map("psd_diff_base_qty")

  // Valuation
  psdStockRateWot       Decimal   @default(0) @db.Decimal(18, 6)                   @map("psd_stock_rate_wot")
  psdStockRateWithTax   Decimal   @default(0) @db.Decimal(18, 6)                   @map("psd_stock_rate_with_tax")

  // Valuation (generated columns)
  psdBookValueWot       Decimal?  @db.Decimal(18, 2)                               @map("psd_book_value_wot")
  psdPhysicalValueWot   Decimal?  @db.Decimal(18, 2)                               @map("psd_physical_value_wot")
  psdDiffValueWot       Decimal?  @db.Decimal(18, 2)                               @map("psd_diff_value_wot")
  psdDiffValueWithTax   Decimal?  @db.Decimal(18, 2)                               @map("psd_diff_value_with_tax")

  // Resolution
  psdReasonId           String?   @db.Uuid                                         @map("psd_reason_id")
  psdResolution         String    @default("ADJUST_LOSS_GAIN") @db.VarChar(30)     @map("psd_resolution")
  psdNotes              String?                                                    @map("psd_notes")

  // Posting / Audit
  psdIsPosted           Boolean   @default(false)                                  @map("psd_is_posted")
  psdIsActive           Boolean   @default(true)                                   @map("psd_is_active")
  psdIsDeleted          Boolean   @default(false)                                  @map("psd_is_deleted")
  psdSyncDate           DateTime? @db.Timestamptz                                  @map("psd_sync_date")
  psdCreatedOn          DateTime  @default(now()) @db.Timestamptz                  @map("psd_created_on")
  psdCreatedBy          String?   @db.Uuid                                         @map("psd_created_by")
  psdModifiedOn         DateTime  @default(now()) @db.Timestamptz                  @map("psd_modified_on")
  psdModifiedBy         String?   @db.Uuid                                         @map("psd_modified_by")

  // Relations
  company               Company                   @relation("PhysicalStockDetailCompany", fields: [psdCompanyId], references: [compId], map: "fk_physical_stock_detail_company")
  branch                BranchMaster              @relation("PhysicalStockDetailBranch", fields: [psdBranchId], references: [brId], map: "fk_physical_stock_detail_branch")
  godown                GodownLocation            @relation("PhysicalStockDetailGodown", fields: [psdGodownId], references: [gdlId], onUpdate: Cascade, onDelete: Restrict, map: "fk_physical_stock_detail_godown")
  item                  ItemMaster                @relation("PhysicalStockDetailItem", fields: [psdItemId], references: [itemId], onUpdate: Cascade, onDelete: Restrict, map: "fk_physical_stock_detail_item")
  unit                  Unit                      @relation("PhysicalStockDetailUnit", fields: [psdUnitId], references: [unit_id], onUpdate: Cascade, onDelete: Restrict, map: "fk_physical_stock_detail_unit")
  baseUnit              Unit                      @relation("PhysicalStockDetailBaseUnit", fields: [psdBaseUnitId], references: [unit_id], onUpdate: Cascade, onDelete: Restrict, map: "fk_physical_stock_detail_base_unit")
  header                PhysicalStockHeader      @relation(fields: [psdPscId], references: [pscId], onDelete: Cascade, map: "fk_physical_stock_detail_header")
  reason                StockAdjReasonMaster?    @relation(fields: [psdReasonId], references: [sarId], map: "fk_physical_stock_detail_reason")
  batchDetails          PhysicalStockBatchDetail[]

  // Unique constraints
  @@unique([psdPscId, psdRowNo])
  @@unique([psdPscId, psdGodownId, psdItemId, psdUnitId])

  // Indexes
  @@index([psdPscId],                                        map: "ix_physical_stock_detail_header")
  @@index([psdCompanyId, psdBranchId, psdGodownId, psdItemId], map: "ix_physical_stock_detail_item")
  @@index([psdPscId, psdDiffBaseQty],                        map: "ix_physical_stock_detail_diff")
  @@index([psdPscId, psdResolution],                         map: "ix_physical_stock_detail_resolution")

  @@map("physical_stock_detail")
  @@schema("inventory")
}
