model PhysicalStockBatchDetail {
  psbId                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid  @map("psb_id")

  // Parent link
  psbPsdId              String    @db.Uuid                                         @map("psb_psd_id")
  psbRowNo              Int       @default(1)                                      @map("psb_row_no")

  // Scope snapshot
  psbAccYear            String    @db.VarChar(9)                                   @map("psb_acc_year")
  psbCompanyId          String    @db.Uuid                                         @map("psb_company_id")
  psbBranchId           String    @db.Uuid                                         @map("psb_branch_id")
  psbGodownId           String    @db.Uuid                                         @map("psb_godown_id")

  // Item snapshot
  psbItemId             String    @db.Uuid                                         @map("psb_item_id")
  psbUnitId             String    @db.Uuid                                         @map("psb_unit_id")
  psbBaseUnitId         String    @db.Uuid                                         @map("psb_base_unit_id")
  psbToBaseFactor       Decimal   @default(1) @db.Decimal(18, 6)                   @map("psb_to_base_factor")

  // Batch / lot / MRP identity
  psbBatchId            String?   @db.Uuid                                         @map("psb_batch_id")
  psbBatchNo            String?   @db.VarChar(100)                                 @map("psb_batch_no")
  psbMfgBatchNo         String?   @db.VarChar(100)                                 @map("psb_mfg_batch_no")
  psbBatchDate          DateTime? @db.Date                                         @map("psb_batch_date")
  psbMfgDate            DateTime? @db.Date                                         @map("psb_mfg_date")
  psbExpiryDate         DateTime? @db.Date                                         @map("psb_expiry_date")
  psbMrp                Decimal   @default(0) @db.Decimal(18, 6)                   @map("psb_mrp")
  psbBarcode            String?   @db.VarChar(100)                                 @map("psb_barcode")
  psbSerialNo           String?   @db.VarChar(100)                                 @map("psb_serial_no")

  // Book stock
  psbBookQty            Decimal   @default(0) @db.Decimal(18, 6)                   @map("psb_book_qty")
  psbBookBaseQty        Decimal   @default(0) @db.Decimal(18, 6)                   @map("psb_book_base_qty")

  // Physical counted stock
  psbPhysicalQty        Decimal   @default(0) @db.Decimal(18, 6)                   @map("psb_physical_qty")
  psbPhysicalBaseQty    Decimal   @default(0) @db.Decimal(18, 6)                   @map("psb_physical_base_qty")

  // Difference (generated columns)
  psbDiffQty            Decimal?  @db.Decimal(18, 6)                               @map("psb_diff_qty")
  psbDiffBaseQty        Decimal?  @db.Decimal(18, 6)                               @map("psb_diff_base_qty")

  // Valuation
  psbStockRateWot       Decimal   @default(0) @db.Decimal(18, 6)                   @map("psb_stock_rate_wot")
  psbStockRateWithTax   Decimal   @default(0) @db.Decimal(18, 6)                   @map("psb_stock_rate_with_tax")

  // Valuation (generated columns)
  psbBookValueWot       Decimal?  @db.Decimal(18, 2)                               @map("psb_book_value_wot")
  psbPhysicalValueWot   Decimal?  @db.Decimal(18, 2)                               @map("psb_physical_value_wot")
  psbDiffValueWot       Decimal?  @db.Decimal(18, 2)                               @map("psb_diff_value_wot")
  psbDiffValueWithTax   Decimal?  @db.Decimal(18, 2)                               @map("psb_diff_value_with_tax")

  // Resolution
  psbReasonId           String?   @db.Uuid                                         @map("psb_reason_id")
  psbResolution         String    @default("ADJUST_LOSS_GAIN") @db.VarChar(30)     @map("psb_resolution")
  psbNotes              String?                                                    @map("psb_notes")

  // Posting / Audit
  psbIsPosted           Boolean   @default(false)                                  @map("psb_is_posted")
  psbIsActive           Boolean   @default(true)                                   @map("psb_is_active")
  psbIsDeleted          Boolean   @default(false)                                  @map("psb_is_deleted")
  psbSyncDate           DateTime? @db.Timestamptz                                  @map("psb_sync_date")
  psbCreatedOn          DateTime  @default(now()) @db.Timestamptz                  @map("psb_created_on")
  psbCreatedBy          String?   @db.Uuid                                         @map("psb_created_by")
  psbModifiedOn         DateTime  @default(now()) @db.Timestamptz                  @map("psb_modified_on")
  psbModifiedBy         String?   @db.Uuid                                         @map("psb_modified_by")

  // Relations
  company               Company                   @relation("PhysicalStockBatchDetailCompany", fields: [psbCompanyId], references: [compId], map: "fk_physical_stock_batch_detail_company")
  branch                BranchMaster              @relation("PhysicalStockBatchDetailBranch", fields: [psbBranchId], references: [brId], map: "fk_physical_stock_batch_detail_branch")
  godown                GodownLocation            @relation("PhysicalStockBatchDetailGodown", fields: [psbGodownId], references: [gdlId], onUpdate: Cascade, onDelete: Restrict, map: "fk_physical_stock_batch_detail_godown")
  item                  ItemMaster                @relation("PhysicalStockBatchDetailItem", fields: [psbItemId], references: [itemId], onUpdate: Cascade, onDelete: Restrict, map: "fk_physical_stock_batch_detail_item")
  unit                  Unit                      @relation("PhysicalStockBatchDetailUnit", fields: [psbUnitId], references: [unit_id], onUpdate: Cascade, onDelete: Restrict, map: "fk_physical_stock_batch_detail_unit")
  baseUnit              Unit                      @relation("PhysicalStockBatchDetailBaseUnit", fields: [psbBaseUnitId], references: [unit_id], onUpdate: Cascade, onDelete: Restrict, map: "fk_physical_stock_batch_detail_base_unit")
  detail                PhysicalStockDetail      @relation(fields: [psbPsdId], references: [psdId], onDelete: Cascade, map: "fk_physical_stock_batch_detail_detail")
  reason                StockAdjReasonMaster?    @relation(fields: [psbReasonId], references: [sarId], map: "fk_physical_stock_batch_detail_reason")

  // Unique constraints
  @@unique([psbPsdId, psbRowNo])
  @@unique([psbPsdId, psbBatchId, psbBatchNo, psbMrp, psbBarcode, psbSerialNo])

  // Indexes
  @@index([psbPsdId],                                          map: "ix_physical_stock_batch_detail_parent")
  @@index([psbCompanyId, psbBranchId, psbGodownId, psbItemId], map: "ix_physical_stock_batch_detail_item")
  @@index([psbItemId, psbBatchNo, psbMrp, psbBarcode],         map: "ix_physical_stock_batch_detail_batch")
  @@index([psbItemId, psbExpiryDate],                          map: "ix_physical_stock_batch_detail_expiry")
  @@index([psbPsdId, psbDiffBaseQty],                          map: "ix_physical_stock_batch_detail_diff")

  @@map("physical_stock_batch_detail")
  @@schema("inventory")
}
