model StockAdjReasonMaster {
  sarId                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid  @map("sar_id")
  sarCode              String    @db.VarChar(30)                                  @map("sar_code")
  sarName              String    @db.VarChar(150)                                 @map("sar_name")
  sarReasonKind        String    @db.VarChar(30)                                  @map("sar_reason_kind")
  sarDefaultResolution String    @db.VarChar(30)                                  @map("sar_default_resolution")
  sarAffectsAccounts   Boolean   @default(true)                                   @map("sar_affects_accounts")
  sarIsActive          Boolean   @default(true)                                   @map("sar_is_active")
  sarIsDeleted         Boolean   @default(false)                                  @map("sar_is_deleted")
  sarCreatedOn         DateTime  @default(now()) @db.Timestamptz                  @map("sar_created_on")
  sarCreatedBy         String?   @db.Uuid                                         @map("sar_created_by")
  sarModifiedOn        DateTime  @default(now()) @db.Timestamptz                  @map("sar_modified_on")
  sarModifiedBy        String?   @db.Uuid                                         @map("sar_modified_by")

  // Relations
  physicalStockDetails      PhysicalStockDetail[]
  physicalStockBatchDetails PhysicalStockBatchDetail[]

  @@unique([sarCode])
  @@map("stock_adj_reason_master")
  @@schema("inventory")
}
