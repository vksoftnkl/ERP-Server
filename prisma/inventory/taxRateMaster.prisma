/// GST rate master. One row per rate, shared by every company — a rate is
/// statutory and national, so the ledgers it names must be global too.
///
/// Replaces the eighteen ledger columns of inventory.item_tax_master with rows
/// in TaxRateLedger; see that model.
model TaxRateMaster {
  taxId              String  @id(map: "pk_tax_rate_master") @default(dbgenerated("uuidv7()")) @db.Uuid @map("tax_id")
  taxName            String  @db.VarChar(100)                                   @map("tax_name")
  taxCode            String? @db.VarChar(30)                                    @map("tax_code")
  taxSortOrder       Int     @default(0) @db.SmallInt                           @map("tax_sort_order")

  // ── Classification ─────────────────────────────────────────────────────
  /// Same vocabulary as accounts."VoucherDocDetailTaxability", minus MIXED — a
  /// rate is never mixed; a DOCUMENT is, when its lines disagree.
  /// TAXABLE | EXEMPT | NIL_RATED | NON_GST | ZERO_RATED (ck_tax_taxability)
  taxTaxability      String  @default("TAXABLE") @db.VarChar(15)                @map("tax_taxability")
  taxIsReverseCharge Boolean @default(false)                                    @map("tax_is_reverse_charge")

  // ── The rate. One number; the rest follow from it ───────────────────────
  /// The total GST rate: 18 means 18%, charged as 9+9 locally or 18 inter-state.
  taxRatePerc        Decimal @default(0) @db.Decimal(7, 3)                      @map("tax_rate_perc")

  // The three component rates are GENERATED ALWAYS ... STORED from taxRatePerc,
  // so they can no longer disagree with the rate they come from. Prisma has no
  // generated-column concept: the no-argument @default(dbgenerated()) marks the
  // value DB-owned so migrate never emits a DROP DEFAULT Postgres would reject,
  // and they read back nullable because a generated column is not NOT NULL.
  taxCgstPerc        Decimal? @default(dbgenerated()) @db.Decimal(7, 3)         @map("tax_cgst_perc")
  taxSgstPerc        Decimal? @default(dbgenerated()) @db.Decimal(7, 3)         @map("tax_sgst_perc")
  taxIgstPerc        Decimal? @default(dbgenerated()) @db.Decimal(7, 3)         @map("tax_igst_perc")

  // ── Cess ───────────────────────────────────────────────────────────────
  /// NONE | PERCENT (taxCessPerc) | PER_UNIT (taxCessPerUnit) | BOTH. Says
  /// which figure is in play, so a zero is never ambiguous (ck_tax_cess_basis).
  taxCessBasis       String  @default("NONE") @db.VarChar(10)                   @map("tax_cess_basis")
  taxCessPerc        Decimal @default(0) @db.Decimal(7, 3)                      @map("tax_cess_perc")
  taxCessPerUnit     Decimal @default(0) @db.Decimal(15, 4)                     @map("tax_cess_per_unit")

  // ── Additional / state cess ────────────────────────────────────────────
  /// A SECOND cess, because sale_bill_item (sbi_acess_*), acc_voucher_doc_register
  /// (gdr_state_cess_value) and the 'State Cess' duty head all expect one. Same
  /// shape as the block above, so a line can carry both independently — Kerala
  /// flood cess beside compensation cess is the standard example.
  taxAcessBasis      String  @default("NONE") @db.VarChar(10)                   @map("tax_acess_basis")
  taxAcessPerc       Decimal @default(0) @db.Decimal(7, 3)                      @map("tax_acess_perc")
  taxAcessPerUnit    Decimal @default(0) @db.Decimal(15, 4)                     @map("tax_acess_per_unit")

  // ── Supersession ───────────────────────────────────────────────────────
  /// The rate this one replaced. A rate change makes a NEW row and re-points
  /// items (see ItemTaxHistory); this keeps the chain followable. NULL on an
  /// original rate.
  taxSupersedesId    String? @db.Uuid                                           @map("tax_supersedes_id")

  // ── Audit ──────────────────────────────────────────────────────────────
  taxIsActive        Boolean   @default(true)                                   @map("tax_is_active")
  taxIsDeleted       Boolean   @default(false)                                  @map("tax_is_deleted")
  taxSyncDate        DateTime? @db.Timestamptz(6)                               @map("tax_sync_date")
  taxCreatedOn       DateTime  @default(now()) @db.Timestamptz(6)               @map("tax_created_on")
  taxCreatedBy       String?   @db.VarChar(50)                                  @map("tax_created_by")
  taxModifiedOn      DateTime? @db.Timestamptz(6)                               @map("tax_modified_on")
  taxModifiedBy      String?   @db.VarChar(50)                                  @map("tax_modified_by")

  // Relations
  supersedes         TaxRateMaster?  @relation("TaxRateSupersedes", fields: [taxSupersedesId], references: [taxId], onUpdate: Cascade, onDelete: SetNull, map: "fk_tax_supersedes")
  supersededBy       TaxRateMaster[] @relation("TaxRateSupersedes")
  ledgerOverrides    TaxRateLedger[]
  // Lines taxed under this rate. The reference is a snapshot, so ON DELETE
  // RESTRICT: a rate a document has used can be superseded, never removed.
  // Items defaulting to this rate, and their rate-change history — moved
  // off ItemTaxMaster by 20260912110000_repoint_items_to_tax_rate_master.
  defaultItems       ItemMaster[]
  itemTaxHistory     ItemTaxHistory[]
  // Service ledgers (freight, packing, labour) that carry this rate when they
  // appear as a taxable line — acc_ledger_master.led_tax_id.
  ledgers            AccLedgerMaster[]
  billItems          SaleBillItem[]
  orderItems         SaleOrderItem[]
  quotationItems     SaleQuotationItem[]

  // Partial indexes — DB-only, Prisma ignores a WHERE predicate and would keep
  // re-creating these without one:
  //   ux_tax_name       UNIQUE (lower(tax_name))  WHERE tax_is_deleted = false
  //   ux_tax_code       UNIQUE (lower(tax_code))  WHERE tax_code IS NOT NULL AND tax_is_deleted = false
  //   ix_tax_rate       (tax_rate_perc)           WHERE NOT deleted AND active
  //   ix_tax_sort       (tax_sort_order, tax_name) WHERE NOT deleted AND active
  //   ix_tax_supersedes (tax_supersedes_id)       WHERE tax_supersedes_id IS NOT NULL
  // Name uniqueness among live rows must therefore be checked app-side.
  @@map("tax_rate_master")
  @@schema("inventory")
}

/// Per-GST-rate ledger overrides. One row per (rate, role, supply nature) that
/// actually differs from the default — a rate that posts wherever
/// accounts.acc_ledger_map says has no rows here at all, which is a complete
/// configuration. Same (scope, role, nature) -> ledger shape as the map; the
/// map's scope is company and branch, this one's is the rate.
model TaxRateLedger {
  trlId           String  @id(map: "pk_tax_rate_ledger") @default(dbgenerated("uuidv7()")) @db.Uuid @map("trl_id")
  trlTaxId        String  @db.Uuid                                              @map("trl_tax_id")
  trlRole         String  @db.VarChar(30)                                       @map("trl_role")
  /// NULL = both natures. Only roles with alrBySupply may set it.
  /// INTRA | INTER (ck_trl_supply_nature)
  trlSupplyNature String? @db.VarChar(5)                                        @map("trl_supply_nature")
  trlLedgerId     String  @db.Uuid                                              @map("trl_ledger_id")
  trlRemarks      String? @db.VarChar(250)                                      @map("trl_remarks")

  trlIsActive     Boolean   @default(true)                                      @map("trl_is_active")
  trlIsDeleted    Boolean   @default(false)                                     @map("trl_is_deleted")
  trlSyncDate     DateTime? @db.Timestamptz(6)                                  @map("trl_sync_date")
  trlCreatedOn    DateTime  @default(now()) @db.Timestamptz(6)                  @map("trl_created_on")
  trlCreatedBy    String?   @db.VarChar(50)                                     @map("trl_created_by")
  trlModifiedOn   DateTime? @db.Timestamptz(6)                                  @map("trl_modified_on")
  trlModifiedBy   String?   @db.VarChar(50)                                     @map("trl_modified_by")

  // Relations. The role is an FK, not a CHECK listing role names: adding a role
  // is one insert in accounts.acc_ledger_role and every table that uses roles
  // follows.
  taxRate         TaxRateMaster   @relation(fields: [trlTaxId], references: [taxId], onUpdate: Cascade, onDelete: Cascade, map: "fk_trl_tax")
  role            AccLedgerRole   @relation(fields: [trlRole], references: [alrRole], onUpdate: Cascade, onDelete: Restrict, map: "fk_trl_role")
  ledger          AccLedgerMaster @relation(fields: [trlLedgerId], references: [ledId], onUpdate: Cascade, onDelete: Restrict, map: "fk_trl_ledger")

  @@index([trlLedgerId], map: "ix_trl_ledger")
  @@index([trlRole], map: "ix_trl_role")
  // Partial indexes — DB-only, see the note on TaxRateMaster:
  //   ux_trl_rate_role UNIQUE (trl_tax_id, trl_role, trl_supply_nature) NULLS NOT DISTINCT WHERE NOT deleted
  //   ix_trl_lookup    (trl_tax_id, trl_role) INCLUDE (trl_ledger_id, trl_supply_nature) WHERE NOT deleted AND active
  @@map("tax_rate_ledger")
  @@schema("inventory")
}
