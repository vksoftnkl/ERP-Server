model OpeningStockDetail {
  // Primary
  oslId               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid @map("osl_id")
  // Header link
  oslVoucherId        String    @db.Uuid @map("osl_voucher_id")
  oslOpeningId        String    @db.Uuid @map("osl_opening_id")
  oslLineNo           Int       @map("osl_line_no")
  // Multi-branch snapshot
  oslAccYear          String    @db.VarChar(9) @map("osl_acc_year")
  oslCompanyId        String    @db.Uuid @map("osl_company_id")
  oslBranchId         String    @db.Uuid @map("osl_branch_id")
  // Item / location
  oslItemId           String    @db.Uuid @map("osl_item_id")
  oslUnitId           String    @db.Uuid @map("osl_unit_id")
  oslBaseUomId        String?   @db.Uuid @map("osl_base_uom_id")
  oslGodownId         String    @db.Uuid @map("osl_godown_id")
  // Tracking — validated at app level (OpeningStockDetailTrackingType)
  oslTrackingType     String    @default("NONE") @db.VarChar(20) @map("osl_tracking_type")
  oslBatchId          String?   @db.Uuid @map("osl_batch_id")
  // Batch / lot / serial fields
  oslBarcode          String?   @db.VarChar(100) @map("osl_barcode")
  oslBatchNo          String?   @db.VarChar(100) @map("osl_batch_no")
  oslMfgBatchNo       String?   @db.VarChar(100) @map("osl_mfg_batch_no")
  oslBatchDate        DateTime? @db.Date @map("osl_batch_date")
  oslMfgDate          DateTime? @db.Date @map("osl_mfg_date")
  oslExpiryDate       DateTime? @db.Date @map("osl_expiry_date")
  oslSerialNo         String?   @db.VarChar(100) @map("osl_serial_no")
  // Quantity
  oslQty              Decimal   @default(0) @db.Decimal(18, 6) @map("osl_qty")
  oslBaseQty          Decimal   @default(0) @db.Decimal(18, 6) @map("osl_base_qty")
  oslFreeQty          Decimal   @default(0) @db.Decimal(18, 6) @map("osl_free_qty")
  oslFreeBaseQty      Decimal   @default(0) @db.Decimal(18, 6) @map("osl_free_base_qty")
  oslConvFactor       Decimal   @default(1) @db.Decimal(18, 6) @map("osl_conv_factor")
  // Tax snapshot
  oslTaxId            String?   @db.Uuid @map("osl_tax_id")
  oslTaxPerc          Decimal   @default(0) @db.Decimal(9, 3) @map("osl_tax_perc")
  // Validated at app level (OpeningStockDetailCessType)
  oslCessType         String    @default("NONE") @db.VarChar(20) @map("osl_cess_type")
  oslCessPerc         Decimal                        @default(0) @db.Decimal(9, 3) @map("osl_cess_perc")
  oslCessPerUnit      Decimal                        @default(0) @db.Decimal(18, 6) @map("osl_cess_per_unit")
  // Cost / value snapshot
  oslCostRate         Decimal                        @default(0) @db.Decimal(18, 6) @map("osl_cost_rate")
  oslCostRateWot      Decimal                        @default(0) @db.Decimal(18, 6) @map("osl_cost_rate_wot")
  oslStockValue       Decimal                        @default(0) @db.Decimal(18, 2) @map("osl_stock_value")
  oslStockValueWot    Decimal                        @default(0) @db.Decimal(18, 2) @map("osl_stock_value_wot")
  // Selling / pricing snapshot
  oslMrpRate          Decimal                        @default(0) @db.Decimal(18, 6) @map("osl_mrp_rate")
  oslMinRate          Decimal                        @default(0) @db.Decimal(18, 6) @map("osl_min_rate")
  oslSaleRateA        Decimal                        @default(0) @db.Decimal(18, 6) @map("osl_sale_rate_a")
  oslSaleRateB        Decimal                        @default(0) @db.Decimal(18, 6) @map("osl_sale_rate_b")
  oslSaleRateC        Decimal                        @default(0) @db.Decimal(18, 6) @map("osl_sale_rate_c")
  oslSaleRateD        Decimal                        @default(0) @db.Decimal(18, 6) @map("osl_sale_rate_d")
  oslSaleRateAWot     Decimal                        @default(0) @db.Decimal(18, 6) @map("osl_sale_rate_a_wot")
  oslSaleRateBWot     Decimal                        @default(0) @db.Decimal(18, 6) @map("osl_sale_rate_b_wot")
  oslSaleRateCWot     Decimal                        @default(0) @db.Decimal(18, 6) @map("osl_sale_rate_c_wot")
  oslSaleRateDWot     Decimal                        @default(0) @db.Decimal(18, 6) @map("osl_sale_rate_d_wot")
  // Markup snapshot
  oslMarkupPercA      Decimal                        @default(0) @db.Decimal(9, 3) @map("osl_markup_perc_a")
  oslMarkupPercB      Decimal                        @default(0) @db.Decimal(9, 3) @map("osl_markup_perc_b")
  oslMarkupPercC      Decimal                        @default(0) @db.Decimal(9, 3) @map("osl_markup_perc_c")
  oslMarkupPercD      Decimal                        @default(0) @db.Decimal(9, 3) @map("osl_markup_perc_d")
  // Notes
  oslRemarks          String?                        @map("osl_remarks")
  // Status
  oslIsActive         Boolean                        @default(true) @map("osl_is_active")
  oslIsDeleted        Boolean                        @default(false) @map("osl_is_deleted")
  // Audit
  oslSyncDate         DateTime?                      @db.Timestamptz(6) @map("osl_sync_date")
  oslCreatedOn        DateTime                       @default(now()) @db.Timestamptz(6) @map("osl_created_on")
  oslCreatedBy        String?                        @db.Uuid @map("osl_created_by")
  oslUpdatedOn        DateTime?                      @db.Timestamptz(6) @map("osl_updated_on")
  oslUpdatedBy        String?                        @db.Uuid @map("osl_updated_by")
  // Relations
  // oslVoucherId stays a plain UUID column — acc_voucher_header was dropped.
  company             Company                        @relation(fields: [oslCompanyId], references: [compId], map: "fk_osl_company")
  branch              BranchMaster                   @relation(fields: [oslBranchId], references: [brId], map: "fk_osl_branch")
  item                ItemMaster                     @relation("OpeningStockDetailItem", fields: [oslItemId], references: [itemId], onUpdate: Cascade, onDelete: Restrict, map: "fk_osl_item")
  unitMaster          Unit                           @relation("OpeningStockDetailUnit", fields: [oslUnitId], references: [unit_id], onUpdate: Cascade, onDelete: Restrict, map: "fk_osl_unit")
  baseUomPriceMaster  ItemPriceMaster?              @relation("OpeningStockDetailBaseUomPrice", fields: [oslBaseUomId], references: [ipmId], onUpdate: Cascade, onDelete: Restrict, map: "fk_osl_base_uom_price")
  godown              GodownLocation                 @relation("OpeningStockDetailGodown", fields: [oslGodownId], references: [gdlId], onUpdate: Cascade, onDelete: Restrict, map: "fk_osl_godown")
  openingHeader       OpeningStockHeader             @relation(fields: [oslOpeningId], references: [oshId], map: "fk_osl_opening_header")
  
  @@unique([oslCompanyId, oslBranchId, oslAccYear, oslVoucherId, oslLineNo], map: "uq_opening_stock_detail_voucher_line")
  @@index([oslCompanyId, oslBranchId, oslAccYear, oslOpeningId], map: "idx_opening_stock_detail_opening")
  @@map("opening_stock_detail")
  @@schema("stock")
}
