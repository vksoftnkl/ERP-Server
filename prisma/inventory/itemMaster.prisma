model ItemMaster {
  itemId               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid @map("item_id")
  itemCompanyId        String?  @db.Uuid @map("item_company_id")
  itemBranchId         String?  @db.Uuid @map("item_branch_id")
  // Names / Codes
  itemCode             String?  @db.VarChar(50)  @map("item_code")
  itemSku              String?  @db.VarChar(60)  @map("item_sku")
  itemNameEn           String   @db.VarChar(200) @map("item_name_en")
  itemNameTa           String?  @db.VarChar(200) @map("item_name_ta")
  itemAlias            String?  @db.VarChar(200) @map("item_alias")
  itemStockType        String   @default("FG") @db.VarChar(20) @map("item_stock_type")
  itemDefaultBarcode   String?  @db.VarChar(200) @map("item_default_barcode")
  // Classification
  itemGroupId          String   @db.Uuid @map("item_group_id")
  itemCategoryId       String?  @db.Uuid @map("item_category_id")
  itemBrandId          String?  @db.Uuid @map("item_brand_id")
  itemSectionId        String?  @db.Uuid @map("item_section_id")
  itemCompanyCategoryId String? @db.Uuid @map("item_company_category_id")
  itemMfgrId           String?  @db.Uuid @map("item_mfgr_id")
  itemSupplierId       String?  @db.Uuid @map("item_supplier_id")
  itemCustGroup        String?  @db.Uuid @map("item_cust_group")
  // Units / Batch / Expiry
  itemBaseUnitId       String?  @db.Uuid @map("item_base_unit_id")
  itemIsService        Boolean  @default(false) @map("item_is_service")
  itemIsBatchBased     Boolean  @default(false) @map("item_is_batch_based")
  itemIsExpiryItem     Boolean  @default(false) @map("item_is_expiry_item")
  itemExpiryDays       Int?     @map("item_expiry_days")
  itemIntimateBeforeDays Int?   @map("item_intimate_before_days")
  // Sales / Purchase flags
  itemAllowSales       Boolean  @default(true) @map("item_allow_sales")
  itemAllowSalesReturn Boolean  @default(true) @map("item_allow_sales_return")
  itemAllowPurchase    Boolean  @default(true) @map("item_allow_purchase")
  itemAllowPo          Boolean  @default(true) @map("item_allow_po")
  itemAllowSo          Boolean  @default(true) @map("item_allow_so")
  itemAllowNegStock    Boolean  @default(true) @map("item_allow_neg_stock")
  itemAllowNegativeSo  Boolean  @default(true) @map("item_allow_negative_so")
  // Pricing / POS / Features
  itemPriceList        Boolean  @default(false) @map("item_price_list")
  itemWeighScale       Boolean  @default(false) @map("item_weigh_scale")
  itemRetailItem       Boolean  @default(true)  @map("item_retail_item")
  itemIsKit            Boolean  @default(false) @map("item_is_kit")
  itemAutoBreak        Boolean  @default(false) @map("item_auto_break")
  itemAutoMake         Boolean  @default(false) @map("item_auto_make")
  itemAllowLoyalty     Boolean  @default(false) @map("item_allow_loyalty")
  itemAllowPromo       Boolean  @default(false) @map("item_allow_promo")
  itemHasOffer         Boolean  @default(false) @map("item_has_offer")
  itemDamagableProduct Boolean  @default(false) @map("item_damagable_product")
  itemIsDemand         Boolean  @default(false) @map("item_is_demand")
  itemAllowLoading     Boolean  @default(false) @map("item_allow_loading")
  itemAllowFreight     Boolean  @default(false) @map("item_allow_freight")
  itemRandomStock      Boolean  @default(false) @map("item_random_stock")
  itemBarcodeSticker   Boolean  @default(false) @map("item_barcode_sticker")
  itemBarcodeStickerId String?  @db.Uuid @map("item_barcode_sticker_id")
  // Tax / HSN
  itemDefaultTaxId     String?  @db.Uuid @map("item_default_tax_id")
  itemHsnCode          String?  @db.VarChar(10) @map("item_hsn_code")
  // UI / misc
  itemBatchConfig      Int      @default(0) @map("item_batch_config")
  /// The stock.stock_track_preset the ITEM-scope stock_track_policy row is
  /// derived from. NULL = derive from itemBatchConfig / itemIsBatchBased /
  /// itemIsExpiryItem instead. The link is on the MASTER, never on the policy:
  /// the policy row still owns its own thirteen columns, so editing a preset
  /// changes nothing until this item is explicitly re-saved.
  itemTrackPresetId    String?  @db.Uuid @map("item_track_preset_id")
  itemSortOrder        Int?     @map("item_sort_order")
  itemPhoto            Bytes?   @map("item_photo")
  itemImageUrl         String?  @db.Text @map("item_image_url")
  itemNotes            String?  @db.VarChar(250) @map("item_notes")
  itemStorageLocation  String?  @db.VarChar(250) @map("item_storage_location")
  itemPackingItemIds   String[] @db.Uuid @map("item_packing_item_ids")
  itemInclTax   Boolean  @default(true) @map("item_incl_tax")
  // Tally identity — mirrors led_tally_* on AccLedgerMaster.
  // itemTallyGuid is uniquely indexed in the DB (ux_item_tally_guid,
  // partial on NOT NULL AND NOT deleted), so it is not @unique here.
  itemTallyName        String?  @db.VarChar(200) @map("item_tally_name")
  itemTallyGuid        String?  @db.VarChar(64) @map("item_tally_guid")
  itemTallyMasterId    BigInt?  @db.BigInt @map("item_tally_master_id")
  itemTallyAlterId     BigInt?  @db.BigInt @map("item_tally_alter_id")
  // Status / Audit
  itemIsActive         Boolean  @default(true)  @map("item_is_active")
  itemIsDeleted        Boolean  @default(false) @map("item_is_deleted")
  itemCreatedOn        DateTime @default(now()) @db.Timestamptz(6) @map("item_created_on")
  itemCreatedBy        String?  @db.VarChar(100) @map("item_created_by")
  itemModifiedOn       DateTime @default(now()) @db.Timestamptz(6) @map("item_modified_on")
  itemModifiedBy       String?  @db.VarChar(100) @map("item_modified_by")
  // Relations
  group                ItemGroupMaster @relation(fields: [itemGroupId], references: [itgId], onUpdate: Cascade, onDelete: Restrict)
  trackPreset          StockTrackPreset? @relation("ItemTrackPreset", fields: [itemTrackPresetId], references: [sptId], onUpdate: Cascade, onDelete: Restrict, map: "fk_item_track_preset")
  category             categoryMaster? @relation(fields: [itemCategoryId], references: [categoryId], onUpdate: Cascade, onDelete: SetNull)
  baseUnit             Unit?           @relation(fields: [itemBaseUnitId], references: [unit_id], onUpdate: Cascade, onDelete: Restrict)
  // Repointed at inventory.tax_rate_master by migration
  // 20260912110000_repoint_items_to_tax_rate_master. The FK keeps its
  // Prisma-default name, so only the table it references changed.
  defaultTax           TaxRateMaster? @relation(fields: [itemDefaultTaxId], references: [taxId], onUpdate: Cascade, onDelete: Restrict)
  prices               ItemPriceMaster[] @relation("ItemPrices")
  qtyPrices            ItemQtyPrice[] @relation("ItemQtyPrices")
  unitConversions      ItemUnitConversion[] @relation("ItemUnitConversions")
  reorders             ItemReorder[]
  taxHistory           ItemTaxHistory[]
  company              Company? @relation(fields: [itemCompanyId], references: [compId], onUpdate: Cascade, onDelete: Restrict)
  saleQuotationItems   SaleQuotationItem[]
  saleBillItems        SaleBillItem[]
  saleOrderItems       SaleOrderItem[]
  promotionSchemeItems PromotionSchemeItem[] @relation("PromotionItemItem")
  promotionSchemeSlabs PromotionSchemeSlab[] @relation("PromotionSlabFreeItem")
  loyaltySchemeItems   LoyaltySchemeItem[]   @relation("LoyaltyItemItem")
  loyaltySchemeSlabs   LoyaltySchemeSlab[]   @relation("LoyaltySlabItem")
  loyaltySchemeGifts   LoyaltySchemeGift[]   @relation("LoyaltyGiftItem")
  stockTrackPolicies   StockTrackPolicy[]    @relation("StockTrackPolicyItem")
  stockLots            StockLot[]            @relation("StockLotItem")
  stockLedgerEntries   StockLedger[]         @relation("StockLedgerItem")
  stockBalances        StockBalance[]        @relation("StockBalanceItem")
  stockItemCosts       StockItemCost[]       @relation("StockItemCostItem")
  stockVoucherItems    StockVoucherItem[]    @relation("StockVoucherItemItem")
  stockReservations    StockReservation[]    @relation("StockReservationItem")
  stockTransits        StockTransit[]        @relation("StockTransitItem")
  stockValuationSnaps  StockValuationSnap[]  @relation("StockValuationSnapItem")
  stockDemandDaily     StockDemandDaily[]    @relation("StockDemandDailyItem")
  stockReorderPolicies StockReorderPolicy[]  @relation("StockReorderPolicyItem")
  stockForecasts       StockForecast[]       @relation("StockForecastItem")
  stockMovementClasses StockMovementClass[]  @relation("StockMovementClassItem")
  // ── Loyalty points engine (20260921140000) ─────────────────────────────
  loyaltyGiftItems      LoyaltyGiftRedeemItem[]   @relation("LoyaltyGiftItemItem")

  // ── Sales documents (20260921200000) ────────────────────────────────────
  saleReturnItems       SaleReturnItem[]          @relation("SaleReturnItemItem")
  saleDcItems           SaleDcItem[]              @relation("SaleDcItemItem")
  saleDcReturnItems     SaleDcReturnItem[]        @relation("SaleDcReturnItemItem")

  @@map("item_master")
  @@schema("inventory")
  // UNIQUE item_name_en globally (since company removed)
  @@unique([itemNameEn], map: "uq_item_name_en_global")
  @@index([itemGroupId], map: "idx_item_group")
  @@index([itemNameEn], map: "idx_item_name_en")
  @@index([itemDefaultBarcode], map: "idx_item_barcode")
}