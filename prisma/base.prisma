generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "grid", "audit", "purchase", "sales", "settings", "fixed", "accounts", "inventory", "stock", "reports", "transport"]
}
generator dbml {
  provider   = "node node_modules/prisma-dbml-generator/dist/generator.js"
  output     = "../dbml"
  outputName = "awesome.dbml"
  projectName = "Project Name"
  projectDatabaseType = "PostgreSQL"
  projectNote = "Test project description"
}
generator docs {
  provider = "node node_modules/prisma-docs-generator"
  output = "../../docs"
}
