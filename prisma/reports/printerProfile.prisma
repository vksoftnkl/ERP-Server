/// reports.printer_profile — the escape-command dialect of one printer model.
///
/// Risk R6: the ESC/P and ESC/POS command sets differ by model family, and the
/// differences cannot be guessed from a datasheet. Rather than compile a
/// customer's printer quirks into the renderer, every raw renderer reads its
/// command bytes from a profile row. Onboarding a new printer model is then a
/// seed row, not a deploy.
///
/// pp_commands holds hex-encoded byte strings keyed by capability name, e.g.
///   { "init": "1B40", "draft": "1B7800", "boldOn": "1B45", ... }
/// Unknown keys are ignored; missing keys fall back to the built-in Epson
/// (ESC/P) or Epson TM (ESC/POS) defaults, so a sparse profile only has to
/// state what actually differs.
///
/// DB-only objects hand-authored in the migration:
///   ux_pp_code   UNIQUE (lower(pp_code)) WHERE NOT pp_is_deleted
model PrinterProfile {
  ppId            String   @id(map: "pk_printer_profile") @default(dbgenerated("uuidv7()")) @db.Uuid @map("pp_id")

  /// NULL = a stock profile shipped with the product.
  ppCompanyId     String?  @db.Uuid                                        @map("pp_company_id")

  ppCode          String   @db.VarChar(40)                                 @map("pp_code")
  ppName          String   @db.VarChar(120)                                @map("pp_name")
  /// ESCP_DOTMATRIX | ESCPOS
  ppOutputMode    String   @db.VarChar(20)                                 @map("pp_output_mode")
  /// Manufacturer family the command set derives from, e.g. EPSON_ESCP, TVS_MSP.
  ppFamily        String   @db.VarChar(40)                                 @map("pp_family")

  /// Printable character columns at the profile's default pitch.
  ppColumns       Int                                                      @map("pp_columns")
  /// Characters per inch for dot matrix (10/12/15); NULL for thermal.
  ppCpi           Int?                                                     @map("pp_cpi")
  /// Paper width in mm for thermal (58/80); NULL for dot matrix.
  ppPaperWidthMm  Int?                                                     @map("pp_paper_width_mm")
  /// Single-byte code page used to encode text, e.g. CP437, CP850, CP1252.
  ppCodepage      String   @default("CP437") @db.VarChar(20)               @map("pp_codepage")

  ppSupportsBold      Boolean @default(true)                               @map("pp_supports_bold")
  ppSupportsUnderline Boolean @default(true)                               @map("pp_supports_underline")
  ppSupportsCut       Boolean @default(false)                              @map("pp_supports_cut")
  ppSupportsGraphics  Boolean @default(false)                              @map("pp_supports_graphics")

  /// Capability name -> hex byte string. Sparse; merged over built-in defaults.
  ppCommands      Json?    @db.JsonB                                       @map("pp_commands")

  ppIsActive      Boolean  @default(true)                                  @map("pp_is_active")
  ppIsDeleted     Boolean  @default(false)                                 @map("pp_is_deleted")

  ppCreatedOn     DateTime  @default(now()) @db.Timestamptz(6)             @map("pp_created_on")
  ppCreatedBy     String?   @db.Uuid                                       @map("pp_created_by")
  ppModifiedOn    DateTime? @db.Timestamptz(6)                             @map("pp_modified_on")
  ppModifiedBy    String?   @db.Uuid                                       @map("pp_modified_by")

  @@map("printer_profile")
  @@schema("reports")
}
