/// reports.print_template — one band-based report design.
///
/// The design itself lives in pt_definition (jsonb), validated against the zod
/// schema in modules/reporting/templates/dto/template-definition.schema.ts.
/// It is deliberately NOT normalised into element/band tables: the designer
/// saves and loads it whole, the layout engine reads it whole, and nothing ever
/// queries inside it. pt_schema_ver is what makes that safe — every read runs
/// through TemplateMigrationService.migrateDefinition() first.
///
/// pt_company_id NULL = system template, shipped with the product and cloned
/// into a tenant before it can be edited. pt_branch_id NULL = applies to every
/// branch of that company.
///
/// DB-only objects Prisma cannot express, hand-authored in the migration:
///   ux_pt_default   UNIQUE NULLS NOT DISTINCT (company, branch, doc_type,
///                   output_mode, paper_code) WHERE pt_is_default AND NOT
///                   is_deleted. NULLS NOT DISTINCT is the whole point: without
///                   it Postgres treats every system template (company NULL) as
///                   distinct and lets a second default in. Needs PG15+.
///   ix_pt_lookup    the resolver's covering index, partial on
///                   (pt_is_active AND NOT is_deleted)
///   ix_pt_company / ix_pt_branch / ix_pt_parent   FK-covering, all partial
model PrintTemplate {
  ptId            String    @id(map: "pk_print_template") @default(dbgenerated("uuidv7()")) @db.Uuid @map("pt_id")

  /// NULL = system template.
  ptCompanyId     String?   @db.Uuid                                        @map("pt_company_id")
  /// NULL = every branch of the company.
  ptBranchId      String?   @db.Uuid                                        @map("pt_branch_id")

  ptDocType       String    @db.VarChar(40)                                 @map("pt_doc_type")
  ptOutputMode    String    @db.VarChar(20)                                 @map("pt_output_mode")
  ptPaperCode     String    @db.VarChar(20)                                 @map("pt_paper_code")
  ptName          String    @db.VarChar(120)                                @map("pt_name")

  /// Bumped on every definition write; the previous body lands in a revision row.
  ptVersion       Int       @default(1)                                     @map("pt_version")
  /// Set when this row was cloned from another template (usually a system one).
  ptParentId      String?   @db.Uuid                                        @map("pt_parent_id")
  /// Definition JSON schema version, migrated forward on read.
  ptSchemaVer     Int       @default(1)                                     @map("pt_schema_ver")

  ptDefinition    Json      @db.JsonB                                       @map("pt_definition")

  ptIsDefault     Boolean   @default(false)                                 @map("pt_is_default")
  ptIsActive      Boolean   @default(true)                                  @map("pt_is_active")
  ptIsDeleted     Boolean   @default(false)                                 @map("pt_is_deleted")

  ptCreatedOn     DateTime  @default(now()) @db.Timestamptz(6)              @map("pt_created_on")
  ptCreatedBy     String?   @db.Uuid                                        @map("pt_created_by")
  ptModifiedOn    DateTime? @db.Timestamptz(6)                              @map("pt_modified_on")
  ptModifiedBy    String?   @db.Uuid                                        @map("pt_modified_by")

  parent          PrintTemplate?         @relation("PrintTemplateLineage", fields: [ptParentId], references: [ptId], onDelete: Restrict, onUpdate: Cascade, map: "fk_pt_parent")
  clones          PrintTemplate[]        @relation("PrintTemplateLineage")
  revisions       PrintTemplateRevision[] @relation("PrintTemplateRevisions")

  @@map("print_template")
  @@schema("reports")
}

/// reports.print_template_revision — the body of every superseded version.
///
/// Written on the same transaction as the parent's version bump, so
/// (template, version) is a complete history with no gaps. Rollback reads a row
/// here and writes it back as a NEW version rather than rewinding the counter —
/// history stays append-only.
model PrintTemplateRevision {
  ptrId          String   @id(map: "pk_print_template_revision") @default(dbgenerated("uuidv7()")) @db.Uuid @map("ptr_id")
  ptrTemplateId  String   @db.Uuid                                         @map("ptr_template_id")
  ptrVersion     Int                                                       @map("ptr_version")
  ptrSchemaVer   Int      @default(1)                                      @map("ptr_schema_ver")
  ptrDefinition  Json     @db.JsonB                                        @map("ptr_definition")
  /// Free-text note, e.g. 'rollback to v3' or the designer's save label.
  ptrNote        String?  @db.VarChar(200)                                 @map("ptr_note")
  ptrCreatedOn   DateTime @default(now()) @db.Timestamptz(6)               @map("ptr_created_on")
  ptrCreatedBy   String?  @db.Uuid                                         @map("ptr_created_by")

  template       PrintTemplate @relation("PrintTemplateRevisions", fields: [ptrTemplateId], references: [ptId], onDelete: Cascade, onUpdate: Cascade, map: "fk_ptr_template")

  @@unique([ptrTemplateId, ptrVersion], map: "ux_ptr_template_version")
  @@map("print_template_revision")
  @@schema("reports")
}
