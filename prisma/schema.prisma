// ----- prisma/sales/promotionScheme.prisma -----
/// sales.promotion_scheme — §1, the campaign header.
///
/// Declared here WITHOUT any CHECK constraint: the vocabulary rules
/// (ck_prm_status, ck_prm_apply_on, ck_prm_benefit, ck_prm_stack_mode,
/// ck_prm_calc_on, ck_prm_bill_type, the three *_scope checks,
/// ck_prm_fixed_price_scope, ck_prm_dates, ck_prm_time_pair, ck_prm_weekdays,
/// ck_prm_priority, ck_prm_thresholds, ck_prm_caps, ck_prm_approved) are
/// enforced in PromotionSchemeService, not in the migration — same treatment
/// item_unit_conversion already gets.
///
/// DB-only objects Prisma cannot express, to be hand-authored in the migration:
///   ux_prm_code      UNIQUE (prm_comp_id, lower(prm_code)) WHERE NOT deleted
///   ix_prm_resolve   the per-bill resolver, covering, partial on
///                    (deleted = false AND active AND status = 'APPROVED')
///   ix_prm_company / ix_prm_branch / ix_prm_price_level /
///   ix_prm_coupon_batch / ix_prm_approved_by   FK-covering, all partial
///   ex_prm_exclusive_clash   EXCLUDE USING gist — two APPROVED, EXCLUSIVE
///                            campaigns on the same company/branch/trigger at
///                            the same priority may not overlap in date.
///                            Needs btree_gist.
model PromotionScheme {
  prmId                   String    @id(map: "pk_promotion_scheme") @default(dbgenerated("uuidv7()")) @db.Uuid @map("prm_id")
  prmCompId               String    @db.Uuid                                        @map("prm_comp_id")
  prmBranchId             String?   @db.Uuid                                        @map("prm_branch_id")
  prmTenantId             String?   @db.Uuid                                        @map("prm_tenant_id")

  prmCode                 String    @db.VarChar(30)                                 @map("prm_code")
  prmName                 String    @db.VarChar(150)                                @map("prm_name")
  prmStatus               String    @default("DRAFT") @db.VarChar(20)               @map("prm_status")

  // ── What it is ──────────────────────────────────────────────────────────
  prmApplyOn              String    @default("ITEM_QTY") @db.VarChar(20)            @map("prm_apply_on")
  prmBenefit              String    @default("DISC_PERC") @db.VarChar(20)           @map("prm_benefit")

  // ── Which one wins ──────────────────────────────────────────────────────
  prmPriority             Int       @default(1) @db.SmallInt                        @map("prm_priority")
  prmStackMode            String    @default("EXCLUSIVE") @db.VarChar(10)           @map("prm_stack_mode")
  prmAutoApply            Boolean   @default(true)                                  @map("prm_auto_apply")
  prmAllowWithManualDisc  Boolean   @default(false)                                 @map("prm_allow_with_manual_disc")

  // ── What it is measured on ──────────────────────────────────────────────
  prmCalcOnAmountType     String    @default("NET_AMOUNT") @db.VarChar(20)          @map("prm_calc_on_amount_type")
  prmIncludeTax           Boolean   @default(false)                                 @map("prm_include_tax")
  prmBillType             String    @default("ALL") @db.VarChar(20)                 @map("prm_bill_type")
  prmMinBillAmount        Decimal   @default(0) @db.Decimal(18, 2)                  @map("prm_min_bill_amount")
  prmMinQty               Decimal   @default(0) @db.Decimal(18, 3)                  @map("prm_min_qty")

  // ── Scope switches: 'ALL' = everything, 'LIST' = read the child table ────
  prmBranchScope          String    @default("ALL") @db.VarChar(10)                 @map("prm_branch_scope")
  prmCustScope            String    @default("ALL") @db.VarChar(10)                 @map("prm_cust_scope")
  prmItemScope            String    @default("ALL") @db.VarChar(10)                 @map("prm_item_scope")
  prmPriceLevelId         Int?                                                      @map("prm_price_level_id")

  // ── Caps, counted by the usage tally ────────────────────────────────────
  prmMaxBenefitPerBill    Decimal   @default(0) @db.Decimal(18, 2)                  @map("prm_max_benefit_per_bill")
  prmMaxUsesTotal         Int       @default(0)                                     @map("prm_max_uses_total")
  prmMaxUsesPerCust       Int       @default(0)                                     @map("prm_max_uses_per_cust")
  prmBudgetAmount         Decimal   @default(0) @db.Decimal(18, 2)                  @map("prm_budget_amount")

  // Points at sales.loyalty_coupon_batch(lcb_id). NO Prisma relation and no FK
  // yet: that table is not in this schema. Add fk_prm_coupon_batch and the
  // relation field when the coupon-batch model lands.
  prmCouponBatchId        String?   @db.Uuid                                        @map("prm_coupon_batch_id")

  // ── When it runs ────────────────────────────────────────────────────────
  prmStartDate            DateTime  @db.Date                                        @map("prm_start_date")
  prmEndDate              DateTime  @db.Date                                        @map("prm_end_date")
  prmValidFromTime        DateTime? @db.Time(6)                                     @map("prm_valid_from_time")
  prmValidToTime          DateTime? @db.Time(6)                                     @map("prm_valid_to_time")
  prmValidWeekdays        String?   @db.VarChar(30)                                 @map("prm_valid_weekdays")

  prmRemarks              String?   @db.Text                                        @map("prm_remarks")
  prmIsActive             Boolean   @default(true)                                  @map("prm_is_active")
  prmIsDeleted            Boolean   @default(false)                                 @map("prm_is_deleted")
  prmSyncDate             DateTime? @db.Timestamptz(6)                              @map("prm_sync_date")
  prmCreatedOn            DateTime  @default(now()) @db.Timestamptz(6)              @map("prm_created_on")
  prmCreatedBy            String?   @db.VarChar(50)                                 @map("prm_created_by")
  prmModifiedOn           DateTime? @db.Timestamptz(6)                              @map("prm_modified_on")
  prmModifiedBy           String?   @db.VarChar(50)                                 @map("prm_modified_by")
  prmApprovedOn           DateTime? @db.Timestamptz(6)                              @map("prm_approved_on")
  prmApprovedBy           String?   @db.Uuid                                        @map("prm_approved_by")

  // ── Relations ───────────────────────────────────────────────────────────
  company                 Company        @relation("PromotionSchemeCompany",    fields: [prmCompId],       references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_prm_company")
  branch                  BranchMaster?  @relation("PromotionSchemeBranchRef",  fields: [prmBranchId],     references: [brId],   onUpdate: Cascade, onDelete: Restrict, map: "fk_prm_branch")
  priceLevel              ItemPriceLevel? @relation("PromotionSchemePriceLevel", fields: [prmPriceLevelId], references: [iplId], onUpdate: Cascade, onDelete: Restrict, map: "fk_prm_price_level")
  approvedBy              UserMaster?    @relation("PromotionSchemeApprovedBy", fields: [prmApprovedBy],   references: [usrId], onUpdate: Cascade, onDelete: Restrict, map: "fk_prm_approved_by")

  branches                PromotionSchemeBranch[] @relation("PromotionSchemeBranches")
  parties                 PromotionSchemeParty[]  @relation("PromotionSchemeParties")
  items                   PromotionSchemeItem[]   @relation("PromotionSchemeItems")
  slabs                   PromotionSchemeSlab[]   @relation("PromotionSchemeSlabs")

  // Not a rule anybody needs in its own right — prmId is already unique — but
  // the target of the slab's composite FK, and therefore the only way to make
  // the database refuse a free-item band on a percentage scheme.
  @@unique([prmId, prmBenefit], map: "uq_prm_benefit")
  @@map("promotion_scheme")
  @@schema("sales")
}

// ----- prisma/sales/promotionSchemeBranch.prisma -----
/// sales.promotion_scheme_branch — §2, which branches run the campaign.
///
/// Read only when prm_branch_scope = 'LIST'. prbIsExclude makes "every branch
/// except two" two rows rather than thirty-eight; an EXCLUDE row always beats
/// an INCLUDE row for the same branch.
///
/// CHECK ck_prb_slno (prb_slno > 0) is enforced in the service, not the DB.
///
/// DB-only objects to hand-author in the migration:
///   ux_prb_row     UNIQUE (prb_prm_id, prb_branch_id) WHERE NOT deleted
///   ix_prb_scheme  (prb_prm_id) INCLUDE (branch, is_exclude), partial
///   ix_prb_branch  (prb_branch_id), partial
model PromotionSchemeBranch {
  prbId          String    @id(map: "pk_promotion_scheme_branch") @default(dbgenerated("uuidv7()")) @db.Uuid @map("prb_id")
  prbPrmId       String    @db.Uuid                                       @map("prb_prm_id")
  prbSlno        Int       @default(1)                                    @map("prb_slno")
  prbBranchId    String    @db.Uuid                                       @map("prb_branch_id")
  prbIsExclude   Boolean   @default(false)                                @map("prb_is_exclude")
  prbNotes       String?   @db.Text                                       @map("prb_notes")
  prbIsActive    Boolean   @default(true)                                 @map("prb_is_active")
  prbIsDeleted   Boolean   @default(false)                                @map("prb_is_deleted")
  prbSyncDate    DateTime? @db.Timestamptz(6)                             @map("prb_sync_date")
  prbCreatedOn   DateTime  @default(now()) @db.Timestamptz(6)             @map("prb_created_on")
  prbCreatedBy   String?   @db.VarChar(50)                                @map("prb_created_by")
  prbModifiedOn  DateTime? @db.Timestamptz(6)                             @map("prb_modified_on")
  prbModifiedBy  String?   @db.VarChar(50)                                @map("prb_modified_by")

  scheme         PromotionScheme @relation("PromotionSchemeBranches",     fields: [prbPrmId],    references: [prmId], onUpdate: Cascade, onDelete: Cascade,  map: "fk_prb_scheme")
  branch         BranchMaster    @relation("PromotionSchemeBranchBranch", fields: [prbBranchId], references: [brId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_prb_branch")

  @@map("promotion_scheme_branch")
  @@schema("sales")
}

// ----- prisma/sales/promotionSchemeItem.prisma -----
/// sales.promotion_scheme_item — §4, which stock the campaign applies to.
///
/// One kind + one scope id, with five GENERATED ALWAYS ... STORED columns
/// carrying the foreign keys — the same shape as PromotionSchemeParty, read
/// that model's header for the write rules and the migration caveat. In short:
/// set priKind + priScopeId (+ priUnitId on an ITEM row) and never touch
/// itemId / groupId / categoryId / brandId / sectionId.
///
/// This is what makes "20% off own-brand, but nothing on tobacco" ONE scheme.
///
/// priMatchPriority: most specific wins. Seed ITEM 4, BRAND 3, CATEGORY 2,
/// SECTION 1, GROUP 0 — data, not a hard-coded rule. An EXCLUDE row kills the
/// line regardless of any broader rule.
///
/// Read only when prm_item_scope = 'LIST'.
///
/// ── The discount trio ───────────────────────────────────────────────────
/// A rate may be stated here, on the item row, instead of on a slab band —
/// that is all "Discount On Items (Offer Per Item)" ever was. Stored in the
/// bill's own idiom because they are copied straight onto
/// sbi_sch_disc_perc / _qty / _amt:
///     priDiscPerc  percentage off the line
///     priDiscQty   rupees off PER UNIT
///     priDiscAmt   flat rupees off the line
/// At most one is non-zero. All three zero = this row only says "in scope".
///
/// A unit is REQUIRED on an ITEM row and FORBIDDEN on every other kind:
/// "10 of item X" is not a quantity until you say ten of WHAT, and a unit is a
/// row of item_unit_conversion keyed to one item, so on a BRAND or CATEGORY
/// row it would claim to apply to items that never define it.
///
/// CHECK ck_pri_kind, ck_pri_unit, ck_pri_one_rate, ck_pri_exclude,
/// ck_pri_values, ck_pri_slno and ck_pri_match_priority are enforced in the
/// service, not the DB.
///
/// DB-only objects to hand-author:
///   ux_pri_row     UNIQUE (prm_id, kind, scope_id) WHERE NOT deleted
///   ix_pri_scheme  (prm_id, match_priority DESC) INCLUDE (...), partial
///   ix_pri_item / _group / _category / _brand / _section / _unit, all partial
model PromotionSchemeItem {
  priId            String    @id(map: "pk_promotion_scheme_item") @default(dbgenerated("uuidv7()")) @db.Uuid @map("pri_id")
  priPrmId         String    @db.Uuid                                       @map("pri_prm_id")
  priSlno          Int       @default(1)                                    @map("pri_slno")

  // The GRID COLUMNS.
  priKind          String    @db.VarChar(20)                                @map("pri_kind")
  priScopeId       String    @db.Uuid                                       @map("pri_scope_id")

  // GENERATED ALWAYS ... STORED. Read-only.
  priItemId        String?   @default(dbgenerated()) @db.Uuid               @map("pri_item_id")
  priGroupId       String?   @default(dbgenerated()) @db.Uuid               @map("pri_group_id")
  priCategoryId    String?   @default(dbgenerated()) @db.Uuid               @map("pri_category_id")
  priBrandId       String?   @default(dbgenerated()) @db.Uuid               @map("pri_brand_id")
  priSectionId     String?   @default(dbgenerated()) @db.Uuid               @map("pri_section_id")

  // Written normally. NOT NULL when priKind = 'ITEM', NULL for every other kind.
  priUnitId        String?   @db.Uuid                                       @map("pri_unit_id")

  priIsExclude     Boolean   @default(false)                                @map("pri_is_exclude")

  priDiscPerc      Decimal   @default(0) @db.Decimal(18, 4)                 @map("pri_disc_perc")
  priDiscQty       Decimal   @default(0) @db.Decimal(18, 4)                 @map("pri_disc_qty")
  priDiscAmt       Decimal   @default(0) @db.Decimal(18, 2)                 @map("pri_disc_amt")

  priMinQty        Decimal   @default(0) @db.Decimal(18, 3)                 @map("pri_min_qty")
  priFactor        Decimal   @default(1) @db.Decimal(18, 4)                 @map("pri_factor")
  priMaxBenefit    Decimal   @default(0) @db.Decimal(18, 2)                 @map("pri_max_benefit")
  priMatchPriority Int       @default(1) @db.SmallInt                       @map("pri_match_priority")
  priNotes         String?   @db.Text                                       @map("pri_notes")
  priIsActive      Boolean   @default(true)                                 @map("pri_is_active")
  priIsDeleted     Boolean   @default(false)                                @map("pri_is_deleted")
  priSyncDate      DateTime? @db.Timestamptz(6)                             @map("pri_sync_date")
  priCreatedOn     DateTime  @default(now()) @db.Timestamptz(6)             @map("pri_created_on")
  priCreatedBy     String?   @db.VarChar(50)                                @map("pri_created_by")
  priModifiedOn    DateTime? @db.Timestamptz(6)                             @map("pri_modified_on")
  priModifiedBy    String?   @db.VarChar(50)                                @map("pri_modified_by")

  scheme           PromotionScheme     @relation("PromotionSchemeItems",     fields: [priPrmId],      references: [prmId],      onUpdate: Cascade,  onDelete: Cascade,  map: "fk_pri_scheme")
  item             ItemMaster?         @relation("PromotionItemItem",        fields: [priItemId],     references: [itemId],     onUpdate: NoAction, onDelete: Restrict, map: "fk_pri_item")
  itemGroup        ItemGroupMaster?    @relation("PromotionItemGroup",       fields: [priGroupId],    references: [itgId],      onUpdate: NoAction, onDelete: Restrict, map: "fk_pri_group")
  itemCategory     categoryMaster?     @relation("PromotionItemCategory",    fields: [priCategoryId], references: [categoryId], onUpdate: NoAction, onDelete: Restrict, map: "fk_pri_category")
  itemBrand        ItemBrandMaster?    @relation("PromotionItemBrand",       fields: [priBrandId],    references: [brand_id],   onUpdate: NoAction, onDelete: Restrict, map: "fk_pri_brand")
  itemSection      ItemSectionMaster?  @relation("PromotionItemSection",     fields: [priSectionId],  references: [secId],      onUpdate: NoAction, onDelete: Restrict, map: "fk_pri_section")
  unit             ItemUnitConversion? @relation("PromotionItemUnit",        fields: [priUnitId],     references: [iucId],      onUpdate: Cascade,  onDelete: Restrict, map: "fk_pri_unit")

  @@map("promotion_scheme_item")
  @@schema("sales")
}

// ----- prisma/sales/promotionSchemeParty.prisma -----
/// sales.promotion_scheme_party — §3, who the campaign applies to.
///
/// ONE KIND + ONE SCOPE ID, the shape the entry grid needs. The screen binds
/// to exactly two columns, prpKind and prpScopeId; the four *_id fields below
/// are GENERATED ALWAYS ... STORED in Postgres and exist only to carry a real
/// foreign key per kind.
///
///     prpKind = 'CUSTOMER' | 'CUSTOMER_GROUP' | 'AREA' | 'CITY'
///
/// CITY reaches a customer THROUGH THEIR AREA and only that way
/// (customers.cus_area_id -> area_master.arm_city_id -> city_master.ctm_id);
/// customers.cus_city is free text and must never be matched on. A customer
/// with no area is in no city.
///
/// prpMatchPriority makes "a rule naming one CUSTOMER beats one naming their
/// CITY" data rather than an assumption: CUSTOMER 4, AREA 3, CITY 2,
/// CUSTOMER_GROUP 1 — narrowest first. EXCLUDE beats INCLUDE at equal priority.
///
/// Read only when prm_cust_scope = 'LIST'.
///
/// ── WRITING THIS MODEL ──────────────────────────────────────────────────
/// NEVER set custId / custGroupId / areaId / cityId, and never use the four
/// nested `connect`s. Postgres computes those columns and rejects any write.
/// Set prpKind + prpScopeId; read the relations back.
///
/// ── MIGRATION ───────────────────────────────────────────────────────────
/// prisma migrate cannot emit a generated column. The four must be
/// hand-authored, e.g.
///   prp_cust_id uuid GENERATED ALWAYS AS
///     (CASE WHEN prp_kind::text = 'CUSTOMER' THEN prp_scope_id END) STORED
/// The `@default(dbgenerated())` below is the no-argument form: it stops every
/// later `migrate dev` emitting an ALTER COLUMN ... DROP DEFAULT that Postgres
/// rejects with 42601 on a generated column.
///
/// The FKs are ON UPDATE NO ACTION, not CASCADE — Postgres forbids a cascading
/// update on a key containing a generated column. Costs nothing: every master
/// key here is a uuidv7() that is never reissued.
///
/// CHECK ck_prp_kind, ck_prp_slno and ck_prp_match_priority are enforced in the
/// service, not the DB.
///
/// DB-only objects to hand-author:
///   ux_prp_row       UNIQUE (prm_id, kind, scope_id) WHERE NOT deleted
///   ix_prp_scheme    (prm_id, match_priority DESC) INCLUDE (...), partial
///   ix_prp_cust / ix_prp_cust_group / ix_prp_area / ix_prp_city, all partial
model PromotionSchemeParty {
  prpId            String    @id(map: "pk_promotion_scheme_party") @default(dbgenerated("uuidv7()")) @db.Uuid @map("prp_id")
  prpPrmId         String    @db.Uuid                                       @map("prp_prm_id")
  prpSlno          Int       @default(1)                                    @map("prp_slno")

  // The GRID COLUMNS — the only two the form reads and writes.
  prpKind          String    @db.VarChar(20)                                @map("prp_kind")
  prpScopeId       String    @db.Uuid                                       @map("prp_scope_id")

  // GENERATED ALWAYS ... STORED. Read-only. See the note above.
  prpCustId        String?   @default(dbgenerated()) @db.Uuid               @map("prp_cust_id")
  prpCustGroupId   String?   @default(dbgenerated()) @db.Uuid               @map("prp_cust_group_id")
  prpAreaId        String?   @default(dbgenerated()) @db.Uuid               @map("prp_area_id")
  prpCityId        String?   @default(dbgenerated()) @db.Uuid               @map("prp_city_id")

  prpIsExclude     Boolean   @default(false)                                @map("prp_is_exclude")
  prpMatchPriority Int       @default(1) @db.SmallInt                       @map("prp_match_priority")
  prpNotes         String?   @db.Text                                       @map("prp_notes")
  prpIsActive      Boolean   @default(true)                                 @map("prp_is_active")
