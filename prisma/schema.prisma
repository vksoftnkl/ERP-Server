model ItemBatchStock {
  // Primary
  ibsId               String          @id @default(dbgenerated("uuidv7()")) @db.Uuid @map("ibs_id")

  // Multi-branch
  ibsAccYear          String          @db.VarChar(9) @map("ibs_acc_year")
  ibsCompanyId        String          @db.Uuid @map("ibs_company_id")
  ibsBranchId         String          @db.Uuid @map("ibs_branch_id")
  ibsGodownId         String          @db.Uuid @map("ibs_godown_id")

  // Item / batch
  ibsItemId           String          @db.Uuid @map("ibs_item_id")
  ibsUnitId           String          @db.Uuid @map("ibs_unit_id")
  ibsBatchId          String          @db.Uuid @map("ibs_batch_id")

  // Optional display snapshots
  ibsBatchNo          String?         @db.VarChar(100) @map("ibs_batch_no")
  ibsSerialNo         String?         @db.VarChar(100) @map("ibs_serial_no")
  ibsMfgDate          DateTime?       @db.Date @map("ibs_mfg_date")
  ibsExpiryDate       DateTime?       @db.Date @map("ibs_expiry_date")
  ibsMrp              Decimal         @default(0) @db.Decimal(18, 6) @map("ibs_mrp")
  ibsStockBucket      String          @default("SALEABLE") @db.VarChar(20) @map("ibs_stock_bucket")

  // Normal qty
  ibsOpeningQty       Decimal         @default(0) @db.Decimal(18, 6) @map("ibs_opening_qty")
  ibsInQty            Decimal         @default(0) @db.Decimal(18, 6) @map("ibs_in_qty")
  ibsOutQty           Decimal         @default(0) @db.Decimal(18, 6) @map("ibs_out_qty")
  ibsClosingQty       Decimal         @default(0) @db.Decimal(18, 6) @map("ibs_closing_qty")

  // Free qty
  ibsOpeningFreeQty   Decimal         @default(0) @db.Decimal(18, 6) @map("ibs_opening_free_qty")
  ibsFreeInQty        Decimal         @default(0) @db.Decimal(18, 6) @map("ibs_free_in_qty")
  ibsFreeOutQty       Decimal         @default(0) @db.Decimal(18, 6) @map("ibs_free_out_qty")
  ibsFreeClosingQty   Decimal         @default(0) @db.Decimal(18, 6) @map("ibs_free_closing_qty")

  // Allocation
  ibsReservedQty      Decimal         @default(0) @db.Decimal(18, 6) @map("ibs_reserved_qty")
  ibsAvailableQty     Decimal         @default(0) @db.Decimal(18, 6) @map("ibs_available_qty")

  // Valuation
  ibsOpeningAvgRate   Decimal         @default(0) @db.Decimal(18, 6) @map("ibs_opening_avg_rate")
  ibsAvgStockRate     Decimal         @default(0) @db.Decimal(18, 6) @map("ibs_avg_stock_rate")
  ibsOpeningValue     Decimal         @default(0) @db.Decimal(18, 2) @map("ibs_opening_value")
  ibsStockValue       Decimal         @default(0) @db.Decimal(18, 2) @map("ibs_stock_value")

  // Helper dates / refs
  ibsLastInDate       DateTime?       @db.Date @map("ibs_last_in_date")
  ibsLastOutDate      DateTime?       @db.Date @map("ibs_last_out_date")

  // Status
  ibsIsActive         Boolean         @default(true) @map("ibs_is_active")
  ibsIsDeleted        Boolean         @default(true) @map("ibs_is_deleted")
  ibsRowVersion       BigInt          @default(1) @map("ibs_row_version")

  // Audit
  ibsCreatedOn        DateTime        @default(now()) @db.Timestamptz(6) @map("ibs_created_on")
  ibsCreatedBy        String?         @db.Uuid @map("ibs_created_by")
  ibsUpdatedOn        DateTime?       @db.Timestamptz(6) @map("ibs_updated_on")
  ibsUpdatedBy        String?         @db.Uuid @map("ibs_updated_by")

  // Relations
  batch               ItemBatchMaster @relation(fields: [ibsBatchId], references: [btmId], map: "fk_ibs_batch")

  @@unique([ibsAccYear, ibsCompanyId, ibsBranchId, ibsGodownId, ibsItemId, ibsBatchId, ibsStockBucket], map: "uq_ibs_scope")

  @@index([ibsAccYear, ibsCompanyId, ibsBranchId, ibsItemId], map: "idx_ibs_item")
  @@index([ibsAccYear, ibsCompanyId, ibsBranchId, ibsGodownId, ibsBatchId], map: "idx_ibs_batch")
  // Partial indexes `idx_ibs_expiry` and `idx_ibs_nonzero_stock` are maintained
  // in SQL because Prisma schema cannot express filtered indexes.

  @@map("item_batch_stock")
  @@schema("inventory")
}

