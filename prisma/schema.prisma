  itemPrices         ItemPriceMaster[]   @relation("ItemPriceMasterUnitConversion")
  itemQtyPrices      ItemQtyPrice[]      @relation("ItemQtyPriceUnitConversion")
  promotionSchemeItems PromotionSchemeItem[] @relation("PromotionItemUnit")
  promotionSchemeSlabs PromotionSchemeSlab[] @relation("PromotionSlabFreeUnit")
  loyaltySchemeSlabs   LoyaltySchemeSlab[]   @relation("LoyaltySlabUnit")
  loyaltySchemeGifts   LoyaltySchemeGift[]   @relation("LoyaltyGiftUnit")
  stockLotsBaseUom     StockLot[]            @relation("StockLotBaseUom")
  stockLedgerUom       StockLedger[]         @relation("StockLedgerUom")
  stockLedgerBaseUom   StockLedger[]         @relation("StockLedgerBaseUom")
  stockBalanceBaseUom  StockBalance[]        @relation("StockBalanceBaseUom")
  stockItemCostBaseUom StockItemCost[]       @relation("StockItemCostBaseUom")
  stockVoucherItemUom  StockVoucherItem[]    @relation("StockVoucherItemUom")
  stockVoucherItemBaseUom StockVoucherItem[] @relation("StockVoucherItemBaseUom")
  stockReservationBaseUom StockReservation[] @relation("StockReservationBaseUom")
  stockTransitBaseUom  StockTransit[]        @relation("StockTransitBaseUom")
  stockDemandDailyBaseUom StockDemandDaily[] @relation("StockDemandDailyBaseUom")
