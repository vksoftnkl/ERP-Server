  physicalStockHeader PhysicalStockHeader @relation("PhysicalStockHeaderBatchDetails", fields: [psbPshId], references: [psId], onUpdate: Cascade, onDelete: Restrict)
  company             Company             @relation("PhysicalStockBatchDetailCompany", fields: [psbCompanyId], references: [compId])
  branch              BranchMaster        @relation("PhysicalStockBatchDetailBranch", fields: [psbBranchId], references: [brId])
  godown              GodownLocation      @relation("PhysicalStockBatchDetailGodown", fields: [psbGodownId], references: [gdlId], onUpdate: Cascade, onDelete: Restrict)

  item ItemMaster @relation("PhysicalStockBatchDetailItem", fields: [psbItemId], references: [itemId])

  unit     Unit @relation("PhysicalStockBatchDetailUnit", fields: [psbUnitId], references: [unit_id], onUpdate: Cascade, onDelete: Restrict)
  baseUnit Unit @relation("PhysicalStockBatchDetailBaseUnit", fields: [psbBaseUnitId], references: [unit_id], onUpdate: Cascade, onDelete: Restrict)

  batch ItemBatchMaster? @relation("PhysicalStockBatchDetailBatch", fields: [psbBatchId], references: [btmId])

