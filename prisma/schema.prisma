  psbCreatedBy  String?  @map("psb_created_by") @db.Uuid
  psbModifiedOn DateTime @default(now()) @updatedAt @map("psb_modified_on") @db.Timestamptz(6)
  psbModifiedBy String?  @map("psb_modified_by") @db.Uuid

