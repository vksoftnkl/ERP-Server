// ----- prisma/inventory/ItemStockBalance.prisma -----
model ItemStockBalance {
  // Primary
  isbId String @id @default(dbgenerated("uuidv7()")) @map("isb_id") @db.Uuid

  // Multi-branch / scope
  isbAccYear   String @map("isb_acc_year") @db.VarChar(9)
  isbCompanyId String @map("isb_company_id") @db.Uuid
  isbBranchId  String @map("isb_branch_id") @db.Uuid
  isbGodownId  String @map("isb_godown_id") @db.Uuid

  // Item — validated at app level (ItemStockBalanceTrackingType, ItemStockBucket)
  isbItemId       String @map("isb_item_id") @db.Uuid
  isbUnitId       String @map("isb_unit_id") @db.Uuid
  isbTrackingType String @default("NONE") @map("isb_tracking_type") @db.VarChar(20)
  isbStockBucket  String @default("SALEABLE") @map("isb_stock_bucket") @db.VarChar(20)

  // Normal qty
  isbOpeningQty Decimal @default(0) @map("isb_opening_qty") @db.Decimal(18, 6)
  isbInQty      Decimal @default(0) @map("isb_in_qty") @db.Decimal(18, 6)
  isbOutQty     Decimal @default(0) @map("isb_out_qty") @db.Decimal(18, 6)
  isbClosingQty Decimal @default(0) @map("isb_closing_qty") @db.Decimal(18, 6)

  // Free qty
  isbOpeningFreeQty Decimal @default(0) @map("isb_opening_free_qty") @db.Decimal(18, 6)
  isbFreeInQty      Decimal @default(0) @map("isb_free_in_qty") @db.Decimal(18, 6)
  isbFreeOutQty     Decimal @default(0) @map("isb_free_out_qty") @db.Decimal(18, 6)
  isbFreeClosingQty Decimal @default(0) @map("isb_free_closing_qty") @db.Decimal(18, 6)

  // Allocation / availability
  isbReservedQty  Decimal @default(0) @map("isb_reserved_qty") @db.Decimal(18, 6)
  isbTransitQty   Decimal @default(0) @map("isb_transit_qty") @db.Decimal(18, 6)
  isbAvailableQty Decimal @default(0) @map("isb_available_qty") @db.Decimal(18, 6)

  // Valuation
  isbOpeningAvgRate Decimal @default(0) @map("isb_opening_avg_rate") @db.Decimal(18, 6)
  isbAvgStockRate   Decimal @default(0) @map("isb_avg_stock_rate") @db.Decimal(18, 6)
  isbOpeningValue   Decimal @default(0) @map("isb_opening_value") @db.Decimal(18, 2)
  isbStockValue     Decimal @default(0) @map("isb_stock_value") @db.Decimal(18, 2)

  // Valuationwot
  isbOpeningAvgRateWot Decimal @default(0) @map("isb_opening_avg_rate_wot") @db.Decimal(18, 6)
  isbAvgStockRateWot   Decimal @default(0) @map("isb_avg_stock_rate_wot") @db.Decimal(18, 6)
  isbOpeningValueWot   Decimal @default(0) @map("isb_opening_value_wot") @db.Decimal(18, 2)
  isbStockValueWot     Decimal @default(0) @map("isb_stock_value_wot") @db.Decimal(18, 2)

  // Helper / reconciliation
  isbLastInDate  DateTime? @map("isb_last_in_date") @db.Date
  isbLastOutDate DateTime? @map("isb_last_out_date") @db.Date

  // Audit
  isbSyncDate  DateTime? @map("isb_sync_date") @db.Timestamptz(6)
  isbCreatedOn DateTime  @default(now()) @map("isb_created_on") @db.Timestamptz(6)
  isbCreatedBy String?   @map("isb_created_by") @db.Uuid
  isbUpdatedOn DateTime? @map("isb_updated_on") @db.Timestamptz(6)
  isbUpdatedBy String?   @map("isb_updated_by") @db.Uuid
  // Partial index `idx_isb_nonzero_stock` is maintained in SQL because Prisma
  // schema cannot express the nonzero-stock predicate.

  @@unique([isbAccYear, isbCompanyId, isbBranchId, isbGodownId, isbItemId, isbUnitId, isbStockBucket], map: "uq_isb_balance_scope")
  @@index([isbAccYear, isbCompanyId, isbBranchId, isbItemId], map: "idx_isb_item")
  @@index([isbAccYear, isbCompanyId, isbBranchId, isbGodownId], map: "idx_isb_godown")
  @@map("item_stock_balance")
  @@schema("inventory")
}

// ----- prisma/inventory/ItemStockLedger.prisma -----
model ItemStockLedger {
  stlId String @id @default(dbgenerated("uuidv7()")) @map("stl_id") @db.Uuid

  // Multi-branch snapshot
  stlAccYear   String @map("stl_acc_year") @db.VarChar(9)
  stlCompanyId String @map("stl_company_id") @db.Uuid
  stlBranchId  String @map("stl_branch_id") @db.Uuid
  stlGodownId  String @map("stl_godown_id") @db.Uuid

  // Source voucher link
  stlVoucherId     String   @map("stl_voucher_id") @db.Uuid
  stlVoucherDate   DateTime @map("stl_voucher_date") @db.Timestamptz(6)
  stlLineNo        Int      @default(1) @map("stl_line_no")
  stlSplitNo       Int      @default(1) @map("stl_split_no")
  stlVoucherTypeId Int      @map("stl_voucher_type_id")

  // Posting / classification — validated at app level (StockTxnType)
  stlTxnType     String   @map("stl_txn_type") @db.VarChar(30)
  stlStockEffect Int      @map("stl_stock_effect") @db.SmallInt
  stlDocDate     DateTime @map("stl_doc_date") @db.Date
  stlPostedOn    DateTime @default(now()) @map("stl_posted_on") @db.Timestamptz(6)
  stlDocRefNo    String?  @map("stl_doc_ref_no") @db.VarChar(50)

  // Item snapshot
  stlItemId       String @map("stl_item_id") @db.Uuid
  stlTrackingType String @default("NONE") @map("stl_tracking_type") @db.VarChar(20)

  // UOM snapshot
  stlUomId            String  @map("stl_uom_id") @db.Uuid
  stlBaseUomId        String  @map("stl_base_uom_id") @db.Uuid
  stlConversionFactor Decimal @default(1) @map("stl_conversion_factor") @db.Decimal(18, 6)

  // Batch snapshot
  stlBatchId    String?   @map("stl_batch_id") @db.Uuid
  stlBatchNo    String?   @map("stl_batch_no") @db.VarChar(100)
  stlMfgDate    DateTime? @map("stl_mfg_date") @db.Date
  stlExpiryDate DateTime? @map("stl_expiry_date") @db.Date

  // Entered quantity
  stlQty         Decimal @default(0) @map("stl_qty") @db.Decimal(18, 6)
  stlBaseQty     Decimal @default(0) @map("stl_base_qty") @db.Decimal(18, 6)
  stlFreeQty     Decimal @default(0) @map("stl_free_qty") @db.Decimal(18, 6)
  stlFreeBaseQty Decimal @default(0) @map("stl_free_base_qty") @db.Decimal(18, 6)

  // Inventory valuation
  stlStockRate       Decimal @default(0) @map("stl_stock_rate") @db.Decimal(18, 6)
  stlStockValue      Decimal @default(0) @map("stl_stock_value") @db.Decimal(18, 2)
  stlLandedCostRate  Decimal @default(0) @map("stl_landed_cost_rate") @db.Decimal(18, 6)
  stlLandedCostValue Decimal @default(0) @map("stl_landed_cost_value") @db.Decimal(18, 2)

  // Commercial snapshot
  stlDocRateWot   Decimal @default(0) @map("stl_doc_rate_wot") @db.Decimal(18, 6)
  stlDocAmountWot Decimal @default(0) @map("stl_doc_amount_wot") @db.Decimal(18, 2)

  // Remarks
  stlNarration String? @map("stl_narration")

  // Sync / audit
  stlIsActive  Boolean   @default(true) @map("stl_is_active")
  stlIsDeleted Boolean   @default(false) @map("stl_is_deleted")
  stlSyncedOn  DateTime? @map("stl_synced_on") @db.Timestamptz(6)
  stlCreatedOn DateTime  @default(now()) @map("stl_created_on") @db.Timestamptz(6)
  stlCreatedBy String?   @map("stl_created_by") @db.Uuid

  // Partial indexes `idx_stl_item` and `idx_stl_voucher` are maintained in SQL
  // with `WHERE stl_is_deleted = false`, which Prisma schema cannot express.

  @@unique([stlVoucherId, stlLineNo, stlSplitNo, stlGodownId, stlBatchId], map: "uq_stl_source_line_split")
  @@map("item_stock_ledger")
  @@schema("inventory")
}

