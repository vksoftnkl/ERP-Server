  brand_name        String  @unique @db.VarChar(150)
  brand_alias       String? @db.VarChar(150)
  brand_short       String? @db.VarChar(50)
  brand_description String? @db.VarChar(250)

  brand_photo     Bytes?
  brand_photo_url String?

  brand_parent_id String?  @db.Uuid
  brand_sort      Int?
  brand_level     Int?
  brand_path_ids  String[] @default([]) @db.Uuid

  brand_is_active  Boolean @default(true)
  brand_is_deleted Boolean @default(false)

  brand_sync_date   DateTime? @db.Timestamptz(6)
  brand_created_on  DateTime  @default(now()) @db.Timestamptz(6)
  brand_created_by  String?   @db.VarChar(100)
  brand_modified_on DateTime  @default(now()) @db.Timestamptz(6)
  brand_modified_by String?   @db.VarChar(100)

  // self relation (parent -> children)
  parent   ItemBrandMaster?  @relation("BrandHierarchy", fields: [brand_parent_id], references: [brand_id], onUpdate: Cascade, onDelete: Restrict)
  children ItemBrandMaster[] @relation("BrandHierarchy")

  @@index([brand_parent_id], map: "idx_brand_parent_id")
  @@index([brand_is_active], map: "idx_brand_active")
  @@map("item_brand_master")
  @@schema("inventory")
}

// ----- prisma/inventory/itemEanCode.prisma -----
model ItemEanCode {
  eanId String @id @default(dbgenerated("uuidv7()")) @map("ean_id") @db.Uuid

  // Link
  eanItemId    String  @map("ean_item_id") @db.Uuid
  eanUcUnitId  String  @map("ean_uc_unit_id") @db.Uuid
  eanCode      String  @map("ean_code") @db.VarChar(64)
  eanSlNo      Int     @default(0) @map("ean_sl_no")
  // Default-barcode rule is scoped per (item, unit)
  eanIsDefault Boolean @default(false) @map("ean_is_default")

  // Status / audit
  eanIsActive  Boolean @default(true) @map("ean_is_active")
  eanIsDeleted Boolean @default(false) @map("ean_is_deleted")

  eanCreatedOn  DateTime @default(now()) @map("ean_created_on") @db.Timestamptz(6)
  eanCreatedBy  String?  @map("ean_created_by") @db.VarChar(100)
  eanModifiedOn DateTime @default(now()) @map("ean_modified_on") @db.Timestamptz(6)
  eanModifiedBy String?  @map("ean_modified_by") @db.VarChar(100)

  eanRemarks String? @map("ean_remarks") @db.VarChar(250)

  // Relation — eanUcUnitId references item_unit_conversion(iuc_id)
  itemUnitConversion ItemUnitConversion @relation("ItemEanCodeUnitConversion", fields: [eanUcUnitId], references: [iucId], onUpdate: Cascade, onDelete: Restrict, map: "fk_ean_item_unit")

  // uq_ean_code UNIQUE (ean_code)
  @@unique([eanCode], map: "uq_ean_code")
  @@index([eanCode], map: "idx_ean_code")
  @@index([eanItemId], map: "idx_ean_item")
  @@map("item_ean_codes")
  @@schema("inventory")
}

// ----- prisma/inventory/itemGroupMaster.prisma -----
model ItemGroupMaster {
  itgId String @id @default(dbgenerated("uuidv7()")) @map("itg_id") @db.Uuid

  itgName        String  @map("itg_name") @db.VarChar(150)
  itgAlias       String? @map("itg_alias") @db.VarChar(100)
  itgShort       String? @map("itg_short") @db.VarChar(50)
  itgDescription String? @map("itg_description") @db.VarChar(250)

  // Hierarchy
  itgParentId String?           @map("itg_parent_id") @db.Uuid
  parent      ItemGroupMaster?  @relation("ItemGroupParent", fields: [itgParentId], references: [itgId], onUpdate: Cascade, onDelete: Restrict)
  children    ItemGroupMaster[] @relation("ItemGroupParent")
  items       ItemMaster[]

  itgSort         Int?     @map("itg_sort")
  itgLevel        Int?     @map("itg_level")
  itgPathIdsCache String[] @default([]) @map("itg_path_ids_cache") @db.Uuid
  itgTaxClaim     Boolean? @map("itg_tax_claim")

  // Defaults / pricing rules
  itgDefaultTaxId String? @map("itg_default_tax_id") @db.Uuid
  itgDefaultHsn   String? @map("itg_default_hsn") @db.VarChar(20)
  itgDefaultUomId String? @map("itg_default_uom_id") @db.Uuid

  // Media
  itgPhoto    Bytes?  @map("itg_photo")
  itgPhotoUrl String? @map("itg_photo_url") @db.Text

  // Status / audit
  itgIsActive  Boolean @default(true) @map("itg_is_active")
  itgIsDeleted Boolean @default(false) @map("itg_is_deleted")

  itgSyncDate   DateTime? @map("itg_sync_date") @db.Timestamptz(6)
  itgCreatedOn  DateTime  @default(now()) @map("itg_created_on") @db.Timestamptz(6)
  itgCreatedBy  String?   @map("itg_created_by") @db.VarChar(100)
  itgModifiedOn DateTime  @default(now()) @map("itg_modified_on") @db.Timestamptz(6)
  itgModifiedBy String?   @map("itg_modified_by") @db.VarChar(100)

  @@unique([itgName], map: "uq_itg_name")
  @@index([itgParentId], map: "idx_itg_parent_id")
  @@index([itgIsActive], map: "idx_itg_active")
  @@map("item_group_master")
  @@schema("inventory")
}

// ----- prisma/inventory/itemGstUnits.prisma -----
