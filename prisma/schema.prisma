  itemPhoto            Bytes?   @map("item_photo")
  itemImageUrl         String?  @db.Text @map("item_image_url")
  itemNotes            String?  @db.VarChar(250) @map("item_notes")
  itemStorageLocation  String?  @db.VarChar(250) @map("item_storage_location")

  itemPackingItemIds   String[] @db.Uuid @map("item_packing_item_ids")

  // Status / Audit
  itemIsActive         Boolean  @default(true)  @map("item_is_active")
  itemIsDeleted        Boolean  @default(false) @map("item_is_deleted")

  itemCreatedOn        DateTime @default(now()) @db.Timestamptz(6) @map("item_created_on")
  itemCreatedBy        String?  @db.VarChar(100) @map("item_created_by")
  itemModifiedOn       DateTime @default(now()) @db.Timestamptz(6) @map("item_modified_on")
  itemModifiedBy       String?  @db.VarChar(100) @map("item_modified_by")

  // Relations
  group                ItemGroupMaster @relation(fields: [itemGroupId], references: [itgId], onUpdate: Cascade, onDelete: Restrict)
  category             categoryMaster? @relation(fields: [itemCategoryId], references: [categoryId], onUpdate: Cascade, onDelete: SetNull)
  baseUnit             Unit            @relation(fields: [itemBaseUnitId], references: [unit_id], onUpdate: Cascade, onDelete: Restrict)
