  // 3) Contact
  ledContactPerson         String?   @db.VarChar(150)                                 @map("led_contact_person")
  ledEmail                 String?   @db.VarChar(150)                                 @map("led_email")
  ledTel                   String?   @db.VarChar(20)                                  @map("led_tel")
  ledPhone1                String?   @db.VarChar(20)                                  @map("led_phone1")
  ledPhone2                String?   @db.VarChar(20)                                  @map("led_phone2")
  ledWhatsappNo            String?   @db.VarChar(20)                                  @map("led_whatsapp_no")
  // 4) Address (Mailing)
  ledAddr1                 String?   @db.VarChar(200)                                 @map("led_addr1")
  ledAddr2                 String?   @db.VarChar(200)                                 @map("led_addr2")
  ledAddr3                 String?   @db.VarChar(200)                                 @map("led_addr3")
  ledCity                  String?   @db.VarChar(100)                                 @map("led_city")
  ledDistrict              String?   @db.VarChar(100)                                 @map("led_district")
  ledStateName             String?   @db.VarChar(100)                                 @map("led_state_name")
  ledStateCode             String?   @db.Char(2)                                      @map("led_state_code")
  ledPin                   String?   @db.VarChar(10)                                  @map("led_pin")
  ledCountry               String?   @default("India") @db.VarChar(60)                @map("led_country")
  // 5) Regional (Mailing)
  ledRegionName            String?   @db.Text                                          @map("led_region_name")
  ledRegionAddr1           String?   @db.VarChar(200)                                 @map("led_region_addr1")
  ledRegionAddr2           String?   @db.VarChar(200)                                 @map("led_region_addr2")
  ledRegionAddr3           String?   @db.VarChar(200)                                 @map("led_region_addr3")
  ledRegionCity            String?   @db.VarChar(100)                                 @map("led_region_city")
  ledRegionDistrict        String?   @db.VarChar(100)                                 @map("led_region_district")
  ledRegionStateName       String?   @db.VarChar(100)                                 @map("led_region_state_name")
  ledRegionCountry         String?   @default("India") @db.VarChar(60)                @map("led_region_country")
  // 6) GST / Statutory
  // Allowed values (REGULAR/COMPOSITION/UNREGISTERED) validated in the app layer
  // (accountLedgerMasters LedGstPartyRegType enum), not a DB enum type.
  ledGstPartyRegType       String?   @db.VarChar(20)                                  @map("led_gst_party_reg_type")
  ledGstinNo               String?   @db.VarChar(15)                                  @map("led_gstin_no")
  ledPanNo                 String?   @db.VarChar(10)                                  @map("led_pan_no")
  ledAadharNo              String?   @db.VarChar(20)                                  @map("led_aadhar_no")
  ledEcommerceGstin        String?   @db.VarChar(15)                                  @map("led_ecommerce_gstin")
  ledIsSez                 Boolean   @default(false)                                   @map("led_is_sez")
  ledTypeOfSupply          String?   @db.VarChar(10)                                  @map("led_type_of_supply")
  ledHsnSac                String?   @db.VarChar(10)                                  @map("led_hsn_sac")
  // The tax_rate_master row this ledger carries when it appears as a taxable
  // line (freight, packing, labour). NULL on a party or bank ledger.
  // Replaced ledGstRate / ledTaxability / ledTaxRate, which held a bare
  // percentage; those columns were dropped in 20260912100000.
  ledTaxId                 String?   @db.Uuid                                         @map("led_tax_id")
  ledGstPartyType          String?   @db.VarChar(30)                                  @map("led_gst_party_type")
  ledTanNo                 String?   @db.VarChar(10)                                  @map("led_tan_no")
  ledCin                   String?   @db.VarChar(21)                                  @map("led_cin")
  ledUdyamNo               String?   @db.VarChar(25)                                  @map("led_udyam_no")
  ledMsmeType              String?   @db.VarChar(10)                                  @map("led_msme_type")
  // 7) Tax / duty ledger (CGST/SGST/IGST/Cess + round-off)
  ledGstDutyHead           String?   @db.VarChar(20)                                  @map("led_gst_duty_head")
  ledRoundingMethod        String?   @db.VarChar(15)                                  @map("led_rounding_method")
  ledRoundingLimit         Decimal?  @db.Decimal                                       @map("led_rounding_limit")
  // 8) TDS / TCS
  ledIsTdsApplicable       Boolean   @default(false)                                   @map("led_is_tds_applicable")
  ledTdsDeducteeType       String?   @db.VarChar(40)                                  @map("led_tds_deductee_type")
  ledTdsNatureOfPayment    String?   @db.VarChar(80)                                  @map("led_tds_nature_of_payment")
  ledIsTcsApplicable       Boolean   @default(false)                                   @map("led_is_tcs_applicable")
  // Input tax credit. Allowed values (ELIGIBLE / INELIGIBLE_17_5 / INELIGIBLE_OTHER /
  // CAPITAL_GOODS / INPUT_SERVICES) are behind chk_led_itc_eligibility (20260917120000)
  // AND the app-layer LedItcEligibility enum, which is what turns a bad value into a
  // 400 instead of a raw 23514. Tally's equivalent is the ledger's "Eligibility for
  // input credit". Without it GSTR-3B table 4(D) cannot be produced and 4(A) is
  // overstated by every blocked s.17(5) credit.
  ledItcEligibility        String?   @db.VarChar(20)                                  @map("led_itc_eligibility")
  // Reverse charge is decided by WHO you buy from and WHAT (unregistered purchase,
  // GTA, legal services, director's fees, import of services) — not by the rate row,
  // which is shared with ordinary forward-charge sales at the same percentage. So it
  // lives here, on the party or expense ledger, and the document flag
  // (acc_voucher_doc_register.gdr_is_reverse_charge) defaults from it.
  ledIsReverseCharge       Boolean   @default(false)                                   @map("led_is_reverse_charge")
  // 9) Opening / Running Balance
  ledObAmount              Decimal   @default(0) @db.Decimal                          @map("led_ob_amount")
  // Allowed values (DR/CR) validated in the app layer (accountLedgerMasters
  // LedObType enum), not a DB enum type.
  ledObType                String    @default("DR") @db.VarChar(2)                     @map("led_ob_type")
  ledObAsOn                DateTime? @db.Date                                          @map("led_ob_as_on")
  ledTotalDr               Decimal   @default(0) @db.Decimal                          @map("led_total_dr")
  ledTotalCr               Decimal   @default(0) @db.Decimal                          @map("led_total_cr")
  ledTotalBalance          Decimal   @default(0) @db.Decimal                          @map("led_total_balance")
  // 10) Status / Notes / Display
  ledSortOrder             Int?      @db.Integer                                       @map("led_sort_order")
  ledIsActive              Boolean   @default(true)                                    @map("led_is_active")
  ledIsDeleted             Boolean   @default(false)                                   @map("led_is_deleted")
  ledAllowEdit             Boolean   @default(false)                                   @map("led_allow_edit")
  ledIsEntry               Boolean   @default(false)                                   @map("led_is_entry")
  ledAllowSms              Boolean   @default(false)                                   @map("led_allow_sms")
  ledRemarks               String?   @db.VarChar(250)                                 @map("led_remarks")
  // 11) Audit / Sync
  ledSyncDate              DateTime? @db.Timestamptz                                  @map("led_sync_date")
  ledCreatedOn             DateTime  @default(now()) @db.Timestamptz                  @map("led_created_on")
  ledCreatedBy             String?   @db.VarChar(100)                                 @map("led_created_by")
  ledModifiedOn            DateTime  @default(now()) @db.Timestamptz                  @map("led_modified_on")
  ledModifiedBy            String?   @db.VarChar(100)                                 @map("led_modified_by")
  // Relations
  company                  Company?               @relation(fields: [ledCompanyId], references: [compId], onUpdate: Cascade, onDelete: Restrict)
  accGroupMaster           AccGroupMaster         @relation(fields: [ledGroupId], references: [accGroupId], onUpdate: Cascade, onDelete: Restrict)
  branches                 BranchMaster?          @relation(fields: [ledBranchId], references: [brId], onUpdate: Cascade, onDelete: Restrict)
  bankAccounts             AccLedgerBankAccount[]
  shipAddrs                AccShipAddr[]
  tenderLedgers            AccTenderMaster[]      @relation("TenderLedger")
  tenderSettlementLedgers  AccTenderMaster[]      @relation("TenderSettlementLedger")
  tenderSurchargeLedgers   AccTenderMaster[]      @relation("TenderSurchargeLedger")
  tenderDetailLedgers      AccTenderDetail[]      @relation("TenderDetailLedger")
  tenderDetailSettleLedgers AccTenderDetail[]     @relation("TenderDetailSettleLedger")
  tenderDetailPartyLedgers AccTenderDetail[]      @relation("TenderDetailPartyLedger")
  tenderDetailSurchargeLedgers AccTenderDetail[]  @relation("TenderDetailSurchargeLedger")
  voucherDocRegisterParties AccVoucherDocRegister[]
  voucherHeaderParties     AccVoucherHeader[]     @relation("VoucherHeaderParty")
  voucherHeaderOppLedgers  AccVoucherHeader[]     @relation("VoucherHeaderOppLedger")
  accountingEntries        AccVoucher[]           @relation("AccVoucherLedger")
  oppositeAccountingEntries AccVoucher[]          @relation("AccVoucherOppLedger")
  billParties              AccBillBalance[]       @relation("BillParty")
  billAdjustmentParties    AccBillAdjustment[]    @relation("BillAdjustmentParty")
  billAdjustmentSettleLedgers AccBillAdjustment[] @relation("BillAdjustmentSettleLedger")
  pdcParties               AccPdcRegister[]       @relation("PdcParty")
  pdcBankLedgers           AccPdcRegister[]       @relation("PdcBankLedger")
  // §2.14 — the quarterly return registers. Back-relations only; nothing reads
  // a ledger's register rows through the ledger, but Prisma requires the
  // opposite side of every relation to be declared.
  tcsCollections           AccTcsRegister[]       @relation("TcsCollectee")
  tdsEntries               AccTdsRegister[]       @relation("TdsParty")
  chargeMasters            ChargeMaster[]
  chargeDetails            TransactionChargeDetail[]
  saleOrderAdvanceLedgers  SaleOrder[]              @relation("SaleOrderAdvanceLedger")
  stockReasonGlLedgers     StockReasonMaster[]      @relation("StockReasonMasterGlLedger")
  // fk_led_tax (20260912060000). ON DELETE RESTRICT: a rate a ledger quotes
  // can be superseded, never removed.
  taxRate                  TaxRateMaster?         @relation(fields: [ledTaxId], references: [taxId], onUpdate: Cascade, onDelete: Restrict, map: "fk_led_tax")
  taxRateLedgers           TaxRateLedger[]
  ledgerMaps               AccLedgerMap[]
  openingBalances          AccOpeningBalance[]
  // cus_id IS led_id and sup_id IS led_id — a 1:1 identity link, not a lookup.
  // fk_cus_ledger / fk_sup_ledger (20260917100000) are what finally say so; before
  // them four live parties had no ledger row at all and could not be posted to.
  customer                 Customer?              @relation("CustomerLedger")
  supplier                 Supplier?              @relation("SupplierLedger")
  // Kept for the exact-case scoped case; the three rules below are what actually hold,
  // because this one is INERT for shared rows (led_company_id IS NULL — 50 of 61
  // ledgers) and case-sensitive besides.
  @@unique([ledCompanyId, ledName], name: "uq_led_name_per_company")
  @@unique([ledCompanyId, ledTallyName], name: "uq_led_tally_name_per_company")
  @@index([ledCompanyId], name: "idx_led_company_id")
  @@index([ledBranchId], name: "idx_led_branch_id")
  @@index([ledGroupId], name: "idx_led_group_id")
  @@index([ledIsActive], name: "idx_led_active")
  @@index([ledGstinNo], name: "idx_led_gstin")
  @@index([ledLedgerType], name: "idx_led_ledger_type")
  // Partial unique indexes — enforced via raw SQL migration, not expressible in Prisma schema:
  //   uq_led_tally_guid       UNIQUE (led_tally_guid)                       WHERE led_tally_guid IS NOT NULL
  //   uq_led_tally_master_id  UNIQUE (led_company_id, led_tally_master_id)  WHERE led_tally_master_id IS NOT NULL
  //
  // NAME UNIQUENESS — the same three rules as acc_group_master (20260917110000):
  //   uq_led_name_shared   UNIQUE (lower(led_name)) WHERE led_company_id IS NULL     AND NOT led_is_deleted
  //   uq_led_name_company  UNIQUE (led_company_id, lower(led_name)) WHERE led_company_id IS NOT NULL AND NOT led_is_deleted
  //   tr_led_name_scope    BEFORE INSERT/UPDATE — a company-scoped ledger must not
  //                        collide with a SHARED one.
  // The trigger fires only when the name or the scope actually CHANGES, which
  // grandfathers the one live cross-scope pair ('VAPI BATTERY & AUTO ELECTRICALS',
  // shared + Acme Foods) — the same trade partner as both customer and supplier —
  // rather than locking both rows out of every unrelated edit. Resolving that pair is
  // a naming decision, not a schema one.
  // ── Loyalty points engine (20260921140000) ─────────────────────────────
  // Snapshot on the wallet, so a points-liability report can join accounts
  // without a hop through the customer master.
  loyaltyMembers        LoyaltyMember[]           @relation("LoyaltyMemberPartyLedger")

  // ── Coupons and gift vouchers (20260921160000) ──────────────────────────
  coupons               LoyaltyCoupon[]           @relation("CouponPartyLedger")

  // ── Sales documents (20260921200000) ────────────────────────────────────
  taxCertificates       AccPartyTaxCertificate[]  @relation("PartyTaxCertificateParty")

  // ── Temp credit (20260922000000) ────────────────────────────────────────
  // The walk-in ledger carries a thousand bills; these rows say WHO took
  // each small counter loan against it.
  tempCredits           AccTempCredit[]           @relation("TempCreditParty")

  @@map("acc_ledger_master")
  @@schema("accounts")
}

// ----- prisma/accounts/accountLedgerRole.prisma -----
/// Every posting role, what kind of ledger it may take, and which dimensions it
/// may be varied along. The single definition that acc_ledger_map and
/// inventory.tax_rate_ledger both validate against, via
/// accounts.fn_check_role_ledger — so adding a role (TCS, composition, an RCM
/// variant) is one INSERT here, not an ALTER on every table that lists roles.
model AccLedgerRole {
  alrRole        String  @id(map: "pk_acc_ledger_role") @db.VarChar(30)                      @map("alr_role")
  /// What the Posting Ledgers screen shows
  alrLabel       String  @db.VarChar(60)                          @map("alr_label")
  /// How that screen groups it.
  /// REVENUE | OUTPUT_TAX | PURCHASE | INPUT_TAX | SHARED | RECEIPT | FUTURE (ck_alr_group)
  alrGroup       String  @db.VarChar(20)                          @map("alr_group")

  // What kind of ledger this role may take. NULL means "not checked on this axis".
  /// Expected acc_ledger_master.led_ledger_type
  alrWantType    String? @db.VarChar(20)                          @map("alr_want_type")
  /// Expected acc_ledger_master.led_gst_duty_head (ck_alr_duty)
  alrWantDuty    String? @db.VarChar(20)                          @map("alr_want_duty")
  /// Expected acc_group_master.acc_group_nature (ck_alr_nature)
  alrWantNature  String? @db.VarChar(20)                          @map("alr_want_nature")

  /// May carry INTRA / INTER. Only revenue and purchase roles can — a tax role
  /// already says the supply nature by which it is used.
  alrBySupply    Boolean @default(false)                          @map("alr_by_supply")
  /// May be overridden per GST rate. Round-off, discount, write-off and
  /// advances cannot — they have nothing to do with a rate.
  alrByRate      Boolean @default(false)                          @map("alr_by_rate")

  alrSortOrder   Int     @default(0) @db.SmallInt                 @map("alr_sort_order")
  alrIsActive    Boolean @default(true)                           @map("alr_is_active")
  alrRemarks     String? @db.VarChar(250)                         @map("alr_remarks")

  /// The role -> ledger rows that name this role.
  ledgerMaps     AccLedgerMap[]
  /// The per-GST-rate overrides that name this role.
  taxRateLedgers TaxRateLedger[]
  /// The voucher legs posted under this role (acc_vouchers.av_role).
  voucherLines   AccVoucher[]

  // accounts.fn_check_role_ledger(role, ledger, company, where) validates a
  // ledger against a row of this table. It lives in raw SQL — a function is not
  // expressible here — and both posting guards call it.
  @@map("acc_ledger_role")
  @@schema("accounts")
}

// ----- prisma/accounts/AccountOpeningBalance.prisma -----
/// Opening balance per ledger per financial year. Balance-sheet ledgers
/// only; P&L ledgers always start at zero. Partitioned by opAccYear, so the
/// primary key is the composite (opId, opAccYear).
model AccOpeningBalance {
  opId            String    @default(dbgenerated("uuidv7()")) @db.Uuid @map("op_id")
  opCompanyId     String    @db.Uuid @map("op_company_id")
  // NULL = company level
  opBranchId      String?   @db.Uuid @map("op_branch_id")
  // FY label in YYYY-YYYY form, matching fiscal_years.fy_code. The partition
  // key.
  opAccYear       String    @db.Char(9) @map("op_acc_year")
  opLedgerId      String    @db.Uuid @map("op_ledger_id")
  /// RESERVED — multi-tenancy, mirroring ablTenantId. No FK: there is no
  /// tenant table yet. Added 20260915090000, which was the only partitioned
  /// accounts table without one.
  opTenantId      String?   @db.Uuid @map("op_tenant_id")

  opAmount        Decimal   @default(0) @db.Decimal(18, 2) @map("op_amount")
  // ck_op_dr_cr: D | C
  opDrCr          String    @db.Char(1) @map("op_dr_cr")

  // ck_op_source: CARRY_FORWARD | MANUAL | MIGRATION.
  // Regeneration updates CARRY_FORWARD rows only — MANUAL and MIGRATION rows
  // are owned by a human and must never be overwritten.
  opSource        String    @default("CARRY_FORWARD") @db.VarChar(20) @map("op_source")

  opIsStale       Boolean   @default(false) @map("op_is_stale")
  opStaleSince    DateTime? @db.Timestamptz(6) @map("op_stale_since")
  // WHY it went stale, not just that it did — added 20260915090000, because
  // "stale" alone cannot answer the only question an accountant asks.
  /// ck_op_stale_reason: VOUCHER_POSTED | VOUCHER_CANCELLED |
  /// SOURCE_OPENING_EDITED | YEAR_REOPENED | MANUAL
  opStaleReason   String?   @db.VarChar(30) @map("op_stale_reason")
  /// The row that invalidated this opening — usually a voucher. Deliberately
  /// NOT a relation: acc_vouchers is partitioned on its own year, and a stale
  /// marker must outlive the cancellation of the document that caused it.
  /// ck_op_stale_ref keeps the pair set or unset together.
  opStaleRefId    String?   @db.Uuid @map("op_stale_ref_id")
  opStaleRefAccYear String? @db.Char(9) @map("op_stale_ref_acc_year")
  opGeneratedAt   DateTime? @db.Timestamptz(6) @map("op_generated_at")
  opGeneratedBy   String?   @db.VarChar(50) @map("op_generated_by")
  opRemarks       String?   @map("op_remarks")

  opIsDeleted     Boolean   @default(false) @map("op_is_deleted")
  opCreatedAt     DateTime  @default(now()) @db.Timestamptz(6) @map("op_created_at")
  opCreatedBy     String?   @db.VarChar(50) @map("op_created_by")
  opModifiedAt    DateTime? @db.Timestamptz(6) @map("op_modified_at")
  opModifiedBy    String?   @db.VarChar(50) @map("op_modified_by")

  // fk_op_ledger / fk_op_company / fk_op_branch (20260915090000). The table
  // shipped with no referential integrity at all. ON DELETE RESTRICT: an
  // opening balance is an accounting record, so deleting a ledger must fail
  // while one names it rather than silently taking the opening with it.
  ledger          AccLedgerMaster @relation(fields: [opLedgerId], references: [ledId], onUpdate: Cascade, onDelete: Restrict, map: "fk_op_ledger")
  company         Company         @relation(fields: [opCompanyId], references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_op_company")
  branch          BranchMaster?   @relation(fields: [opBranchId], references: [brId], onUpdate: Cascade, onDelete: Restrict, map: "fk_op_branch")

  @@id([opId, opAccYear], map: "pk_acc_opening")
  @@map("acc_opening_balance")
  @@schema("accounts")
  // DB-only objects not expressible in the Prisma schema (see migrations
  // 20260806090000_add_voucher_header_bills_pdc and
  // 20260811060000_partition_account_bill_tables_by_acc_year):
  //   - PARTITION BY LIST (op_acc_year); one partition per accounting year,
  //     created by public.ensure_acc_year_partitions('YYYY-YYYY').
  //   - Partial UNIQUE index ux_op_scope on
  //     (op_company_id, COALESCE(op_branch_id, all-zero uuid), op_acc_year,
  //     op_ledger_id) WHERE op_is_deleted = false. Branch NULL must still
  //     collide with branch NULL, hence the COALESCE — not expressible as
  //     @@unique.
  //   - Partial/covering indexes ix_op_lookup, ix_op_stale.
  //   - CHECK constraints ck_op_dr_cr, ck_op_amount, ck_op_source,
  //     ck_op_acc_year, and ck_op_stale_reason / ck_op_stale_ref /
  //     ck_op_stale_ref_acc_year (20260915090000).
  //   - NOT constrained: what clears op_is_stale, and therefore whether a
  //     not-stale row may still carry stale detail. That is DECISION 5 and
  //     still open — a CHECK now would settle it by accident.
}

// ----- prisma/accounts/AccountOpeningRun.prisma -----
/// One row per carry-forward run, never updated — the history that
/// fiscal_years overwrites. fyIsCarriedForward / fyCarriedForwardAt record
/// THAT a year was carried forward and WHEN, once; a regenerate overwrites the
/// timestamp, and the numbers that say whether the run was sound — rows
/// created, manual openings stepped around, the Dr/Cr totals and the
/// difference between them — were returned to the caller and then lost.
///
/// Deliberately NOT partitioned by accounting year: a run is keyed by the two
/// years it spans rather than living inside either, and it grows by a handful
/// of rows a year. Added by migration 20260915090000 (DECISION 11).
model AccOpeningRun {
  aorId              String   @id(map: "pk_acc_opening_run") @default(dbgenerated("uuidv7()")) @db.Uuid @map("aor_id")

  aorCompanyId       String   @db.Uuid                            @map("aor_company_id")
  /// NULL = the run covered the company as a whole, matching opBranchId.
  aorBranchId        String?  @db.Uuid                            @map("aor_branch_id")

  /// The year read from, and the year written into. ck_aor_year_order: a
  /// carry-forward moves strictly forward.
  aorFromAccYear     String   @db.Char(9)                         @map("aor_from_acc_year")
  aorToAccYear       String   @db.Char(9)                         @map("aor_to_acc_year")

  aorRunAt           DateTime @default(now()) @db.Timestamptz(6)  @map("aor_run_at")
  aorRunBy           String?  @db.VarChar(50)                     @map("aor_run_by")

  // What the run did.
  aorCreated         Int      @default(0)                         @map("aor_created")
  aorUpdated         Int      @default(0)                         @map("aor_updated")
  /// Openings left alone because opSource was MANUAL or MIGRATION — those are
  /// owned by a human and are never overwritten by a regenerate.
  aorSkippedManual   Int      @default(0)                         @map("aor_skipped_manual")

  // What it produced.
  aorTotalDebit      Decimal  @default(0) @db.Decimal(18, 2)      @map("aor_total_debit")
  aorTotalCredit     Decimal  @default(0) @db.Decimal(18, 2)      @map("aor_total_credit")
  /// GENERATED ALWAYS AS (debit - credit) STORED — read-only. The one number
  /// everybody reads off this table is the one nobody can write incorrectly.
  /// Non-zero means the carried trial balance did not agree.
  ///
  /// dbgenerated() is the closest Prisma has to a generated column: it has no
  /// attribute for one, and this at least keeps the field out of the create
  /// input and the schema free of drift. Postgres rejects a write to it.
  aorDifference      Decimal  @default(dbgenerated("(aor_total_debit - aor_total_credit)")) @db.Decimal(18, 2) @map("aor_difference")

  /// Whether this run was allowed to overwrite MANUAL openings. The single
  /// most important thing to know about a run after the fact.
  aorOverwriteManual Boolean  @default(false)                     @map("aor_overwrite_manual")

  aorRemarks         String?  @db.VarChar(500)                    @map("aor_remarks")

  company            Company       @relation(fields: [aorCompanyId], references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_aor_company")
  branch             BranchMaster? @relation(fields: [aorBranchId], references: [brId], onUpdate: Cascade, onDelete: Restrict, map: "fk_aor_branch")

  /// "When was this year last carried forward, and what happened?" — newest
  /// first, for one company and target year.
  @@index([aorCompanyId, aorToAccYear, aorRunAt(sort: Desc)], map: "ix_aor_target")
  // DB-only, not expressible here:
  //   - aor_difference is a STORED generated column. Prisma has no attribute
  //     for one, so it appears above as an ordinary Decimal: NEVER write it.
  //   - CHECKs ck_aor_from_acc_year / ck_aor_to_acc_year (YYYY-YYYY, second
  //     half = first + 1), ck_aor_year_order, ck_aor_counts, ck_aor_totals.
  @@map("acc_opening_run")
  @@schema("accounts")
}

// ----- prisma/accounts/AccountPartyTaxCertificate.prisma -----
/// The party's paper: what a party has shown us that changes a rate or a
/// refusal. One row per certificate, windowed by validity.
///
/// Read by the TDS/TCS rate resolver and by the PAN / Form-60 guard on a cash
/// sale above the 269ST limit. LDC_197 is the one that carries numbers of its
/// own: a lower rate certified, and a ceiling up to which it applies.
model AccPartyTaxCertificate {
  ptcId             String    @id(map: "pk_acc_party_tax_certificate") @default(dbgenerated("uuidv7()")) @db.Uuid @map("ptc_id")
  ptcCompanyId      String    @db.Uuid                                 @map("ptc_company_id")
  /// accounts.acc_ledger_master — the accounting identity of the party.
  ptcPartyId        String    @db.Uuid                                 @map("ptc_party_id")
