// ----- prisma/inventory/itemUnitsMaster.prisma -----
model Unit {
  // Identity
  unit_id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid

  // Master fields
  unit_name        String   @unique @db.VarChar(50)
  unit_alias       String?  @db.VarChar(50)
 unit_code        String?  @db.Text
  gstUnit          ItemGstUnits? @relation(fields: [unit_code], references: [itemGstUnitCode], onDelete: SetNull, onUpdate: Cascade)
  unit_description String?  @db.VarChar(100)

  // Decimal / measurement
  unit_decimal_count  Int      @default(0)
  unit_weight         Decimal? @db.Decimal
  unit_loading        Decimal? @db.Decimal
  unit_unloading      Decimal? @db.Decimal
  unit_attach_charge  Decimal? @db.Decimal

  // Packing / conversion
  unit_is_pack_unit Boolean  @default(false)
  unit_base_unit_id String?  @db.Uuid
  unit_conversion   Decimal? @db.Decimal

  // Notes / status
  unit_is_active  Boolean @default(true)
  unit_is_deleted Boolean @default(false)

  // Tally identity — unit_tally_guid is uniquely indexed in the DB
  // (ux_unit_tally_guid, partial on NOT NULL AND NOT deleted).
  unit_tally_name      String? @db.VarChar(100)
  unit_tally_guid      String? @db.VarChar(64)
  unit_tally_master_id BigInt? @db.BigInt
  unit_tally_alter_id  BigInt? @db.BigInt

  // Audit / Sync
  unit_sync_date   DateTime? @db.Timestamptz(6)
  unit_created_on  DateTime  @default(now()) @db.Timestamptz(6)
  unit_created_by  String?   @db.VarChar(100)
  unit_modified_on DateTime  @default(now()) @db.Timestamptz(6)
  unit_modified_by String?   @db.VarChar(100)

  // Self relation
  baseUnit  Unit?  @relation("UnitBase", fields: [unit_base_unit_id], references: [unit_id], onUpdate: Cascade, onDelete: Restrict)
  packUnits Unit[] @relation("UnitBase")

  // Back-relations — ItemUnitConversion
  iucUnits     ItemUnitConversion[] @relation("IucUnit")
  iucBaseUnits ItemUnitConversion[] @relation("IucBaseUnit")

  // Back-relations — ItemPriceMaster
  // (ItemPriceMaster no longer stores a base unit — it reaches one through ItemUnitConversion.)

  // Back-relations — others
  itemMasters  ItemMaster[]

  /// The three-letter GST Unit Quantity Code, for the e-invoice, the e-way
  /// bill and the GSTR-1 HSN summary. The table had a Tally name and no UQC.
  unitUqc       String?   @db.Char(3)                                      @map("unit_uqc")

  @@map("item_unit_master")
  @@schema("inventory")
  @@index([unit_is_active], map: "idx_unit_active")
  @@index([unit_base_unit_id], map: "idx_unit_base")
}

// ----- prisma/inventory/taxRateMaster.prisma -----
/// GST rate master. One row per rate, shared by every company — a rate is
/// statutory and national, so the ledgers it names must be global too.
///
/// Replaces the eighteen ledger columns of inventory.item_tax_master with rows
/// in TaxRateLedger; see that model.
model TaxRateMaster {
  taxId              String  @id(map: "pk_tax_rate_master") @default(dbgenerated("uuidv7()")) @db.Uuid @map("tax_id")
  taxName            String  @db.VarChar(100)                                   @map("tax_name")
  taxCode            String? @db.VarChar(30)                                    @map("tax_code")
  taxSortOrder       Int     @default(0) @db.SmallInt                           @map("tax_sort_order")

  // ── Classification ─────────────────────────────────────────────────────
  /// Same vocabulary as accounts."VoucherDocDetailTaxability", minus MIXED — a
  /// rate is never mixed; a DOCUMENT is, when its lines disagree.
  /// TAXABLE | EXEMPT | NIL_RATED | NON_GST | ZERO_RATED (ck_tax_taxability)
  taxTaxability      String  @default("TAXABLE") @db.VarChar(15)                @map("tax_taxability")
  taxIsReverseCharge Boolean @default(false)                                    @map("tax_is_reverse_charge")

  // ── The rate. One number; the rest follow from it ───────────────────────
  /// The total GST rate: 18 means 18%, charged as 9+9 locally or 18 inter-state.
  taxRatePerc        Decimal @default(0) @db.Decimal(7, 3)                      @map("tax_rate_perc")

  // The three component rates are GENERATED ALWAYS ... STORED from taxRatePerc,
  // so they can no longer disagree with the rate they come from. Prisma has no
  // generated-column concept: the no-argument @default(dbgenerated()) marks the
  // value DB-owned so migrate never emits a DROP DEFAULT Postgres would reject,
  // and they read back nullable because a generated column is not NOT NULL.
  taxCgstPerc        Decimal? @default(dbgenerated()) @db.Decimal(7, 3)         @map("tax_cgst_perc")
  taxSgstPerc        Decimal? @default(dbgenerated()) @db.Decimal(7, 3)         @map("tax_sgst_perc")
  taxIgstPerc        Decimal? @default(dbgenerated()) @db.Decimal(7, 3)         @map("tax_igst_perc")

  // ── Cess ───────────────────────────────────────────────────────────────
  /// NONE | PERCENT (taxCessPerc) | PER_UNIT (taxCessPerUnit) | BOTH. Says
  /// which figure is in play, so a zero is never ambiguous (ck_tax_cess_basis).
  taxCessBasis       String  @default("NONE") @db.VarChar(10)                   @map("tax_cess_basis")
  taxCessPerc        Decimal @default(0) @db.Decimal(7, 3)                      @map("tax_cess_perc")
  taxCessPerUnit     Decimal @default(0) @db.Decimal(15, 4)                     @map("tax_cess_per_unit")

  // ── Additional / state cess ────────────────────────────────────────────
  /// A SECOND cess, because sale_bill_item (sbi_acess_*), acc_voucher_doc_register
  /// (gdr_state_cess_value) and the 'State Cess' duty head all expect one. Same
  /// shape as the block above, so a line can carry both independently — Kerala
  /// flood cess beside compensation cess is the standard example.
  taxAcessBasis      String  @default("NONE") @db.VarChar(10)                   @map("tax_acess_basis")
  taxAcessPerc       Decimal @default(0) @db.Decimal(7, 3)                      @map("tax_acess_perc")
  taxAcessPerUnit    Decimal @default(0) @db.Decimal(15, 4)                     @map("tax_acess_per_unit")

  // ── Supersession ───────────────────────────────────────────────────────
  /// The rate this one replaced. A rate change makes a NEW row and re-points
  /// items (see ItemTaxHistory); this keeps the chain followable. NULL on an
  /// original rate.
  taxSupersedesId    String? @db.Uuid                                           @map("tax_supersedes_id")

  // ── Audit ──────────────────────────────────────────────────────────────
  taxIsActive        Boolean   @default(true)                                   @map("tax_is_active")
  taxIsDeleted       Boolean   @default(false)                                  @map("tax_is_deleted")
  taxSyncDate        DateTime? @db.Timestamptz(6)                               @map("tax_sync_date")
  taxCreatedOn       DateTime  @default(now()) @db.Timestamptz(6)               @map("tax_created_on")
  taxCreatedBy       String?   @db.VarChar(50)                                  @map("tax_created_by")
  taxModifiedOn      DateTime? @db.Timestamptz(6)                               @map("tax_modified_on")
  taxModifiedBy      String?   @db.VarChar(50)                                  @map("tax_modified_by")

  // Relations
  supersedes         TaxRateMaster?  @relation("TaxRateSupersedes", fields: [taxSupersedesId], references: [taxId], onUpdate: Cascade, onDelete: SetNull, map: "fk_tax_supersedes")
  supersededBy       TaxRateMaster[] @relation("TaxRateSupersedes")
  ledgerOverrides    TaxRateLedger[]
  // Lines taxed under this rate. The reference is a snapshot, so ON DELETE
  // RESTRICT: a rate a document has used can be superseded, never removed.
  // Items defaulting to this rate, and their rate-change history — moved
  // off ItemTaxMaster by 20260912110000_repoint_items_to_tax_rate_master.
  defaultItems       ItemMaster[]
  itemTaxHistory     ItemTaxHistory[]
  // Service ledgers (freight, packing, labour) that carry this rate when they
  // appear as a taxable line — acc_ledger_master.led_tax_id.
  ledgers            AccLedgerMaster[]
  billItems          SaleBillItem[]
  orderItems         SaleOrderItem[]
  quotationItems     SaleQuotationItem[]
  // Charges carrying their own rate, and the charge lines that recorded it —
  // charge_master.chg_tax_id and txn_charge_detail.cd_tax_code. Both FKs were
  // in the database from 20260912050000/20260912070000 but had no relation
  // here, so `migrate diff` reported them as drift and `migrate dev` would
  // have dropped them.
  charges            ChargeMaster[]
  chargeLines        TransactionChargeDetail[]

  // Partial indexes — DB-only, Prisma ignores a WHERE predicate and would keep
  // re-creating these without one:
  //   ux_tax_name       UNIQUE (lower(tax_name))  WHERE tax_is_deleted = false
  //   ux_tax_code       UNIQUE (lower(tax_code))  WHERE tax_code IS NOT NULL AND tax_is_deleted = false
  //   ix_tax_rate       (tax_rate_perc)           WHERE NOT deleted AND active
  //   ix_tax_sort       (tax_sort_order, tax_name) WHERE NOT deleted AND active
  //   ix_tax_supersedes (tax_supersedes_id)       WHERE tax_supersedes_id IS NOT NULL
  // Name uniqueness among live rows must therefore be checked app-side.
  @@map("tax_rate_master")
  @@schema("inventory")
}

/// Per-GST-rate ledger overrides. One row per (rate, role, supply nature) that
/// actually differs from the default — a rate that posts wherever
/// accounts.acc_ledger_map says has no rows here at all, which is a complete
/// configuration. Same (scope, role, nature) -> ledger shape as the map; the
/// map's scope is company and branch, this one's is the rate.
model TaxRateLedger {
  trlId           String  @id(map: "pk_tax_rate_ledger") @default(dbgenerated("uuidv7()")) @db.Uuid @map("trl_id")
  trlTaxId        String  @db.Uuid                                              @map("trl_tax_id")
  trlRole         String  @db.VarChar(30)                                       @map("trl_role")
  /// NULL = both natures. Only roles with alrBySupply may set it.
  /// INTRA | INTER (ck_trl_supply_nature)
  trlSupplyNature String? @db.VarChar(5)                                        @map("trl_supply_nature")
  trlLedgerId     String  @db.Uuid                                              @map("trl_ledger_id")
  trlRemarks      String? @db.VarChar(250)                                      @map("trl_remarks")

  trlIsActive     Boolean   @default(true)                                      @map("trl_is_active")
  trlIsDeleted    Boolean   @default(false)                                     @map("trl_is_deleted")
  trlSyncDate     DateTime? @db.Timestamptz(6)                                  @map("trl_sync_date")
  trlCreatedOn    DateTime  @default(now()) @db.Timestamptz(6)                  @map("trl_created_on")
  trlCreatedBy    String?   @db.VarChar(50)                                     @map("trl_created_by")
  trlModifiedOn   DateTime? @db.Timestamptz(6)                                  @map("trl_modified_on")
  trlModifiedBy   String?   @db.VarChar(50)                                     @map("trl_modified_by")

  // Relations. The role is an FK, not a CHECK listing role names: adding a role
  // is one insert in accounts.acc_ledger_role and every table that uses roles
  // follows.
  taxRate         TaxRateMaster   @relation(fields: [trlTaxId], references: [taxId], onUpdate: Cascade, onDelete: Cascade, map: "fk_trl_tax")
  role            AccLedgerRole   @relation(fields: [trlRole], references: [alrRole], onUpdate: Cascade, onDelete: Restrict, map: "fk_trl_role")
  ledger          AccLedgerMaster @relation(fields: [trlLedgerId], references: [ledId], onUpdate: Cascade, onDelete: Restrict, map: "fk_trl_ledger")

  @@index([trlLedgerId], map: "ix_trl_ledger")
  @@index([trlRole], map: "ix_trl_role")
  // Partial indexes — DB-only, see the note on TaxRateMaster:
  //   ux_trl_rate_role UNIQUE (trl_tax_id, trl_role, trl_supply_nature) NULLS NOT DISTINCT WHERE NOT deleted
  //   ix_trl_lookup    (trl_tax_id, trl_role) INCLUDE (trl_ledger_id, trl_supply_nature) WHERE NOT deleted AND active
  @@map("tax_rate_ledger")
  @@schema("inventory")
}

// ----- prisma/public/appSettings.prisma -----
// ═══════════════════════════════════════════════════════════════════════════
//  app_setting_def / app_setting_value  —  Prisma models
//
//  Everything Prisma cannot express stays in the raw migration
//  (20260812120000_add_app_settings — see NOTES at the foot of this file):
//    · CHECK constraints (ck_asd_*, ck_asv_*)
//    · partial indexes (ix_asd_module, ix_asv_company, ux_asv_scope_target)
//    · NULLS NOT DISTINCT on ux_asv_scope_target
//    · tr_asv_check_scope trigger + fn_asv_check_scope()
//    · fn_app_settings() / fn_app_setting()
//    · the catalog seed
// ═══════════════════════════════════════════════════════════════════════════

/// Catalog — one row per configurable setting, forever.
/// A new setting is an INSERT here; no DDL, no client release.
model AppSettingDef {
  asdId String @id @default(dbgenerated("uuidv7()")) @map("asd_id") @db.Uuid

  // ── Identity ─────────────────────────────────────────────────────────
  /// Dotted, lowercase, module-prefixed: 'sales.allow_bill_over_order_qty'.
  /// Never renamed — retire the row (asdIsActive = false) and add a new key.
  asdKey String @unique(map: "ux_app_setting_def_key") @map("asd_key") @db.VarChar(80)

  // ── Where it belongs (draws the settings-screen tree) ────────────────
  asdModule String @map("asd_module") @db.VarChar(30)
  asdGroup  String @default("General") @map("asd_group") @db.VarChar(40)

  // ── Shape ────────────────────────────────────────────────────────────
  /// BOOL | INT | DECIMAL | TEXT | UUID | DATE | JSON  (ck_asd_data_type)
  asdDataType     String   @map("asd_data_type") @db.VarChar(10)
  /// NULL = no value; fn_app_settings omits the key entirely.
  asdDefaultValue String?  @map("asd_default_value")
  /// JSON array of legal values for an enum-ish TEXT setting. NULL = free text.
  asdAllowedValues Json?   @map("asd_allowed_values")
  asdMinValue     Decimal? @map("asd_min_value") @db.Decimal(18, 6)
  asdMaxValue     Decimal? @map("asd_max_value") @db.Decimal(18, 6)

  // ── How deep it may be overridden ────────────────────────────────────
  /// GLOBAL | COMPANY | BRANCH | DEVICE | USER  (ck_asd_max_scope)
  asdMaxScope String @default("COMPANY") @map("asd_max_scope") @db.VarChar(10)

  // ── How it reads on screen ───────────────────────────────────────────
  asdLabel       String  @map("asd_label") @db.VarChar(120)
  asdDescription String? @map("asd_description")
  asdSortOrder   Int     @default(0) @map("asd_sort_order") @db.SmallInt

  // ── Lifecycle ────────────────────────────────────────────────────────
  asdIsActive     Boolean @default(true) @map("asd_is_active")
  asdNeedsRelogin Boolean @default(false) @map("asd_needs_relogin")

  // ── Audit ────────────────────────────────────────────────────────────
  asdIsDeleted  Boolean   @default(false) @map("asd_is_deleted")
  asdSyncDate   DateTime? @map("asd_sync_date") @db.Timestamptz(6)
  asdCreatedOn  DateTime  @default(now()) @map("asd_created_on") @db.Timestamptz(6)
  asdCreatedBy  String    @map("asd_created_by") @db.VarChar(50)
  asdModifiedOn DateTime? @map("asd_modified_on") @db.Timestamptz(6)
  asdModifiedBy String?   @map("asd_modified_by") @db.VarChar(50)

  values AppSettingValue[]

  @@map("app_setting_def")
  @@schema("public")
}

/// Overrides — one row per (setting, scope target).
/// A row exists only where somebody changed something. "Reset to default" is a
/// DELETE, never a write of the default value.
model AppSettingValue {
  asvId String @id @default(dbgenerated("uuidv7()")) @map("asv_id") @db.Uuid

  asvSettingKey String @map("asv_setting_key") @db.VarChar(80)

  /// GLOBAL | COMPANY | BRANCH | DEVICE | USER  (ck_asv_scope);
  /// the id columns below must agree with it (ck_asv_scope_ids).
  asvScope String @map("asv_scope") @db.VarChar(10)

  asvCompanyId String? @map("asv_company_id") @db.Uuid
  asvBranchId  String? @map("asv_branch_id") @db.Uuid
  asvDeviceId  String? @map("asv_device_id") @db.Uuid
  asvUserId    String? @map("asv_user_id") @db.Uuid

  /// Stored as text for every type; fn_app_settings casts on the way out.
  /// NULL = "explicitly nothing", distinct from no row at all ("inherit").
  asvValue   String? @map("asv_value")
  asvRemarks String? @map("asv_remarks") @db.VarChar(250)

  // ── Audit ────────────────────────────────────────────────────────────
  asvIsDeleted  Boolean   @default(false) @map("asv_is_deleted")
  asvSyncDate   DateTime? @map("asv_sync_date") @db.Timestamptz(6)
  asvCreatedOn  DateTime  @default(now()) @map("asv_created_on") @db.Timestamptz(6)
  asvCreatedBy  String    @map("asv_created_by") @db.VarChar(50)
  asvModifiedOn DateTime? @map("asv_modified_on") @db.Timestamptz(6)
  asvModifiedBy String?   @map("asv_modified_by") @db.VarChar(50)

  // ── Relations ────────────────────────────────────────────────────────
  // RESTRICT: a catalog row with overrides is retired, never deleted.
  setting AppSettingDef @relation(fields: [asvSettingKey], references: [asdKey], onUpdate: Cascade, onDelete: Restrict, map: "fk_asv_setting")

  // CASCADE: a branch that is gone cannot keep outvoting its company.
  company Company?      @relation(fields: [asvCompanyId], references: [compId], onUpdate: Cascade, onDelete: Cascade, map: "fk_asv_company")
  branch  BranchMaster? @relation(fields: [asvBranchId], references: [brId], onUpdate: Cascade, onDelete: Cascade, map: "fk_asv_branch")
  device  DeviceMaster? @relation(fields: [asvDeviceId], references: [devId], onUpdate: Cascade, onDelete: Cascade, map: "fk_asv_device")
  user    UserMaster?   @relation(fields: [asvUserId], references: [usrId], onUpdate: Cascade, onDelete: Cascade, map: "fk_asv_user")

  @@map("app_setting_value")
  @@schema("public")
}

// ═══════════════════════════════════════════════════════════════════════════
//  NOTES — what stays in raw SQL (DB-only, never declared above)
//
//  1. Indexes. Both partial, and ux_asv_scope_target additionally needs
//     NULLS NOT DISTINCT — neither is expressible in Prisma, so they are
//     declared ONLY in the migration and never in this file (same rule as
//     ux_sqi_quote_line). Prisma ignores indexes with a WHERE predicate, so
//     declaring them here would produce phantom drift on every migrate dev:
//
//       CREATE INDEX IF NOT EXISTS ix_asd_module
//           ON public.app_setting_def USING btree
//           (asd_module, asd_group, asd_sort_order)
//           WITH (fillfactor=100, deduplicate_items=True)
//           WHERE asd_is_deleted = false AND asd_is_active = true;
//
//       CREATE UNIQUE INDEX IF NOT EXISTS ux_asv_scope_target
//           ON public.app_setting_value USING btree
//           (asv_setting_key, asv_company_id, asv_branch_id,
//            asv_device_id, asv_user_id)
//           NULLS NOT DISTINCT
//           WITH (fillfactor=100, deduplicate_items=True)
//           WHERE asv_is_deleted = false;
//
//       CREATE INDEX IF NOT EXISTS ix_asv_company
//           ON public.app_setting_value USING btree
//           (asv_company_id, asv_setting_key)
//           WITH (fillfactor=100, deduplicate_items=True)
//           WHERE asv_is_deleted = false;
//
//  2. CHECK constraints (ck_asd_data_type, ck_asd_max_scope, ck_asd_range,
//     ck_asv_scope, ck_asv_scope_ids), fn_asv_check_scope() +
//     tr_asv_check_scope, fn_app_settings(), fn_app_setting(), and the catalog
//     seed all live in the migration.
//
//  3. Back-relations added on the existing models:
//
//       model Company      { appSettingValues AppSettingValue[] }
//       model BranchMaster { appSettingValues AppSettingValue[] }
//       model DeviceMaster { appSettingValues AppSettingValue[] }   // @@schema("fixed")
//       model UserMaster   { appSettingValues AppSettingValue[] }
//
//  4. asvSettingKey points at AppSettingDef.asdKey, a non-PK unique column.
//     That is legal in Prisma only because asdKey carries @unique — keep it.
//
//  5. Reading a resolved settings object from NestJS:
//
//       const [{ data }] = await this.prisma.$queryRaw<[{ data: unknown }]>`
//         SELECT public.fn_app_settings(
//           ${companyId}::uuid, ${branchId}::uuid,
//           ${deviceId}::uuid,  ${userId}::uuid) AS data`;
//
//     Do not rebuild the five-layer merge in TypeScript; the resolver is the
//     single source of precedence for both client and server-side rules.
// ═══════════════════════════════════════════════════════════════════════════

