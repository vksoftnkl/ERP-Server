// ----- prisma/inventory/ItemStockBalance.prisma -----
model ItemStockBalance {
  // Primary
  isbId               String                       @id @default(dbgenerated("uuidv7()")) @db.Uuid @map("isb_id")

  // Multi-branch / scope
  isbAccYear          String                       @db.VarChar(9) @map("isb_acc_year")
  isbCompanyId        String                       @db.Uuid @map("isb_company_id")
  isbBranchId         String                       @db.Uuid @map("isb_branch_id")
  isbGodownId         String                       @db.Uuid @map("isb_godown_id")

  // Item — validated at app level (ItemStockBalanceTrackingType, ItemStockBucket)
  isbItemId           String                       @db.Uuid @map("isb_item_id")
  isbUnitId           String                       @db.Uuid @map("isb_unit_id")
  isbTrackingType     String                       @default("NONE") @db.VarChar(20) @map("isb_tracking_type")
  isbStockBucket      String                       @default("SALEABLE") @db.VarChar(20) @map("isb_stock_bucket")

  // Normal qty
  isbOpeningQty       Decimal                      @default(0) @db.Decimal(18, 6) @map("isb_opening_qty")
  isbInQty            Decimal                      @default(0) @db.Decimal(18, 6) @map("isb_in_qty")
  isbOutQty           Decimal                      @default(0) @db.Decimal(18, 6) @map("isb_out_qty")
  isbClosingQty       Decimal                      @default(0) @db.Decimal(18, 6) @map("isb_closing_qty")

  // Free qty
  isbOpeningFreeQty   Decimal                      @default(0) @db.Decimal(18, 6) @map("isb_opening_free_qty")
  isbFreeInQty        Decimal                      @default(0) @db.Decimal(18, 6) @map("isb_free_in_qty")
  isbFreeOutQty       Decimal                      @default(0) @db.Decimal(18, 6) @map("isb_free_out_qty")
  isbFreeClosingQty   Decimal                      @default(0) @db.Decimal(18, 6) @map("isb_free_closing_qty")

  // Allocation / availability
  isbReservedQty      Decimal                      @default(0) @db.Decimal(18, 6) @map("isb_reserved_qty")
  isbTransitQty       Decimal                      @default(0) @db.Decimal(18, 6) @map("isb_transit_qty")
  isbAvailableQty     Decimal                      @default(0) @db.Decimal(18, 6) @map("isb_available_qty")

  // Valuation
  isbOpeningAvgRate   Decimal                      @default(0) @db.Decimal(18, 6) @map("isb_opening_avg_rate")
  isbAvgStockRate     Decimal                      @default(0) @db.Decimal(18, 6) @map("isb_avg_stock_rate")
  isbOpeningValue     Decimal                      @default(0) @db.Decimal(18, 2) @map("isb_opening_value")
  isbStockValue       Decimal                      @default(0) @db.Decimal(18, 2) @map("isb_stock_value")
  
  // Valuationwot
  isbOpeningAvgRateWot   Decimal                      @default(0) @db.Decimal(18, 6) @map("isb_opening_avg_rate_wot")
  isbAvgStockRateWot    Decimal                      @default(0) @db.Decimal(18, 6) @map("isb_avg_stock_rate_wot")
  isbOpeningValueWot    Decimal                      @default(0) @db.Decimal(18, 2) @map("isb_opening_value_wot")
  isbStockValueWot      Decimal                      @default(0) @db.Decimal(18, 2) @map("isb_stock_value_wot")

  // Helper / reconciliation
  isbLastInDate       DateTime?                    @db.Date @map("isb_last_in_date")
  isbLastOutDate      DateTime?                    @db.Date @map("isb_last_out_date")

  // Audit
  isbSyncDate         DateTime?                    @db.Timestamptz(6) @map("isb_sync_date")
  isbCreatedOn        DateTime                     @default(now()) @db.Timestamptz(6) @map("isb_created_on")
  isbCreatedBy        String?                      @db.Uuid @map("isb_created_by")
  isbUpdatedOn        DateTime?                    @db.Timestamptz(6) @map("isb_updated_on")
  isbUpdatedBy        String?                      @db.Uuid @map("isb_updated_by")

  @@unique([isbAccYear, isbCompanyId, isbBranchId, isbGodownId, isbItemId, isbUnitId, isbStockBucket], map: "uq_isb_balance_scope")

  @@index([isbAccYear, isbCompanyId, isbBranchId, isbItemId], map: "idx_isb_item")
  @@index([isbAccYear, isbCompanyId, isbBranchId, isbGodownId], map: "idx_isb_godown")
  // Partial index `idx_isb_nonzero_stock` is maintained in SQL because Prisma
  // schema cannot express the nonzero-stock predicate.

  @@map("item_stock_balance")
  @@schema("inventory")
}

