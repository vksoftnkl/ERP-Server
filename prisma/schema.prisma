  // ── Legacy permission flags ────────────────────────────────────────────────
  usrEditDate            Boolean   @default(false) @map("usr_edit_date")
  usrEditEntry           Boolean   @default(false) @map("usr_edit_entry")
  usrEditRate            Boolean   @default(false) @map("usr_edit_rate")

  // ── Login channels ─────────────────────────────────────────────────────────
  usrDesktopLogin        Boolean   @default(true)  @map("usr_desktop_login")
  usrWebLogin            Boolean   @default(true)  @map("usr_web_login")
  usrMobileLogin         Boolean   @default(false) @map("usr_mobile_login")

  // ── Status & lockout ───────────────────────────────────────────────────────
  usrIsActive            Boolean   @default(true)  @map("usr_is_active")
  usrIsLocked            Boolean   @default(false) @map("usr_is_locked")
  usrFailedLoginCount    Int       @default(0)     @map("usr_failed_login_count")
  usrLastFailedLoginOn   DateTime? @db.Timestamptz() @map("usr_last_failed_login_on")
  usrLockedOn            DateTime? @db.Timestamptz() @map("usr_locked_on")
  usrLockedBy            String?   @db.Uuid @map("usr_locked_by")
  usrLastLoginOn         DateTime? @db.Timestamptz() @map("usr_last_login_on")

  // ── Soft delete ────────────────────────────────────────────────────────────
  usrIsDeleted           Boolean   @default(false) @map("usr_is_deleted")

  // ── Admin notes ────────────────────────────────────────────────────────────
  usrNotes               String?   @map("usr_notes")

  // ── Audit ──────────────────────────────────────────────────────────────────
  usrSyncDate            DateTime? @db.Timestamptz() @map("usr_sync_date")
  usrCreatedOn           DateTime  @default(now()) @db.Timestamptz() @map("usr_created_on")
  usrCreatedBy           String?   @db.Uuid @map("usr_created_by")
  usrModifiedOn          DateTime? @db.Timestamptz() @map("usr_modified_on")
  usrModifiedBy          String?   @db.Uuid @map("usr_modified_by")

  // ── Relations ──────────────────────────────────────────────────────────────
  userMenus              UserMenus[]
  deviceMasters          DeviceMaster[]
  voucherHeaders         AccVoucherHeader[]
  tenderDetails          AccTenderDetail[]
  appSettingValues       AppSettingValue[]
  approvedPromotionSchemes PromotionScheme[] @relation("PromotionSchemeApprovedBy")

  // ── printing (17_printing.sql) — every *_created_by / *_modified_by in
  // that schema carries a real FK, unlike the reports.* tables it replaces.
  printPurposesCreated       PrintPurpose[]            @relation("PrintPurposeCreatedBy")
  printPurposesModified      PrintPurpose[]            @relation("PrintPurposeModifiedBy")
  printTemplatesCreated      PrintTemplate[]           @relation("PrintTemplateCreatedBy")
  printTemplatesModified     PrintTemplate[]           @relation("PrintTemplateModifiedBy")
  printVersionsApproved      PrintTemplateVersion[]    @relation("PrintTemplateVersionApprovedBy")
  printVersionsCreated       PrintTemplateVersion[]    @relation("PrintTemplateVersionCreatedBy")
  printVersionsModified      PrintTemplateVersion[]    @relation("PrintTemplateVersionModifiedBy")
  printDatasetsCreated       PrintTemplateDataset[]    @relation("PrintTemplateDatasetCreatedBy")
  printDatasetsModified      PrintTemplateDataset[]    @relation("PrintTemplateDatasetModifiedBy")
  printAssignmentsCreated    PrintTemplateAssignment[] @relation("PrintTemplateAssignmentCreatedBy")
  printAssignmentsModified   PrintTemplateAssignment[] @relation("PrintTemplateAssignmentModifiedBy")
  printerProfilesCreated     PrinterProfile[]          @relation("PrinterProfileCreatedBy")
  printerProfilesModified    PrinterProfile[]          @relation("PrinterProfileModifiedBy")
  printLogs                  PrintLog[]                @relation("PrintLogPrintedBy")

  // ── Indexes ────────────────────────────────────────────────────────────────
  //   CREATE UNIQUE INDEX uix_user_login_name
  //       ON public.user_master (usr_login_name)
  //       WHERE usr_is_deleted = false;
  //
  //   CREATE INDEX ix_user_is_active
  //       ON public.user_master (usr_is_active)
  //       WHERE usr_is_deleted = false;

  @@map("user_master")
  @@schema("public")
}

// ----- prisma/public/userMenus.prisma -----
model UserMenus {
  // ── Primary key ────────────────────────────────────────────────────────────
  umId          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid @map("um_id")

  // ── References ─────────────────────────────────────────────────────────────
  umUserId      String    @db.Uuid @map("um_user_id")
  umMenuId      Int       @map("um_menu_id")

  // ── CRUD permissions (admin-assigned) ──────────────────────────────────────
  umCanView     Boolean   @default(true)  @map("um_can_view")
  umCanCreate   Boolean   @default(false) @map("um_can_create")
  umCanEdit     Boolean   @default(false) @map("um_can_edit")
  umCanDelete   Boolean   @default(false) @map("um_can_delete")
  umCanPrint    Boolean   @default(false) @map("um_can_print")
  umCanExport   Boolean   @default(false) @map("um_can_export")

  // ── User preferences (user-controlled) ─────────────────────────────────────
  umVisibility  Boolean   @default(true)  @map("um_visibility")
  umIsFavourite Boolean   @default(false) @map("um_is_favourite")
  umIsPinned    Boolean   @default(false) @map("um_is_pinned")
  umSortOrder   Int       @default(0)     @map("um_sort_order")

  // ── Soft delete ────────────────────────────────────────────────────────────
  umIsDeleted   Boolean   @default(false) @map("um_is_deleted")

  // ── Audit ──────────────────────────────────────────────────────────────────
  umSyncDate    DateTime? @db.Timestamptz() @map("um_sync_date")
  umCreatedOn   DateTime  @default(now()) @db.Timestamptz() @map("um_created_on")
  umCreatedBy   String    @db.Uuid @map("um_created_by")
  umModifiedOn  DateTime? @db.Timestamptz() @map("um_modified_on")
  umModifiedBy  String?   @db.Uuid @map("um_modified_by")

  // ── Relations ──────────────────────────────────────────────────────────────
  user          UserMaster @relation(fields: [umUserId], references: [usrId])
  menu          Menu       @relation(fields: [umMenuId], references: [menuId])

  // ── Constraints & indexes ──────────────────────────────────────────────────
  @@unique([umUserId, umMenuId], name: "uq_user_menus_user_menu")

  @@index([umUserId])
  @@index([umUserId, umCanView, umVisibility])
  @@index([umUserId, umIsFavourite, umIsPinned])

  @@map("user_menus")
  @@schema("public")
}

// ----- prisma/purchase/suppliers.prisma -----
model Supplier {
  supId               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid @map("sup_id")
  // 1) Scope / Link
  supCompanyId         String?  @db.Uuid @map("sup_company_id")
  supBranchId          String?  @db.Uuid @map("sup_branch_id")
  supGroupId           String   @db.Uuid @map("sup_group_id")
  supPurchaseType      String   @db.VarChar(20) @map("sup_purchase_type")
  // 2) Names / Contact
  supName              String   @db.VarChar(200) @map("sup_name")
  supShort             String?  @db.VarChar(50) @map("sup_short")
  supAddr1             String?  @db.VarChar(250) @map("sup_addr1")
  supAddr2             String?  @db.VarChar(250) @map("sup_addr2")
  supAddr3             String?  @db.VarChar(250) @map("sup_addr3")
  supCity              String?  @db.VarChar(250) @map("sup_city")
  supDistrict          String?  @db.VarChar(250) @map("sup_district")
  supStateName         String   @db.VarChar(100) @map("sup_state_name")
  supCountry           String?  @default("India") @db.VarChar(60) @map("sup_country")
  supPincode           String?  @db.VarChar(10) @map("sup_pincode")
  supTel               String?  @db.VarChar(20) @map("sup_tel")
  supPhone             String?  @db.VarChar(20) @map("sup_phone")
  supMailId            String?  @db.VarChar(120) @map("sup_mail_id")
  supWhatsappNo        String?  @db.VarChar(20) @map("sup_whatsapp_no")
  supWebsiteAddress    String?  @db.VarChar(200) @map("sup_website_address")
  supChequePreName     String?  @db.VarChar(200) @map("sup_cheque_pre_name")
  supNotes             String?  @db.VarChar(250) @map("sup_notes")
  // 3) Credit / Discount
  supCreditDays        Int      @default(0) @map("sup_credit_days")
  supCashDiscPerc      Decimal  @default(0) @db.Decimal(7, 3) @map("sup_cash_disc_perc")
  // 5) Collection / Schedules
  supCollectionDays    Int[]    @default([]) @map("sup_collection_days")
  // 6) Tax / Compliance
  supGstNo             String?  @db.VarChar(15) @map("sup_gst_no")
  supStateCode         String   @db.Char(2) @map("sup_state_code")
  supPanNo             String?  @db.VarChar(10) @map("sup_pan_no")
  supGstType           String   @db.VarChar(30) @map("sup_gst_type")
  supSupCst            String?  @db.VarChar(25) @map("sup_sup_cst")
  supDrugLiscenceNo    String?  @db.VarChar(100) @map("sup_drug_liscence_no")
  // 7) Regional (Tally style)
  supRegionName        String?  @db.VarChar(200) @map("sup_region_name")
  supRegionAddr1       String?  @db.VarChar(250) @map("sup_region_addr1")
  supRegionAddr2       String?  @db.VarChar(250) @map("sup_region_addr2")
  supRegionAddr3       String?  @db.VarChar(250) @map("sup_region_addr3")
  supRegionCity        String?  @db.VarChar(250) @map("sup_region_city")
  supRegionDistrict    String?  @db.VarChar(250) @map("sup_region_district")
  supRegionStateName   String?  @db.VarChar(100) @map("sup_region_state_name")
  supRegionCountry     String?  @default("India") @db.VarChar(60) @map("sup_region_country")
  // 8) Stats
  supBilledDate        DateTime? @db.Date @map("sup_billed_date")
  supSortOrder         Int?      @default(0) @map("sup_sort_order")
  // 9) Status / Audit / Sync
  supIsActive          Boolean   @default(true) @map("sup_is_active")
  supIsDeleted         Boolean   @default(false) @map("sup_is_deleted")
  supSyncDate          DateTime? @db.Timestamptz(6) @map("sup_sync_date")
  supCreatedOn         DateTime  @default(now()) @db.Timestamptz(6) @map("sup_created_on")
  supCreatedBy         String?   @db.VarChar(100) @map("sup_created_by")
  supModifiedOn        DateTime  @updatedAt @db.Timestamptz(6) @map("sup_modified_on")
  supModifiedBy        String?   @db.VarChar(100) @map("sup_modified_by")
  // 11) FK fields + relations
  // NOTE: sup_state_id column was missing in your DDL snippet, but FK references it.
 
  group                SupplierGroup   @relation(fields: [supGroupId], references: [spgId], onUpdate: Cascade, onDelete: Restrict)
  @@map("suppliers")
  @@schema("purchase")
  @@index([supCompanyId], map: "idx_sup_company")
  @@index([supGroupId], map: "idx_sup_group")
  @@index([supGstNo], map: "idx_sup_gst")
  // NOTE: Partial indexes can't be expressed in Prisma schema:
  // idx_sup_active (WHERE sup_is_deleted = false)
  // uq_sup_company_name (WHERE sup_is_deleted = false)
}

