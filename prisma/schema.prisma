// ----- prisma/inventory/itemPricemaster.prisma -----
model ItemPriceMaster {
  ipmId               String    @id @default(dbgenerated("uuidv7()")) @map("ipm_id") @db.Uuid
  ipmCompanyId        String?   @map("ipm_company_id") @db.Uuid
  ipmBranchId         String?   @map("ipm_branch_id") @db.Uuid
  ipmItemId           String    @map("ipm_item_id") @db.Uuid
  ipmUcUnitId         String    @map("ipm_uc_unit_id") @db.Uuid
  ipmGodownId         String?   @map("ipm_godown_id") @db.Uuid // NULL = price applies to every godown
  ipmSlNo             Int       @default(0) @map("ipm_sl_no") @db.Integer
  ipmCostPrice        Decimal   @default(0) @map("ipm_cost_price") @db.Decimal(18, 6)
  ipmCostWot          Decimal   @default(0) @map("ipm_cost_wot") @db.Decimal(18, 6)
  ipmSalesPriceA      Decimal   @default(0) @map("ipm_sales_price_a") @db.Decimal(18, 6)
  ipmSalesPriceB      Decimal   @default(0) @map("ipm_sales_price_b") @db.Decimal(18, 6)
  ipmSalesPriceC      Decimal   @default(0) @map("ipm_sales_price_c") @db.Decimal(18, 6)
  ipmSalesPriceD      Decimal   @default(0) @map("ipm_sales_price_d") @db.Decimal(18, 6)
  ipmPriceAWot        Decimal   @default(0) @map("ipm_price_a_wot") @db.Decimal(18, 6)
  ipmPriceBWot        Decimal   @default(0) @map("ipm_price_b_wot") @db.Decimal(18, 6)
  ipmPriceCWot        Decimal   @default(0) @map("ipm_price_c_wot") @db.Decimal(18, 6)
  ipmPriceDWot        Decimal   @default(0) @map("ipm_price_d_wot") @db.Decimal(18, 6)
  ipmPriceAMarkupPerc Decimal   @default(0) @map("ipm_price_a_markup_perc") @db.Decimal(9, 3)
  ipmPriceBMarkupPerc Decimal   @default(0) @map("ipm_price_b_markup_perc") @db.Decimal(9, 3)
  ipmPriceCMarkupPerc Decimal   @default(0) @map("ipm_price_c_markup_perc") @db.Decimal(9, 3)
  ipmPriceDMarkupPerc Decimal   @default(0) @map("ipm_price_d_markup_perc") @db.Decimal(9, 3)
  ipmMaxPrice         Decimal   @default(0) @map("ipm_max_price") @db.Decimal(18, 6)
  ipmMinPrice         Decimal   @default(0) @map("ipm_min_price") @db.Decimal(18, 6)
  ipmDiscPerc         Decimal   @default(0) @map("ipm_disc_perc") @db.Decimal(9, 3)
  ipmDiscQty          Decimal   @default(0) @map("ipm_disc_qty") @db.Decimal(18, 6)
  ipmAddlCess         Decimal   @default(0) @map("ipm_addl_cess") @db.Decimal(18, 6)
  ipmProfitType       String    @default("MANUAL") @map("ipm_profit_type") @db.VarChar(20)
  ipmRoundOff         Decimal   @default(0) @map("ipm_round_off") @db.Decimal(10, 4)
  ipmLoadingCharge    Decimal   @default(0) @map("ipm_loading_charge") @db.Decimal(18, 6)
  ipmFreightCharge    Decimal   @default(0) @map("ipm_freight_charge") @db.Decimal(18, 6)
  ipmLoyaltyPoints    Decimal   @default(0) @map("ipm_loyalty_points") @db.Decimal(18, 3)
  ipmUomRemarks       String?   @map("ipm_uom_remarks") @db.VarChar(250)
  ipmCostRemarks      String?   @map("ipm_cost_remarks") @db.VarChar(250)
  ipmIsActive         Boolean   @default(true) @map("ipm_is_active")
  ipmIsDeleted        Boolean   @default(false) @map("ipm_is_deleted")
  ipmSyncDate         DateTime? @map("ipm_sync_date") @db.Timestamptz(6)
  ipmCreatedOn        DateTime  @default(now()) @map("ipm_created_on") @db.Timestamptz(6)
  ipmCreatedBy        String?   @map("ipm_created_by") @db.Uuid
  ipmUpdatedOn        DateTime? @map("ipm_updated_on") @db.Timestamptz(6)
  ipmUpdatedBy        String?   @map("ipm_updated_by") @db.Uuid

  item                       ItemMaster           @relation("ItemPrices", fields: [ipmItemId], references: [itemId], onUpdate: Cascade, onDelete: Restrict, map: "fk_ipm_item")
  company                    Company?             @relation("CompanyItemPrices", fields: [ipmCompanyId], references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_ipm_company_id")
  branch                     BranchMaster?        @relation("BranchItemPrices", fields: [ipmBranchId], references: [brId], onUpdate: Cascade, onDelete: Restrict, map: "fk_ipm_branch_id")
  itemUnitConversion         ItemUnitConversion   @relation("ItemPriceMasterUnitConversion", fields: [ipmUcUnitId], references: [iucId], onUpdate: Cascade, onDelete: Restrict, map: "fk_ipm_unit")
  godown                     GodownLocation?      @relation("GodownPrices", fields: [ipmGodownId], references: [gdlId], onUpdate: Cascade, onDelete: Restrict, map: "fk_ipm_godown_id")
  openingStockBaseUomDetails OpeningStockDetail[] @relation("OpeningStockDetailBaseUomPrice")
  // Partial unique index uq_item_price_master_scope is not expressible in Prisma
  // schema: (ipm_company_id, ipm_branch_id, ipm_item_id, ipm_uc_unit_id)
  // NULLS NOT DISTINCT WHERE ipm_is_deleted = false. It replaced
  // uq_item_price_master_branch and uq_item_price_master_item_unit_global.
  // ipm_godown_id is deliberately NOT part of the key, so two godowns cannot
  // hold different prices for the same item + unit + branch.
  // CHECK constraints are not expressible in Prisma schema.

  @@index([ipmItemId, ipmUcUnitId], map: "idx_item_price_master_item")
  @@map("item_price_master")
  @@schema("inventory")
}

// ----- prisma/inventory/itemQtyPrice.prisma -----
model ItemQtyPrice {
  iqpId              String             @id @default(dbgenerated("uuidv7()")) @map("iqp_id") @db.Uuid
  iqpCompanyId       String?            @map("iqp_company_id") @db.Uuid
  iqpBranchId        String?            @map("iqp_branch_id") @db.Uuid
  iqpPartyId         String?            @map("iqp_party_id") @db.Uuid
  iqpPriceLevel      Int?               @map("iqp_price_level")
  iqpItemId          String             @map("iqp_item_id") @db.Uuid
  iqpItemUnitId      String             @map("iqp_item_unit_id") @db.Uuid
  // slab: lower bound inclusive, upper bound exclusive (NULL = "& above")
  iqpFromQty         Decimal            @default(0) @map("iqp_from_qty") @db.Decimal(14, 3)
  iqpToQty           Decimal?           @map("iqp_to_qty") @db.Decimal(14, 3)
  // discount type: P = by % | R = by qty (flat off) | F = fixed price
  iqpPriceMode       String             @default("P") @map("iqp_price_mode") @db.Char(1)
  iqpDiscPct         Decimal?           @map("iqp_disc_pct") @db.Decimal(6, 3)
  iqpFlatOff         Decimal?           @map("iqp_flat_off") @db.Decimal(14, 3)
  iqpPrice           Decimal?           @map("iqp_price") @db.Decimal(14, 3)
  iqpIsTaxIncl       Boolean            @default(false) @map("iqp_is_tax_incl")
  iqpEffectiveFrom   DateTime           @map("iqp_effective_from") @db.Date
  iqpEffectiveTo     DateTime?          @map("iqp_effective_to") @db.Date
  iqpIsActive        Boolean            @default(true) @map("iqp_is_active")
  iqpIsDeleted       Boolean            @default(false) @map("iqp_is_deleted")
  iqpSyncDate        DateTime?          @map("iqp_sync_date") @db.Timestamptz(6)
  iqpCreatedBy       String?            @map("iqp_created_by") @db.VarChar(100)
  iqpCreatedOn       DateTime           @default(now()) @map("iqp_created_on") @db.Timestamptz(6)
  iqpModifiedBy      String?            @map("iqp_modified_by") @db.VarChar(100)
  iqpModifiedOn      DateTime           @default(now()) @map("iqp_modified_on") @db.Timestamptz(6)
  // Relations
  item               ItemMaster         @relation("ItemQtyPrices", fields: [iqpItemId], references: [itemId], onUpdate: Cascade, onDelete: Restrict, map: "fk_iqp_item")
  itemUnitConversion ItemUnitConversion @relation("ItemQtyPriceUnitConversion", fields: [iqpItemUnitId], references: [iucId], onUpdate: Cascade, onDelete: Restrict, map: "fk_iqp_item_unit")
  company            Company?           @relation("CompanyItemQtyPrices", fields: [iqpCompanyId], references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_iqp_company_id")
  branch             BranchMaster?      @relation("BranchItemQtyPrices", fields: [iqpBranchId], references: [brId], onUpdate: Cascade, onDelete: Restrict, map: "fk_iqp_branch_id")
  priceLevel         ItemPriceLevel?    @relation("ItemQtyPricePriceLevel", fields: [iqpPriceLevel], references: [iplId], onUpdate: Cascade, onDelete: Restrict, map: "fk_iqp_price_level")
  party              Customer?          @relation("CustomerItemQtyPrices", fields: [iqpPartyId], references: [cusId], onUpdate: Cascade, onDelete: Restrict, map: "fk_iqp_party_id")
  // iqp_item_id, iqp_item_unit_id, iqp_company_id, iqp_branch_id, iqp_price_level
  // and iqp_party_id are now Prisma relations (see above); run a migration to
  // create the FK constraints at the DB level.
  // CHECK constraints (ck_iqp_qty_range, ck_iqp_qty_nonneg, ck_iqp_date_range,
  // ck_iqp_mode) are not expressible in Prisma schema.
  // DB-only EXCLUDE USING gist constraint ex_iqp_no_overlap (requires the
  // btree_gist extension) prevents overlapping active qty+date slabs per
  // company/branch/item/price_level/unit; not expressible in Prisma schema.
  // DB-only partial index ix_iqp_lookup on (iqp_item_id, iqp_company_id,
  // iqp_effective_from DESC) WHERE iqp_is_deleted = false AND iqp_is_active =
  // true is not expressible in Prisma schema.

  @@map("item_qty_price")
  @@schema("inventory")
}

// ----- prisma/inventory/itemReorder.prisma -----
model ItemReorder {
  irId String @id @default(dbgenerated("uuidv7()")) @map("ir_id") @db.Uuid

  // Scope / link
  irBranchId     String? @map("ir_branch_id") @db.Uuid
  irItemId       String  @map("ir_item_id") @db.Uuid
  irUcUnitId     String? @map("ir_uc_unit_id") @db.Uuid
  irGodownId     String? @map("ir_godown_id") @db.Uuid // NULL = global reorder rule
  irSlNo         Int     @default(0) @map("ir_sl_no")
  // Core reorder controls
  irMinLevel     Decimal @default(0) @map("ir_min_level") @db.Decimal(15, 4)
  irMaxLevel     Decimal @default(0) @map("ir_max_level") @db.Decimal(15, 4)
  irReorderLevel Decimal @default(0) @map("ir_reorder_level") @db.Decimal(15, 4)
  irReorderQty   Decimal @default(0) @map("ir_reorder_qty") @db.Decimal(15, 4)

  // Time parameters
  irLeadTimeDays     Int @default(0) @map("ir_lead_time_days")
  irReviewCycleDays  Int @default(0) @map("ir_review_cycle_days")
  irReorderDays      Int @default(0) @map("ir_reorder_days")
  irExpiryBufferDays Int @default(0) @map("ir_expiry_buffer_days")

  // Policy / type
  irReorderType String @default("MIN_MAX") @map("ir_reorder_type") @db.VarChar(20)

  // Flags
  irIsActive  Boolean @default(true) @map("ir_is_active")
  irIsDeleted Boolean @default(false) @map("ir_is_deleted")

  // Notes / audit
  irRemarks    String?  @map("ir_remarks") @db.VarChar(250)
  irCreatedOn  DateTime @default(now()) @map("ir_created_on") @db.Timestamptz(6)
  irCreatedBy  String?  @map("ir_created_by") @db.VarChar(100)
  irModifiedOn DateTime @default(now()) @map("ir_modified_on") @db.Timestamptz(6)
  irModifiedBy String?  @map("ir_modified_by") @db.VarChar(100)

  // Relations
  item               ItemMaster          @relation(fields: [irItemId], references: [itemId], onUpdate: Cascade, onDelete: Restrict)
  // irUcUnitId references item_unit_conversion(iuc_id)
  itemUnitConversion ItemUnitConversion? @relation("ItemReorderUnitConversion", fields: [irUcUnitId], references: [iucId], onUpdate: Cascade, onDelete: Restrict, map: "fk_ir_item_unit")

  // Prevent duplicates per scope (no company)
  @@unique([irItemId, irUcUnitId, irGodownId], map: "uq_ir_item_unit_godown")
  @@index([irItemId], map: "idx_ir_item")
  @@index([irUcUnitId], map: "idx_ir_unit")
  @@index([irGodownId], map: "idx_ir_godown")
  @@map("item_reorders")
  @@schema("inventory")
}

