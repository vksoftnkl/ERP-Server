// ----- prisma/master/items/itemPriceMaster.prisma -----
model ItemPriceMaster {
  ipmUnitRateId          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid @map("ipm_unit_rate_id")

  ipmItemId              String  @db.Uuid @map("ipm_item_id")
  ipmUnitId              String  @db.Uuid @map("ipm_unit_id")
  ipmGodownId            String? @db.Uuid @map("ipm_godown_id") // NULL = global price

  ipmUnitSlno            Int     @default(0) @map("ipm_unit_slno")

  ipmConversionFactor    Decimal @default(1) @db.Decimal(18, 6) @map("ipm_conversion_factor")

  // COST
  ipmCostPrice           Decimal @default(0) @db.Decimal(15, 4) @map("ipm_cost_price")
  ipmCostWot             Decimal @default(0) @db.Decimal(15, 4) @map("ipm_cost_wot")

  // SALES prices (A/B/C/D)
  ipmSalesPriceA         Decimal @default(0) @db.Decimal(15, 4) @map("ipm_sales_price_a")
  ipmSalesPriceB         Decimal @default(0) @db.Decimal(15, 4) @map("ipm_sales_price_b")
  ipmSalesPriceC         Decimal @default(0) @db.Decimal(15, 4) @map("ipm_sales_price_c")
  ipmSalesPriceD         Decimal @default(0) @db.Decimal(15, 4) @map("ipm_sales_price_d")

  // Without tax
  ipmPriceAWot           Decimal @default(0) @db.Decimal(15, 4) @map("ipm_price_a_wot")
  ipmPriceBWot           Decimal @default(0) @db.Decimal(15, 4) @map("ipm_price_b_wot")
  ipmPriceCWot           Decimal @default(0) @db.Decimal(15, 4) @map("ipm_price_c_wot")
  ipmPriceDWot           Decimal @default(0) @db.Decimal(15, 4) @map("ipm_price_d_wot")

  // Margin
  ipmPriceAMargin        Decimal @default(0) @db.Decimal(15, 4) @map("ipm_price_a_margin")
  ipmPriceBMargin        Decimal @default(0) @db.Decimal(15, 4) @map("ipm_price_b_margin")
  ipmPriceCMargin        Decimal @default(0) @db.Decimal(15, 4) @map("ipm_price_c_margin")
  ipmPriceDMargin        Decimal @default(0) @db.Decimal(15, 4) @map("ipm_price_d_margin")

  // Controls
  ipmMaxPrice            Decimal @default(0) @db.Decimal(15, 4) @map("ipm_max_price")
  ipmMinPrice            Decimal @default(0) @db.Decimal(15, 4) @map("ipm_min_price")

  ipmDiscPerc            Decimal @default(0) @db.Decimal(7, 3)  @map("ipm_disc_perc")
  ipmDiscQty             Decimal @default(0) @db.Decimal(15, 4) @map("ipm_disc_qty")
  ipmAddlCess            Decimal @default(0) @db.Decimal(15, 4) @map("ipm_addl_cess")

  ipmProfitType          String  @db.VarChar(20) @map("ipm_profit_type") // BY % / BY RS / BY USER
  ipmRoundOff            Decimal @default(0) @db.Decimal(10, 4) @map("ipm_round_off")

  ipmBigUnit             Boolean @default(false) @map("ipm_big_unit")
  ipmUomWeight           Decimal @default(0) @db.Decimal(15, 4) @map("ipm_uom_weight")
  ipmLoadingCharge       Decimal @default(0) @db.Decimal(15, 4) @map("ipm_loading_charge")
  ipmFreightCharge       Decimal @default(0) @db.Decimal(15, 4) @map("ipm_freight_charge")

  ipmRemarks             String? @db.VarChar(250) @map("ipm_remarks")

  ipmIsActive            Boolean @default(true) @map("ipm_is_active")

  ipmCreatedOn           DateTime @default(now()) @db.Timestamptz(6) @map("ipm_created_on")
  ipmCreatedBy           String?  @db.VarChar(100) @map("ipm_created_by")
  ipmModifiedOn          DateTime @default(now()) @db.Timestamptz(6) @map("ipm_modified_on")
  ipmModifiedBy          String?  @db.VarChar(100) @map("ipm_modified_by")

  // Relations
  item                  ItemMaster @relation(fields: [ipmItemId], references: [itemId], onUpdate: Cascade, onDelete: Restrict)
  unit                  Unit       @relation(fields: [ipmUnitId], references: [unit_id], onUpdate: Cascade, onDelete: Restrict)
  qtywiseRates          ItemQtywiseRate[]

  @@map("item_price_master")
  @@schema("public")

  // one rate per combination (without company)
  @@unique([ipmItemId, ipmUnitId, ipmGodownId], map: "uq_ipm_item_unit_godown")
}

// ----- prisma/master/items/itemQtyWiseRateMaster.prisma -----
model ItemQtywiseRate {
  iqrId          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid @map("iqr_id")

  iqrBranchId    String? @db.Uuid @map("iqr_branch_id")

  // Link to base unit-rate row (item+unit+godown)
  iqrUnitRateId  String  @db.Uuid @map("iqr_unit_rate_id")

  // Price Level + Quantity Slab
  iqrPriceLevel  Int     @map("iqr_price_level")

  iqrStartQty    Decimal @db.Decimal(15, 4) @map("iqr_start_qty")
  iqrEndQty      Decimal? @db.Decimal(15, 4) @map("iqr_end_qty")     // NULL = open-ended
  iqrEachQty     Decimal @db.Decimal(15, 4) @map("iqr_each_qty")

  // Pricing + Discount
  iqrSalesPrice  Decimal @default(0) @db.Decimal(15, 4) @map("iqr_sales_price")
  iqrPriceWot    Decimal @default(0) @db.Decimal(15, 4) @map("iqr_price_wot")
  iqrPriceMargin Decimal @default(0) @db.Decimal(15, 4) @map("iqr_price_margin")

  iqrDiscPerc    Decimal @default(0) @db.Decimal(7, 3)  @map("iqr_disc_perc")
  iqrDiscQty     Decimal @default(0) @db.Decimal(15, 4) @map("iqr_disc_qty")

  // Validity
  iqrValidFrom   DateTime? @db.Date @map("iqr_valid_from")
  iqrValidTo     DateTime? @db.Date @map("iqr_valid_to")
  iqrPriority    Int       @default(0) @map("iqr_priority")

  // Status / Audit
  iqrIsActive    Boolean  @default(true)  @map("iqr_is_active")
  iqrIsDeleted   Boolean  @default(false) @map("iqr_is_deleted")

  iqrCreatedOn   DateTime @default(now()) @db.Timestamptz(6) @map("iqr_created_on")
  iqrCreatedBy   String?  @db.VarChar(100) @map("iqr_created_by")
  iqrModifiedOn  DateTime @default(now()) @db.Timestamptz(6) @map("iqr_modified_on")
  iqrModifiedBy  String?  @db.VarChar(100) @map("iqr_modified_by")

  iqrRemarks     String?  @db.VarChar(250) @map("iqr_remarks")

  // Relation
  unitRate       ItemPriceMaster @relation(fields: [iqrUnitRateId], references: [ipmUnitRateId], onUpdate: Cascade, onDelete: Restrict)

  @@map("item_qtywise_rates")
  @@schema("public")

  @@index([iqrUnitRateId], map: "idx_iqr_unit_rate")
  @@index([iqrBranchId], map: "idx_iqr_branch")
  @@index([iqrIsDeleted, iqrIsActive], map: "idx_iqr_active_deleted")
}

// ----- prisma/master/items/itemReorder.prisma -----
model ItemReorder {
