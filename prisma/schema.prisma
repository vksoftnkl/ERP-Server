/// └─────────────────────────────────────────────────────────────────────────┘
///
/// Declared here WITHOUT any CHECK constraint, as every other model in this
/// module is: the vocabularies live in the migration and in
/// PrinterProfileService.
///   prfConnKind     LOCAL | NETWORK | CUPS | WINDOWS | RAW_TCP | FILE
///   prfEmulation    ESCPOS | ESCP2 | PCL | PDF | RAW
///
/// DB-only objects Prisma cannot express, hand-authored in the migration:
///   ux_prf_code    UNIQUE (prf_company_id, lower(prf_code)) WHERE NOT deleted
///   ix_prf_device  (prf_device_id) — "which printers hang off this counter"
///   ix_prf_company / ix_prf_branch / ix_prf_created_by / ix_prf_modified_by
///                  FK-covering, all partial
model PrinterProfile {
  prfId               String    @id(map: "pk_printer_profile") @default(dbgenerated("uuidv7()")) @db.Uuid @map("prf_id")
  prfCompanyId        String    @db.Uuid                                     @map("prf_company_id")
  /// NULL = available at every branch.
  prfBranchId         String?   @db.Uuid                                     @map("prf_branch_id")
  /// The counter this printer hangs off. NULL = a shared/server-side queue.
  prfDeviceId         String?   @db.Uuid                                     @map("prf_device_id")

  prfCode             String    @db.VarChar(40)                              @map("prf_code")
  prfName             String    @db.VarChar(120)                             @map("prf_name")

  // ── How the server reaches it ───────────────────────────────────────────
  prfConnKind         String    @default("CUPS") @db.VarChar(15)             @map("prf_conn_kind")
  /// The OS print queue, share name, or device path.
  prfQueueName        String?   @db.VarChar(120)                             @map("prf_queue_name")
  prfHost             String?   @db.VarChar(120)                             @map("prf_host")
  prfPort             Int?                                                   @map("prf_port")

  // ── What it understands ─────────────────────────────────────────────────
  // ptv_engine says what a template body IS; this says what the hardware can
  // consume. The renderer is what reconciles the two.
  prfEmulation        String    @default("ESCPOS") @db.VarChar(20)           @map("prf_emulation")
  prfCodepage         String?   @db.VarChar(20)                              @map("prf_codepage")

  // ── The paper actually loaded ───────────────────────────────────────────
  // Asserted against ptv_paper_code / ptv_width_mm / ptv_columns at render
  // time. This is the check §5 deliberately does NOT put in the assignment
  // key: paper is a property of the version and of the device, never a
  // resolution axis.
  prfPaperCode        String    @default("A4") @db.VarChar(20)               @map("prf_paper_code")
  prfWidthMm          Decimal?  @db.Decimal(8, 2)                            @map("prf_width_mm")
  prfHeightMm         Decimal?  @db.Decimal(8, 2)                            @map("prf_height_mm")
  /// Characters per line. The text-engine counterpart of ptv_columns.
  prfColumns          Int?      @db.SmallInt                                 @map("prf_columns")
  prfDpi              Int?      @db.SmallInt                                 @map("prf_dpi")

  // ── Capabilities ────────────────────────────────────────────────────────
  prfSupportsCut      Boolean   @default(false)                              @map("prf_supports_cut")
  prfSupportsDrawer   Boolean   @default(false)                              @map("prf_supports_drawer")
  prfSupportsColor    Boolean   @default(false)                              @map("prf_supports_color")
  /// Raw escape sequences, hex or the printer's own notation.
  prfInitSequence     String?   @db.Text                                     @map("prf_init_sequence")
  prfCutSequence      String?   @db.Text                                     @map("prf_cut_sequence")

  prfSortOrder        Int       @default(100) @db.SmallInt                   @map("prf_sort_order")
  prfRemarks          String?   @db.VarChar(250)                             @map("prf_remarks")

  prfIsActive         Boolean   @default(true)                               @map("prf_is_active")
  prfIsDeleted        Boolean   @default(false)                              @map("prf_is_deleted")
  prfSyncDate         DateTime? @db.Timestamptz(6)                           @map("prf_sync_date")
  prfCreatedOn        DateTime  @default(now()) @db.Timestamptz(6)           @map("prf_created_on")
  prfCreatedBy        String?   @db.Uuid                                     @map("prf_created_by")
  prfModifiedOn       DateTime? @db.Timestamptz(6)                           @map("prf_modified_on")
  prfModifiedBy       String?   @db.Uuid                                     @map("prf_modified_by")

  // ── Relations ───────────────────────────────────────────────────────────
  company             Company       @relation("PrinterProfileCompany",    fields: [prfCompanyId],  references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_prf_company")
  branch              BranchMaster? @relation("PrinterProfileBranch",     fields: [prfBranchId],   references: [brId],   onUpdate: Cascade, onDelete: Restrict, map: "fk_prf_branch")
  device              DeviceMaster? @relation("PrinterProfileDevice",     fields: [prfDeviceId],   references: [devId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_prf_device")
  createdByUser       UserMaster?   @relation("PrinterProfileCreatedBy",  fields: [prfCreatedBy],  references: [usrId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_prf_created_by")
  modifiedByUser      UserMaster?   @relation("PrinterProfileModifiedBy", fields: [prfModifiedBy], references: [usrId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_prf_modified_by")

  assignments         PrintTemplateAssignment[] @relation("PrintTemplateAssignmentPrinter")
  printLogs           PrintLog[]                @relation("PrintLogPrinter")

  @@map("printer_profile")
  @@schema("public")
}

// ----- prisma/public/printLog.prisma -----
/// public.print_log — §7, every render, immutable.
///
/// ┌─────────────────────────────────────────────────────────────────────────┐
/// │ RECONSTRUCTED, NOT TRANSCRIBED. §7 of 17_printing.sql has not reached   │
/// │ me — both pastes of the file hit the 50,000-character message limit     │
/// │ before it. RECONCILE AGAINST §7 BEFORE GENERATING A CLIENT.             │
/// │                                                                         │
/// │ Load-bearing and safe (the file states each of these directly):        │
/// │   * prefix plg_, table public.print_log                                │
/// │   * PARTITIONED BY LIST (plg_acc_year), one partition per accounting   │
/// │     year, created by public.fn_create_printing_partitions('YYYY-YYYY') │
/// │     as public.print_log_YYYY_YYYY. Retiring a year is a DROP of one    │
/// │     partition; retention is policy, not schema.                        │
/// │   * plg_version_id is a REAL FK to print_template_version — "what did  │
/// │     this bill look like when it was printed" is enforced, not          │
/// │     snapshotted and hoped for. This is the whole reason the body lives │
/// │     on the version rather than the template.                           │
/// │   * NO foreign key to any document. The subject is named by the        │
/// │     POLYMORPHIC SOURCE QUAD (module, doc type, doc id, acc year),      │
/// │     because the documents are themselves partitioned by their own      │
/// │     accounting year and a purpose may name a master or a report.       │
/// │   * plg_copy_label records what was printed on the paper. Deciding that │
/// │     the second print of a tax invoice is a DUPLICATE is a rule about   │
/// │     GST and belongs to the service layer, not here.                    │
/// │   * plg_params is ONE jsonb object per render — the answers to         │
/// │     ptv_params — not one per dataset. §3 cites this table as the       │
/// │     reason the declaration moved to the version.                       │
/// │   * A REPRINT IS NOT A STATUS TRANSITION. This table is the record of  │
/// │     printing; sale_bill.sb_print_count and its siblings stay a         │
/// │     denormalised cache of COUNT(*) over it, never the truth.           │
/// │                                                                         │
/// │ Inferred, most likely to differ from §7: the outcome block             │
/// │ (plgStatus … plgDurationMs) and the exact spelling of the quad.        │
/// └─────────────────────────────────────────────────────────────────────────┘
///
/// The composite primary key is the house shape for a partitioned fact table —
/// sale_bill does the same — because PostgreSQL requires the partition key to
/// be part of every unique constraint.
///
/// IMMUTABLE means immutable: there is no _is_deleted, no _modified_on and no
/// _sync_date here. Enforce append-only with a REVOKE UPDATE, DELETE on the
/// application role and, if you want it in the database, a BEFORE UPDATE OR
/// DELETE trigger that raises. Prisma cannot express either.
///
/// Declared here WITHOUT any CHECK constraint:
///   ck_plg_acc_year_shape   ^[0-9]{4}-[0-9]{4}$ with consecutive years, the
///                           same rule fn_create_printing_partitions enforces
///   ck_plg_src_module       the ppo_src_module vocabulary
///   ck_plg_output_mode      PRINT | PREVIEW | EMAIL | FILE | REPRINT
///   ck_plg_status           SUCCESS | FAILED | QUEUED | CANCELLED
///   ck_plg_copy_no          >= 1
///
/// DB-only objects Prisma cannot express, hand-authored in the migration:
///   ix_plg_subject   (plg_src_module, plg_src_doc_type, plg_src_doc_id,
///                     plg_src_acc_year) — "how many times was this printed",
///                     the query sb_print_count caches
///   ix_plg_recent    (plg_company_id, plg_printed_on DESC) per partition
///   ix_plg_version / ix_plg_purpose / ix_plg_template / ix_plg_printer /
///   ix_plg_device / ix_plg_branch / ix_plg_printed_by   FK-covering
model PrintLog {
  plgId               String    @default(dbgenerated("uuidv7()")) @db.Uuid   @map("plg_id")
  /// THE PARTITION KEY. One partition per accounting year.
  plgAccYear          String    @db.Char(9)                                  @map("plg_acc_year")

  plgCompanyId        String    @db.Uuid                                     @map("plg_company_id")
  plgBranchId         String?   @db.Uuid                                     @map("plg_branch_id")
  /// The counter the render came from.
  plgDeviceId         String?   @db.Uuid                                     @map("plg_device_id")

  // ── The subject, as the polymorphic source quad ─────────────────────────
  // Deliberately NOT a foreign key to any document: the same shape every
  // other polymorphic table in this chain uses.
  plgSrcModule        String    @default("SALES") @db.VarChar(20)            @map("plg_src_module")
  plgSrcDocType       String    @db.VarChar(40)                              @map("plg_src_doc_type")
  plgSrcDocId         String?   @db.Uuid                                     @map("plg_src_doc_id")
  /// The DOCUMENT's accounting year, which is not necessarily the year the
  /// render happened in — a reprint of last year's bill is logged this year.
  plgSrcAccYear       String?   @db.Char(9)                                  @map("plg_src_acc_year")

  // ── What was rendered, and with what ────────────────────────────────────
  plgPurposeId        String    @db.Uuid                                     @map("plg_purpose_id")
  plgTemplateId       String    @db.Uuid                                     @map("plg_template_id")
  /// The exact bytes. A real FK, and the point of the whole versioning design.
  plgVersionId        String    @db.Uuid                                     @map("plg_version_id")
  plgPrinterId        String?   @db.Uuid                                     @map("plg_printer_id")

  plgOutputMode       String    @default("PRINT") @db.VarChar(15)            @map("plg_output_mode")
  plgCopyNo           Int       @default(1) @db.SmallInt                     @map("plg_copy_no")
  /// ORIGINAL / DUPLICATE / TRIPLICATE — what the paper actually said.
  plgCopyLabel        String?   @db.VarChar(20)                              @map("plg_copy_label")
  plgLang             String?   @db.VarChar(5)                               @map("plg_lang")

  /// The answers to ptv_params, ONE object for the whole render.
  plgParams           Json?     @db.JsonB                                    @map("plg_params")

  // ── Outcome ─────────────────────────────────────────────────────────────
  plgStatus           String    @default("SUCCESS") @db.VarChar(15)          @map("plg_status")
  plgError            String?   @db.Text                                     @map("plg_error")
  plgPageCount        Int?      @db.SmallInt                                 @map("plg_page_count")
  plgByteCount        Int?                                                   @map("plg_byte_count")
  plgDurationMs       Int?                                                   @map("plg_duration_ms")

  plgPrintedOn        DateTime  @default(now()) @db.Timestamptz(6)           @map("plg_printed_on")
  plgPrintedBy        String?   @db.Uuid                                     @map("plg_printed_by")

  // ── Relations ───────────────────────────────────────────────────────────
  company             Company              @relation("PrintLogCompany",   fields: [plgCompanyId],  references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_plg_company")
  branch              BranchMaster?        @relation("PrintLogBranch",    fields: [plgBranchId],   references: [brId],   onUpdate: Cascade, onDelete: Restrict, map: "fk_plg_branch")
  device              DeviceMaster?        @relation("PrintLogDevice",    fields: [plgDeviceId],   references: [devId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_plg_device")
  purpose             PrintPurpose         @relation("PrintLogPurpose",   fields: [plgPurposeId],  references: [ppoId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_plg_purpose")
  template            PrintTemplate        @relation("PrintLogTemplate",  fields: [plgTemplateId], references: [ptlId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_plg_template")
  version             PrintTemplateVersion @relation("PrintLogVersion",   fields: [plgVersionId],  references: [ptvId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_plg_version")
  printer             PrinterProfile?      @relation("PrintLogPrinter",   fields: [plgPrinterId],  references: [prfId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_plg_printer")
  printedByUser       UserMaster?          @relation("PrintLogPrintedBy", fields: [plgPrintedBy],  references: [usrId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_plg_printed_by")

  // Declared so `migrate dev` does not offer to drop them. The PARTIAL ones
  // (ix_plg_subject, ix_plg_printer, ix_plg_device, ix_plg_branch,
  // ix_plg_printed_by) stay DB-only — Prisma cannot express a WHERE clause and
  // therefore ignores them.
  @@index([plgCompanyId, plgPrintedOn(sort: Desc)], map: "ix_plg_recent")
  @@index([plgVersionId],  map: "ix_plg_version")
  @@index([plgPurposeId],  map: "ix_plg_purpose")
  @@index([plgTemplateId], map: "ix_plg_template")
  @@id([plgId, plgAccYear], map: "pk_print_log")
  @@map("print_log")
  @@schema("public")
}

// ----- prisma/public/printPurpose.prisma -----
/// public.print_purpose — §1, WHAT can be printed.
///
/// 3.0 kept this list in C++ as a magic integer at ten call sites
/// (PrintUtil(this, 9) = Sales Bill). It is a table now, and that is the first
/// half of "printing is never controlled by code".
///
/// A purpose is (document type, what you want printed OF it): the same sale
/// bill is a tax invoice, a delivery slip and a godown slip.
/// ppoCompanyId NULL = shipped with the product, visible to every company.
///
/// Declared here WITHOUT any CHECK constraint, the same treatment
/// promotion_scheme gets: ck_ppo_code_shape, ck_ppo_src_module, ck_ppo_copies
/// and ck_ppo_sort live in the migration and in PrintPurposeService.
///
/// DB-only objects Prisma cannot express, hand-authored in the migration:
///   ux_ppo_code    UNIQUE (ppo_company_id, lower(ppo_code)) NULLS NOT DISTINCT
///                  WHERE NOT deleted. NOTE: NULLS NOT DISTINCT dedupes the
///                  SHIPPED rows against each other only — a shipped
///                  SALE_INVOICE and a company's own SALE_INVOICE coexist by
///                  design, which is what makes forking (§2) possible.
///   ix_ppo_doc     (ppo_src_module, ppo_doc_type, ppo_sort_order), partial on
///                  (NOT deleted AND active)
///   ix_ppo_company / ix_ppo_created_by / ix_ppo_modified_by
///                  FK-covering, all partial on IS NOT NULL
model PrintPurpose {
  ppoId               String    @id(map: "pk_print_purpose") @default(dbgenerated("uuidv7()")) @db.Uuid @map("ppo_id")
  /// NULL = shipped with the product, visible to every company.
  ppoCompanyId        String?   @db.Uuid                                     @map("ppo_company_id")

  ppoCode             String    @db.VarChar(40)                              @map("ppo_code")
  ppoName             String    @db.VarChar(120)                             @map("ppo_name")

  // ── The document this prints ────────────────────────────────────────────
  // Free-form on purpose: a purpose may name a transaction (SALE_BILL), a
  // master (ITEM_LABEL) or a report (STOCK_AGEING).
  ppoSrcModule        String    @default("SALES") @db.VarChar(20)            @map("ppo_src_module")
  ppoDocType          String    @db.VarChar(40)                              @map("ppo_doc_type")

  // ── Copies ──────────────────────────────────────────────────────────────
  // How many the paper normally carries, and what they are called. Deciding
  // that the second print of a tax invoice is a DUPLICATE is a rule about
  // GST, not about this table — the service layer labels the copies.
  ppoCopyCount        Int       @default(1) @db.SmallInt                     @map("ppo_copy_count")
  ppoCopyLabels       String?   @db.VarChar(120)                             @map("ppo_copy_labels")

  ppoAllowReprint     Boolean   @default(true)                               @map("ppo_allow_reprint")

  ppoSortOrder        Int       @default(100) @db.SmallInt                   @map("ppo_sort_order")
  ppoNotes            String?   @db.Text                                     @map("ppo_notes")

  ppoIsActive         Boolean   @default(true)                               @map("ppo_is_active")
  ppoIsDeleted        Boolean   @default(false)                              @map("ppo_is_deleted")
  ppoSyncDate         DateTime? @db.Timestamptz(6)                           @map("ppo_sync_date")
  ppoCreatedOn        DateTime  @default(now()) @db.Timestamptz(6)           @map("ppo_created_on")
  ppoCreatedBy        String?   @db.Uuid                                     @map("ppo_created_by")
  ppoModifiedOn       DateTime? @db.Timestamptz(6)                           @map("ppo_modified_on")
  ppoModifiedBy       String?   @db.Uuid                                     @map("ppo_modified_by")

  // ── Relations ───────────────────────────────────────────────────────────
  company             Company?    @relation("PrintPurposeCompany",    fields: [ppoCompanyId], references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_ppo_company")
  createdByUser       UserMaster? @relation("PrintPurposeCreatedBy",  fields: [ppoCreatedBy], references: [usrId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_ppo_created_by")
  modifiedByUser      UserMaster? @relation("PrintPurposeModifiedBy", fields: [ppoModifiedBy], references: [usrId], onUpdate: Cascade, onDelete: Restrict, map: "fk_ppo_modified_by")

  templates           PrintTemplate[]           @relation("PrintTemplatePurpose")
  assignments         PrintTemplateAssignment[] @relation("PrintTemplateAssignmentPurpose")

  printLogs           PrintLog[]                @relation("PrintLogPurpose")

  @@map("print_purpose")
  @@schema("public")
}

// ----- prisma/public/printTemplate.prisma -----
/// public.print_template — §2, the design's IDENTITY, and nothing else.
///
/// Deliberately almost empty: a name, an owner, and a pointer to the revision
/// that is currently published. Everything editable — the body, the page, the
/// datasets — lives on PrintTemplateVersion, because it is versioned and this
/// row is not.
///
/// It carries NO branch, NO device and NO isDefault. Every one of those is a
/// RESOLUTION question and belongs to PrintTemplateAssignment. 3.0 split that
/// question across pgrp_style_id (never read by anything) and pstyl_default
/// (a boolean with no unique constraint), and both were wrong.
///
/// ptlCompanyId NULL = shipped with the product. A company customises one by
/// cloning it, which ptlForkedFromId/ptlForkedFromRev record — replacing 3.0's
/// pstyl_id < 5000 reserved range, a convention nothing enforced.
///
/// Declared here WITHOUT any CHECK constraint: ck_ptl_code_shape,
/// ck_ptl_not_own_fork, ck_ptl_fork_pair and ck_ptl_sort live in the migration
/// and in PrintTemplateService.
///
/// DB-only objects Prisma cannot express, hand-authored in the migration:
///   ux_ptl_code    UNIQUE (ptl_company_id, lower(ptl_code)) NULLS NOT DISTINCT
///                  WHERE NOT deleted. As with ux_ppo_code, a shipped code and
///                  a company's own code coexist — that is what forking means.
///   ix_ptl_purpose (ptl_purpose_id, ptl_company_id, ptl_sort_order) INCLUDE
///                  (code, name, published_rev_id), partial on active AND NOT
///                  deleted — the "print in format" list.
///   ix_ptl_company / ix_ptl_forked_from / ix_ptl_published_rev /
///   ix_ptl_created_by / ix_ptl_modified_by     FK-covering, all partial
///
/// NOT YET ENFORCED ANYWHERE, and worth adding: fk_ptl_published_rev points at
/// ptv_id alone, so nothing stops it naming a DRAFT, a RETIRED version, or a
/// version of a DIFFERENT template. The fix is a composite FK on
/// (ptl_id, ptl_published_rev_id) against a UNIQUE (ptv_template_id, ptv_id)
/// on the version table; status still needs a trigger. Until then it is
/// PrintTemplateService's job.
model PrintTemplate {
  ptlId               String    @id(map: "pk_print_template") @default(dbgenerated("uuidv7()")) @db.Uuid @map("ptl_id")
  /// NULL = shipped with the product. The only scope column here.
  ptlCompanyId        String?   @db.Uuid                                     @map("ptl_company_id")

  ptlPurposeId        String    @db.Uuid                                     @map("ptl_purpose_id")
  ptlCode             String    @db.VarChar(60)                              @map("ptl_code")
  ptlName             String    @db.VarChar(120)                             @map("ptl_name")
  ptlDescription      String?   @db.Text                                     @map("ptl_description")

  /// The revision a render actually uses. NULL until something is published,
  /// which is why a template with only a draft simply does not resolve.
  ptlPublishedRevId   String?   @db.Uuid                                     @map("ptl_published_rev_id")

  // ── Where this came from, when cloned from a shipped design ─────────────
  ptlForkedFromId     String?   @db.Uuid                                     @map("ptl_forked_from_id")
  ptlForkedFromRev    Int?                                                   @map("ptl_forked_from_rev")

  ptlSortOrder        Int       @default(100) @db.SmallInt                   @map("ptl_sort_order")

  /// GENERATED ALWAYS ... STORED: the owner with NULL folded to the nil uuid,
  /// so that §5's composite fk_pta_template can point at (id, owner).
  /// Read-only — writing it raises 428C9; the no-arg dbgenerated() is what
  /// stops `migrate dev` emitting DROP DEFAULT.
  ///
  /// It exists because MATCH SIMPLE treats a composite key as satisfied the
  /// moment ANY of its columns is NULL, so a key on (ptl_id, ptl_company_id)
  /// would stop checking anything at all for a SHIPPED design — exactly the
  /// case the check is for. Folding NULL to the sentinel keeps every column
  /// non-null, so the key always fires.
  ptlCompanyKey       String?   @default(dbgenerated()) @db.Uuid             @map("ptl_company_key")

  ptlIsActive         Boolean   @default(true)                               @map("ptl_is_active")
  ptlIsDeleted        Boolean   @default(false)                              @map("ptl_is_deleted")
  ptlSyncDate         DateTime? @db.Timestamptz(6)                           @map("ptl_sync_date")
  ptlCreatedOn        DateTime  @default(now()) @db.Timestamptz(6)           @map("ptl_created_on")
  ptlCreatedBy        String?   @db.Uuid                                     @map("ptl_created_by")
  ptlModifiedOn       DateTime? @db.Timestamptz(6)                           @map("ptl_modified_on")
  ptlModifiedBy       String?   @db.Uuid                                     @map("ptl_modified_by")

  // ── Relations ───────────────────────────────────────────────────────────
  company             Company?      @relation("PrintTemplateCompany",    fields: [ptlCompanyId],  references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_ptl_company")
  purpose             PrintPurpose  @relation("PrintTemplatePurpose",    fields: [ptlPurposeId],  references: [ppoId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_ptl_purpose")
  forkedFrom          PrintTemplate? @relation("PrintTemplateFork",      fields: [ptlForkedFromId], references: [ptlId], onUpdate: Cascade, onDelete: Restrict, map: "fk_ptl_forked_from")
  createdByUser       UserMaster?   @relation("PrintTemplateCreatedBy",  fields: [ptlCreatedBy],  references: [usrId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_ptl_created_by")
  modifiedByUser      UserMaster?   @relation("PrintTemplateModifiedBy", fields: [ptlModifiedBy], references: [usrId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_ptl_modified_by")

  /// The circular half. Prisma needs both sides named; in SQL this is the
  /// ALTER at the end of §3, because neither table can be created with a
  /// foreign key to the other.
  publishedRev        PrintTemplateVersion? @relation("PrintTemplatePublishedRev", fields: [ptlPublishedRevId], references: [ptvId], onUpdate: Cascade, onDelete: Restrict, map: "fk_ptl_published_rev")

  forks               PrintTemplate[]           @relation("PrintTemplateFork")
  versions            PrintTemplateVersion[]    @relation("PrintTemplateVersions")
  assignments         PrintTemplateAssignment[] @relation("PrintTemplateAssignmentTemplate")

  printLogs           PrintLog[]                @relation("PrintLogTemplate")

  /// The target of §5's composite fk_pta_template. ptlId alone is already the
  /// primary key, so this constrains nothing new; it exists so that a foreign
  /// key can name (id, owner) as a pair.
  @@unique([ptlId, ptlCompanyKey], map: "ux_ptl_id_company_key")
  @@map("print_template")
  @@schema("public")
}

// ----- prisma/public/printTemplateAssignment.prisma -----
/// public.print_template_assignment — §5, WHICH design wins, and WHERE.
///
/// THERE IS DELIBERATELY NO isDefault COLUMN. Default-ness is the ROW'S
/// EXISTENCE. A pta_ row is the choice for one scope; templates that are merely
/// available are PrintTemplate rows matching the purpose, which is what the
/// "print in format" list shows.
///
/// That removes three defects at once:
///   * "exactly one default" becomes a plain unique index on the scope key,
///     with no flag anyone can forget to clear.
///   * THERE IS NO CLEAR STEP. Changing the default is an UPDATE of ONE row.
///     3.0's clear-then-set was scope-unaware, so on a mixed site setting the
///     Windows default silently unset the Linux one.
///   * A partial unique index on a boolean cannot be DEFERRED, so flipping two
///     rows in one UPDATE can fail on row order alone. With no boolean there is
///     no swap to get wrong.
///
/// Narrowest wins: counter -> branch -> company -> EVERY COMPANY, via
/// ptaSpecificity. Four rungs, not three: ptaCompanyId is nullable, so a
/// shipped design can be the default for every company that has not said
/// otherwise.
///
/// PAPER IS NOT IN THE KEY. Output mode is: a 3-inch thermal receipt genuinely
/// is a different artifact from an A4 tax invoice. Paper is a PROPERTY of the
/// chosen version, asserted against the counter's printer profile at render
/// time.
///
/// Declared here WITHOUT any CHECK constraint: ck_pta_output_mode,
/// ck_pta_device_needs_branch, ck_pta_branch_needs_company,
/// ck_pta_template_scope, ck_pta_copies and ck_pta_printer_one_of live in the
/// migration and in PrintTemplateAssignmentService.
///
/// DB-only objects Prisma cannot express, hand-authored in the migration:
///   ux_pta_scope     UNIQUE (COALESCE(company, nil), purpose,
///                    COALESCE(branch, nil), COALESCE(device, nil),
///                    output_mode) WHERE NOT deleted — "exactly one default
///                    per scope", as an index rather than as care. COALESCE to
///                    the nil uuid rather than NULLS NOT DISTINCT, because it
///                    is the same expression the resolver uses.
///   ix_pta_resolve   the render-time resolver, leading with the SAME COALESCE
///                    expression and ordered by specificity DESC, so that
///                    "this company's rows plus the global ones" is one index
///                    scan.
///   ix_pta_company / ix_pta_branch / ix_pta_device / ix_pta_purpose /
///   ix_pta_template / ix_pta_printer / ix_pta_created_by / ix_pta_modified_by
///                    FK-covering, all partial
model PrintTemplateAssignment {
  ptaId               String    @id(map: "pk_print_template_assignment") @default(dbgenerated("uuidv7()")) @db.Uuid @map("pta_id")
  /// NULL = EVERY COMPANY, the ladder's widest rung.
  ///
  /// A global row can only ever name a SHIPPED design, and that is enforced
  /// rather than trusted: ptaTemplateCompanyKey carries the template's owner
  /// and ck_pta_template_scope ties the two together. Without it a global
  /// assignment could point at one company's private design and every other
  /// company's till would render it — their logo, their address, on somebody
  /// else's paper.
  ptaCompanyId        String?   @db.Uuid                                     @map("pta_company_id")
  /// NULL = every branch.
  ptaBranchId         String?   @db.Uuid                                     @map("pta_branch_id")
  /// NULL = every counter.
  ptaDeviceId         String?   @db.Uuid                                     @map("pta_device_id")

  ptaPurposeId        String    @db.Uuid                                     @map("pta_purpose_id")
  ptaTemplateId       String    @db.Uuid                                     @map("pta_template_id")
  /// The OWNER of ptaTemplateId, carried so that the composite fk_pta_template
  /// can exist. Same idiom as the promotion schema's benefit lock: a fact a
  /// single-column key cannot check is made checkable by carrying the second
  /// half of the parent's identity.
  ///
  /// NOT NULL, and the nil uuid means "a shipped design" — matching
  /// ptlCompanyKey rather than ptlCompanyId, so no NULL ever reaches the key
  /// and MATCH SIMPLE cannot quietly stop checking. There is no default: the
  /// writer must state which design's owner this is, because defaulting it to
  /// the sentinel would mean defaulting to "shipped", and that is the one
  /// answer that must never be assumed. PrintTemplateAssignmentService reads it
  /// off the template rather than trusting the caller.
  ptaTemplateCompanyKey String  @db.Uuid                                     @map("pta_template_company_key")
  ptaOutputMode       String    @default("PRINT") @db.VarChar(15)            @map("pta_output_mode")

  /// Where the paper comes out for this scope. NULL = the server's default
  /// queue for the device.
  /// Points at public.printer_profile(prf_id) — §6.
  ptaPrinterId        String?   @db.Uuid                                     @map("pta_printer_id")

  /// The same answer given as a bare queue or share name, for a scope whose
  /// printer nobody has registered as a profile.
  ///
  /// A FALLBACK, never a copy of the profile's name: ck_pta_printer_one_of
  /// refuses it alongside ptaPrinterId. Two columns answering "which printer"
  /// is the same defect §5 spent its whole argument removing from 3.0's default
  /// handling, and a denormalised name on a MASTER goes stale the day the
  /// profile is renamed — unlike plgPrinterName, which is a snapshot on an
  /// immutable log and is meant to be frozen.
  ///
  /// What it costs: a registered profile carries the family, the codepage, the
  /// column count and what the device can physically do. A bare name carries
  /// none of that, so a render through this column falls back to the counter's
  /// defaults for all of it and prfPaperCode cannot assert anything — which is
  /// exactly the check that stops an A4 invoice going to an 80mm roll.
  ptaPrinterName      String?   @db.VarChar(150)                             @map("pta_printer_name")

  /// Overrides the purpose's copy count for this scope. NULL = use it.
  ptaCopies           Int?      @db.SmallInt                                 @map("pta_copies")

  /// GENERATED ALWAYS ... STORED: 3 counter, 2 branch, 1 company, 0 every
  /// company. Read-only — writing it raises 428C9. The no-arg dbgenerated() is
  /// what stops `migrate dev` emitting DROP DEFAULT.
  ///
  /// A single CASE rather than added weights, because a counter row must also
  /// name its branch (ck_pta_device_needs_branch), so device 4 + branch 2 would
  /// score SIX and every reader would have to know that 6, not 4, means
  /// counter. Consecutive values cost nothing and cannot be misread.
  ///
  /// Rung 0 is its own rung and not shared with rung 1: if a global row and a
  /// company row both scored 0 the resolver would have a tie it cannot break,
  /// and ux_pta_scope would let both exist.
  ptaSpecificity      Int?      @default(dbgenerated()) @db.SmallInt         @map("pta_specificity")

  ptaRemarks          String?   @db.VarChar(250)                             @map("pta_remarks")
  ptaIsActive         Boolean   @default(true)                               @map("pta_is_active")
  ptaIsDeleted        Boolean   @default(false)                              @map("pta_is_deleted")
  ptaSyncDate         DateTime? @db.Timestamptz(6)                           @map("pta_sync_date")
  ptaCreatedOn        DateTime  @default(now()) @db.Timestamptz(6)           @map("pta_created_on")
  ptaCreatedBy        String?   @db.Uuid                                     @map("pta_created_by")
  ptaModifiedOn       DateTime? @db.Timestamptz(6)                           @map("pta_modified_on")
  ptaModifiedBy       String?   @db.Uuid                                     @map("pta_modified_by")

  // ── Relations ───────────────────────────────────────────────────────────
  company             Company?      @relation("PrintTemplateAssignmentCompany",    fields: [ptaCompanyId],  references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_pta_company")
  branch              BranchMaster? @relation("PrintTemplateAssignmentBranch",     fields: [ptaBranchId],   references: [brId],   onUpdate: Cascade, onDelete: Restrict, map: "fk_pta_branch")
  device              DeviceMaster? @relation("PrintTemplateAssignmentDevice",     fields: [ptaDeviceId],   references: [devId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_pta_device")
  purpose             PrintPurpose  @relation("PrintTemplateAssignmentPurpose",    fields: [ptaPurposeId],  references: [ppoId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_pta_purpose")
  /// COMPOSITE, against ux_ptl_id_company_key — (ptl_id, ptl_company_key) —
  /// so that a company cannot assign another company's private template. Both
  /// columns are NOT NULL on this side and generated non-null on the other, so
  /// the key always fires; it subsumes the plain existence check a
  /// single-column key would give.
  template            PrintTemplate @relation("PrintTemplateAssignmentTemplate",   fields: [ptaTemplateId, ptaTemplateCompanyKey], references: [ptlId, ptlCompanyKey], onUpdate: Cascade, onDelete: Restrict, map: "fk_pta_template")
  printer             PrinterProfile? @relation("PrintTemplateAssignmentPrinter", fields: [ptaPrinterId],  references: [prfId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_pta_printer")
  createdByUser       UserMaster?   @relation("PrintTemplateAssignmentCreatedBy",  fields: [ptaCreatedBy],  references: [usrId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_pta_created_by")
  modifiedByUser      UserMaster?   @relation("PrintTemplateAssignmentModifiedBy", fields: [ptaModifiedBy], references: [usrId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_pta_modified_by")

  @@map("print_template_assignment")
  @@schema("public")
}

// ----- prisma/public/printTemplateDataset.prisma -----
/// public.print_template_dataset — §4, where the rows come from.
///
/// This model and PrintTemplateAssignment are the whole point of the module. A
/// layout has been data since 3.0; what was never data is WHICH QUERY feeds it.
///
/// It hangs off the VERSION, not the template. A dataset is part of the report
/// definition, not a setting beside it — if it hung off the template, editing a
/// query would silently change what every past version rendered, and print_log's
/// version reference would be a lie.
///
/// THE 3.0 FIX, in two columns:
///   ptdDatasetNo   THE BINDING. The body's bands reference this number. The
///                  master is always 0.
///   ptdSortOrder   Display order in the designer. Binds nothing.
/// pssql_slno was both jobs at once — documented as a serial number, actually
/// the DataSet index — so reordering rows in the editor rebound every band to
/// the wrong query, with no error and no visible cause.
///
/// Declared here WITHOUT any CHECK constraint. That is a bigger omission than
/// usual, so the full list is below and PrintTemplateDatasetService must carry
/// every one of them:
///   ck_ptd_role                  MASTER | DETAIL
///   ck_ptd_source_kind           PROVIDER | SQL
///   ck_ptd_source_biconditional  PROVIDER <=> provider_code, SQL <=> sql
///   ck_ptd_master_is_zero        MASTER <=> dataset_no = 0
///   ck_ptd_dataset_no            0..99
///   ck_ptd_name_shape            ^[a-z][a-z0-9_]*$
///   ck_ptd_provider_shape        dotted lower snake
///   ck_ptd_parent                no self-parent, MASTER may not have one
///   ck_ptd_parent_pair           parent_no <=> link_fields
///   ck_ptd_link_fields_shape     parent=child, comma separated, no spaces
///   ck_ptd_limits                row_limit 1..200000, timeout 100..120000 ms
///   ck_ptd_sql_*                 the eleven stored-SQL guards, below
///
/// ── THE STORED-SQL GUARDS ARE AN AUTHORING LINT, NOT A SECURITY BOUNDARY ──
/// The boundary is three runtime facts: parameters BOUND over the extended
/// protocol (which makes a second statement structurally impossible rather than
/// merely filtered), the query run in a READ ONLY transaction, and a role with
/// no write privilege. A CHECK cannot parse SQL and never will.
///
/// Verified behaviour of the guards against PostgreSQL 18, so the service layer
/// can reproduce it exactly:
///   REFUSED   ':iacc_year' (3.0's quoted param), :1, arr[2:5], two statements,
///             data-modifying CTE, $q$dollar quotes$q$, nested block comments,
///             pg_sleep and friends, a query with no :company_id
///   ACCEPTED  'last updated' AND x = :company_id (a literal BEFORE a param —
///             the false positive the count-based check was written to kill),
///             'it''s', a ';' inside a literal, last_updated_on, updated_at,
///             E'...' and U&'...' (the comment claiming these are caught is
///             wrong; they normalise harmlessly)
///   KNOWN FALSE POSITIVES, both undocumented in §4 — the service layer should
///   give a better message than the constraint name does:
///     * a :name inside a "--" comment trips ck_ptd_sql_no_quoted_param, whose
///       error talks about literals
///     * a "--" inside a literal mangles the residue and the query is refused
///       by ck_ptd_sql_company_scoped, i.e. a company-scoped query is told it
///       is not company-scoped
///
/// DB-only objects Prisma cannot express, hand-authored in the migration:
///   ux_ptd_dataset_no   UNIQUE (ptd_version_id, ptd_dataset_no) WHERE NOT deleted
///   ux_ptd_name         UNIQUE (ptd_version_id, ptd_name)       WHERE NOT deleted
///   ux_ptd_one_master   UNIQUE (ptd_version_id) WHERE role = 'MASTER' AND NOT deleted
///   ix_ptd_version      (ptd_version_id, ptd_sort_order) WHERE NOT deleted
///   ix_ptd_created_by / ix_ptd_modified_by   FK-covering, partial
model PrintTemplateDataset {
  ptdId               String    @id(map: "pk_print_template_dataset") @default(dbgenerated("uuidv7()")) @db.Uuid @map("ptd_id")
  ptdVersionId        String    @db.Uuid                                     @map("ptd_version_id")

  /// MASTER: exactly one, the header context, one row read (3.0's pstyl_sql).
  /// DETAIL: the repeating bands (3.0's printing_style_sql rows).
  ptdRole             String    @default("DETAIL") @db.VarChar(10)           @map("ptd_role")

  /// THE BINDING — what a band actually points at. Unique per version.
  ptdDatasetNo        Int       @db.SmallInt                                 @map("ptd_dataset_no")
  /// Display order in the designer. Binds nothing. Safe to reorder.
  ptdSortOrder        Int       @default(0) @db.SmallInt                     @map("ptd_sort_order")
  /// The same binding by name, so a later engine can address 'items' rather
  /// than 2 and ptdDatasetNo becomes pure back-compatibility.
  ptdName             String    @db.VarChar(40)                              @map("ptd_name")
  ptdLabel            String?   @db.VarChar(120)                             @map("ptd_label")

  // ── PROVIDER or SQL ─────────────────────────────────────────────────────
  // A code-registered PROVIDER for anything needing joins across partitioned
  // tables or real business logic — the e-invoice QR, tax summaries, amount in
  // words. Stored SQL for everything else, so a new report costs no release.
  ptdSourceKind       String    @default("PROVIDER") @db.VarChar(10)         @map("ptd_source_kind")
  ptdProviderCode     String?   @db.VarChar(80)                              @map("ptd_provider_code")
  ptdSql              String?   @db.Text                                     @map("ptd_sql")

  /// GENERATED ALWAYS ... STORED: comments stripped, literals and quoted
  /// identifiers replaced by tokens, casts flattened, lowercased. Read-only —
  /// writing it raises 428C9. The no-arg dbgenerated() is what stops
  /// `migrate dev` emitting DROP DEFAULT. EVERY sql guard reads this and not
  /// ptdSql, so a keyword inside a literal is neither a false positive nor a
  /// way through.
  ptdSqlNorm          String?   @default(dbgenerated()) @db.Text             @map("ptd_sql_norm")

  // There is deliberately NO per-dataset params column. USER prompts are
  // declared once on print_template_version.ptv_params; CONTEXT parameters
  // (:company_id, :branch_id, :acc_year, :doc_id, :user_id, :device_id) are a
  // closed set the server finds by reading the query text.

  /// A report that is not company-scoped shows one company another's numbers.
  /// Set false only for genuinely global data, such as a state-code list.
  ptdRequiresCompany  Boolean   @default(false)                               @map("ptd_requires_company")

  /// Nested detail, which 3.0 could not express at all: this dataset's rows are
  /// the children of the current row of the dataset numbered ptdParentNo.
  ///
  /// ptdLinkFields says HOW they match, as parent=child pairs, comma separated
  /// for a composite — `sbi_id=line_id` or `sb_id=bill_id,sbi_slno=slno`. LEFT
  /// is a column the PARENT dataset returns; RIGHT is a column THIS dataset
  /// returns. Both are output columns, neither side is a bound parameter.
  ///
  /// THE CHILD QUERY RUNS ONCE FOR THE WHOLE RENDER, NOT ONCE PER PARENT ROW.
  /// It is bound with the same context every other dataset gets, returns the
  /// parent's key as an ordinary column, and the RENDERER groups on it. A
  /// 14-line bill costs one query, not fifteen — which is also why ptdRowLimit
  /// and ptdTimeoutMs measure the whole band, not a single child execution.
  ptdParentNo         Int?      @db.SmallInt                                 @map("ptd_parent_no")
  ptdLinkFields       String?   @db.VarChar(200)                             @map("ptd_link_fields")

  ptdRowLimit         Int       @default(5000)                               @map("ptd_row_limit")
  ptdTimeoutMs        Int       @default(15000)                              @map("ptd_timeout_ms")

  ptdRemarks          String?   @db.VarChar(250)                             @map("ptd_remarks")
  ptdIsDeleted        Boolean   @default(false)                              @map("ptd_is_deleted")
  ptdSyncDate         DateTime? @db.Timestamptz(6)                           @map("ptd_sync_date")
  ptdCreatedOn        DateTime  @default(now()) @db.Timestamptz(6)           @map("ptd_created_on")
  ptdCreatedBy        String?   @db.Uuid                                     @map("ptd_created_by")
  ptdModifiedOn       DateTime? @db.Timestamptz(6)                           @map("ptd_modified_on")
  ptdModifiedBy       String?   @db.Uuid                                     @map("ptd_modified_by")

  // ── Relations ───────────────────────────────────────────────────────────
  version             PrintTemplateVersion @relation("PrintTemplateDatasetVersion",    fields: [ptdVersionId],  references: [ptvId], onUpdate: Cascade, onDelete: Cascade,  map: "fk_ptd_version")
  createdByUser       UserMaster?          @relation("PrintTemplateDatasetCreatedBy",  fields: [ptdCreatedBy],  references: [usrId], onUpdate: Cascade, onDelete: Restrict, map: "fk_ptd_created_by")
  modifiedByUser      UserMaster?          @relation("PrintTemplateDatasetModifiedBy", fields: [ptdModifiedBy], references: [usrId], onUpdate: Cascade, onDelete: Restrict, map: "fk_ptd_modified_by")

  @@map("print_template_dataset")
  @@schema("public")
}

// ----- prisma/public/printTemplateVersion.prisma -----
/// public.print_template_version — §3, the design itself, frozen once published.
///
/// THE BODY LIVES HERE, not on the template. That one decision is what makes
/// the rest of the module honest:
///   * print_log.plg_version_id is a real FK to the exact bytes that were
///     rendered, so "what did this bill look like" is enforced, not hoped for.
///   * Publishing and rolling back are a POINTER MOVE on ptl_published_rev_id
///     — one row, atomic. Rollback writes FORWARD as a new version, so the
///     history is append-only and a rolled-back design is still evidence.
///   * A render in flight cannot see a half-saved template, because a
///     published version is never UPDATEd.
///
/// ptvEngine declares what ptvBody IS. 3.0 had no such column — "the body is
/// QtRPT XML" lived in C++, so moving off QtRPT would have been a flag day for
/// every customer at once.
///
/// Declared here WITHOUT any CHECK constraint: ck_ptv_status, ck_ptv_engine,
/// ck_ptv_body_is_json (ptv_body IS JSON OBJECT when engine = JSON_BANDS),
/// ck_ptv_body_size, ck_ptv_rev_no, ck_ptv_orientation, ck_ptv_geometry,
/// ck_ptv_published (a PUBLISHED row must name an approver, the same shape
/// ck_prm_approved uses), ck_ptv_lang_shape and ck_ptv_params_is_array live in
/// the migration and in PrintTemplateVersionService.
///
/// Vocabularies, for the service layer:
///   ptvStatus       DRAFT | PUBLISHED | RETIRED
///   ptvEngine       JSON_BANDS | HTML_CSS | QTRPT_XML | ESCPOS_TEXT | RAW
///   ptvOrientation  PORTRAIT | LANDSCAPE
///
/// DB-only objects Prisma cannot express, hand-authored in the migration:
///   ux_ptv_template_rev    UNIQUE (ptv_template_id, ptv_rev_no) — NOT partial
///                          on is_deleted, unlike every other unique index in
///                          this module, because the history is append-only.
///                          Note the tension with ptvIsDeleted existing at all;
///                          resolve it one way or the other.
///   ix_ptv_template_recent (ptv_template_id, ptv_rev_no DESC) INCLUDE
///                          (status, engine, paper_code) WHERE NOT deleted
///   ix_ptv_approved_by / ix_ptv_created_by / ix_ptv_modified_by  FK-covering
model PrintTemplateVersion {
  ptvId               String    @id(map: "pk_print_template_version") @default(dbgenerated("uuidv7()")) @db.Uuid @map("ptv_id")
  ptvTemplateId       String    @db.Uuid                                     @map("ptv_template_id")
  ptvRevNo            Int                                                    @map("ptv_rev_no")

  ptvStatus           String    @default("DRAFT") @db.VarChar(15)            @map("ptv_status")

  // ── What the body IS ────────────────────────────────────────────────────
  ptvEngine           String    @default("JSON_BANDS") @db.VarChar(20)       @map("ptv_engine")
  ptvBody             String    @db.Text                                     @map("ptv_body")
  ptvSchemaVer        Int       @default(1)                                  @map("ptv_schema_ver")

  // ── The page ────────────────────────────────────────────────────────────
  // Authoritative here, unlike 3.0 where pstyl_size sat beside an XML that
  // actually decided, and the two were free to disagree.
  ptvPaperCode        String    @default("A4") @db.VarChar(20)               @map("ptv_paper_code")
  ptvOrientation      String    @default("PORTRAIT") @db.VarChar(10)         @map("ptv_orientation")
  ptvWidthMm          Decimal?  @db.Decimal(8, 2)                            @map("ptv_width_mm")
  ptvHeightMm         Decimal?  @db.Decimal(8, 2)                            @map("ptv_height_mm")
  ptvMarginTopMm      Decimal   @default(0) @db.Decimal(6, 2)                @map("ptv_margin_top_mm")
  ptvMarginBottomMm   Decimal   @default(0) @db.Decimal(6, 2)                @map("ptv_margin_bottom_mm")
  ptvMarginLeftMm     Decimal   @default(0) @db.Decimal(6, 2)                @map("ptv_margin_left_mm")
  ptvMarginRightMm    Decimal   @default(0) @db.Decimal(6, 2)                @map("ptv_margin_right_mm")
  /// Characters per line for the text engines. Meaningless for a page one.
  ptvColumns          Int?      @db.SmallInt                                 @map("ptv_columns")

  // ── Language ────────────────────────────────────────────────────────────
  // The DEFAULT, not a resolution key. A render may override it. Language must
  // never fork a template the way pstyl_platform forked every one of 3.0's.
  ptvLang             String    @default("en-IN") @db.VarChar(5)             @map("ptv_lang")
  ptvFontFamily       String?   @db.VarChar(80)                              @map("ptv_font_family")

  /// ── What the OPERATOR is asked, once, for the whole render ─────────────
  /// A JSON array, one entry per prompt:
  ///   [{"name":"from_date","type":"DATE","required":true,"label":"From date"},
  ///    {"name":"godown_id","type":"UUID","required":false,"label":"Godown"}]
  ///
  /// ON THE VERSION, not on the dataset. The operator is asked ONCE — if
  /// dataset 1 declared from_date as DATE required and dataset 3 declared it
  /// as TEXT optional there is no answer to what the screen should ask — and
  /// print_log.plg_params is one jsonb object per render, not one per dataset.
  ///
  /// CONTEXT PARAMETERS ARE NOT DECLARED ANYWHERE. :company_id, :branch_id,
  /// :acc_year, :doc_id, :user_id and :device_id are a closed set the server
  /// holds the types for, and it finds which of them a query uses by reading
  /// the query — exactly as ck_ptd_sql_company_scoped already reads
  /// ptd_sql_norm for :company_id. So there is no "source" field here:
  /// everything in this array is asked, everything else is context.
  ///
  /// ck_ptv_params_is_array (jsonb_typeof = 'array') is enforced in the
  /// migration and in PrintTemplateVersionService.
  ptvParams           Json?     @db.JsonB                                    @map("ptv_params")

  // There is deliberately NO sample-document pointer. Which bill a designer
  // previews against is a property of the EDITING SESSION, not of the
  // published design: it is one user's convenience, meaningless to every other
  // user of the same template, and a version is frozen once published while
  // the document it named can be cancelled, corrected or purged with the year.
  // The designer holds the last previewed document in its own state.

  ptvNote             String?   @db.VarChar(250)                             @map("ptv_note")

  /// Publishing is a privileged act: a version whose datasets carry stored SQL
  /// is, in every meaningful sense, code.
  ptvApprovedOn       DateTime? @db.Timestamptz(6)                           @map("ptv_approved_on")
  ptvApprovedBy       String?   @db.Uuid                                     @map("ptv_approved_by")

  ptvIsDeleted        Boolean   @default(false)                              @map("ptv_is_deleted")
  ptvSyncDate         DateTime? @db.Timestamptz(6)                           @map("ptv_sync_date")
  ptvCreatedOn        DateTime  @default(now()) @db.Timestamptz(6)           @map("ptv_created_on")
  ptvCreatedBy        String?   @db.Uuid                                     @map("ptv_created_by")
  ptvModifiedOn       DateTime? @db.Timestamptz(6)                           @map("ptv_modified_on")
  ptvModifiedBy       String?   @db.Uuid                                     @map("ptv_modified_by")

  // ── Relations ───────────────────────────────────────────────────────────
  template            PrintTemplate @relation("PrintTemplateVersions",           fields: [ptvTemplateId], references: [ptlId], onUpdate: Cascade, onDelete: Cascade,  map: "fk_ptv_template")
  approvedByUser      UserMaster?   @relation("PrintTemplateVersionApprovedBy",  fields: [ptvApprovedBy], references: [usrId], onUpdate: Cascade, onDelete: Restrict, map: "fk_ptv_approved_by")
  createdByUser       UserMaster?   @relation("PrintTemplateVersionCreatedBy",   fields: [ptvCreatedBy],  references: [usrId], onUpdate: Cascade, onDelete: Restrict, map: "fk_ptv_created_by")
  modifiedByUser      UserMaster?   @relation("PrintTemplateVersionModifiedBy",  fields: [ptvModifiedBy], references: [usrId], onUpdate: Cascade, onDelete: Restrict, map: "fk_ptv_modified_by")

  /// The other half of the circular pair — the templates that publish this
  /// version. At most one in practice; the schema does not say so.
  publishedFor        PrintTemplate[]        @relation("PrintTemplatePublishedRev")
  datasets            PrintTemplateDataset[] @relation("PrintTemplateDatasetVersion")

  printLogs           PrintLog[]             @relation("PrintLogVersion")

  /// Version numbers are dense and unique per template. NOT partial on
  /// is_deleted, unlike every other unique index in this module, because the
  /// history is append-only.
  @@unique([ptvTemplateId, ptvRevNo], map: "ux_ptv_template_rev")
  @@map("print_template_version")
  @@schema("public")
}

// ----- prisma/public/transactionChargeDetail.prisma -----
/// Per-document applied charges — freight, loading, packing, cash discount, etc.
/// One row per charge line on a document, shared by every module (sales,
/// purchase, quotation, GRN, invoice) via the cdDocType discriminator.
///
/// Every cd* column except the amounts is a SNAPSHOT taken from ChargeMaster
/// (and its ledger) at save time, so editing a charge master later never
/// rewrites what was already invoiced.
///
/// public.txn_charge_detail is LIST-partitioned by cd_acc_year, like
/// sales.sale_bill, sales.sale_order and sales.sale_quotation. Partitions (e.g.
/// txn_charge_detail_2026_2027) are created by
/// public.ensure_acc_year_partitions('YYYY-YYYY') — run it whenever a fiscal
/// year is opened, or every insert fails with "no partition of relation
/// "txn_charge_detail" found for row". Because Postgres requires every unique
/// constraint on a partitioned table to contain the partition key, the primary
/// key is the pair (cdId, cdAccYear): a row is addressed by both, never by the
/// id alone.
model TransactionChargeDetail {
  cdId            String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("cd_id")
  // -- Parent document (polymorphic — no single FK possible) ----------------
  cdDocType       String    @db.VarChar(12)                                @map("cd_doc_type")   // which module's document
  cdDocId         String    @db.Uuid                                       @map("cd_doc_id")     // parent document id
  cdSlno          Int?                                                     @map("cd_slno")       // line order within the document
  // -- Denormalised context (lets the table be queried/reported without
  //    joining the parent document) -----------------------------------------
  cdCompId        String    @db.Uuid                                       @map("cd_comp_id")
  cdBranchId      String    @db.Uuid                                       @map("cd_branch_id")
  cdAccYear       String    @db.Char(9)                                    @map("cd_acc_year")
  cdVoucherNo     BigInt?                                                  @map("cd_voucher_no")
  // -- Charge reference + snapshots -----------------------------------------
  cdChgId         String    @db.Uuid                                       @map("cd_chg_id")     // FK charge_master.chg_id
  cdChgName       String?   @db.VarChar(100)                               @map("cd_chg_name")   // snapshot, for print/history
  cdRole          String?   @db.VarChar(15)                                @map("cd_role")       // FREIGHT | LOADING | UNLOADING | CASH_DISC | OTHERS | NONE
  cdMethod        String?   @db.VarChar(10)                                @map("cd_method")     // how the amount is computed
  cdType          String    @default("ADD") @db.VarChar(10)                @map("cd_type")       // ADD | DEDUCT (the sign)
  cdApplyOn       String?   @db.VarChar(10)                                @map("cd_apply_on")   // distribution basis for a FIXED lump sum
  cdLedgerCode    String    @db.Uuid                                       @map("cd_ledger_code") // GL ledger this charge posts to
  // -- Landing cost + posting flags -----------------------------------------
  cdLandingCost   Boolean   @default(false)                                @map("cd_landing_cost") // purchase: adds to item landing cost
  cdCostAlloc     String?   @db.VarChar(10)                                @map("cd_cost_alloc")   // how that landing cost is allocated
  // The two tax flags are mutually exclusive (ck_cd_tax_apl in the DB).
  // cdBeforeTax folds the charge into the goods' taxable value, so it is taxed
  // at each ITEM's own GST rate; cdTaxApl means the charge carries its OWN GST,
  // after tax. Both at once would tax it twice. Neither = flat, untaxed
  // adjustment.
  cdBeforeTax     Boolean   @default(false)                                @map("cd_before_tax")
  cdTaxApl        Boolean   @default(false)                                @map("cd_tax_apl")
  cdSepPost       Boolean   @default(false)                                @map("cd_sep_post")     // post to its own ledger vs absorb
  // -- Basis + amounts ------------------------------------------------------
  cdUnit          String?   @db.VarChar(15)                                @map("cd_unit")
  cdQtyVal        Decimal?  @db.Decimal(18, 4)                             @map("cd_qty_val")      // qty or value basis keyed on the line
  cdWeight        Decimal?  @db.Decimal(18, 4)                             @map("cd_weight")       // weight / tonnage basis
  // rate 0 with a non-zero amount is meaningful, NOT missing data: the operator
  // priced the charge by typing its total, and the client spreads that total in
  // the method's own shape rather than deriving a rate. Never add a
  // rate-is-required constraint.
  cdRate          Decimal?  @db.Decimal(14, 4)                             @map("cd_rate")         // rate or %, per cdMethod
  cdAmount        Decimal?  @db.Decimal(14, 4)                             @map("cd_amount")       // charge amount BEFORE tax
  // -- Tax (non-zero only when cdTaxApl AND NOT cdBeforeTax) ----------------
  cdTaxCode       String?   @db.Uuid                                       @map("cd_tax_code")
  cdHsn           String?   @db.VarChar(15)                                @map("cd_hsn")          // HSN/SAC, snapshot from the ledger
  cdTaxPerc       Decimal?  @db.Decimal(9, 4)                              @map("cd_tax_perc")
  cdTaxAmt        Decimal?  @db.Decimal(14, 4)                             @map("cd_tax_amt")
  cdSgstPerc      Decimal?  @db.Decimal(9, 4)                              @map("cd_sgst_perc")
  cdSgstAmt       Decimal?  @db.Decimal(14, 4)                             @map("cd_sgst_amt")
  cdCgstPerc      Decimal?  @db.Decimal(9, 4)                              @map("cd_cgst_perc")
  cdCgstAmt       Decimal?  @db.Decimal(14, 4)                             @map("cd_cgst_amt")
  cdIgstPerc      Decimal?  @db.Decimal(9, 4)                              @map("cd_igst_perc")
  cdIgstAmt       Decimal?  @db.Decimal(14, 4)                             @map("cd_igst_amt")
  cdCessPerc      Decimal?  @db.Decimal(9, 4)                              @map("cd_cess_perc")
  cdCessAmt       Decimal?  @db.Decimal(14, 4)                             @map("cd_cess_amt")
  cdNetAmt        Decimal?  @db.Decimal(14, 4)                             @map("cd_net_amt")      // cdAmount + its own tax
  // -- Status + audit -------------------------------------------------------
  cdRemarks       String?   @db.VarChar(255)                               @map("cd_remarks")
  cdIsActive      Boolean   @default(true)                                 @map("cd_is_active")
  cdIsDeleted     Boolean   @default(false)                                @map("cd_is_deleted")
  cdSyncDate      DateTime? @db.Timestamptz                                @map("cd_sync_date")
  cdCreatedOn     DateTime  @default(now()) @db.Timestamptz                @map("cd_created_on")
  cdCreatedBy     String?   @db.Text                                   @map("cd_created_by")
  cdModifiedOn    DateTime? @db.Timestamptz                                @map("cd_modified_on")
  cdModifiedBy    String?   @db.Text                                      @map("cd_modified_by")
  // Relations
  charge          ChargeMaster    @relation(fields: [cdChgId], references: [chgId], onUpdate: NoAction, onDelete: NoAction, map: "fk_cd_charge")
  // The GL ledger the charge posts to. Restrict on delete: a ledger that has
  // been posted to on any document must not disappear from under it.
  ledger          AccLedgerMaster @relation(fields: [cdLedgerCode], references: [ledId], onUpdate: Cascade, onDelete: Restrict, map: "fk_cd_ledger")
  company         Company         @relation("CompanyChargeDetails", fields: [cdCompId], references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_cd_company")
  branch          BranchMaster    @relation("BranchChargeDetails", fields: [cdBranchId], references: [brId], onUpdate: Cascade, onDelete: Restrict, map: "fk_cd_branch")
  // The partition key completes the primary key — see the note above the model.
  @@id([cdId, cdAccYear], map: "pk_txn_charge_detail")
  // Fetch all charge lines for one document (the hot path on entry load).
  @@index([cdDocType, cdDocId], map: "ix_txn_charge_detail_doc")
  @@index([cdChgId], map: "ix_txn_charge_detail_chg")
  @@index([cdLedgerCode], map: "ix_txn_charge_detail_ledger")
  @@index([cdCompId], map: "ix_txn_charge_detail_comp")
  @@index([cdBranchId], map: "ix_txn_charge_detail_branch")
  @@map("txn_charge_detail")
  @@schema("public")
  // The table began life as sales.sale_charge_detail (created in
  // 20260728130000_create_sale_charge_detail, rebuilt by
  // 20260729071620_sale_charge_details_table_schema_changed) and was moved,
  // renamed and partitioned by
  // 20260810140000_partition_txn_charge_detail_by_acc_year.
  //
  // The CHECK constraints 20260728140000_sale_charge_detail_check_constraints
  // added (ck_cd_tax_apl / ck_cd_doc_type / ck_cd_type / ck_cd_method /
  // ck_cd_apply_on / ck_cd_cost_alloc) did NOT survive that 20260729071620
  // rebuild and are no longer in the database. The value sets they guarded live
  // on app-side only, as the TypeScript enums in
  // src/modules/master/charge-master/types/charge-enum.ts (ChargeDocType /
  // ChargeType / ChargeMethod / ChargeApplyOn / ChargeCostAlloc), which the DTOs
  // and CHARGE_DETAIL_VALUE_GUARDS both read:
  //   - cd_tax_apl and cd_before_tax are mutually exclusive.
  //     Taxed at the item rate, or carrying its own GST — never both.
  //   - cd_doc_type   PURCHASE | SALES | GRN | QUOTATION | INVOICE
  //   - cd_type       ADD | DEDUCT
  //   - cd_method     FIXED | QTY | NET_QTY | KG | QTL | TON | PERCENT (nullable)
  //   - cd_apply_on   FLAT | QTY | VALUE | WEIGHT (nullable)
  //   - cd_cost_alloc VALUE | QTY | WEIGHT (nullable)
  // cd_ledger_code / cd_comp_id / cd_branch_id gained their FKs in migration
  // 20260728150000_sale_charge_detail_relations. cd_tax_code still carries NO
  // FK: the value is a snapshot and no module writes it from a tax master yet.
}

// ----- prisma/public/txnHold.prisma -----
// public.txn_hold is the parking bay for half-finished transactional work:
// a POS sale the operator pressed Hold on, a screen's own crash-recovery
// snapshot, or a saved template that is copied on resume. One row is one
// parked document; the document body itself lives verbatim in txhPayload and
// is read back only by the module that wrote it.
//
// It replaces public.transaction_hold (dropped in migration
// 20260810160000_add_txn_hold), which was sales/POS-only, unpartitioned, and
// kept its screen state in an untyped th_ui_state.
//
// LIST-partitioned by txhAccYear (the parked WORK's year), like
// public.txn_status_log / sales.sale_bill / sales.sale_order. Partitions (e.g.
// txn_hold_2026_2027) are created by
// public.ensure_acc_year_partitions('YYYY-YYYY') — run it whenever a fiscal
// year is opened, or every insert fails with "no partition of relation
// "txn_hold" found for row".
model TxnHold {
  txhId               String    @default(dbgenerated("uuidv7()")) @db.Uuid    @map("txh_id")
  txhCompanyId        String    @db.Uuid                                      @map("txh_company_id")
  txhBranchId         String    @db.Uuid                                      @map("txh_branch_id")
  txhTenantId         String?   @db.Uuid                                      @map("txh_tenant_id")
  txhAccYear          String    @db.Char(9)                                   @map("txh_acc_year")

  // ── What kind of parked work ─────────────────────────────────────────
  // HOLD | AUTOSAVE | TEMPLATE. At most one live AUTOSAVE per screen
  // (ux_txh_autosave), overwritten in place — see txhRevision.
  txhKind             String    @default("HOLD") @db.VarChar(15)              @map("txh_kind")

  // Which document this will become. Same vocabulary as txn_status_log's
  // tslSrcModule / tslSrcDocType, so one join reads a hold's trail.
  txhSrcModule        String    @db.VarChar(20)                               @map("txh_src_module")
  txhDocType          String    @db.VarChar(30)                               @map("txh_doc_type")

  // ── Identity of the hold itself ──────────────────────────────────────
  // txhHoldNo is what gets printed on the token slip; txhHoldSlno is the raw
  // per-device counter behind it, so an offline till can number holds with no
  // server round trip (same split as soOrderSlno / soOrderRefno).
  txhHoldNo           String    @db.VarChar(30)                               @map("txh_hold_no")
  txhHoldSlno         Int                                                     @map("txh_hold_slno")
  txhHoldOn           DateTime  @default(now()) @db.Timestamptz(6)            @map("txh_hold_on")

  // ── Where it was parked ──────────────────────────────────────────────
  // The device owns the number series, so its FK is RESTRICT: a till can be
  // blocked or retired, never unlinked from its holds. Device TYPE is
  // deliberately absent — it is one join into fixed.device_master.
  txhDeviceId         String    @db.Uuid                                      @map("txh_device_id")
  txhCounterId        String?   @db.Uuid                                      @map("txh_counter_id")
  txhSessionId        String?   @db.Uuid                                      @map("txh_session_id")
  txhHeldBy           String    @db.Uuid                                      @map("txh_held_by")

  // ── Party snapshot, for the pick list only ───────────────────────────
  // PARTY, not customer: the same row parks a purchase entry (supplier), a
  // stock transfer (branch), a receipt (ledger) or a job card (employee).
  // txhPartyType says which master txhPartyId points into — polymorphic, so
  // no FK and no relation field. Denormalised on purpose: the picker must
  // render without opening the payload, and a walk-in has no party row at all.
  txhPartyType        String?   @db.VarChar(15)                               @map("txh_party_type")
  txhPartyId          String?   @db.Uuid                                      @map("txh_party_id")
  txhPartyName        String?   @db.VarChar(150)                              @map("txh_party_name")
  txhPartyMobile      String?   @db.VarChar(20)                               @map("txh_party_mobile")
  // Salesman on a sales document, buyer on a purchase one, technician on a
  // job card — always public.employee_master, so this one keeps its FK.
  txhStaffId          String?   @db.Uuid                                      @map("txh_staff_id")
  // Free label the floor recognises the hold by: table 7, bay 3, locker 12.
  txhRefLabel         String?   @db.VarChar(50)                               @map("txh_ref_label")

  // ── Roll-up caches (pick list + sweeper) ─────────────────────────────
  // Three numbers, because three is what a pick list shows. Every other
  // total — gross, discount, charge, tax, what was already tendered — is in
  // the payload, where the module that computed it reads it back.
  txhItemCount        Int       @default(0)                                   @map("txh_item_count")
  txhTotalQty         Decimal   @default(0) @db.Decimal(18, 3)                @map("txh_total_qty")
  txhNetAmount        Decimal   @default(0) @db.Decimal(18, 2)                @map("txh_net_amount")

  // ── The document itself ──────────────────────────────────────────────
  // The module's own save body, verbatim. This table never interprets it.
  txhPayload          Json      @db.JsonB                                     @map("txh_payload")
  // Version of the payload's own shape, so an old hold resumed after a client
  // upgrade is readable.
  txhPayloadVersion   Int       @default(1) @db.SmallInt                      @map("txh_payload_version")
  // Bumped on every overwrite. An offline till that re-syncs an older
  // snapshot loses to the higher revision.
  txhRevision         Int       @default(1)                                   @map("txh_revision")

  // ── State ────────────────────────────────────────────────────────────
  // HELD | LOCKED | RESUMED | CONVERTED | EXPIRED | CANCELLED | ABANDONED
  txhStatus           String    @default("HELD") @db.VarChar(15)              @map("txh_status")
  txhHoldReason       String?   @db.VarChar(100)                              @map("txh_hold_reason")
  txhRemarks          String?   @db.VarChar(500)                              @map("txh_remarks")
  // When the sweeper may retire it. NULL = keeps until someone acts.
  txhExpiresOn        DateTime? @db.Timestamptz(6)                            @map("txh_expires_on")

  // ── Lease ────────────────────────────────────────────────────────────
  // All-or-nothing (ck_txh_lock_block): a lease with no end is the bug this
  // column set exists to prevent. txhLockToken proves the releaser.
  txhLockedBy         String?   @db.Uuid                                      @map("txh_locked_by")
  txhLockedDeviceId   String?   @db.Uuid                                      @map("txh_locked_device_id")
  txhLockedOn         DateTime? @db.Timestamptz(6)                            @map("txh_locked_on")
  txhLockExpiresOn    DateTime? @db.Timestamptz(6)                            @map("txh_lock_expires_on")
  txhLockToken        String?   @db.Uuid                                      @map("txh_lock_token")

  // ── Resume ───────────────────────────────────────────────────────────
  txhResumedBy        String?   @db.Uuid                                      @map("txh_resumed_by")
  txhResumedOn        DateTime? @db.Timestamptz(6)                            @map("txh_resumed_on")
  txhResumeCount      Int       @default(0)                                   @map("txh_resume_count")

  // ── Conversion — the hold's one and only exit into a real document ───
  // No converted doc TYPE: a hold becomes the document it was parked as, so
  // txhDocType already names the table these ids point into. The year is kept
  // separately because a March hold can become an April document.
  txhConvertedDocId   String?   @db.Uuid                                      @map("txh_converted_doc_id")
  txhConvertedAccYear String?   @db.Char(9)                                   @map("txh_converted_acc_year")
  txhConvertedRefno   String?   @db.VarChar(100)                              @map("txh_converted_refno")
  txhConvertedOn      DateTime? @db.Timestamptz(6)                            @map("txh_converted_on")
  txhConvertedBy      String?   @db.Uuid                                      @map("txh_converted_by")

  // ── Stock held against the parked work ───────────────────────────────
  // A flag only: does this hold owe stock back? Who reserved and when is a
  // txn_status_log event; the reserved quantities are in the payload.
  txhIsStockReserved  Boolean   @default(false)                               @map("txh_is_stock_reserved")

  // ── Token slip ───────────────────────────────────────────────────────
  txhPrintCount       Int       @default(0) @db.SmallInt                      @map("txh_print_count")
  txhLastPrintedOn    DateTime? @db.Timestamptz(6)                            @map("txh_last_printed_on")

  // ── Audit ────────────────────────────────────────────────────────────
  // created_by / modified_by are VarChar(50) to match every other table in
  // this schema set; the OPERATIONAL actors above (held / locked / resumed /
  // converted _by) are uuid, like tslChangedBy, because screens filter on them.
  txhIsDeleted        Boolean   @default(false)                               @map("txh_is_deleted")
  txhSyncDate         DateTime? @db.Timestamptz(6)                            @map("txh_sync_date")
  txhCreatedOn        DateTime  @default(now()) @db.Timestamptz(6)            @map("txh_created_on")
  txhCreatedBy        String    @db.VarChar(50)                               @map("txh_created_by")
  txhModifiedOn       DateTime? @db.Timestamptz(6)                            @map("txh_modified_on")
  txhModifiedBy       String?   @db.VarChar(50)                               @map("txh_modified_by")

  // Relations
  device              DeviceMaster    @relation("TxnHoldDevice", fields: [txhDeviceId], references: [devId], onUpdate: Cascade, onDelete: Restrict, map: "fk_txh_device")
  lockDevice          DeviceMaster?   @relation("TxnHoldLockDevice", fields: [txhLockedDeviceId], references: [devId], onUpdate: Cascade, onDelete: SetNull, map: "fk_txh_lock_device")
  staff               EmployeeMaster? @relation(fields: [txhStaffId], references: [empId], onUpdate: Cascade, onDelete: SetNull, map: "fk_txh_staff")
  // No relation fields for:
  //   txhCompanyId / txhBranchId / txhTenantId — the DDL declares no FKs, so a
  //                    parked row never pins a master row.
  //   txhHeldBy / txhLockedBy / txhResumedBy / txhConvertedBy — operators, no FK.
  //   txhCounterId / txhSessionId — user_login_sessions.uls_session_id is
  //                    nullable and not unique, so it is not a valid FK target.
  //   txhPartyId     — polymorphic; the master varies by txhPartyType.
  //   txhConvertedDocId — polymorphic; the table varies by txhDocType.

  @@id([txhId, txhAccYear], map: "pk_txn_hold")

  // EVERY index on this table is PARTIAL, and Prisma ignores WHERE predicates —
  // a declared @@unique/@@index would drift into a non-partial CREATE INDEX on
  // the same name on the next migrate dev. They live in migration
  // 20260810160000_add_txn_hold as raw SQL:
  //
  //   ux_txh_hold_no       (company, branch, acc_year, doc_type, hold_no)  WHERE NOT deleted
  //   ux_txh_device_slno   (company, branch, acc_year, device, doc_type, slno) WHERE NOT deleted
  //   ux_txh_autosave      (acc_year, device, held_by, doc_type)
  //                        WHERE kind = 'AUTOSAVE' AND status = 'HELD' AND NOT deleted
  //   ix_txh_pick_list     (company, branch, doc_type, status, hold_on DESC)
  //                        WHERE kind = 'HOLD' AND NOT deleted
  //   ix_txh_device_open   (company, branch, device, status, hold_on DESC)  WHERE NOT deleted
  //   ix_txh_counter_session (counter, session, status)                     WHERE NOT deleted
  //   ix_txh_expiry        (expires_on)      WHERE expires_on IS NOT NULL
  //                        AND status IN ('HELD','LOCKED') AND NOT deleted
  //   ix_txh_lock_expiry   (lock_expires_on) WHERE status = 'LOCKED' AND lock_expires_on IS NOT NULL
  //   ix_txh_converted_doc (converted_doc_id) WHERE converted_doc_id IS NOT NULL
  //   ix_txh_party         (company, branch, party_type, party_id, hold_on DESC)
  //                        WHERE party_id IS NOT NULL AND NOT deleted
  //   ix_txh_party_mobile  (company, branch, party_mobile) WHERE party_mobile IS NOT NULL AND NOT deleted
  //   ix_txh_stock_reserved (company, branch, hold_on DESC)
  //                        WHERE is_stock_reserved AND NOT deleted
  //   ix_txh_sync_pending  (device, modified_on) WHERE sync_date IS NULL
  //
  // No GIN index on txh_payload: nothing queries INTO a hold's document — the
  // module opens the row it already picked.
  //
  // CHECK constraints (DB-only): ck_txh_kind, ck_txh_src_module,
  //   ck_txh_doc_type, ck_txh_status, ck_txh_party_type, ck_txh_party_typed,
  //   ck_txh_hold_no_shape, ck_txh_hold_slno, ck_txh_payload_object,
  //   ck_txh_payload_version, ck_txh_revision, ck_txh_amounts,
  //   ck_txh_print_count, ck_txh_expires_after_hold, ck_txh_lock_block,
  //   ck_txh_locked_status, ck_txh_resume_count, ck_txh_resume_block,
  //   ck_txh_converted_block, ck_txh_converted_status, ck_txh_printed

  @@map("txn_hold")
  @@schema("public")
}

// ----- prisma/public/txnStatusLog.prisma -----
// Append-only status trail for every transactional document (quotation,
// order, challan, bill, return, voucher, ...). One row per status step; a
// document's history is the ordered set of its rows. Rows are written once
// and never edited — correcting history means appending, not rewriting, which
// is why there is no modified_on/modified_by pair here.
//
// LIST-partitioned by tslAccYear (the SOURCE DOCUMENT's year), like
// sales.sale_bill / sales.sale_bill_item / accounts.acc_tender_detail.
// Partitions (e.g. txn_status_log_2026_2027) are created by
// public.ensure_acc_year_partitions('YYYY-YYYY') — run it whenever a fiscal
// year is opened, or every insert fails with "no partition of relation ...".
model TxnStatusLog {
  tslId              String    @default(dbgenerated("uuidv7()")) @db.Uuid   @map("tsl_id")
  tslCompanyId       String    @db.Uuid                                     @map("tsl_company_id")
  tslBranchId        String    @db.Uuid                                     @map("tsl_branch_id")
  tslTenantId        String?   @db.Uuid                                     @map("tsl_tenant_id")
  tslAccYear         String    @db.Char(9)                                  @map("tsl_acc_year")

  // ── Which document ───────────────────────────────────────────────────
  tslSrcModule       String    @db.VarChar(20)                              @map("tsl_src_module")
  tslSrcDocType      String    @db.VarChar(30)                              @map("tsl_src_doc_type")
  tslSrcDocId        String    @db.Uuid                                     @map("tsl_src_doc_id")
  tslSrcDocRefno     String?   @db.VarChar(100)                             @map("tsl_src_doc_refno")
  tslSeqNo           Int                                                    @map("tsl_seq_no")

  // ── What happened ────────────────────────────────────────────────────
  tslEvent           String    @db.VarChar(30)                              @map("tsl_event")
  tslFromStatus      String?   @db.VarChar(20)                              @map("tsl_from_status")
  tslToStatus        String    @db.VarChar(20)                              @map("tsl_to_status")
  tslChangedOn       DateTime  @default(now()) @db.Timestamptz(6)           @map("tsl_changed_on")
  tslChangedBy       String    @db.Uuid                                     @map("tsl_changed_by")
  tslRemarks         String?   @db.VarChar(500)                             @map("tsl_remarks")

  // Where it happened, for a device-level audit in an offline chain.
  tslDeviceId        String?   @db.Uuid                                     @map("tsl_device_id")
  tslSessionId       String?   @db.Uuid                                     @map("tsl_session_id")

  // ── Party notification that accompanied the step ─────────────────────
  tslNotifyChannel   String?   @db.VarChar(20)                              @map("tsl_notify_channel")
  tslNotifiedOn      DateTime? @db.Timestamptz(6)                           @map("tsl_notified_on")
  tslNotifyRef       String?   @db.VarChar(100)                             @map("tsl_notify_ref")

  // ── Audit ────────────────────────────────────────────────────────────
  tslIsDeleted       Boolean   @default(false)                              @map("tsl_is_deleted")
  tslSyncDate        DateTime? @db.Timestamptz(6)                           @map("tsl_sync_date")
  tslCreatedOn       DateTime  @default(now()) @db.Timestamptz(6)           @map("tsl_created_on")
  tslCreatedBy       String    @db.VarChar(50)                              @map("tsl_created_by")

  // Relations
  device             DeviceMaster? @relation(fields: [tslDeviceId], references: [devId], onUpdate: Cascade, onDelete: SetNull, map: "fk_tsl_device")
  // No relation fields for:
  //   tslCompanyId / tslBranchId / tslChangedBy
  //                  — the DDL declares no FKs for them; a log row must survive
  //                    even if the actor row is later reorganised.
  //   tslTenantId    — no Tenant model exists in this schema (same as sb_tenant_id).
  //   tslSessionId   — user_login_sessions.uls_session_id is nullable and not
  //                    unique, so it is not a valid FK target.
  //   tslSrcDocId    — polymorphic; the target table varies by
  //                    tslSrcModule/tslSrcDocType.

  @@id([tslId, tslAccYear], map: "pk_txn_status_log")

  // One document's trail in order — the History button's query, and the
  // uniqueness of the sequence within a document. Intentionally NOT partial.
  @@unique([tslSrcDocType, tslSrcDocId, tslAccYear, tslSeqNo], map: "ux_tsl_doc_seq")
  // Same trail, newest first, when a screen shows only the last few steps.
  @@index([tslSrcDocType, tslSrcDocId, tslChangedOn(sort: Desc)], map: "ix_tsl_doc_recent")

  // Partial indexes are DB-only — Prisma ignores WHERE predicates, so
  // declaring them here would produce phantom drift on every migrate dev:
  //
  //   CREATE INDEX ix_tsl_branch_period
  //       ON public.txn_status_log
  //          (tsl_company_id, tsl_branch_id, tsl_acc_year, tsl_changed_on DESC)
  //       WHERE tsl_is_deleted = false;
  //
  //   CREATE INDEX ix_tsl_user_event
  //       ON public.txn_status_log (tsl_changed_by, tsl_event, tsl_changed_on DESC)
  //       WHERE tsl_is_deleted = false;
  //
  //   CREATE INDEX ix_tsl_module_event
  //       ON public.txn_status_log
  //          (tsl_src_module, tsl_event, tsl_acc_year, tsl_changed_on DESC)
  //       WHERE tsl_is_deleted = false;
  //
  //   -- notification retry queue
  //   CREATE INDEX ix_tsl_notify_pending
  //       ON public.txn_status_log (tsl_changed_on)
  //       WHERE tsl_notify_channel IS NOT NULL
  //         AND tsl_notify_channel <> 'NONE'
  //         AND tsl_notified_on IS NULL;
  //
  // CHECK constraints (DB-only): ck_tsl_src_module, ck_tsl_src_doc_type,
  //   ck_tsl_seq_no, ck_tsl_event_shape, ck_tsl_to_status_shape,
  //   ck_tsl_from_status_shape, ck_tsl_reason_required, ck_tsl_notify_channel,
  //   ck_tsl_notified

  @@map("txn_status_log")
  @@schema("public")
}

