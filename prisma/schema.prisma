  sbiCessPerc        Decimal   @default(0) @db.Decimal(15, 4) @map("sbi_cess_perc")
  sbiCessPerUnit     Decimal   @default(0) @db.Decimal(15, 4) @map("sbi_cess_per_unit")
  sbiCessAmt         Decimal   @default(0) @db.Decimal(15, 2) @map("sbi_cess_amt")
  sbiAcessPerc       Decimal   @default(0) @db.Decimal(15, 4) @map("sbi_acess_perc")
  sbiAcessPerUnit    Decimal   @default(0) @db.Decimal(15, 4) @map("sbi_acess_per_unit")
  sbiAcessAmt        Decimal   @default(0) @db.Decimal(15, 2) @map("sbi_acess_amt")
  sbiBatchConfig     Int       @default(0) @map("sbi_batch_config")
  // Per-line charges
  sbiFreightQty      Decimal   @default(0) @db.Decimal(15, 3) @map("sbi_freight_qty")
  sbiFreightAmt      Decimal   @default(0) @db.Decimal(15, 2) @map("sbi_freight_amt")
  sbiLoadQty         Decimal   @default(0) @db.Decimal(15, 3) @map("sbi_load_qty")
  sbiLoadAmt         Decimal   @default(0) @db.Decimal(15, 2) @map("sbi_load_amt")
  sbiUnloadQty       Decimal   @default(0) @db.Decimal(15, 3) @map("sbi_unload_qty")
  sbiUnloadAmt       Decimal   @default(0) @db.Decimal(15, 2) @map("sbi_unload_amt")
  sbiRoundOff        Decimal   @default(0) @db.Decimal(15, 2) @map("sbi_round_off")
  sbiNetAmt          Decimal   @default(0) @db.Decimal(15, 2) @map("sbi_net_amt")
  // Costing / margin, PER UNIT
  sbiSoldPrice       Decimal?  @db.Decimal(15, 4) @map("sbi_sold_price")
  sbiSoldPreTax      Decimal?  @db.Decimal(15, 2) @map("sbi_sold_pre_tax")
  sbiItemProfit      Decimal?  @db.Decimal(15, 2) @map("sbi_item_profit")
  sbiProfitPreTax    Decimal?  @db.Decimal(15, 2) @map("sbi_profit_pre_tax")
  sbiMrpSavings      Decimal?  @db.Decimal(15, 3) @map("sbi_mrp_savings")
  sbiMrpSavingsPerc  Decimal?  @db.Decimal(15, 4) @map("sbi_mrp_savings_perc")
  // Attribution
  sbiSalesmanId      String?   @db.Uuid @map("sbi_salesman_id")
  sbiSchemeId        String?   @db.Uuid @map("sbi_scheme_id")
  sbiSchemeName      String?   @db.VarChar(150) @map("sbi_scheme_name")
  sbiRemarks         String?   @db.VarChar(250) @map("sbi_remarks")
  // Audit
  sbiIsDeleted       Boolean   @default(false) @map("sbi_is_deleted")
  sbiSyncDate        DateTime? @db.Timestamptz(6) @map("sbi_sync_date")
  sbiCreatedOn       DateTime  @default(now()) @db.Timestamptz(6) @map("sbi_created_on")
  sbiCreatedBy       String    @db.Text @map("sbi_created_by")
  sbiModifiedOn      DateTime? @db.Timestamptz(6) @map("sbi_modified_on")
  sbiModifiedBy      String?   @db.Text @map("sbi_modified_by")
  // Relations
  bill               SaleBill           @relation(fields: [sbiBillId, sbiAccYear], references: [sbId, sbAccYear], onDelete: Cascade, onUpdate: Cascade, map: "fk_sbi_bill")
  item               ItemMaster         @relation(fields: [sbiItemId], references: [itemId], onDelete: Restrict, onUpdate: Cascade, map: "fk_sbi_item")
  priceLevel         ItemPriceLevel     @relation("SaleBillItemPriceLevel", fields: [sbiPriceLevel], references: [iplId], onDelete: Restrict, onUpdate: Cascade, map: "fk_sbi_price_level")
  // sbiItemUnitId references item_unit_conversion(iuc_id), NOT item_unit_master(unit_id)
  itemUnitConversion ItemUnitConversion @relation("SaleBillItemUnitConversion", fields: [sbiItemUnitId], references: [iucId], onDelete: Restrict, onUpdate: Cascade, map: "fk_sbi_item_unit")
  // ck_sbi_free_type, ck_sbi_split_no and ck_sbi_batch_split were dropped
  // before the migration was ever applied and are enforced in the
  // application layer instead (BillService.ensureBillItemValuesAreAllowed).
  @@id([sbiId, sbiAccYear], map: "pk_sale_bill_item")
  // Migration 20260813050000. The sale-order module re-derives soi_delivered_qty
  // by summing these rows for one order — across every partition, since an order
  // taken in one year is routinely billed in the next — so the src-doc reference
  // needs an index of its own. Plain and non-unique, so unlike the DB-only
  // partial indexes on sale_order_item it is safe to declare here.
  @@index([sbiSrcDocId, sbiSrcDocYear, sbiSrcDocLineNo], map: "ix_sbi_src_doc")
  @@map("sale_bill_item")
  @@schema("sales")
}

// ----- prisma/sales/saleFreightCharges.prisma -----
model SaleFreightCharge {
  frId          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid   @map("fr_id")
  frBranchId    String?   @db.Uuid                                         @map("fr_branch_id")
  frCompanyId   String?   @db.Uuid                                         @map("fr_company_id")
  frFromKm      Int?      @default(0)                                     @map("fr_from_km")
  frToKm        Int?      @default(0)                                     @map("fr_to_km")
  frFromWeight  Decimal?  @default(0.0) @db.Decimal                        @map("fr_from_weight")
  frToWeight    Decimal?  @default(0.0) @db.Decimal                        @map("fr_to_weight")
  frFreightChrg Decimal?  @default(0.0) @db.Decimal                        @map("fr_freight_chrg")
  frIsActive    Boolean   @default(true)                                   @map("fr_is_active")
  frIsDeleted   Boolean   @default(false)                                  @map("fr_is_deleted")
  frSyncDate    DateTime? @db.Timestamptz                                  @map("fr_sync_date")
  frCreatedOn   DateTime  @default(now()) @db.Timestamptz                  @map("fr_created_on")
  frCreatedBy   String?   @db.VarChar(100)                                 @map("fr_created_by")
  frModifiedOn  DateTime  @default(now()) @db.Timestamptz                  @map("fr_modified_on")
  frModifiedBy  String?   @db.VarChar(100)                                 @map("fr_modified_by")

  // Relations
  company       Company?      @relation("CompanyFreightCharges", fields: [frCompanyId], references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_fr_company_id")
  branch        BranchMaster? @relation("BranchFreightCharges", fields: [frBranchId], references: [brId], onUpdate: Cascade, onDelete: Restrict, map: "fk_fr_branch_id")

  @@index([frIsActive], name: "idx_fr_active")
  // DB-only partial unique index uq_fr_slab_scope (migration 20260721140000):
  // (frCompanyId, frBranchId, frFromKm, frToKm, frFromWeight, frToWeight),
  // NULLS NOT DISTINCT, WHERE fr_is_deleted = false. Prisma cannot express the
  // WHERE predicate; declaring it as @@unique here would make `migrate dev`
  // regenerate it without the predicate and fail on the existing name.
  // Do NOT add @@unique for it.
  @@map("sale_freight_charges")
  @@schema("sales")
}

// ----- prisma/sales/saleLoadingCharges.prisma -----
model SaleLoadingCharge {
  ilcId         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid   @map("ilc_id")
  ilcCompId     String?   @db.Uuid                                         @map("ilc_comp_id")
  ilcBranchId   String?   @db.Uuid                                         @map("ilc_branch_id")
  ilcFromWeight Decimal?  @default(0.0) @db.Decimal                        @map("ilc_from_weight")
  ilcToWeight   Decimal?  @default(0.0) @db.Decimal                        @map("ilc_to_weight")
  ilcLoadChrg   Decimal?  @default(0.0) @db.Decimal                        @map("ilc_load_chrg")
  ilcUnloadChrg Decimal?  @default(0.0) @db.Decimal                        @map("ilc_unload_chrg")
  ilcIsActive   Boolean   @default(true)                                   @map("ilc_is_active")
  ilcIsDeleted  Boolean   @default(false)                                  @map("ilc_is_deleted")
  ilcSyncDate   DateTime? @db.Timestamptz                                  @map("ilc_sync_date")
  ilcCreatedOn  DateTime  @default(now()) @db.Timestamptz                  @map("ilc_created_on")
  ilcCreatedBy  String?   @db.VarChar(100)                                 @map("ilc_created_by")
  ilcModifiedOn DateTime  @default(now()) @db.Timestamptz                  @map("ilc_modified_on")
  ilcModifiedBy String?   @db.VarChar(100)                                 @map("ilc_modified_by")

  // Relations
  company       Company?      @relation("CompanyLoadingCharges", fields: [ilcCompId], references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_ilc_comp_id")
  branch        BranchMaster? @relation("BranchLoadingCharges", fields: [ilcBranchId], references: [brId], onUpdate: Cascade, onDelete: Restrict, map: "fk_ilc_branch_id")

  @@index([ilcIsActive], name: "idx_ilc_active")
  // DB-only GiST exclusion constraint excl_ilc_slab_overlap (migration
  // 20260728120000): no two non-deleted rows may share a scope AND overlap on
  // weight -- COALESCE(comp_id, nil uuid) =, COALESCE(branch_id, nil uuid) =,
  // numrange(COALESCE(from_weight, 0), to_weight, '[)') &&, WHERE
  // ilc_is_deleted = false. It is what makes the item-price lookup's `auto`
  // slab match single-valued. Prisma can express neither EXCLUDE constraints
  // nor the WHERE predicate, so it lives only in the migration -- do NOT try to
  // declare it here.
  @@map("sale_loading_charges")
  @@schema("sales")
}

// ----- prisma/sales/saleOrder.prisma -----
// sales.sale_order is LIST-partitioned by so_acc_year, like sales.sale_bill /
// sales.sale_bill_item and accounts.acc_tender_detail. Partitions (e.g.
// sale_order_2026_2027) are created by
// public.ensure_acc_year_partitions('YYYY-YYYY') — run it whenever a fiscal
// year is opened, or every insert fails with "no partition of relation
// "sale_order" found for row".
model SaleOrder {
  soId                 String    @default(dbgenerated("uuidv7()")) @db.Uuid @map("so_id")
  soCompanyId          String    @db.Uuid @map("so_company_id")
  soBranchId           String    @db.Uuid @map("so_branch_id") // branch that TOOK the order
  soTenantId           String?   @db.Uuid @map("so_tenant_id")
  soAccYear            String    @db.Char(9) @map("so_acc_year")
  // Where it was raised. The DEVICE is the counter — there is no separate
  // counter id: fixed.device_master is the register of billing points, and
  // soDeviceId keys the per-device number series (ux_so_slno). NOT NULL,
  // because in an offline chain the device owns the document and its series.
  // Device name / type / platform / MAC are NOT snapshotted here; they are
  // reachable through the FK and a device does not change identity.
  soSessionId          String?   @db.Uuid @map("so_session_id")
  soDeviceId           String    @db.Uuid @map("so_device_id")
  // Document identity
  soDocType            String    @default("SALES_ORDER") @db.VarChar(30) @map("so_doc_type")
  soOrderType          String    @default("CASH") @db.VarChar(20) @map("so_order_type") // CASH | CREDIT
  soPriceLevel         Int       @map("so_price_level")
  soOrderSlno          BigInt    @map("so_order_slno") // per company/branch/year/DEVICE
  soOrderRefno         String    @db.VarChar(100) @map("so_order_refno")
  soUsrRefno           String?   @db.VarChar(100) @map("so_usr_refno")
  soOrderDate          DateTime  @db.Date @map("so_order_date")
  soOrderDatetime      DateTime  @default(now()) @db.Timestamptz(6) @map("so_order_datetime")
  // Delivery window. The date agreed with the customer (legacy ord_del_date).
  // Lines may carry their own when an order is delivered in parts — see
  // soiDeliveryDate.
  soDeliveryDate       DateTime? @db.Date @map("so_delivery_date")
  soDeliverySlot       String?   @db.VarChar(30) @map("so_delivery_slot") // 'FN' | 'AN' | '10-12' ... free text by design
  soPriority           String    @default("NORMAL") @db.VarChar(10) @map("so_priority")
  soValidUntil         DateTime? @db.Date @map("so_valid_until") // unclaimed booking lapses
  // Where it came from: quotation (usually), or an imported/marketplace order.
  // Polymorphic, so no FK — but the source's OWN accounting year is kept,
  // because a March quotation can become an April order.
  soSrcDocType         String?   @db.VarChar(30) @map("so_src_doc_type")
  soSrcDocId           String?   @db.Uuid @map("so_src_doc_id")
  soSrcDocAccYear      String?   @db.Char(9) @map("so_src_doc_acc_year")
  soSrcDocRefno        String?   @db.VarChar(100) @map("so_src_doc_refno")
  soSrcDocDate         DateTime? @db.Date @map("so_src_doc_date")
  // How the goods reach the customer. The branch that takes the order is the
  // branch that supplies and bills it — inter-branch movement is an inventory
  // transfer document with no link to this one.
  soDeliveryMode       String    @default("STORE_PICKUP") @db.VarChar(20) @map("so_delivery_mode")
  // Customer, snapshotted at order time
  soCustId             String    @db.Uuid @map("so_cust_id")
  soCustName           String    @db.VarChar(200) @map("so_cust_name")
  soCustAddr           String?   @db.VarChar(500) @map("so_cust_addr")
  soCustPlace          String?   @db.VarChar(100) @map("so_cust_place")
  soCustPin            String?   @db.VarChar(10) @map("so_cust_pin")
  soCustPhone          String?   @db.VarChar(20) @map("so_cust_phone")
  soCustEmail          String?   @db.VarChar(150) @map("so_cust_email")
  soCustGstin          String?   @db.VarChar(15) @map("so_cust_gstin")
  soCustGstType        String?   @db.VarChar(20) @map("so_cust_gst_type")
  soCustStcd           String?   @db.Char(2) @map("so_cust_stcd")
  soPosStcd            String?   @db.Char(2) @map("so_pos_stcd") // place of supply: CGST+SGST vs IGST
  soStateName          String?   @db.VarChar(100) @map("so_state_name")
  soContactPerson      String?   @db.VarChar(150) @map("so_contact_person")
  soContactPhone       String?   @db.VarChar(20) @map("so_contact_phone")
  // Ship-to, snapshotted separately from the billing address
  soShipName           String?   @db.VarChar(200) @map("so_ship_name")
  soShipAddr           String?   @db.VarChar(500) @map("so_ship_addr")
  soShipPlace          String?   @db.VarChar(100) @map("so_ship_place")
  soShipPin            String?   @db.VarChar(10) @map("so_ship_pin")
  soShipPhone          String?   @db.VarChar(20) @map("so_ship_phone")
  soShipStcd           String?   @db.Char(2) @map("so_ship_stcd")
  soShipLandmark       String?   @db.VarChar(250) @map("so_ship_landmark")
  soShipLat            Decimal?  @db.Decimal(9, 6) @map("so_ship_lat")
  soShipLng            Decimal?  @db.Decimal(9, 6) @map("so_ship_lng")
  // Options carried on the document
  soHasLoad            Boolean   @default(false) @map("so_has_load")
  soHasUnload          Boolean   @default(false) @map("so_has_unload")
  soHasFreight         Boolean   @default(false) @map("so_has_freight")
  soHasPromo           Boolean   @default(false) @map("so_has_promo")
  soHasComm            Boolean   @default(false) @map("so_has_comm")
  soHasLoyalty         Boolean   @default(false) @map("so_has_loyalty")
  // People. Delivery crew and vehicle are NOT here: an order is a commitment,
  // not a despatch. Who loaded it and what it went on is the bill's / delivery
  // challan's fact (sale_bill.sb_driver_id, sb_vehicle_id, sb_loadman_id).
  soUserId             String    @db.Uuid @map("so_user_id")
  soSalesmanId         String[]  @db.Uuid @map("so_salesman_id")
  soAgentId            String?   @db.Uuid @map("so_agent_id")
  soAgentCommPerc      Decimal?  @db.Decimal(15, 4) @map("so_agent_comm_perc")
  soAgentCommAmt       Decimal?  @db.Decimal(15, 2) @map("so_agent_comm_amt")
  soPackedId           String[]  @db.Uuid @map("so_packed_id")
  // Quantities
  soTotItems           Int       @default(0) @map("so_tot_items") // ordered LINES
  soDeliveredItems     Int       @default(0) @map("so_delivered_items") // fully delivered LINES
  soTotWeight          Decimal   @default(0) @db.Decimal(15, 3) @map("so_tot_weight")
  soTotBags            Decimal   @default(0) @db.Decimal(15, 3) @map("so_tot_bags")
  // Money (same shape and order as sale_bill)
  soGrossAmt           Decimal   @default(0) @db.Decimal(15, 2) @map("so_gross_amt")
  soItemDisc           Decimal   @default(0) @db.Decimal(15, 2) @map("so_item_disc")
  soSplDisc            Decimal   @default(0) @db.Decimal(15, 2) @map("so_spl_disc")
  soSchDisc            Decimal   @default(0) @db.Decimal(15, 2) @map("so_sch_disc")
  soBillSchDisc        Decimal   @default(0) @db.Decimal(15, 2) @map("so_bill_sch_disc")
  soAddlDisc1          Decimal   @default(0) @db.Decimal(15, 2) @map("so_addl_disc1")
  soAddlDisc2          Decimal   @default(0) @db.Decimal(15, 2) @map("so_addl_disc2")
  soCashDiscPerc       Decimal   @default(0) @db.Decimal(15, 4) @map("so_cash_disc_perc")
  soCashDisc           Decimal   @default(0) @db.Decimal(15, 2) @map("so_cash_disc")
  soTaxableAmt         Decimal   @default(0) @db.Decimal(15, 2) @map("so_taxable_amt") // POST-charge
  soCgstAmt            Decimal   @default(0) @db.Decimal(15, 2) @map("so_cgst_amt")
  soSgstAmt            Decimal   @default(0) @db.Decimal(15, 2) @map("so_sgst_amt")
  soIgstAmt            Decimal   @default(0) @db.Decimal(15, 2) @map("so_igst_amt")
  soCessAmt            Decimal   @default(0) @db.Decimal(15, 2) @map("so_cess_amt")
  soTaxAmt             Decimal   @default(0) @db.Decimal(15, 2) @map("so_tax_amt")
  // Roll-ups of sales.sale_doc_charge rows (reporting without a join).
  soFreightAmt         Decimal   @default(0) @db.Decimal(15, 2) @map("so_freight_amt")
  soLoadAmt            Decimal   @default(0) @db.Decimal(15, 2) @map("so_load_amt")
  soUnloadAmt          Decimal   @default(0) @db.Decimal(15, 2) @map("so_unload_amt")
  soOtherAmt1          Decimal   @default(0) @db.Decimal(15, 2) @map("so_other_amt1")
  soOtherAmt2          Decimal   @default(0) @db.Decimal(15, 2) @map("so_other_amt2")
  soRoundOff           Decimal   @default(0) @db.Decimal(15, 2) @map("so_round_off")
  soOrderAmt           Decimal   @default(0) @db.Decimal(15, 2) @map("so_order_amt") // the order value
  // Costing (never printed; drives margin reports)
  soTotalCost          Decimal?  @db.Decimal(15, 2) @map("so_total_cost")
  soMarginAmt          Decimal?  @db.Decimal(15, 2) @map("so_margin_amt")
  soMarginAmtWot       Decimal?  @db.Decimal(15, 2) @map("so_margin_amt_wot")
  soMarginPerc         Decimal?  @db.Decimal(15, 4) @map("so_margin_perc")
  soMarginPercWot      Decimal?  @db.Decimal(15, 4) @map("so_margin_perc_wot")
  soMrpSavings         Decimal?  @default(0) @db.Decimal(15, 3) @map("so_mrp_savings")
  soMrpSavingsPerc     Decimal?  @default(0) @db.Decimal(15, 4) @map("so_mrp_savings_perc")
  // Advance payment. Policy is snapshotted per order because it is negotiated
  // per order (a custom-cut order takes 50%, a stocked item takes a token).
  soAdvancePolicy      String    @default("NONE") @db.VarChar(10) @map("so_advance_policy")
  soAdvancePerc        Decimal   @default(0) @db.Decimal(15, 4) @map("so_advance_perc")
  soAdvanceRequired    Decimal   @default(0) @db.Decimal(15, 2) @map("so_advance_required")
  soAdvanceDueDate     DateTime? @db.Date @map("so_advance_due_date")
  soIsAdvanceMandatory Boolean   @default(false) @map("so_is_advance_mandatory")
  soAdvanceLedgerId    String?   @db.Uuid @map("so_advance_ledger_id") // customer-advance liability ledger
  // Roll-ups. Received comes from accounts.acc_tender_detail; the other three
  // are stated by the caller. Balance is what the company still HOLDS, and
  // ck_so_advance_balance keeps it honest.
  soAdvanceRecdAmt     Decimal   @default(0) @db.Decimal(15, 2) @map("so_advance_recd_amt")
  soAdvanceAdjustedAmt Decimal   @default(0) @db.Decimal(15, 2) @map("so_advance_adjusted_amt")
  soAdvanceRefundAmt   Decimal   @default(0) @db.Decimal(15, 2) @map("so_advance_refund_amt")
  soAdvanceForfeitAmt  Decimal   @default(0) @db.Decimal(15, 2) @map("so_advance_forfeit_amt")
  soAdvanceBalanceAmt  Decimal   @default(0) @db.Decimal(15, 2) @map("so_advance_balance_amt")
  soAdvanceStatus      String?    @default("NONE") @db.VarChar(20) @map("so_advance_status")
  soAdvanceRecdOn      DateTime? @db.Timestamptz(6) @map("so_advance_recd_on") // first instalment
  // Settlement roll-ups for the order itself (tender rows live in
  // accounts.acc_tender_detail; these are caches so a counter can balance
  // without a join).
  soPayMode            String?   @db.VarChar(20) @map("so_pay_mode")
  soSurchargeAmt       Decimal   @default(0) @db.Decimal(15, 2) @map("so_surcharge_amt")
  soTenderAmt          Decimal   @default(0) @db.Decimal(15, 2) @map("so_tender_amt")
  soRefundAmt          Decimal   @default(0) @db.Decimal(15, 2) @map("so_refund_amt")
  soPayStatus          String    @default("UNPAID") @db.VarChar(20) @map("so_pay_status")
  // Fulfilment caches (sale_bill / sale_bill_item are the truth)
  soBilledAmt          Decimal   @default(0) @db.Decimal(15, 2) @map("so_billed_amt")
  soCancelledAmt       Decimal   @default(0) @db.Decimal(15, 2) @map("so_cancelled_amt")
  soPendingAmt         Decimal   @default(0) @db.Decimal(15, 2) @map("so_pending_amt")
  soFulfilStatus       String    @default("PENDING") @db.VarChar(20) @map("so_fulfil_status")
  soLastBilledOn       DateTime? @db.Timestamptz(6) @map("so_last_billed_on")
  soCompletedOn        DateTime? @db.Timestamptz(6) @map("so_completed_on") // last line delivered
  // Terms
  soPaymentTerms       String?   @db.VarChar(250) @map("so_payment_terms")
  soDeliveryTerms      String?   @db.VarChar(250) @map("so_delivery_terms")
  soTermsConditions    String?   @map("so_terms_conditions")
  soRemarks            String?   @db.VarChar(500) @map("so_remarks")
  // Pricing policy, snapshotted as this order was priced
  soFreightCalcType    String?   @db.VarChar(12) @map("so_freight_calc_type")
  soLoadingCalcType    String?   @db.VarChar(12) @map("so_loading_calc_type")
  soDiscAlterBase      Boolean?  @map("so_disc_alter_base")
  soRoundOffStep       Decimal   @default(1) @db.Decimal(15, 2) @map("so_round_off_step")
  // Lifecycle. soStatus is the CURRENT state and the ONLY lifecycle column
  // here — a cache of the newest log row's tsl_to_status, which is what the
  // list screen filters on.
  //
  // Everything else about how the order got here — who confirmed, who approved
  // an override, who cancelled and why, when each step happened — is owned by
  // public.txn_status_log, the trail every document in every module shares.
  // The cancellation reason therefore lives in that row's tsl_remarks, and the
  // "a cancelled order must say why" invariant is enforced there by
  // ck_tsl_reason_required — not by a duplicate column on this table.
  soStatus             String    @default("DRAFT") @db.VarChar(20) @map("so_status")
  soVersionNo          Int       @default(1) @map("so_version_no")
  soPrintCount         Int       @default(0) @map("so_print_count")
  // Audit
  soIsDeleted          Boolean   @default(false) @map("so_is_deleted")
  soSyncDate           DateTime? @db.Timestamptz(6) @map("so_sync_date")
  soCreatedOn          DateTime  @default(now()) @db.Timestamptz(6) @map("so_created_on")
  soCreatedBy          String    @db.VarChar(50) @map("so_created_by")
  soModifiedOn         DateTime? @db.Timestamptz(6) @map("so_modified_on")
  soModifiedBy         String?   @db.VarChar(50) @map("so_modified_by")
  // Relations
  items                 SaleOrderItem[]
  customer      Customer         @relation(fields: [soCustId], references: [cusId], onDelete: Restrict, onUpdate: Cascade, map: "fk_so_cust")
  posState      StateCode?       @relation("SaleOrderPosState", fields: [soPosStcd], references: [stateCode], onDelete: Restrict, onUpdate: Cascade, map: "fk_so_pos_state")
  shipState     StateCode?       @relation("SaleOrderShipState", fields: [soShipStcd], references: [stateCode], onDelete: Restrict, onUpdate: Cascade, map: "fk_so_ship_state")
  priceLevel    ItemPriceLevel   @relation("SaleOrderPriceLevel", fields: [soPriceLevel], references: [iplId], onDelete: Restrict, onUpdate: Cascade, map: "fk_so_price_level")
  agent         EmployeeMaster?  @relation("SaleOrderAgent", fields: [soAgentId], references: [empId], onDelete: Restrict, onUpdate: Cascade, map: "fk_so_salesman_agent")
  advanceLedger AccLedgerMaster? @relation("SaleOrderAdvanceLedger", fields: [soAdvanceLedgerId], references: [ledId], onDelete: Restrict, onUpdate: Cascade, map: "fk_so_advance_ledger")
  // RESTRICT, not SET NULL: the device owns this document's number series, so
  // it can be blocked or deactivated but never unlinked.
  device        DeviceMaster     @relation(fields: [soDeviceId], references: [devId], onDelete: Restrict, onUpdate: Cascade, map: "fk_so_device")
  // No relation fields for soCompanyId / soBranchId / soUserId / soSessionId /
  // soSalesmanId[] / soPackedId[] / soTenantId — the DDL declares no FKs for
  // them (arrays cannot carry one, and there is no Tenant model).
  //
  // DB-only partial indexes (migration 20260808132323): ix_so_list,
  // ix_so_status, ix_so_pending, ix_so_advance_held, ix_so_src_doc and the
  // unique ux_so_slno / ux_so_order_no. Prisma cannot express their WHERE
  // predicates; declaring them here makes `migrate dev` regenerate them
  // without the predicate and fail on the existing names. Do NOT add
  // @@unique/@@index for them — ux_so_slno / ux_so_order_no uniqueness must be
  // checked app-side (or rely on the DB error).
  //
  // Beware when reading that DB error: because sale_order is PARTITIONED, a
  // duplicate is reported against the PARTITION-LOCAL index, not the parent —
  // e.g. "sale_order_2026_2027_so_company_id_so_branch_id_so_acc_yea_idx4",
  // never "ux_so_order_no". The name is positional and changes per year, so
  // the trick quotation.service.ts uses (matching P2002 meta.target against
  // the literal 'ux_sq_slno', on the UNpartitioned sale_quotation) does not
  // port here. Match on the column list in meta.target, or pre-check.
  //
  // CHECK constraints (DB-only): ck_so_doc_type, ck_so_order_type,
  // ck_so_priority, ck_so_delivery_mode, ck_so_status, ck_so_fulfil_status,
  // ck_so_pay_status, ck_so_advance_policy, ck_so_advance_status,
  // ck_so_advance_amounts, ck_so_advance_balance, ck_so_advance_policy_input.
  @@id([soId, soAccYear], map: "pk_sale_order")
  @@index([soCustId], map: "ix_so_cust")
  @@map("sale_order")
  @@schema("sales")
}

// ----- prisma/sales/saleOrderItem.prisma -----
// One row per ORDERED LINE (not per batch: an order allocates no stock).
// Fulfilment is tracked as two written caches — delivered and cancelled — from
// which soi_pending_qty and soi_line_status are GENERATED, so "what is still
// pending" never needs the bill table and can never disagree with itself.
//
// LIST-partitioned by soi_acc_year — see the note on SaleOrder.
model SaleOrderItem {
  soiId               String    @default(dbgenerated("uuidv7()")) @db.Uuid @map("soi_id")
  soiOrderId          String    @db.Uuid @map("soi_order_id")
  soiCompanyId        String    @db.Uuid @map("soi_company_id")
  soiBranchId         String    @db.Uuid @map("soi_branch_id")
  soiTenantId         String?   @db.Uuid @map("soi_tenant_id")
  soiAccYear          String    @db.Char(9) @map("soi_acc_year")
  soiLineNo           Int       @map("soi_line_no")
  // Which line of which source document this came from (quotation).
  soiSrcDocType       String?   @db.VarChar(30) @map("soi_src_doc_type")
  soiSrcDocId         String?   @db.Uuid @map("soi_src_doc_id")
  soiSrcDocAccYear    String?   @db.Char(9) @map("soi_src_doc_acc_year")
  soiSrcDocRefno      String?   @db.VarChar(100) @map("soi_src_doc_refno")
  soiSrcLineNo        Int?      @map("soi_src_line_no")
  // What is being ordered
  soiItemId           String    @db.Uuid @map("soi_item_id")
  soiItemUnitId       String    @db.Uuid @map("soi_item_unit_id")
  soiToBaseFactor     Decimal   @default(0) @db.Decimal(15, 6) @map("soi_to_base_factor")
  soiHsnCode          String?   @db.VarChar(8) @map("soi_hsn_code")
  soiPriceLevel       Int       @map("soi_price_level")
  soiEanCode          String?   @db.VarChar(100) @map("soi_ean_code")
  // Free-text dimension the operator typed, e.g. a timber shop's "12*6*2*10"
  // (length ft * width in * thickness in * pieces), which is what soiOrderQty
  // was derived from. Stored verbatim so a reprint shows the size the customer
  // agreed to, not just the cubic feet it became.
  soiSize             String?   @db.VarChar(50) @map("soi_size")
  soiSizeUom          String?   @db.VarChar(20) @map("soi_size_uom")
  // Reservation (a soft hold; inventory owns the hard one)
  soiGodownId         String?   @db.Uuid @map("soi_godown_id")
  soiIsReserved       Boolean   @default(false) @map("soi_is_reserved")
  soiReservedQty      Decimal   @default(0) @db.Decimal(15, 3) @map("soi_reserved_qty")
  soiReserveExpiresOn DateTime? @db.Date @map("soi_reserve_expires_on")
  // Flags
  soiIsTaxIncl        Boolean   @default(false) @map("soi_is_tax_incl")
  soiIsPromo          Boolean   @default(false) @map("soi_is_promo")
  soiIsFree           Boolean   @default(false) @map("soi_is_free")
  soiFreeType         String?   @db.VarChar(20) @map("soi_free_type") // NULL / SCHEME / SAMPLE / REPLACEMENT (ck_soi_free_type in DB)
  soiIsService        Boolean   @default(false) @map("soi_is_service")
  soiHasFreight       Boolean   @default(false) @map("soi_has_freight")
  // Quantities
  soiCaseQty          Decimal   @default(0) @db.Decimal(15, 3) @map("soi_case_qty")
  soiOrderQty         Decimal   @default(0) @db.Decimal(15, 3) @map("soi_order_qty")
  soiLengthQty        Decimal?  @default(0) @db.Decimal(15, 3) @map("soi_length_qty")
  soiNetQty           Decimal   @default(0) @db.Decimal(15, 3) @map("soi_net_qty")
  soiWeightQty        Decimal?  @default(0) @db.Decimal(15, 3) @map("soi_weight_qty")
  soiAvailableStock   Decimal   @default(0) @db.Decimal(15, 3) @map("soi_available_stock") // at order time
  // Fulfilment caches — sale_bill_item is the truth (sbi_src_doc_id).
  soiDeliveredQty     Decimal   @default(0) @db.Decimal(15, 3) @map("soi_delivered_qty")
  soiCancelledQty     Decimal   @default(0) @db.Decimal(15, 3) @map("soi_cancelled_qty")
  // GENERATED ALWAYS ... STORED as round(net - delivered - cancelled, 3)
  // (migration 20260814060000). Read-only: writing it raises 428C9. The
  // no-arg dbgenerated() is what stops `migrate dev` emitting DROP DEFAULT.
  soiPendingQty       Decimal   @default(dbgenerated()) @db.Decimal(15, 3) @map("soi_pending_qty")
  soiBilledAmt        Decimal   @default(0) @db.Decimal(15, 2) @map("soi_billed_amt")
  // Rates
  soiRate             Decimal   @default(0) @db.Decimal(15, 4) @map("soi_rate")
  soiRatePreTax       Decimal   @default(0) @db.Decimal(15, 4) @map("soi_rate_pre_tax")
  soiRateDiff         Decimal   @default(0) @db.Decimal(15, 4) @map("soi_rate_diff")
  soiActPrice         Decimal?  @db.Decimal(15, 4) @map("soi_act_price")
  soiMaxPrice         Decimal?  @db.Decimal(15, 4) @map("soi_max_price") // MRP
  soiMinPrice         Decimal?  @db.Decimal(15, 4) @map("soi_min_price")
  soiCostPrice        Decimal?  @db.Decimal(15, 4) @map("soi_cost_price")
  soiCostPreTax       Decimal?  @db.Decimal(15, 2) @map("soi_cost_pre_tax")
  // A confirmed order holds its price even if the price master moves; false
  // lets the bill re-price at delivery (long-lead custom orders).
  soiIsRateLocked     Boolean   @default(true) @map("soi_is_rate_locked")
  // Discounts
  soiItemDiscPerc     Decimal   @default(0) @db.Decimal(15, 4) @map("soi_item_disc_perc")
  soiItemDiscQty      Decimal   @default(0) @db.Decimal(15, 3) @map("soi_item_disc_qty")
  soiItemDiscAmt      Decimal   @default(0) @db.Decimal(15, 2) @map("soi_item_disc_amt")
  soiSplDiscPerc      Decimal   @default(0) @db.Decimal(15, 4) @map("soi_spl_disc_perc")
  soiSplDiscQty       Decimal   @default(0) @db.Decimal(15, 3) @map("soi_spl_disc_qty")
  soiSplDiscAmt       Decimal   @default(0) @db.Decimal(15, 2) @map("soi_spl_disc_amt")
  soiSchDiscPerc      Decimal   @default(0) @db.Decimal(15, 4) @map("soi_sch_disc_perc")
  soiSchDiscQty       Decimal   @default(0) @db.Decimal(15, 3) @map("soi_sch_disc_qty")
  soiSchDiscAmt       Decimal   @default(0) @db.Decimal(15, 2) @map("soi_sch_disc_amt")
  soiBillSchPerc      Decimal   @default(0) @db.Decimal(15, 4) @map("soi_bill_sch_perc")
  soiBillSchQty       Decimal   @default(0) @db.Decimal(15, 3) @map("soi_bill_sch_qty")
  soiBillSchAmt       Decimal   @default(0) @db.Decimal(15, 2) @map("soi_bill_sch_amt")
  soiAddlDisc1Perc    Decimal   @default(0) @db.Decimal(15, 4) @map("soi_addl_disc1_perc")
  soiAddlDisc1Amt     Decimal   @default(0) @db.Decimal(15, 2) @map("soi_addl_disc1_amt")
  soiAddlDisc2Perc    Decimal   @default(0) @db.Decimal(15, 4) @map("soi_addl_disc2_perc")
  soiAddlDisc2Amt     Decimal   @default(0) @db.Decimal(15, 2) @map("soi_addl_disc2_amt")
  soiCashDiscPerc     Decimal   @default(0) @db.Decimal(15, 4) @map("soi_cash_disc_perc")
  soiCashDiscAmt      Decimal   @default(0) @db.Decimal(15, 2) @map("soi_cash_disc_amt")
  // The charge-distribution trio
  soiGrossAmt         Decimal   @default(0) @db.Decimal(15, 2) @map("soi_gross_amt")
  soiNetGross         Decimal?  @db.Decimal(14, 4) @map("soi_net_gross")
  soiChrgBeforeTax    Decimal?  @db.Decimal(14, 4) @map("soi_chrg_before_tax")
  soiChrgAfterTax     Decimal?  @db.Decimal(14, 4) @map("soi_chrg_after_tax")
  // Tax (on the POST-charge taxable)
  soiTaxableAmt       Decimal   @default(0) @db.Decimal(15, 2) @map("soi_taxable_amt")
  soiTaxPerc          Decimal   @default(0) @db.Decimal(15, 4) @map("soi_tax_perc")
  soiTaxAmt           Decimal   @default(0) @db.Decimal(15, 2) @map("soi_tax_amt")
  soiCgstPerc         Decimal   @default(0) @db.Decimal(15, 4) @map("soi_cgst_perc")
  soiCgstAmt          Decimal   @default(0) @db.Decimal(15, 2) @map("soi_cgst_amt")
  soiSgstPerc         Decimal   @default(0) @db.Decimal(15, 4) @map("soi_sgst_perc")
  soiSgstAmt          Decimal   @default(0) @db.Decimal(15, 2) @map("soi_sgst_amt")
  soiIgstPerc         Decimal   @default(0) @db.Decimal(15, 4) @map("soi_igst_perc")
  soiIgstAmt          Decimal   @default(0) @db.Decimal(15, 2) @map("soi_igst_amt")
  soiCessPerc         Decimal   @default(0) @db.Decimal(15, 4) @map("soi_cess_perc")
  soiCessPerUnit      Decimal   @default(0) @db.Decimal(15, 4) @map("soi_cess_per_unit")
  soiCessAmt          Decimal   @default(0) @db.Decimal(15, 2) @map("soi_cess_amt")
  soiAcessPerc        Decimal   @default(0) @db.Decimal(15, 4) @map("soi_acess_perc")
  soiAcessPerUnit     Decimal   @default(0) @db.Decimal(15, 4) @map("soi_acess_per_unit")
  soiAcessAmt         Decimal   @default(0) @db.Decimal(15, 2) @map("soi_acess_amt")
  // Per-line charges
  soiFreightQty       Decimal   @default(0) @db.Decimal(15, 3) @map("soi_freight_qty")
  soiFreightAmt       Decimal   @default(0) @db.Decimal(15, 2) @map("soi_freight_amt")
  soiLoadQty          Decimal   @default(0) @db.Decimal(15, 3) @map("soi_load_qty")
  soiLoadAmt          Decimal   @default(0) @db.Decimal(15, 2) @map("soi_load_amt")
  soiUnloadQty        Decimal   @default(0) @db.Decimal(15, 3) @map("soi_unload_qty")
  soiUnloadAmt        Decimal   @default(0) @db.Decimal(15, 2) @map("soi_unload_amt")
  soiRoundOff         Decimal   @default(0) @db.Decimal(15, 2) @map("soi_round_off")
  soiNetAmt           Decimal   @default(0) @db.Decimal(15, 2) @map("soi_net_amt")
  // Costing / margin, PER UNIT
  soiSoldPrice        Decimal?  @db.Decimal(15, 4) @map("soi_sold_price")
  soiSoldPreTax       Decimal?  @db.Decimal(15, 2) @map("soi_sold_pre_tax")
  soiItemProfit       Decimal?  @db.Decimal(15, 2) @map("soi_item_profit")
  soiProfitPreTax     Decimal?  @db.Decimal(15, 2) @map("soi_profit_pre_tax")
  soiMrpSavings       Decimal?  @db.Decimal(15, 3) @map("soi_mrp_savings")
  soiMrpSavingsPerc   Decimal?  @db.Decimal(15, 4) @map("soi_mrp_savings_perc")
  // Line fulfilment / attribution
  soiDeliveryDate     DateTime? @db.Date @map("soi_delivery_date") // a split delivery per line
  // GENERATED ALWAYS ... STORED from the three quantities (migration
  // 20260814060000) — PENDING / PARTIAL / DELIVERED / CANCELLED. Read-only.
  soiLineStatus       String    @default(dbgenerated()) @db.VarChar(20) @map("soi_line_status")
  soiSalesmanId       String?   @db.Uuid @map("soi_salesman_id")
  soiSchemeId         String?   @db.Uuid @map("soi_scheme_id")
  soiSchemeName       String?   @db.VarChar(150) @map("soi_scheme_name")
  soiRemarks          String?   @db.VarChar(250) @map("soi_remarks")
  soiCancelReason     String?   @db.VarChar(250) @map("soi_cancel_reason")
  // Audit
  soiIsDeleted        Boolean   @default(false) @map("soi_is_deleted")
  soiSyncDate         DateTime? @db.Timestamptz(6) @map("soi_sync_date")
  soiCreatedOn        DateTime  @default(now()) @db.Timestamptz(6) @map("soi_created_on")
  soiCreatedBy        String    @db.VarChar(50) @map("soi_created_by")
  soiModifiedOn       DateTime? @db.Timestamptz(6) @map("soi_modified_on")
  soiModifiedBy       String?   @db.VarChar(50) @map("soi_modified_by")
  // Relations
  order              SaleOrder          @relation(fields: [soiOrderId, soiAccYear], references: [soId, soAccYear], onDelete: Cascade, onUpdate: Cascade, map: "fk_soi_order")
  item               ItemMaster         @relation(fields: [soiItemId], references: [itemId], onDelete: Restrict, onUpdate: Cascade, map: "fk_soi_item")
  priceLevel         ItemPriceLevel     @relation("SaleOrderItemPriceLevel", fields: [soiPriceLevel], references: [iplId], onDelete: Restrict, onUpdate: Cascade, map: "fk_soi_price_level")
  // soiItemUnitId references item_unit_conversion(iuc_id), NOT item_unit_master(unit_id)
  itemUnitConversion ItemUnitConversion @relation("SaleOrderItemUnitConversion", fields: [soiItemUnitId], references: [iucId], onDelete: Restrict, onUpdate: Cascade, map: "fk_soi_item_unit")
  // DB-only partial indexes (migration 20260808132323): the unique
  // ux_soi_order_line, plus ix_soi_pending_item and ix_soi_reserved. Prisma
  // cannot express their WHERE predicates; declaring them here makes
  // `migrate dev` regenerate them without the predicate and fail on the
  // existing names. Do NOT add @@unique/@@index for them.
  //
  // CHECK constraints (DB-only): ck_soi_free_type, ck_soi_line_no,
  // ck_soi_line_status, ck_soi_qty_signs, ck_soi_reserved, ck_soi_size.
  // ck_soi_qty_balance was dropped by 20260814060000 — the balance identity is
  // now how soi_pending_qty is computed, so the CHECK was a tautology.
  @@id([soiId, soiAccYear], map: "pk_sale_order_item")
  @@index([soiOrderId], map: "ix_soi_order")
  @@map("sale_order_item")
  @@schema("sales")
}

// ----- prisma/sales/saleQuotation.prisma -----
// LIST-partitioned by sq_acc_year (migration 20260810130000), like sale_bill
// and sale_order. Postgres requires the partition key in every unique
// constraint, so the primary key is (sq_id, sq_acc_year) and a row is addressed
// by that pair -- `where: { sqId_sqAccYear: { sqId, sqAccYear } }` -- never by
// sqId alone. A new accounting year needs its partitions created before the
// first save: SELECT public.ensure_acc_year_partitions('YYYY-YYYY').
model SaleQuotation {
  sqId               String    @default(dbgenerated("uuidv7()")) @db.Uuid @map("sq_id")
  // scope
  sqCompanyId        String    @db.Uuid @map("sq_company_id")
  sqBranchId         String    @db.Uuid @map("sq_branch_id")
  sqTenantId         String?   @db.Uuid @map("sq_tenant_id")
  sqAccYear          String    @db.Char(9) @map("sq_acc_year")
  sqSessionId        String?   @db.Uuid @map("sq_session_id")
  sqCategoryId       String?   @db.Uuid @map("sq_category_id")
  sqPriceLevel       Int       @map("sq_price_level")
  // document identity
  sqDocType          String    @default("QUOTATION") @db.VarChar(30) @map("sq_doc_type")
  sqQuoteSlno        BigInt    @map("sq_quote_slno")
  sqQuoteRefno       String   @db.VarChar(100) @map("sq_quote_refno")
  sqUsrRefno         String?   @db.VarChar(100) @map("sq_usr_refno")
  sqQuoteDate        DateTime  @db.Date @map("sq_quote_date")
  sqQuoteDatetime    DateTime  @default(now()) @db.Timestamptz(6) @map("sq_quote_datetime")
  sqValidUntil       DateTime? @db.Date @map("sq_valid_until")
  sqValidityDays     Int?      @map("sq_validity_days")
  // revision / versioning
  sqRevisionNo       Int       @default(0) @map("sq_revision_no")
  sqParentQuoteId    String?   @db.Uuid @map("sq_parent_quote_id")
  // The parent revision's accounting year — the second half of its composite
  // primary key. Set exactly when sqParentQuoteId is (ck_sq_parent_pair).
  sqParentAccYear    String?   @db.Char(9) @map("sq_parent_acc_year")
  // source (enquiry / lead) -- polymorphic, no FK
  sqSrcDocType       String?   @db.VarChar(30) @map("sq_src_doc_type")
  sqSrcDocId         String?   @db.Uuid @map("sq_src_doc_id")
  sqSrcDocRefno      String?   @db.VarChar(100) @map("sq_src_doc_refno")
  sqSrcDocDate       DateTime? @db.Timestamptz(6) @map("sq_src_doc_date")
  // customer / prospect snapshot (sq_cust_id nullable: may be a prospect)
  sqCustId           String?   @db.Uuid @map("sq_cust_id")
  sqCustAreaId       String?   @db.Uuid @map("sq_cust_area_id")
  sqCustName         String    @db.VarChar(200) @map("sq_cust_name")
  sqCustAddr         String?   @db.VarChar(500) @map("sq_cust_addr")
  sqCustPlace        String?   @db.VarChar(100) @map("sq_cust_place")
  sqCustPhone        String?   @db.VarChar(20) @map("sq_cust_phone")
  sqCustEmail        String?   @db.VarChar(150) @map("sq_cust_email")
  sqCustGstin        String?   @db.VarChar(15) @map("sq_cust_gstin")
  sqCustGstType      String?   @db.VarChar(20) @map("sq_cust_gst_type")
  sqCustStcd         String?   @db.Char(2) @map("sq_cust_stcd")
  sqPosStcd          String?   @db.Char(2) @map("sq_pos_stcd")
  sqStateName        String?   @db.VarChar(100) @map("sq_state_name")
  sqContactPerson    String?   @db.VarChar(150) @map("sq_contact_person")
  sqContactPhone     String?   @db.VarChar(20) @map("sq_contact_phone")
  // applicability flags
  sqHasLoad          Boolean   @default(false) @map("sq_has_load")
  sqHasUnload        Boolean   @default(false) @map("sq_has_unload")
  sqHasFreight       Boolean   @default(false) @map("sq_has_freight")
  sqHasPromo         Boolean   @default(false) @map("sq_has_promo")
  sqHasComm          Boolean   @default(false) @map("sq_has_comm")
  // people
  sqUserId           String    @db.Uuid @map("sq_user_id")
  sqSalesmanId       String?   @db.Uuid @map("sq_salesman_id")
  sqAgentId          String?   @db.Uuid @map("sq_agent_id")
  // counts / weight
  sqTotItems         Int       @default(0) @map("sq_tot_items")
  sqTotWeight        Decimal   @default(0) @db.Decimal(15, 3) @map("sq_tot_weight")
  sqTotBags          Decimal   @default(0) @db.Decimal(15, 3) @map("sq_tot_bags")
  // amounts (priced-out offer)
  sqGrossAmt         Decimal   @default(0) @db.Decimal(15, 2) @map("sq_gross_amt")
  sqItemDisc         Decimal   @default(0) @db.Decimal(15, 2) @map("sq_item_disc")
  sqSplDisc          Decimal   @default(0) @db.Decimal(15, 2) @map("sq_spl_disc")
  sqSchDisc          Decimal   @default(0) @db.Decimal(15, 2) @map("sq_sch_disc")
  sqBillSchDisc      Decimal   @default(0) @db.Decimal(15, 2) @map("sq_bill_sch_disc")
  sqAddlDisc1        Decimal   @default(0) @db.Decimal(15, 2) @map("sq_addl_disc1")
  sqAddlDisc2        Decimal   @default(0) @db.Decimal(15, 2) @map("sq_addl_disc2")
  sqTaxableAmt       Decimal   @default(0) @db.Decimal(15, 2) @map("sq_taxable_amt")
  sqCgstAmt          Decimal   @default(0) @db.Decimal(15, 2) @map("sq_cgst_amt")
  sqSgstAmt          Decimal   @default(0) @db.Decimal(15, 2) @map("sq_sgst_amt")
  sqIgstAmt          Decimal   @default(0) @db.Decimal(15, 2) @map("sq_igst_amt")
  sqCessAmt          Decimal   @default(0) @db.Decimal(15, 2) @map("sq_cess_amt")
  sqTaxAmt           Decimal   @default(0) @db.Decimal(15, 2) @map("sq_tax_amt")
  sqFreightAmt       Decimal   @default(0) @db.Decimal(15, 2) @map("sq_freight_amt")
  sqLoadAmt          Decimal   @default(0) @db.Decimal(15, 2) @map("sq_load_amt")
  sqUnloadAmt        Decimal   @default(0) @db.Decimal(15, 2) @map("sq_unload_amt")
  sqOtherAmt1        Decimal   @default(0) @db.Decimal(15, 2) @map("sq_other_amt1")
  sqOtherAmt2        Decimal   @default(0) @db.Decimal(15, 2) @map("sq_other_amt2")
  sqRoundOff         Decimal   @default(0) @db.Decimal(15, 2) @map("sq_round_off")
  sqQuoteAmt         Decimal   @default(0) @db.Decimal(15, 2) @map("sq_quote_amt")
  // internal margin (never printed)
  sqTotalCost        Decimal?  @db.Decimal(15, 2) @map("sq_total_cost")
  sqMarginAmt        Decimal?  @db.Decimal(15, 2) @map("sq_margin_amt")
  sqMarginPerc       Decimal?  @db.Decimal(15, 4) @map("sq_margin_perc")
  // terms
  sqPaymentTerms     String?   @db.VarChar(250) @map("sq_payment_terms")
  sqDeliveryTerms    String?   @db.VarChar(250) @map("sq_delivery_terms")
  sqTermsConditions  String?   @map("sq_terms_conditions")
  // status + conversion tracking
  // DRAFT / SENT / ACCEPTED / REJECTED / EXPIRED / CONVERTED / CANCELLED (ck_sq_status in DB)
  sqStatus           String    @default("DRAFT") @db.VarChar(20) @map("sq_status")
  sqSentOn           DateTime? @db.Timestamptz(6) @map("sq_sent_on")
  sqAcceptedOn       DateTime? @db.Timestamptz(6) @map("sq_accepted_on")
  sqRejectedOn       DateTime? @db.Timestamptz(6) @map("sq_rejected_on")
  sqRejectReason     String?   @db.VarChar(250) @map("sq_reject_reason")
  sqConvertedDocType String?   @db.VarChar(30) @map("sq_converted_doc_type")
  sqConvertedDocId   String?   @db.Uuid @map("sq_converted_doc_id")
  sqConvertedOn      DateTime? @db.Timestamptz(6) @map("sq_converted_on")
  // approval / cancel
  sqApprovedOn       DateTime? @db.Timestamptz(6) @map("sq_approved_on")
  sqApprovedBy       String?   @db.Uuid @map("sq_approved_by")
  sqCancelledOn      DateTime? @db.Timestamptz(6) @map("sq_cancelled_on")
  sqCancelledBy      String?   @db.Uuid @map("sq_cancelled_by")
  sqCancelReason     String?   @db.VarChar(250) @map("sq_cancel_reason")
  sqMrpSavings       Decimal?   @default(0) @db.Decimal(15,3) @map("sq_mrp_savings")
  sqMrpSavingsPerc   Decimal?   @default(0) @db.Decimal(15,4) @map("sq_mrp_savings_perc")
  // print / device / sync + audit
  sqPrintCount       Int       @default(0) @map("sq_print_count")
  sqDeviceType       String?   @db.VarChar(20) @map("sq_device_type")
  // Free text, not a uuid: clients identify the originating device with a
  // fingerprint / hostname string, which no uuid column can hold.
  sqDeviceId         String?   @db.Text @map("sq_device_id")
  sqRemarks          String?   @db.VarChar(500) @map("sq_remarks")
  sqIsDeleted        Boolean   @default(false) @map("sq_is_deleted")
  sqSyncDate         DateTime? @db.Timestamptz(6) @map("sq_sync_date")
  sqCreatedOn        DateTime  @default(now()) @db.Timestamptz(6) @map("sq_created_on")
  sqCreatedBy        String    @db.Text @map("sq_created_by")
  sqModifiedOn       DateTime? @db.Timestamptz(6) @map("sq_modified_on")
  sqModifiedBy       String?   @db.Text @map("sq_modified_by")
  // charge calculation preferences -- ChargeMethod snapshot
  // (FIXED / QTY / NET_QTY / KG / QTL / TON / PERCENT), no DB check constraint
  sqFreightCalcType  String?   @db.VarChar(12) @map("sq_freight_calc_type")
  sqLoadingCalcType  String?   @db.VarChar(12) @map("sq_loading_calc_type")
  // true = discounts change the basis the charges are computed on
  sqDiscAlterBase    Boolean?  @map("sq_disc_alter_base")
  // Relations
  parentQuote SaleQuotation?      @relation("SaleQuotationRevisions", fields: [sqParentQuoteId, sqParentAccYear], references: [sqId, sqAccYear], onDelete: NoAction, onUpdate: NoAction, map: "fk_sq_parent")
  revisions   SaleQuotation[]     @relation("SaleQuotationRevisions")
  items       SaleQuotationItem[]
  customer    Customer?           @relation(fields: [sqCustId], references: [cusId], onDelete: Restrict, onUpdate: Cascade, map: "fk_sq_cust")
  custArea    AreaMaster?         @relation(fields: [sqCustAreaId], references: [armId], onDelete: Restrict, onUpdate: Cascade, map: "fk_sq_cust_area")
  priceLevel  ItemPriceLevel      @relation(fields: [sqPriceLevel], references: [iplId], onDelete: Restrict, onUpdate: Cascade, map: "fk_sq_price_level")
  posState    StateCode?          @relation(fields: [sqPosStcd], references: [stateCode], onDelete: Restrict, onUpdate: Cascade, map: "fk_sq_pos_state")
  salesman    EmployeeMaster?     @relation(fields: [sqSalesmanId], references: [empId], onDelete: Restrict, onUpdate: Cascade, map: "fk_sq_salesman")
  // DB-only partial indexes (migration 20260708120000): ux_sq_quote_no and
  // ux_sq_slno (unique per company/branch/year among non-deleted rows),
  // ix_sq_cust, ix_sq_status, ix_sq_valid, ix_sq_conv, ix_sq_parent.
  // Prisma cannot express their WHERE predicates; declaring them here makes
  // `migrate dev` regenerate them without the predicate and fail on the
  // existing names. Do NOT add @@unique/@@index for them.
  //
  // CHECK constraints (DB-only): ck_sq_status, ck_sq_parent_pair.
  @@id([sqId, sqAccYear], map: "pk_sale_quotation")
  @@index([sqCompanyId, sqBranchId, sqQuoteDate], map: "ix_sq_date")
  @@map("sale_quotation")
  @@schema("sales")
}

// ----- prisma/sales/saleQuotationItem.prisma -----
// Batch/expiry/available_stock here are INFORMATIONAL (availability shown while
// quoting). A quote allocates NO stock -- allocation happens at DC/invoice.
//
// LIST-partitioned by sqi_acc_year -- see the note on SaleQuotation. A line
// always carries its header's year, which is what puts the two in the same
// partition and lets fk_sqi_quote reference the header's composite key.
model SaleQuotationItem {
  sqiId              String    @default(dbgenerated("uuidv7()")) @db.Uuid @map("sqi_id")
  sqiQuoteId         String    @db.Uuid @map("sqi_quote_id")
  sqiCompanyId       String    @db.Uuid @map("sqi_company_id")
  sqiBranchId        String    @db.Uuid @map("sqi_branch_id")
  // Nullable to follow sq_tenant_id: a line inherits the header's tenant, so it
  // cannot be NOT NULL once the header's is optional.
  sqiTenantId        String?   @db.Uuid @map("sqi_tenant_id")
  sqiAccYear         String    @db.Char(9) @map("sqi_acc_year")
  // source (enquiry line -> quote line) -- polymorphic, no FK
  sqiSrcDocType      String?   @db.VarChar(30) @map("sqi_src_doc_type")
  sqiSrcItemId       String?   @db.Uuid @map("sqi_src_item_id")
  sqiSrcUnitId       String?   @db.Uuid @map("sqi_src_unit_id")
  sqiSrcDocRefno     String?   @db.VarChar(100) @map("sqi_src_doc_refno")
  sqiSrcItemQty      Decimal?  @db.Decimal(15, 3) @map("sqi_src_item_qty")
  sqiLineNo          Int       @map("sqi_line_no")
  sqiItemId          String    @db.Uuid @map("sqi_item_id")
  sqiItemUnitId      String    @db.Uuid @map("sqi_item_unit_id")
  sqiHsnCode         String?   @db.VarChar(8) @map("sqi_hsn_code")
  sqiPriceLevel      Int       @map("sqi_price_level")
  sqiEanCode         String?   @db.VarChar(100) @map("sqi_ean_code")
