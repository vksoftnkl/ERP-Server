  ibsLastOutDate      DateTime?       @db.Date @map("ibs_last_out_date")

  // Status
  ibsIsActive         Boolean         @default(true) @map("ibs_is_active")
  ibsIsDeleted        Boolean         @default(true) @map("ibs_is_deleted")
  ibsRowVersion       BigInt          @default(1) @map("ibs_row_version")

  // Audit
  ibsCreatedOn        DateTime        @default(now()) @db.Timestamptz(6) @map("ibs_created_on")
  ibsCreatedBy        String?         @db.Uuid @map("ibs_created_by")
  ibsUpdatedOn        DateTime?       @db.Timestamptz(6) @map("ibs_updated_on")
  ibsUpdatedBy        String?         @db.Uuid @map("ibs_updated_by")

  // Relations
  batch               ItemBatchMaster @relation(fields: [ibsBatchId], references: [btmId], map: "fk_ibs_batch")

  @@unique([ibsAccYear, ibsCompanyId, ibsBranchId, ibsGodownId, ibsItemId, ibsBatchId, ibsStockBucket], map: "uq_ibs_scope")

  @@index([ibsAccYear, ibsCompanyId, ibsBranchId, ibsItemId], map: "idx_ibs_item")
  @@index([ibsAccYear, ibsCompanyId, ibsBranchId, ibsGodownId, ibsBatchId], map: "idx_ibs_batch")
  // Partial indexes `idx_ibs_expiry` and `idx_ibs_nonzero_stock` are maintained
  // in SQL because Prisma schema cannot express filtered indexes.

  @@map("item_batch_stock")
  @@schema("inventory")
}

