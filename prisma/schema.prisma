  avCreatedOn    DateTime         @default(now()) @map("av_created_on") @db.Timestamptz(6)
  avCreatedBy    String?          @map("av_created_by") @db.Uuid
  avUpdatedOn    DateTime?        @map("av_updated_on") @db.Timestamptz(6)
  avUpdatedBy    String?          @map("av_updated_by") @db.Uuid
  // Relations
  voucherHeader  AccVoucherHeader @relation(fields: [avVoucherId], references: [avhVoucherId], onDelete: Cascade, map: "fk_acc_vouchers_header")
