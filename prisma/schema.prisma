  ipmCompanyId        String?       @db.Uuid @map("ipm_company_id")
  ipmBranchId         String?       @db.Uuid @map("ipm_branch_id")
  ipmItemId           String        @db.Uuid @map("ipm_item_id")
  ipmUcUnitId         String        @db.Uuid @map("ipm_uc_unit_id")
  ipmGodownId         String?       @db.Uuid @map("ipm_godown_id") // NULL = price applies to every godown
  ipmSlNo             Int           @default(0) @db.Integer @map("ipm_sl_no")
  ipmCostPrice        Decimal       @default(0) @db.Decimal(18, 6) @map("ipm_cost_price")
  ipmCostWot          Decimal       @default(0) @db.Decimal(18, 6) @map("ipm_cost_wot")
  ipmSalesPriceA      Decimal       @default(0) @db.Decimal(18, 6) @map("ipm_sales_price_a")
  ipmSalesPriceB      Decimal       @default(0) @db.Decimal(18, 6) @map("ipm_sales_price_b")
  ipmSalesPriceC      Decimal       @default(0) @db.Decimal(18, 6) @map("ipm_sales_price_c")
  ipmSalesPriceD      Decimal       @default(0) @db.Decimal(18, 6) @map("ipm_sales_price_d")
  ipmPriceAWot        Decimal       @default(0) @db.Decimal(18, 6) @map("ipm_price_a_wot")
  ipmPriceBWot        Decimal       @default(0) @db.Decimal(18, 6) @map("ipm_price_b_wot")
  ipmPriceCWot        Decimal       @default(0) @db.Decimal(18, 6) @map("ipm_price_c_wot")
  ipmPriceDWot        Decimal       @default(0) @db.Decimal(18, 6) @map("ipm_price_d_wot")
  ipmPriceAMarkupPerc Decimal       @default(0) @db.Decimal(9, 3) @map("ipm_price_a_markup_perc")
  ipmPriceBMarkupPerc Decimal       @default(0) @db.Decimal(9, 3) @map("ipm_price_b_markup_perc")
  ipmPriceCMarkupPerc Decimal       @default(0) @db.Decimal(9, 3) @map("ipm_price_c_markup_perc")
  ipmPriceDMarkupPerc Decimal       @default(0) @db.Decimal(9, 3) @map("ipm_price_d_markup_perc")
  ipmMaxPrice         Decimal       @default(0) @db.Decimal(18, 6) @map("ipm_max_price")
  ipmMinPrice         Decimal       @default(0) @db.Decimal(18, 6) @map("ipm_min_price")
  ipmDiscPerc         Decimal       @default(0) @db.Decimal(9, 3) @map("ipm_disc_perc")
  ipmDiscQty          Decimal       @default(0) @db.Decimal(18, 6) @map("ipm_disc_qty")
  ipmAddlCess         Decimal       @default(0) @db.Decimal(18, 6) @map("ipm_addl_cess")
  ipmProfitType       String        @default("MANUAL") @db.VarChar(20) @map("ipm_profit_type")
  ipmRoundOff         Decimal       @default(0) @db.Decimal(10, 4) @map("ipm_round_off")
  ipmLoadingCharge    Decimal       @default(0) @db.Decimal(18, 6) @map("ipm_loading_charge")
  ipmFreightCharge    Decimal       @default(0) @db.Decimal(18, 6) @map("ipm_freight_charge")
  ipmLoyaltyPoints    Decimal       @default(0) @db.Decimal(18, 3) @map("ipm_loyalty_points")
  ipmUomRemarks       String?       @db.VarChar(250) @map("ipm_uom_remarks")
  ipmCostRemarks      String?       @db.VarChar(250) @map("ipm_cost_remarks")
  ipmIsActive         Boolean       @default(true) @map("ipm_is_active")
  ipmIsDeleted        Boolean       @default(false) @map("ipm_is_deleted")
  ipmSyncDate         DateTime?     @db.Timestamptz(6) @map("ipm_sync_date")
  ipmCreatedOn        DateTime      @default(now()) @db.Timestamptz(6) @map("ipm_created_on")
  ipmCreatedBy        String?       @db.Uuid @map("ipm_created_by")
  ipmUpdatedOn        DateTime?     @db.Timestamptz(6) @map("ipm_updated_on")
  ipmUpdatedBy        String?       @db.Uuid @map("ipm_updated_by")

  item                ItemMaster     @relation("ItemPrices", fields: [ipmItemId], references: [itemId], onUpdate: Cascade, onDelete: Restrict, map: "fk_ipm_item")
  company             Company?       @relation("CompanyItemPrices", fields: [ipmCompanyId], references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_ipm_company_id")
  branch              BranchMaster?  @relation("BranchItemPrices", fields: [ipmBranchId], references: [brId], onUpdate: Cascade, onDelete: Restrict, map: "fk_ipm_branch_id")
  itemUnitConversion ItemUnitConversion @relation("ItemPriceMasterUnitConversion", fields: [ipmUcUnitId], references: [iucId], onUpdate: Cascade, onDelete: Restrict, map: "fk_ipm_unit")
  godown              GodownLocation? @relation("GodownPrices", fields: [ipmGodownId], references: [gdlId], onUpdate: Cascade, onDelete: Restrict, map: "fk_ipm_godown_id")

  @@index([ipmItemId, ipmUcUnitId], map: "idx_item_price_master_item")
  @@map("item_price_master")
  @@schema("inventory")
  // Partial unique index uq_item_price_master_scope is not expressible in Prisma
  // schema: (ipm_company_id, ipm_branch_id, ipm_item_id, ipm_uc_unit_id)
  // NULLS NOT DISTINCT WHERE ipm_is_deleted = false. It replaced
  // uq_item_price_master_branch and uq_item_price_master_item_unit_global.
  // ipm_godown_id is deliberately NOT part of the key, so two godowns cannot
  // hold different prices for the same item + unit + branch.
  // CHECK constraints are not expressible in Prisma schema.
}

// ----- prisma/inventory/itemQtyPrice.prisma -----
model ItemQtyPrice {
  iqpId           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid @map("iqp_id")
  iqpCompanyId    String?   @db.Uuid @map("iqp_company_id")
  iqpBranchId     String?   @db.Uuid @map("iqp_branch_id")
  iqpPartyId      String?   @db.Uuid @map("iqp_party_id")
  iqpPriceLevel   Int?      @map("iqp_price_level")
  iqpItemId       String    @db.Uuid @map("iqp_item_id")
  iqpItemUnitId   String    @db.Uuid @map("iqp_item_unit_id")
  // slab: lower bound inclusive, upper bound exclusive (NULL = "& above")
  iqpFromQty      Decimal   @default(0) @db.Decimal(14, 3) @map("iqp_from_qty")
  iqpToQty        Decimal?  @db.Decimal(14, 3) @map("iqp_to_qty")
  // discount type: P = by % | R = by qty (flat off) | F = fixed price
  iqpPriceMode    String    @default("P") @db.Char(1) @map("iqp_price_mode")
  iqpDiscPct      Decimal?  @db.Decimal(6, 3) @map("iqp_disc_pct")
  iqpFlatOff      Decimal?  @db.Decimal(14, 3) @map("iqp_flat_off")
  iqpPrice        Decimal?  @db.Decimal(14, 3) @map("iqp_price")
  iqpIsTaxIncl    Boolean   @default(false) @map("iqp_is_tax_incl")
  iqpEffectiveFrom DateTime @db.Date @map("iqp_effective_from")
  iqpEffectiveTo  DateTime? @db.Date @map("iqp_effective_to")
  iqpIsActive     Boolean   @default(true) @map("iqp_is_active")
  iqpIsDeleted    Boolean   @default(false) @map("iqp_is_deleted")
  iqpSyncDate     DateTime? @db.Timestamptz(6) @map("iqp_sync_date")
  iqpCreatedBy    String?   @db.VarChar(100) @map("iqp_created_by")
  iqpCreatedOn    DateTime  @default(now()) @db.Timestamptz(6) @map("iqp_created_on")
  iqpModifiedBy   String?   @db.VarChar(100) @map("iqp_modified_by")
  iqpModifiedOn   DateTime  @default(now()) @db.Timestamptz(6) @map("iqp_modified_on")
  // Relations
  item                ItemMaster         @relation("ItemQtyPrices", fields: [iqpItemId], references: [itemId], onUpdate: Cascade, onDelete: Restrict, map: "fk_iqp_item")
  itemUnitConversion  ItemUnitConversion @relation("ItemQtyPriceUnitConversion", fields: [iqpItemUnitId], references: [iucId], onUpdate: Cascade, onDelete: Restrict, map: "fk_iqp_item_unit")
  company             Company?           @relation("CompanyItemQtyPrices", fields: [iqpCompanyId], references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_iqp_company_id")
  branch              BranchMaster?      @relation("BranchItemQtyPrices", fields: [iqpBranchId], references: [brId], onUpdate: Cascade, onDelete: Restrict, map: "fk_iqp_branch_id")
  priceLevel          ItemPriceLevel?    @relation("ItemQtyPricePriceLevel", fields: [iqpPriceLevel], references: [iplId], onUpdate: Cascade, onDelete: Restrict, map: "fk_iqp_price_level")
  party               Customer?          @relation("CustomerItemQtyPrices", fields: [iqpPartyId], references: [cusId], onUpdate: Cascade, onDelete: Restrict, map: "fk_iqp_party_id")
  @@map("item_qty_price")
  @@schema("inventory")
  // iqp_item_id, iqp_item_unit_id, iqp_company_id, iqp_branch_id, iqp_price_level
  // and iqp_party_id are now Prisma relations (see above); run a migration to
  // create the FK constraints at the DB level.
  // CHECK constraints (ck_iqp_qty_range, ck_iqp_qty_nonneg, ck_iqp_date_range,
  // ck_iqp_mode) are not expressible in Prisma schema.
  // DB-only EXCLUDE USING gist constraint ex_iqp_no_overlap (requires the
  // btree_gist extension) prevents overlapping active qty+date slabs per
  // company/branch/item/price_level/unit; not expressible in Prisma schema.
  // DB-only partial index ix_iqp_lookup on (iqp_item_id, iqp_company_id,
  // iqp_effective_from DESC) WHERE iqp_is_deleted = false AND iqp_is_active =
  // true is not expressible in Prisma schema.
}

// ----- prisma/inventory/itemReorder.prisma -----
model ItemReorder {
  irId               String  @id @default(dbgenerated("uuidv7()")) @db.Uuid @map("ir_id")

  // Scope / link
  irBranchId          String? @db.Uuid @map("ir_branch_id")
  irItemId            String  @db.Uuid @map("ir_item_id")
  irUcUnitId            String? @db.Uuid @map("ir_uc_unit_id")
  irGodownId          String? @db.Uuid @map("ir_godown_id") // NULL = global reorder rule
  irSlNo              Int     @default(0) @map("ir_sl_no")
  // Core reorder controls
  irMinLevel          Decimal @default(0) @db.Decimal(15, 4) @map("ir_min_level")
  irMaxLevel          Decimal @default(0) @db.Decimal(15, 4) @map("ir_max_level")
  irReorderLevel      Decimal @default(0) @db.Decimal(15, 4) @map("ir_reorder_level")
  irReorderQty        Decimal @default(0) @db.Decimal(15, 4) @map("ir_reorder_qty")

  // Time parameters
  irLeadTimeDays      Int     @default(0) @map("ir_lead_time_days")
  irReviewCycleDays   Int     @default(0) @map("ir_review_cycle_days")
  irReorderDays       Int     @default(0) @map("ir_reorder_days")
  irExpiryBufferDays  Int     @default(0) @map("ir_expiry_buffer_days")

  // Policy / type
  irReorderType       String  @default("MIN_MAX") @db.VarChar(20) @map("ir_reorder_type")

  // Flags
  irIsActive          Boolean @default(true)  @map("ir_is_active")
  irIsDeleted         Boolean @default(false) @map("ir_is_deleted")

  // Notes / audit
  irRemarks           String?  @db.VarChar(250) @map("ir_remarks")
  irCreatedOn         DateTime @default(now()) @db.Timestamptz(6) @map("ir_created_on")
  irCreatedBy         String?  @db.VarChar(100) @map("ir_created_by")
  irModifiedOn        DateTime @default(now()) @db.Timestamptz(6) @map("ir_modified_on")
  irModifiedBy        String?  @db.VarChar(100) @map("ir_modified_by")

  // Relations
  item                ItemMaster @relation(fields: [irItemId], references: [itemId], onUpdate: Cascade, onDelete: Restrict)
  // irUcUnitId references item_unit_conversion(iuc_id)
  itemUnitConversion  ItemUnitConversion? @relation("ItemReorderUnitConversion", fields: [irUcUnitId], references: [iucId], onUpdate: Cascade, onDelete: Restrict, map: "fk_ir_item_unit")

  @@map("item_reorders")
   @@schema("inventory")

  // Prevent duplicates per scope (no company)
  @@unique([irItemId, irUcUnitId, irGodownId], map: "uq_ir_item_unit_godown")

  @@index([irItemId], map: "idx_ir_item")
  @@index([irUcUnitId], map: "idx_ir_unit")
  @@index([irGodownId], map: "idx_ir_godown")
}

