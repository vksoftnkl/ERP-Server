  stockReorderPolicies StockReorderPolicy[] @relation("StockReorderPolicySupplier")
  stockForecasts      StockForecast[]  @relation("StockForecastSupplier")
  @@map("suppliers")
  @@schema("purchase")
  @@index([supCompanyId], map: "idx_sup_company")
  @@index([supGroupId], map: "idx_sup_group")
  @@index([supGstNo], map: "idx_sup_gst")
  // NOTE: Partial indexes can't be expressed in Prisma schema:
