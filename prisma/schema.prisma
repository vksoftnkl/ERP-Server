  // Valuationwot
  isbOpeningAvgRateWot   Decimal                      @default(0) @db.Decimal(18, 6) @map("isb_opening_avg_rate_wot")
  isbAvgStockRateWot    Decimal                      @default(0) @db.Decimal(18, 6) @map("isb_avg_stock_rate_wot")
  isbOpeningValueWot    Decimal                      @default(0) @db.Decimal(18, 2) @map("isb_opening_value_wot")
  isbStockValueWot      Decimal                      @default(0) @db.Decimal(18, 2) @map("isb_stock_value_wot")

  // Helper / reconciliation
  isbLastInDate       DateTime?                    @db.Date @map("isb_last_in_date")
  isbLastOutDate      DateTime?                    @db.Date @map("isb_last_out_date")

  // Audit
  isbSyncDate         DateTime?                    @db.Timestamptz(6) @map("isb_sync_date")
  isbCreatedOn        DateTime                     @default(now()) @db.Timestamptz(6) @map("isb_created_on")
  isbCreatedBy        String?                      @db.Uuid @map("isb_created_by")
  isbUpdatedOn        DateTime?                    @db.Timestamptz(6) @map("isb_updated_on")
  isbUpdatedBy        String?                      @db.Uuid @map("isb_updated_by")

  @@unique([isbAccYear, isbCompanyId, isbBranchId, isbGodownId, isbItemId, isbUnitId, isbStockBucket], map: "uq_isb_balance_scope")

  @@index([isbAccYear, isbCompanyId, isbBranchId, isbItemId], map: "idx_isb_item")
  @@index([isbAccYear, isbCompanyId, isbBranchId, isbGodownId], map: "idx_isb_godown")
  // Partial index `idx_isb_nonzero_stock` is maintained in SQL because Prisma
  // schema cannot express the nonzero-stock predicate.

  @@map("item_stock_balance")
  @@schema("inventory")
}

// ----- prisma/inventory/ItemStockLedger.prisma -----
model ItemStockLedger {
  stlId                String            @id @default(dbgenerated("uuidv7()")) @db.Uuid @map("stl_id")

  // Multi-branch snapshot
  stlAccYear           String            @db.VarChar(9) @map("stl_acc_year")
  stlCompanyId         String            @db.Uuid @map("stl_company_id")
  stlBranchId          String            @db.Uuid @map("stl_branch_id")
  stlGodownId          String            @db.Uuid @map("stl_godown_id")

  // Source voucher link
  stlVoucherId         String            @db.Uuid @map("stl_voucher_id")
  stlVoucherDate       DateTime          @db.Timestamptz(6) @map("stl_voucher_date")
  stlLineNo            Int               @default(1) @map("stl_line_no")
  stlSplitNo           Int               @default(1) @map("stl_split_no")
  stlVoucherTypeId     Int               @map("stl_voucher_type_id")

  // Posting / classification — validated at app level (StockTxnType)
  stlTxnType           String            @db.VarChar(30) @map("stl_txn_type")
  stlStockEffect       Int               @db.SmallInt @map("stl_stock_effect")
  stlDocDate           DateTime          @db.Date @map("stl_doc_date")
  stlPostedOn          DateTime          @default(now()) @db.Timestamptz(6) @map("stl_posted_on")
  stlDocRefNo          String?           @db.VarChar(50) @map("stl_doc_ref_no")

  // Item snapshot
  stlItemId            String            @db.Uuid @map("stl_item_id")
  stlTrackingType      String            @default("NONE") @db.VarChar(20) @map("stl_tracking_type")

  // UOM snapshot
  stlUomId             String            @db.Uuid @map("stl_uom_id")
  stlBaseUomId         String            @db.Uuid @map("stl_base_uom_id")
  stlConversionFactor  Decimal           @default(1) @db.Decimal(18, 6) @map("stl_conversion_factor")

  // Batch snapshot
  stlBatchId           String?           @db.Uuid @map("stl_batch_id")
  stlBatchNo           String?           @db.VarChar(100) @map("stl_batch_no")
  stlMfgDate           DateTime?         @db.Date @map("stl_mfg_date")
  stlExpiryDate        DateTime?         @db.Date @map("stl_expiry_date")

  // Entered quantity
  stlQty               Decimal           @default(0) @db.Decimal(18, 6) @map("stl_qty")
  stlBaseQty           Decimal           @default(0) @db.Decimal(18, 6) @map("stl_base_qty")
  stlFreeQty           Decimal           @default(0) @db.Decimal(18, 6) @map("stl_free_qty")
  stlFreeBaseQty       Decimal           @default(0) @db.Decimal(18, 6) @map("stl_free_base_qty")

  // Inventory valuation
  stlStockRate         Decimal           @default(0) @db.Decimal(18, 6) @map("stl_stock_rate")
  stlStockValue        Decimal           @default(0) @db.Decimal(18, 2) @map("stl_stock_value")
  stlLandedCostRate    Decimal           @default(0) @db.Decimal(18, 6) @map("stl_landed_cost_rate")
  stlLandedCostValue   Decimal           @default(0) @db.Decimal(18, 2) @map("stl_landed_cost_value")

  // Commercial snapshot
  stlDocRateWot        Decimal           @default(0) @db.Decimal(18, 6) @map("stl_doc_rate_wot")
  stlDocAmountWot      Decimal           @default(0) @db.Decimal(18, 2) @map("stl_doc_amount_wot")

  // Remarks
  stlNarration         String?           @map("stl_narration")

  // Sync / audit
  stlIsActive          Boolean           @default(true) @map("stl_is_active")
  stlIsDeleted         Boolean           @default(false) @map("stl_is_deleted")
  stlSyncedOn          DateTime?         @db.Timestamptz(6) @map("stl_synced_on")
  stlCreatedOn         DateTime          @default(now()) @db.Timestamptz(6) @map("stl_created_on")
  stlCreatedBy         String?           @db.Uuid @map("stl_created_by")

  @@unique([stlVoucherId, stlLineNo, stlSplitNo, stlGodownId, stlBatchId], map: "uq_stl_source_line_split")

  // Partial indexes `idx_stl_item` and `idx_stl_voucher` are maintained in SQL
  // with `WHERE stl_is_deleted = false`, which Prisma schema cannot express.

  @@map("item_stock_ledger")
  @@schema("inventory")
}

// ----- prisma/inventory/itemTaxHistory.prisma -----
