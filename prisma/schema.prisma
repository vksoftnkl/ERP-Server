// ----- prisma/inventory/itemTaxMaster.prisma -----
model ItemTaxMaster {
  taxId                   String  @id @default(dbgenerated("uuidv7()")) @db.Uuid @map("tax_id")
  taxName                 String  @db.VarChar(100) @map("tax_name")
  taxCode                 String? @db.VarChar(30)  @map("tax_code")
  taxTaxabilityType       String  @default("TAXABLE") @db.VarChar(30) @map("tax_taxability_type")
  taxIsReverseCharge      Boolean @default(false) @map("tax_is_reverse_charge")
  // Component rates (Sales)
  taxCgstPerc             Decimal @default(0) @db.Decimal(7, 3) @map("tax_cgst_perc")
  taxSgstPerc             Decimal @default(0) @db.Decimal(7, 3) @map("tax_sgst_perc")
  taxIgstPerc             Decimal @default(0) @db.Decimal(7, 3) @map("tax_igst_perc")
  // Component rates (Purchase)
  taxCgstPurPerc          Decimal @default(0) @db.Decimal(7, 3) @map("tax_cgst_pur_perc")
  taxSgstPurPerc          Decimal @default(0) @db.Decimal(7, 3) @map("tax_sgst_pur_perc")
  taxIgstPurPerc          Decimal @default(0) @db.Decimal(7, 3) @map("tax_igst_pur_perc")
  // Cess
  taxCessType             String  @default("NONE") @db.VarChar(20) @map("tax_cess_type")
  taxCessPerc             Decimal @default(0) @db.Decimal(7, 3) @map("tax_cess_perc")
  taxCessUnit             Decimal @default(0) @db.Decimal(15, 4) @map("tax_cess_unit")
  taxCessPurPerc          Decimal @default(0) @db.Decimal(7, 3) @map("tax_cess_pur_perc")
  taxCessPurUnit          Decimal @default(0) @db.Decimal(15, 4) @map("tax_cess_pur_unit")
  // Convenience total
  taxGstRateTotal         Decimal @default(0) @db.Decimal(7, 3) @map("tax_gst_rate_total")
  // Taxable value posting ledgers (ONE per slab)
  taxSalesLedgerId        String? @db.Uuid @map("tax_sales_ledger_id")
  taxSalesReturnLedgerId  String? @db.Uuid @map("tax_sales_return_ledger_id")
  taxPurchaseLedgerId     String? @db.Uuid @map("tax_purchase_ledger_id")
  taxPurchaseReturnLedgerId String? @db.Uuid @map("tax_purchase_return_ledger_id")
  // Output (Sales tax ledgers)
  taxCgstOutputLedgerId   String? @db.Uuid @map("tax_cgst_output_ledger_id")
  taxSgstOutputLedgerId   String? @db.Uuid @map("tax_sgst_output_ledger_id")
  taxIgstOutputLedgerId   String? @db.Uuid @map("tax_igst_output_ledger_id")
  taxCessOutputLedgerId   String? @db.Uuid @map("tax_cess_output_ledger_id")
  // Input (Purchase tax ledgers)
  taxCgstInputLedgerId    String? @db.Uuid @map("tax_cgst_input_ledger_id")
  taxSgstInputLedgerId    String? @db.Uuid @map("tax_sgst_input_ledger_id")
  taxIgstInputLedgerId    String? @db.Uuid @map("tax_igst_input_ledger_id")
  taxCessInputLedgerId    String? @db.Uuid @map("tax_cess_input_ledger_id")
  taxIsActive             Boolean  @default(true)  @map("tax_is_active")
  taxIsDeleted            Boolean  @default(false) @map("tax_is_deleted")
  taxSyncDate             DateTime? @db.Timestamptz(6) @map("tax_sync_date")
  taxCreatedOn            DateTime  @default(now()) @db.Timestamptz(6) @map("tax_created_on")
  taxCreatedBy            String?   @db.VarChar(100) @map("tax_created_by")
  taxModifiedOn           DateTime  @default(now()) @db.Timestamptz(6) @map("tax_modified_on")
  taxModifiedBy           String?   @db.VarChar(100) @map("tax_modified_by")
  defaultItems            ItemMaster[]
  taxHistory              ItemTaxHistory[]
  @@map("item_tax_master")
   @@schema("inventory")
  // unique slab name globally (since company removed)
  @@unique([taxName], map: "uq_tax_name_global")
  @@index([taxIsActive], map: "idx_tax_active")
  @@index([taxGstRateTotal], map: "idx_tax_rate_total")
  @@index([taxSalesLedgerId], map: "idx_tax_sales_ledger")
  @@index([taxCgstOutputLedgerId], map: "idx_tax_cgst_out")
  @@index([taxSgstOutputLedgerId], map: "idx_tax_sgst_out")
  @@index([taxIgstOutputLedgerId], map: "idx_tax_igst_out")
}

// ----- prisma/inventory/itemUnitConversion.prisma -----
model ItemUnitConversion {
  iucId              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid @map("iuc_id")
  iucItemId          String    @db.Uuid @map("iuc_item_id")
  iucUnitId          String    @db.Uuid @map("iuc_unit_id")
  iucBaseUnitId      String    @db.Uuid @map("iuc_base_unit_id")
  iucToBaseFactor    Decimal   @default(1) @db.Decimal(18, 6) @map("iuc_to_base_factor")
  iucUnitSlno        Int       @default(0) @map("iuc_unit_slno")
  iucUnitFactor      Decimal   @default(1) @db.Decimal(18, 6) @map("iuc_unit_factor")
  iucIsDefaultUnit   Boolean   @default(false) @map("iuc_is_default_unit")
  iucIsBaseUnit      Boolean   @default(false) @map("iuc_is_base_unit")
  iucIsBigUnit       Boolean   @default(false) @map("iuc_is_big_unit")
  iucUomWeight       Decimal   @default(0) @db.Decimal(18, 6) @map("iuc_uom_weight")
  iucUomRemarks      String?   @db.VarChar(250) @map("iuc_uom_remarks")
  iucIsActive        Boolean   @default(true) @map("iuc_is_active")
  iucIsDeleted       Boolean   @default(false) @map("iuc_is_deleted")
  iucSyncDate        DateTime? @db.Timestamptz(6) @map("iuc_sync_date")
  iucCreatedOn       DateTime  @default(now()) @db.Timestamptz(6) @map("iuc_created_on")
  iucCreatedBy       String?   @db.Uuid @map("iuc_created_by")
  iucUpdatedOn       DateTime? @db.Timestamptz(6) @map("iuc_updated_on")
  iucUpdatedBy       String?   @db.Uuid @map("iuc_updated_by")
  item               ItemMaster @relation("ItemUnitConversions", fields: [iucItemId], references: [itemId], onUpdate: Cascade, onDelete: Restrict, map: "fk_iuc_item_id")
  unit               Unit       @relation("IucUnit", fields: [iucUnitId], references: [unit_id], onUpdate: Cascade, onDelete: Restrict, map: "fk_iuc_unit_id")
  baseUnit           Unit       @relation("IucBaseUnit", fields: [iucBaseUnitId], references: [unit_id], onUpdate: Cascade, onDelete: Restrict, map: "fk_iuc_base_unit_id")
  saleQuotationItem  SaleQuotationItem[] @relation("SaleQuotationItemUnitConversion")
  saleBillItems      SaleBillItem[]      @relation("SaleBillItemUnitConversion")
  itemEanCodes       ItemEanCode[]       @relation("ItemEanCodeUnitConversion")
  itemReorders       ItemReorder[]       @relation("ItemReorderUnitConversion")
  itemPrices         ItemPriceMaster[]   @relation("ItemPriceMasterUnitConversion")
  itemQtyPrices      ItemQtyPrice[]      @relation("ItemQtyPriceUnitConversion")
  @@index([iucItemId, iucUnitSlno], map: "idx_item_unit_conversion_item")
  @@map("item_unit_conversion")
  @@schema("inventory")
  // Partial unique indexes uq_item_unit_conversion, uq_item_unit_conversion_default,
  // and uq_item_unit_conversion_base are not expressible in Prisma schema.
  // CHECK constraints (chk_iuc_to_base_factor, chk_iuc_uom_weight, chk_iuc_base_row)
  // were dropped and are now enforced in the application layer
  // (ItemUnitConversionService.assertItemUnitConversionConstraints).
}

// ----- prisma/inventory/itemUnitsMaster.prisma -----
model Unit {
  // Identity
  unit_id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid

  // Master fields
  unit_name        String   @unique @db.VarChar(50)
  unit_alias       String?  @db.VarChar(50)
 unit_code        String?  @db.Text
  gstUnit          ItemGstUnits? @relation(fields: [unit_code], references: [itemGstUnitCode], onDelete: SetNull, onUpdate: Cascade)
  unit_description String?  @db.VarChar(100)

  // Decimal / measurement
  unit_decimal_count  Int      @default(0)
  unit_weight         Decimal? @db.Decimal
  unit_loading        Decimal? @db.Decimal
  unit_unloading      Decimal? @db.Decimal
  unit_attach_charge  Decimal? @db.Decimal

  // Packing / conversion
  unit_is_pack_unit Boolean  @default(false)
  unit_base_unit_id String?  @db.Uuid
  unit_conversion   Decimal? @db.Decimal

  // Notes / status
  unit_is_active  Boolean @default(true)
  unit_is_deleted Boolean @default(false)

  // Audit / Sync
  unit_sync_date   DateTime? @db.Timestamptz(6)
  unit_created_on  DateTime  @default(now()) @db.Timestamptz(6)
  unit_created_by  String?   @db.VarChar(100)
  unit_modified_on DateTime  @default(now()) @db.Timestamptz(6)
  unit_modified_by String?   @db.VarChar(100)

  // Self relation
  baseUnit  Unit?  @relation("UnitBase", fields: [unit_base_unit_id], references: [unit_id], onUpdate: Cascade, onDelete: Restrict)
  packUnits Unit[] @relation("UnitBase")

  // Back-relations — ItemUnitConversion
  iucUnits     ItemUnitConversion[] @relation("IucUnit")
  iucBaseUnits ItemUnitConversion[] @relation("IucBaseUnit")

  // Back-relations — ItemPriceMaster
  // (ItemPriceMaster no longer stores a base unit — it reaches one through ItemUnitConversion.)
  openingStockUnits OpeningStockDetail[] @relation("OpeningStockDetailUnit")
  physicalStockUnits PhysicalStockDetail[] @relation("PhysicalStockDetailUnit")
  physicalStockBaseUnits PhysicalStockDetail[] @relation("PhysicalStockDetailBaseUnit")
  physicalStockBatchUnits PhysicalStockBatchDetail[] @relation("PhysicalStockBatchDetailUnit")
  physicalStockBatchBaseUnits PhysicalStockBatchDetail[] @relation("PhysicalStockBatchDetailBaseUnit")

  // Back-relations — others
  itemMasters  ItemMaster[]
  loyaltySchemePoints LoyaltySchemePoint[]
  loyaltySchemeGifts  LoyaltySchemeGift[]

  @@map("item_unit_master")
  @@schema("inventory")
  @@index([unit_is_active], map: "idx_unit_active")
  @@index([unit_base_unit_id], map: "idx_unit_base")
}

