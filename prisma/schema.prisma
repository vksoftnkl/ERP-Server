/**
 * =========================================================
 * Enums
 * =========================================================
 */

enum AuditLogAction {
  insert
  update
  approve
  cancel

  @@map("audit_log_action")
  @@schema("audit")
}

model AuditLog {
  logId String @id @default(dbgenerated("uuidv7()")) @map("log_id") @db.Uuid

  logDate   DateTime       @default(now()) @map("log_date") @db.Timestamptz(6)
  logAction AuditLogAction @map("log_action")

  logScreenId Int         @map("log_screen_id")
  auditScreen AuditScreen @relation(fields: [logScreenId], references: [screenId], onUpdate: Cascade, onDelete: Restrict)

  // Entity / record identity
  logTableName   String  @map("log_table_name") @db.Text
  logPk          String? @map("log_pk")
  logEntityId    String? @map("log_entity_id") @db.Uuid
  logDisplayName String? @map("log_display_name") @db.Text

  // Before/after snapshots
  logOriginalRecord Json? @map("log_original_record") @db.JsonB
  logModifiedRecord Json? @map("log_modified_record") @db.JsonB
  logChangedFields  Json? @map("log_changed_fields") @db.JsonB

  // Actor / scope
  logUserId   String? @map("log_user_id") @db.Uuid
  logBranchId String? @map("log_branch_id") @db.Uuid

  // Client info
  logDeviceName String? @map("log_device_name") @db.Text
  logIp         String? @map("log_ip") @db.Text
  logAppName    String? @map("log_app_name") @db.Text

  // Notes
  logNotes String? @map("log_notes") @db.Text

  // NOTE: Prisma can't fully express GIN(jsonb) indexes.
  // Create these with raw SQL migrations:
  //   CREATE INDEX ... USING GIN (log_modified_record);
  //   CREATE INDEX ... USING GIN (log_changed_fields);

  @@index([logDate], map: "idx_audit_log_date")
  @@index([logScreenId, logDate], map: "idx_audit_log_screen_date")
  @@index([logUserId, logDate], map: "idx_audit_log_user_date")
  @@index([logBranchId, logDate], map: "idx_audit_log_branch_date")
  @@index([logTableName, logDate], map: "idx_audit_log_table_date")
  @@map("audit_log")
  @@schema("audit")
}

