model AccVoucherHeader {
  avhVoucherId           String            @id @default(dbgenerated("uuidv7()")) @db.Uuid @map("avh_voucher_id")

  // Multi-branch identity
  avhAccYear             String            @db.VarChar(9) @map("avh_acc_year")
  avhCompanyId           String            @db.Uuid @map("avh_company_id")
  avhBranchId            String            @db.Uuid @map("avh_branch_id")

  // Voucher identity
  avhVoucherTypeId       Int               @map("avh_voucher_type_id")
  avhVoucherNo           BigInt            @map("avh_voucher_no")
  avhVoucherSlno         BigInt            @map("avh_voucher_slno")

  // References
  avhUserRefno           String?           @db.VarChar(50) @map("avh_user_refno")
  avhVoucherDate         DateTime          @db.Timestamptz(6) @map("avh_voucher_date")
  avhVoucherRefno        String            @db.VarChar(50) @map("avh_voucher_refno")
  avhBillDate            DateTime?         @db.Timestamptz(6) @map("avh_bill_date")
  avhBillRefno           String            @db.VarChar(100) @map("avh_bill_refno")

  // Amounts
  avhBillAmount          Decimal           @default(0) @db.Decimal(18, 2) @map("avh_bill_amount")
  avhAdjustAmount        Decimal           @default(0) @db.Decimal(18, 2) @map("avh_adjust_amount")
  avhTotalDebit          Decimal           @default(0) @db.Decimal(18, 2) @map("avh_total_debit")
  avhTotalCredit         Decimal           @default(0) @db.Decimal(18, 2) @map("avh_total_credit")

  // Ledger / party
  avhPartyId             String            @db.Uuid @map("avh_party_id")
  avhOppositeLedgerId    String?           @db.Uuid @map("avh_opposite_ledger_id")
  avhEmployeeId          String[]          @db.Uuid @map("avh_employee_id")

  // Notes
  avhPayNotes            String?           @db.VarChar(100) @map("avh_pay_notes")
  avhRemarks             String?           @map("avh_remarks")

  // Workflow
  avhVoucherStatus       VoucherStatus     @default(DRAFT) @map("avh_voucher_status")
  avhStatusOn            DateTime?         @db.Timestamptz(6) @map("avh_status_on")
  avhStatusBy            String?           @db.Uuid @map("avh_status_by")
  avhCancelReason        String?           @db.VarChar(250) @map("avh_cancel_reason")

  // Device / session
  avhUserId              String            @db.Uuid @map("avh_user_id")
  avhSessionId           String?           @db.Uuid @map("avh_session_id")
  avhDeviceType          DeviceType        @map("avh_device_type")
  avhDeviceId            String?           @db.Uuid @map("avh_device_id")
  avhCounterId           String            @db.VarChar(20) @map("avh_counter_id")

  // Print / notification
  avhPrintCount          Int               @default(0) @map("avh_print_count")
  avhWhatsappStatus      MessageSendStatus @default(NA) @map("avh_whatsapp_status")
  avhSmsStatus           MessageSendStatus @default(NA) @map("avh_sms_status")

  // Tally export
  avhTallyExportStatus   TallyExportStatus @default(PENDING) @map("avh_tally_export_status")
  avhTallyExportedOn     DateTime?         @db.Timestamptz(6) @map("avh_tally_exported_on")
  avhTallyGuid           String?           @db.VarChar(100) @map("avh_tally_guid")
  avhTallyErrorMsg       String?           @map("avh_tally_error_msg")

  // Audit
  avhIsActive            Boolean           @default(true) @map("avh_is_active")
  avhIsDeleted           Boolean           @default(false) @map("avh_is_deleted")
  avhSyncDate            DateTime?         @db.Timestamptz(6) @map("avh_sync_date")
  avhCreatedOn           DateTime          @default(now()) @db.Timestamptz(6) @map("avh_created_on")
  avhCreatedBy           String?           @db.Uuid @map("avh_created_by")
  avhUpdatedOn           DateTime?         @db.Timestamptz(6) @map("avh_updated_on")
  avhUpdatedBy           String?           @db.Uuid @map("avh_updated_by")

  // Relations
  voucherType            AccVoucherType    @relation(fields: [avhVoucherTypeId], references: [vchrTypeId], map: "fk_acc_voucher_header_voucher_type")
  company                Company           @relation(fields: [avhCompanyId], references: [compId], map: "fk_acc_voucher_header_voucher_company")
  branch                 BranchMaster      @relation(fields: [avhBranchId], references: [brId], map: "fk_acc_voucher_header_voucher_branch")
  party                  AccLedgerMaster   @relation(fields: [avhPartyId], references: [ledId], map: "fk_acc_voucher_header_voucher_party")
  user                   UserMaster        @relation(fields: [avhUserId], references: [usrId], map: "fk_acc_voucher_header_voucher_user")
  voucherBills           AccVoucherBill[]  @relation("VoucherBillHeader")
  againstVoucherBills    AccVoucherBill[]  @relation("VoucherBillAgainstHeader")
  voucherCheques         AccVoucherCheque[]
  voucherDocDetails      AccVoucherDocDetail[]
  voucherDocRegisters    AccVoucherDocRegister[]
  vouchers               AccVoucher[]
  voucherTenders         AccVoucherTender[]
  openingStockHeaders    OpeningStockHeader[] @relation("OpeningStockHeaderVoucher")
  openingStockDetails    OpeningStockDetail[] @relation("OpeningStockDetailVoucher")

  @@unique([avhCompanyId, avhBranchId, avhAccYear, avhVoucherId], map: "uq_acc_voucher_header_voucher_id")
  @@unique([avhCompanyId, avhBranchId, avhAccYear, avhVoucherTypeId, avhVoucherRefno], map: "uq_acc_voucher_header_voucher_refno")

  @@index([avhCompanyId, avhBranchId, avhAccYear, avhVoucherNo], map: "idx_acc_voucher_header_voucher_no")
  @@index([avhCompanyId, avhBranchId, avhAccYear, avhVoucherTypeId, avhVoucherSlno], map: "idx_acc_voucher_header_voucher_slno")
  @@index([avhCompanyId, avhBranchId, avhAccYear, avhVoucherDate], map: "idx_acc_voucher_header_branch_date")
  @@index([avhCompanyId, avhBranchId, avhAccYear, avhVoucherStatus], map: "idx_acc_voucher_header_status")
  @@map("acc_voucher_header")
  @@schema("accounts")
  // Partial index idx_acc_voucher_header_bill_refno WHERE avh_is_deleted = false
  // is not expressible in Prisma schema.
}

// ----- prisma/accounts/AccountVouchers.prisma -----
enum DrCrType {
  DR
  CR
  @@schema("accounts")
}

model AccVoucher {
  // Primary
  avId               String           @id @default(dbgenerated("uuidv7()")) @db.Uuid @map("av_id")

  // Header link
  avVoucherId        String           @db.Uuid @map("av_voucher_id")

  // Multi-branch snapshot
  avAccYear          String           @db.VarChar(20) @map("av_acc_year")
  avCompanyId        String           @db.Uuid @map("av_company_id")
  avBranchId         String           @db.Uuid @map("av_branch_id")

  // Voucher snapshot
  avVoucherTypeId    Int              @map("av_voucher_type_id")
  avVoucherNo        BigInt           @map("av_voucher_no")
  avRowNo            Int              @map("av_row_no")

  // Business dates / refs
  avVoucherDate      DateTime         @db.Timestamptz(6) @map("av_voucher_date")
  avVoucherRefno     String?          @db.VarChar(50) @map("av_voucher_refno")
  avBillDate         DateTime?        @db.Timestamptz(6) @map("av_bill_date")
  avBillRefno        String?          @db.VarChar(100) @map("av_bill_refno")

  // Accounting line
  avDrCr             DrCrType         @map("av_dr_cr")
  avLedgerId         String           @db.Uuid @map("av_ledger_id")
  avOppLedgerId      String           @db.Uuid @map("av_opp_ledger_id")
  avAmount           Decimal          @default(0) @db.Decimal(18, 2) @map("av_amount")

  // Narration
  avRemarks          String?          @map("av_remarks")

  // User / session
  avSessionId        String?          @db.Uuid @map("av_session_id")
  avUserId           String           @db.Uuid @map("av_user_id")

  // Status
  avIsActive         Boolean          @default(true) @map("av_is_active")
  avIsDeleted        Boolean          @default(false) @map("av_is_deleted")

  // Audit
  avSyncDate         DateTime?        @db.Timestamptz(6) @map("av_sync_date")
  avCreatedOn        DateTime         @default(now()) @db.Timestamptz(6) @map("av_created_on")
  avCreatedBy        String?          @db.Uuid @map("av_created_by")
  avUpdatedOn        DateTime?        @db.Timestamptz(6) @map("av_updated_on")
  avUpdatedBy        String?          @db.Uuid @map("av_updated_by")
  // Relations
  voucherHeader      AccVoucherHeader @relation(fields: [avVoucherId], references: [avhVoucherId], onDelete: Cascade, map: "fk_acc_vouchers_header")
  voucherType        AccVoucherType   @relation(fields: [avVoucherTypeId], references: [vchrTypeId], map: "fk_acc_vouchers_voucher_type")
  company            Company          @relation(fields: [avCompanyId], references: [compId], map: "fk_acc_vouchers_voucher_company")
  branch             BranchMaster     @relation(fields: [avBranchId], references: [brId], map: "fk_acc_vouchers_voucher_branch")
  ledger             AccLedgerMaster  @relation("AccVoucherLedger", fields: [avLedgerId], references: [ledId], map: "fk_acc_vouchers_voucher_ledger")
  oppositeLedger     AccLedgerMaster  @relation("AccVoucherOppLedger", fields: [avOppLedgerId], references: [ledId], map: "fk_acc_vouchers_voucher_opp_ledger")
  user               UserMaster       @relation(fields: [avUserId], references: [usrId], map: "fk_acc_vouchers_voucher_user")
  @@map("acc_vouchers")
  @@schema("accounts")
  // Partial indexes idx_acc_vouchers_voucher_id and idx_acc_vouchers_ledger_id
  // WHERE av_is_deleted = false are not expressible in Prisma schema.
}

// ----- prisma/accounts/AccountVoucherSequence.prisma -----
model AccVoucherSeq {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid @map("seq_id")
  // Link to voucher type master
  vchrTypeId    Int      @map("seq_vchr_type_id")
  // Multi branch scope
  companyId     String   @db.Uuid @map("seq_company_id")
  branchId      String   @db.Uuid @map("seq_branch_id")
  accYear       String   @db.VarChar(9) @map("seq_acc_year")
  // Device/counter scope
  deviceId      String?  @db.Uuid @map("seq_device_id")
  deviceCode    String   @default("MAIN") @db.VarChar(20) @map("seq_device_code")
  // Reset period key: 2026-27 / 2026-04 / 2026-04-27 / ALL
  periodKey     String   @db.VarChar(20) @map("seq_period_key")
  // Running number
  lastNo        BigInt   @default(0) @map("seq_last_no")
  // Applied format snapshot
  voucherPrefix String?  @db.VarChar(20) @map("seq_voucher_prefix")
  companyCode   String?  @db.VarChar(20) @map("seq_company_code")
  branchCode    String?  @db.VarChar(20) @map("seq_branch_code")
  voucherSuffix String?  @db.VarChar(20) @map("seq_voucher_suffix")
  noWidth       Int      @default(5) @map("seq_no_width")
  // Last generated printable number
  lastRefno     String?  @db.VarChar(100) @map("seq_last_refno")
  // Status
  isActive      Boolean  @default(true) @map("seq_is_active")
  // Add this only if SQL table also has seq_is_deleted
  isDeleted     Boolean  @default(false) @map("seq_is_deleted")
  // Audit
  createdOn     DateTime  @default(now()) @db.Timestamptz @map("seq_created_on")
  createdBy     String?   @db.Uuid @map("seq_created_by")
  modifiedOn    DateTime? @db.Timestamptz @map("seq_modified_on")
  modifiedBy    String?   @db.Uuid @map("seq_modified_by")
  // Relations
  voucherType   AccVoucherType @relation(fields: [vchrTypeId], references: [vchrTypeId], map: "fk_acc_voucher_seq_type")
  company       Company        @relation(fields: [companyId], references: [compId], map: "fk_acc_voucher_seq_company")
  branch        BranchMaster   @relation(fields: [branchId], references: [brId], map: "fk_acc_voucher_seq_branch")
  // Main duplicate prevention constraint
  @@unique([vchrTypeId, companyId, branchId, accYear, deviceCode, periodKey], map: "uq_acc_voucher_seq_scope")
  // Useful indexes
  @@index([companyId, branchId, accYear], map: "idx_acc_voucher_seq_company_branch_year")
  @@index([vchrTypeId], map: "idx_acc_voucher_seq_vchr_type")
  @@index([deviceId], map: "idx_acc_voucher_seq_device")
  @@index([periodKey], map: "idx_acc_voucher_seq_period_key")
  @@index([isActive, isDeleted], map: "idx_acc_voucher_seq_status")
  @@map("acc_voucher_seq")
  @@schema("accounts")
}

