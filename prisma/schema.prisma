// ----- prisma/sales/loyaltyCoupon.prisma -----
/// One ISSUED coupon.
///
/// NOT partitioned, and never carried forward at year end. A voucher issued in
/// 2025-2026 and spent in 2027-2028 is the SAME row throughout — which is what
/// makes LoyaltyCouponTxn's reference to it a plain foreign key. lcpAccYear is
/// the FY of ISSUE and a reporting filter only, never a partition key.
///
/// lcpFaceValue is a SNAPSHOT taken at issue. Re-pricing a batch must not
/// re-price the cards already in customers' wallets — the same reason
/// AccTenderDetail snapshots its ledger and its rate.
model LoyaltyCoupon {
  lcpId               String    @id(map: "pk_loyalty_coupon") @default(dbgenerated("uuidv7()")) @db.Uuid @map("lcp_id")
  lcpCompId           String    @db.Uuid                                 @map("lcp_comp_id")
  /// Branch that ISSUED it.
  lcpBranchId         String?   @db.Uuid                                 @map("lcp_branch_id")
  lcpTenantId         String?   @db.Uuid                                 @map("lcp_tenant_id")
  /// FY of issue. Reporting filter only.
  lcpAccYear          String    @db.Char(9)                              @map("lcp_acc_year")

  lcpLcbId            String    @db.Uuid                                 @map("lcp_lcb_id")
  /// What the counter scans or types.
  lcpCode             String    @db.VarChar(40)                          @map("lcp_code")
  /// So a code photographed off someone's phone screen is not by itself
  /// spendable.
  lcpPin              String?   @db.VarChar(10)                          @map("lcp_pin")

  /// NULL = bearer instrument. Non-null and a non-transferable batch means
  /// this customer alone may spend it.
  lcpCustId           String?   @db.Uuid                                 @map("lcp_cust_id")
  /// If the holder is also a points member.
  lcpMemberId         String?   @db.Uuid                                 @map("lcp_member_id")
  lcpPartyLedgerId    String?   @db.Uuid                                 @map("lcp_party_ledger_id")

  lcpIssuedOn         DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date @map("lcp_issued_on")
  lcpValidFrom        DateTime? @db.Date                                 @map("lcp_valid_from")
  lcpValidUpto        DateTime? @db.Date                                 @map("lcp_valid_upto")

  // ── The bill that SOLD it, when it was sold rather than given away ───
  // All three of module/type/id or none (ck_lcp_src_doc). No relation field:
  // polymorphic by design.
  lcpSrcModule        String?   @db.VarChar(20)                          @map("lcp_src_module")
  lcpSrcDocType       String?   @db.VarChar(30)                          @map("lcp_src_doc_type")
  lcpSrcDocId         String?   @db.Uuid                                 @map("lcp_src_doc_id")
  lcpSrcAccYear       String?   @db.Char(9)                              @map("lcp_src_acc_year")
  lcpSrcDocRefno      String?   @db.VarChar(100)                         @map("lcp_src_doc_refno")

  /// Snapshot at issue, and must be POSITIVE (ck_lcp_face) — so an uncapped
  /// PERCENT batch cannot issue a coupon. Give such a batch an lcbMaxValue and
  /// snapshot that as the face.
  lcpFaceValue        Decimal   @db.Decimal(18, 2)                       @map("lcp_face_value")
  /// What was actually PAID for it: 0 for a giveaway, face value for a sold
  /// card, something between for a discounted promotion. Breakage — vouchers
  /// sold and never spent — has no other source.
  lcpIssueAmount      Decimal   @default(0) @db.Decimal(18, 2)           @map("lcp_issue_amount")

  // ── Caches of LoyaltyCouponTxn ───────────────────────────────────────
  // Recomputed by LoyaltyCouponService.recomputeCoupons(). There is no
  // trigger; no other code may write them. A coupon movement is an AMOUNT and
  // the TYPE carries the sign, so these are plain sums — the OPPOSITE of the
  // points ledger, where a spend is negative.
  lcpUsedValue        Decimal   @default(0) @db.Decimal(18, 2)           @map("lcp_used_value")
  lcpTopupValue       Decimal   @default(0) @db.Decimal(18, 2)           @map("lcp_topup_value")
  lcpUseCount         Int       @default(0)                              @map("lcp_use_count")
  /// MAX(lctTxnDate) over this coupon's movements, recomputed with the value
  /// buckets. Added by this migration and not by the design note, whose
  /// recompute contract writes it against a column it never declared.
  lcpLastUsedOn       DateTime? @db.Date                                 @map("lcp_last_used_on")

  /// GENERATED ALWAYS ... STORED: face + topup - used. Read-only — never send
  /// it on a create or update, and @default(dbgenerated()) marks it DB-owned
  /// so migrate never emits a default of its own.
  lcpBalanceValue     Decimal?  @default(dbgenerated()) @db.Decimal(18, 2) @map("lcp_balance_value")

  /// ISSUED | PARTIAL | REDEEMED | EXPIRED | CANCELLED | BLOCKED.
  ///
  /// Deliberately NOT a generated column. The first three are arithmetic, but
  /// EXPIRED, CANCELLED and BLOCKED are DECISIONS and cannot be derived from
  /// the amounts — and expiry additionally depends on today's date, which a
  /// generated column may not read. recomputeCoupons() moves it between the
  /// first three ONLY; the admin path and couponExpiryRun() own the rest.
  /// Writing a decision from a recompute is how a cancelled voucher silently
  /// comes back to life.
  lcpStatus           String    @default("ISSUED") @db.VarChar(20)       @map("lcp_status")
  lcpRedeemedOn       DateTime? @db.Date                                 @map("lcp_redeemed_on")
  lcpCancelledOn      DateTime? @db.Date                                 @map("lcp_cancelled_on")
  lcpCancelledBy      String?   @db.Uuid                                 @map("lcp_cancelled_by")
  lcpCancelReason     String?   @db.VarChar(250)                         @map("lcp_cancel_reason")

  lcpRemarks          String?   @db.VarChar(250)                         @map("lcp_remarks")
  lcpIsActive         Boolean   @default(true)                           @map("lcp_is_active")
  lcpIsDeleted        Boolean   @default(false)                          @map("lcp_is_deleted")

  lcpSyncDate         DateTime? @db.Timestamptz(6)                       @map("lcp_sync_date")
  lcpCreatedOn        DateTime  @default(now()) @db.Timestamptz(6)       @map("lcp_created_on")
  lcpCreatedBy        String?   @db.VarChar(50)                          @map("lcp_created_by")
  lcpModifiedOn       DateTime? @db.Timestamptz(6)                       @map("lcp_modified_on")
  lcpModifiedBy       String?   @db.VarChar(50)                          @map("lcp_modified_by")

  // Relations
  batch               LoyaltyCouponBatch @relation("CouponBatchCoupons",   fields: [lcpLcbId],         references: [lcbId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_lcp_batch")
  company             Company            @relation("CouponCompany",        fields: [lcpCompId],        references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_lcp_company")
  branch              BranchMaster?      @relation("CouponBranch",         fields: [lcpBranchId],      references: [brId],   onUpdate: Cascade, onDelete: Restrict, map: "fk_lcp_branch")
  customer            Customer?          @relation("CouponCustomer",       fields: [lcpCustId],        references: [cusId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_lcp_cust")
  member              LoyaltyMember?     @relation("CouponMember",         fields: [lcpMemberId],      references: [lmbId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_lcp_member")
  cancelledByUser     UserMaster?        @relation("CouponCancelledBy",    fields: [lcpCancelledBy],   references: [usrId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_lcp_cancelled_by")
  partyLedger         AccLedgerMaster?   @relation("CouponPartyLedger",    fields: [lcpPartyLedgerId], references: [ledId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_lcp_party_ledger")

  txns                LoyaltyCouponTxn[] @relation("CouponTxnCoupon")

  // Partial indexes are DB-only — Prisma ignores WHERE predicates and
  // expression keys:
  //
  //   -- THE SCAN AT THE COUNTER. Company-scoped rather than batch-scoped,
  //   -- because a cashier types a code, not a code and the batch it came from.
  //   CREATE UNIQUE INDEX ux_lcp_code ON sales.loyalty_coupon
  //       (lcp_comp_id, upper(lcp_code::text)) WHERE lcp_is_deleted = false;
  //
  //   -- the expiry sweep and the outstanding-voucher liability report
  //   CREATE INDEX ix_lcp_open ON sales.loyalty_coupon (lcp_comp_id, lcp_valid_upto)
  //       INCLUDE (lcp_code, lcp_face_value, lcp_balance_value, lcp_cust_id)
  //       WHERE lcp_is_deleted = false AND lcp_balance_value > 0
  //         AND lcp_status IN ('ISSUED','PARTIAL');
  //
  //   -- reconciliation. No over-spend CHECK exists: movements sync in pieces
  //   -- and the guard is the service's at post. The over-draw is RECORDED and
  //   -- found here the next morning rather than by a customer.
  //   CREATE INDEX ix_lcp_overdrawn ON sales.loyalty_coupon
  //       (lcp_comp_id, lcp_balance_value)
  //       WHERE lcp_is_deleted = false AND lcp_balance_value < 0;
  //
  //   -- ix_lcp_batch, ix_lcp_cust, ix_lcp_src_doc, and FK-covering
  //   -- ix_lcp_member, ix_lcp_party_ledger, ix_lcp_branch, ix_lcp_cust_fk,
  //   -- ix_lcp_cancelled_by
  //
  // CHECK constraints (DB-only): ck_lcp_acc_year, ck_lcp_src_acc_year,
  //   ck_lcp_src_doc, ck_lcp_code_shape, ck_lcp_status, ck_lcp_cancel,
  //   ck_lcp_validity, ck_lcp_issue_amount, ck_lcp_face

  // ── Promotion usage (20260921180000) ────────────────────────────────────
  // When a campaign was coupon-gated, the code that unlocked it.
  promotionUsages       PromotionUsage[]          @relation("PromotionUsageCoupon")

  @@map("loyalty_coupon")
  @@schema("sales")
}

// ----- prisma/sales/loyaltyCouponBatch.prisma -----
/// The coupon batch — what a coupon of this kind is worth and how it behaves.
///
/// A coupon is a MONEY instrument with a code on it. It is not points, it
/// shares no ledger with points, and it redeems through its own tender type
/// (accounts.acc_tender_types 11, VOUCHER).
///
/// Two sources, and only two:
///   SOLD      a gift voucher the customer bought. May be RELOADED
///             (lcbAllowTopup), which is what makes it a gift CARD rather
///             than a one-shot slip.
///   CAMPAIGN  codes issued in bulk and handed out or mailed. Not reloadable
///             (ck_lcb_topup) — a campaign code is not a wallet.
///
/// A PERCENT batch ("20% off, up to 500") resolves against the bill at the
/// moment of redemption and only the RESOLVED RUPEE AMOUNT reaches
/// lctAmount and acc_tender_detail.td_amount. The percentage never leaves
/// this row.
model LoyaltyCouponBatch {
  lcbId               String    @id(map: "pk_loyalty_coupon_batch") @default(dbgenerated("uuidv7()")) @db.Uuid @map("lcb_id")
  lcbCompId           String    @db.Uuid                                 @map("lcb_comp_id")
  /// NULL = every branch.
  lcbBranchId         String?   @db.Uuid                                 @map("lcb_branch_id")
  lcbTenantId         String?   @db.Uuid                                 @map("lcb_tenant_id")

  /// Stable handle, never renamed — retire the batch instead.
  lcbCode             String    @db.VarChar(20)                          @map("lcb_code")
  lcbName             String    @db.VarChar(150)                         @map("lcb_name")
  /// SOLD | CAMPAIGN
  lcbSource           String    @db.VarChar(15)                          @map("lcb_source")

  // ── What it is worth ─────────────────────────────────────────────────
  /// AMOUNT | PERCENT
  lcbValueType        String    @default("AMOUNT") @db.VarChar(10)       @map("lcb_value_type")
  lcbFaceValue        Decimal   @default(0) @db.Decimal(18, 2)           @map("lcb_face_value")
  lcbPercent          Decimal   @default(0) @db.Decimal(6, 3)            @map("lcb_percent")
  /// Cap on a PERCENT coupon, and the only case where a cap means anything
  /// (ck_lcb_cap_percent). An uncapped PERCENT batch cannot issue a coupon,
  /// because ck_lcp_face demands a positive face value to snapshot — so give
  /// a PERCENT batch a cap and use it as the face.
  lcbMaxValue         Decimal?  @db.Decimal(18, 2)                       @map("lcb_max_value")
  lcbMinBillAmount    Decimal   @default(0) @db.Decimal(18, 2)           @map("lcb_min_bill_amount")

  // ── How it may be spent ──────────────────────────────────────────────
  /// May a 500 voucher go 300 now and 200 next week. This is what decides
  /// whether lcpUsedValue behaves as a balance or as a switch.
  lcbAllowPartial     Boolean   @default(false)                          @map("lcb_allow_partial")
  /// Reloadable gift card. SOLD only.
  lcbAllowTopup       Boolean   @default(false)                          @map("lcb_allow_topup")
  lcbMaxPerBill       Int       @default(1) @db.SmallInt                 @map("lcb_max_per_bill")
  /// false = bound to lcpCustId.
  lcbIsTransferable   Boolean   @default(true)                           @map("lcb_is_transferable")
  lcbPinRequired      Boolean   @default(false)                          @map("lcb_pin_required")

  // ── Code generation (CAMPAIGN) ───────────────────────────────────────
  lcbPrefix           String?   @db.VarChar(10)                          @map("lcb_prefix")
  lcbCodeLength       Int       @default(12) @db.SmallInt                @map("lcb_code_length")
  /// NULL = unlimited. Checked by the service WHEN IT ISSUES, not by the
  /// recompute — a recompute reports, it does not refuse.
  lcbMaxIssueCount    Int?                                               @map("lcb_max_issue_count")
  /// Caches of LoyaltyCoupon, recomputed by
  /// LoyaltyCouponService.recomputeCouponBatches(). There is no trigger; no
  /// other code may write these.
  lcbIssuedCount      Int       @default(0)                              @map("lcb_issued_count")
  lcbRedeemedCount    Int       @default(0)                              @map("lcb_redeemed_count")

  // ── Validity ─────────────────────────────────────────────────────────
  lcbValidFrom        DateTime? @db.Date                                 @map("lcb_valid_from")
  lcbValidUpto        DateTime? @db.Date                                 @map("lcb_valid_upto")
  /// SOLD vouchers usually expire N days after THEIR OWN issue rather than on
  /// a batch-wide date; this is that N.
  lcbValidityDays     Int?                                               @map("lcb_validity_days")

  /// ALL | LIST
  lcbBranchScope      String    @default("ALL") @db.VarChar(10)          @map("lcb_branch_scope")
  lcbCustGroupId      String?   @db.Uuid                                 @map("lcb_cust_group_id")

  /// The VOUCHER tender (type 11) redemption settles through. NULL = the
  /// branch's default. The rate and the floor stay owned by the tender
  /// master, exactly as they do for points.
  lcbRedeemTenderId   String?   @db.Uuid                                 @map("lcb_redeem_tender_id")

  lcbRemarks          String?   @db.VarChar(500)                         @map("lcb_remarks")
  lcbIsActive         Boolean   @default(true)                           @map("lcb_is_active")
  lcbIsDeleted        Boolean   @default(false)                          @map("lcb_is_deleted")

  lcbSyncDate         DateTime? @db.Timestamptz(6)                       @map("lcb_sync_date")
  lcbCreatedOn        DateTime  @default(now()) @db.Timestamptz(6)       @map("lcb_created_on")
  lcbCreatedBy        String?   @db.VarChar(50)                          @map("lcb_created_by")
  lcbModifiedOn       DateTime? @db.Timestamptz(6)                       @map("lcb_modified_on")
  lcbModifiedBy       String?   @db.VarChar(50)                          @map("lcb_modified_by")

  // Relations
  company             Company          @relation("CouponBatchCompany",     fields: [lcbCompId],         references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_lcb_company")
  branch              BranchMaster?    @relation("CouponBatchBranch",      fields: [lcbBranchId],       references: [brId],   onUpdate: Cascade, onDelete: Restrict, map: "fk_lcb_branch")
  redeemTender        AccTenderMaster? @relation("CouponBatchRedeemTender", fields: [lcbRedeemTenderId], references: [tndId], onUpdate: Cascade, onDelete: Restrict, map: "fk_lcb_redeem_tender")
  custGroup           CustGroup?       @relation("CouponBatchCustGroup",   fields: [lcbCustGroupId],    references: [cgrId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_lcb_cust_group")

  coupons             LoyaltyCoupon[]    @relation("CouponBatchCoupons")
  couponTxns          LoyaltyCouponTxn[] @relation("CouponTxnBatch")

  // Partial indexes are DB-only — Prisma ignores WHERE predicates and
  // expression keys:
  //
  //   CREATE UNIQUE INDEX ux_lcb_code ON sales.loyalty_coupon_batch
  //       (lcb_comp_id, upper(lcb_code::text)) WHERE lcb_is_deleted = false;
  //
  //   CREATE INDEX ix_lcb_lookup ON sales.loyalty_coupon_batch
  //       (lcb_comp_id, lcb_branch_id, lcb_valid_from, lcb_valid_upto)
  //       WHERE lcb_is_active = true AND lcb_is_deleted = false;
  //
  //   -- reconciliation. There is deliberately no "redeemed <= issued" CHECK:
  //   -- a sync batch may carry the redemption before the issue, and two tills
  //   -- offline can both issue the last voucher of a batch. Recorded, not
  //   -- refused.
  //   CREATE INDEX ix_lcb_overdrawn ON sales.loyalty_coupon_batch (lcb_comp_id)
  //       WHERE lcb_is_deleted = false AND lcb_redeemed_count > lcb_issued_count;
  //
  //   -- FK-covering: ix_lcb_branch, ix_lcb_cust_group, ix_lcb_redeem_tender
  //
  // CHECK constraints (DB-only): ck_lcb_code_shape, ck_lcb_source,
  //   ck_lcb_value_type, ck_lcb_value, ck_lcb_max_value, ck_lcb_min_bill,
  //   ck_lcb_code_length, ck_lcb_max_issue, ck_lcb_max_per_bill,
  //   ck_lcb_validity, ck_lcb_validity_days, ck_lcb_branch_scope,
  //   ck_lcb_topup, ck_lcb_cap_percent

  @@map("loyalty_coupon_batch")
  @@schema("sales")
}

// ----- prisma/sales/loyaltyCouponTxn.prisma -----
/// One movement against one coupon.
///
/// LIST-partitioned by lctAccYear — the year of the MOVEMENT, not of the
/// issue: a 2027 spend of a 2025 voucher lands in 2027 and the voucher row
/// never moves. Hence the composite PK. Partitions
/// (sales.loyalty_coupon_txn_2026_2027) come from
/// public.ensure_acc_year_partitions('YYYY-YYYY'), which
/// 20260921160000_add_coupon_voucher_engine taught about this table.
///
/// lctAmount is SIGNED and always means "what this event does to the
/// voucher": REDEEM / EXPIRE / CANCEL consume it, TOPUP adds to it (into its
/// own bucket). A reversal repeats its TYPE with the opposite sign and names
/// the row it undoes — there is no REVERSAL type, so each bucket needs one
/// summing rule rather than two.
///
/// BEWARE, because it is the opposite of the points ledger and the two live in
/// the same schema: HERE a spend is POSITIVE and the type carries the
/// direction. In LoyaltyLedger a spend is NEGATIVE. Do not copy one recompute
/// into the other.
///
/// WRITE RULE: exactly one private method of LoyaltyCouponService may write
/// this table. It writes the rows, then recomputes the touched COUPONS and
/// then their BATCHES, in that order, before returning — lcbRedeemedCount
/// counts vouchers by STATUS, so a batch re-counted first counts a status
/// that is about to change.
model LoyaltyCouponTxn {
  lctId                 String    @default(dbgenerated("uuidv7()")) @db.Uuid @map("lct_id")
  lctCompId             String    @db.Uuid                               @map("lct_comp_id")
  /// Where it was presented. NOT NULL — the expiry sweep must therefore fall
  /// back to the batch's branch when the voucher has none.
  lctBranchId           String    @db.Uuid                               @map("lct_branch_id")
  lctTenantId           String?   @db.Uuid                               @map("lct_tenant_id")
  lctAccYear            String    @db.Char(9)                            @map("lct_acc_year")

  // Single-column FK: LoyaltyCoupon is not partitioned, which is what makes
  // redeeming a two-year-old voucher a plain foreign key.
  lctLcpId              String    @db.Uuid                               @map("lct_lcp_id")
  /// Snapshot, so batch reports need no hop through the coupon.
  lctLcbId              String    @db.Uuid                               @map("lct_lcb_id")
  lctCustId             String?   @db.Uuid                               @map("lct_cust_id")
  lctMemberId           String?   @db.Uuid                               @map("lct_member_id")

  /// REDEEM | TOPUP | CANCEL | EXPIRE
  lctTxnType            String    @db.VarChar(20)                        @map("lct_txn_type")
  lctRowNo              Int       @default(1)                            @map("lct_row_no")
  /// Positive unless it is a reversal, whatever the type (ck_lct_sign).
  lctAmount             Decimal   @db.Decimal(18, 2)                     @map("lct_amount")
  lctTxnDate            DateTime  @db.Date                               @map("lct_txn_date")

  /// For a PERCENT batch: the bill it was measured against, and the rate that
  /// produced lctAmount. Without these the resolved figure is unexplainable
  /// afterwards.
  lctBillAmount         Decimal   @default(0) @db.Decimal(18, 2)         @map("lct_bill_amount")
  lctPercentApplied     Decimal   @default(0) @db.Decimal(6, 3)          @map("lct_percent_applied")

  // All three of module/type/id or none (ck_lct_src_doc). No relation field:
  // polymorphic by design.
  lctSrcModule          String?   @db.VarChar(20)                        @map("lct_src_module")
  lctSrcDocType         String?   @db.VarChar(30)                        @map("lct_src_doc_type")
  lctSrcDocId           String?   @db.Uuid                               @map("lct_src_doc_id")
  lctSrcAccYear         String?   @db.Char(9)                            @map("lct_src_acc_year")
  lctSrcDocRefno        String?   @db.VarChar(100)                       @map("lct_src_doc_refno")

  /// The tender line (type 11, VOUCHER) the money went out on. Required on a
  /// REDEEM (ck_lct_redeem_tender) and forbidden on EXPIRE or CANCEL
  /// (ck_lct_no_tender) — nothing was paid out. This is also the only route by
  /// which a redemption reaches the GL and then Tally.
  lctTenderId           String?   @db.Uuid                               @map("lct_tender_id")
  lctTenderAccYear      String?   @db.Char(9)                            @map("lct_tender_acc_year")

  lctReversalOfId       String?   @db.Uuid                               @map("lct_reversal_of_id")
  lctReversalOfAccYear  String?   @db.Char(9)                            @map("lct_reversal_of_acc_year")
  lctReversalReason     String?   @db.VarChar(250)                       @map("lct_reversal_reason")

  /// Voiding a live voucher is somebody's decision — ck_lct_cancel_approval
  /// makes CANCEL require this.
  lctApprovedBy         String?   @db.Uuid                               @map("lct_approved_by")
  lctUserId             String?   @db.Uuid                               @map("lct_user_id")
  lctSessionId          String?   @db.Uuid                               @map("lct_session_id")
  lctDeviceId           String?   @db.Uuid                               @map("lct_device_id")

  lctRemarks            String?   @db.VarChar(250)                       @map("lct_remarks")
  lctIsDeleted          Boolean   @default(false)                        @map("lct_is_deleted")

  lctSyncDate           DateTime? @db.Timestamptz(6)                     @map("lct_sync_date")
  lctCreatedOn          DateTime  @default(now()) @db.Timestamptz(6)     @map("lct_created_on")
  lctCreatedBy          String?   @db.VarChar(50)                        @map("lct_created_by")
  lctModifiedOn         DateTime? @db.Timestamptz(6)                     @map("lct_modified_on")
  lctModifiedBy         String?   @db.VarChar(50)                        @map("lct_modified_by")

  // Relations
  coupon                LoyaltyCoupon      @relation("CouponTxnCoupon",   fields: [lctLcpId],     references: [lcpId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_lct_coupon")
  batch                 LoyaltyCouponBatch @relation("CouponTxnBatch",    fields: [lctLcbId],     references: [lcbId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_lct_batch")
  customer              Customer?          @relation("CouponTxnCustomer", fields: [lctCustId],    references: [cusId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_lct_cust")
  member                LoyaltyMember?     @relation("CouponTxnMember",   fields: [lctMemberId],  references: [lmbId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_lct_member")
  company               Company            @relation("CouponTxnCompany",  fields: [lctCompId],    references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_lct_company")
  branch                BranchMaster       @relation("CouponTxnBranch",   fields: [lctBranchId],  references: [brId],   onUpdate: Cascade, onDelete: Restrict, map: "fk_lct_branch")
  user                  UserMaster?        @relation("CouponTxnUser",     fields: [lctUserId],    references: [usrId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_lct_user")
  approver              UserMaster?        @relation("CouponTxnApprover", fields: [lctApprovedBy], references: [usrId], onUpdate: Cascade, onDelete: Restrict, map: "fk_lct_approved_by")
  device                DeviceMaster?      @relation("CouponTxnDevice",   fields: [lctDeviceId],  references: [devId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_lct_device")

  tender                AccTenderDetail?   @relation("CouponTxnTender",   fields: [lctTenderId, lctTenderAccYear], references: [tdId, tdAccYear], onUpdate: Cascade, onDelete: Restrict, map: "fk_lct_tender")

  reversalOf            LoyaltyCouponTxn?  @relation("CouponTxnReversal", fields: [lctReversalOfId, lctReversalOfAccYear], references: [lctId, lctAccYear], onUpdate: Cascade, onDelete: Restrict, map: "fk_lct_reversal")
  reversedBy            LoyaltyCouponTxn[] @relation("CouponTxnReversal")

  @@id([lctId, lctAccYear], map: "pk_loyalty_coupon_txn")

  // Partial indexes are DB-only — Prisma ignores WHERE predicates:
  //
  //   -- one voucher cannot be spent twice on the same bill by an offline
  //   -- re-sync. This is also what makes couponExpiryRun() safe to re-run on
  //   -- the same date: its deterministic runId lands here as lct_src_doc_id,
  //   -- and that runId must carry a '|coupon|' segment so it cannot collide
  //   -- with the points sweep's.
  //   CREATE UNIQUE INDEX ux_lct_src_row ON sales.loyalty_coupon_txn
  //       (lct_lcp_id, lct_src_doc_type, lct_src_doc_id, lct_acc_year, lct_row_no)
  //       WHERE lct_src_doc_id IS NOT NULL AND lct_is_deleted = false;
  //
  //   -- unique per YEAR only, the usual partition-key caveat. A cross-year
  //   -- double reversal is the posting code's job to prevent.
  //   CREATE UNIQUE INDEX ux_lct_reversal ON sales.loyalty_coupon_txn
  //       (lct_reversal_of_id, lct_acc_year)
  //       WHERE lct_reversal_of_id IS NOT NULL AND lct_is_deleted = false;
  //
  //   CREATE INDEX ix_lct_coupon ON sales.loyalty_coupon_txn (lct_lcp_id, lct_txn_date) …
  //   CREATE INDEX ix_lct_batch_period ON sales.loyalty_coupon_txn
  //       (lct_comp_id, lct_lcb_id, lct_txn_date)
  //       INCLUDE (lct_amount, lct_txn_type) WHERE lct_is_deleted = false;
  //   CREATE INDEX ix_lct_src_doc, ix_lct_tender …
  //
  //   -- FK-covering: ix_lct_member, ix_lct_cust, ix_lct_user, ix_lct_device,
  //   -- ix_lct_batch_fk, ix_lct_branch, ix_lct_approved_by,
  //   -- ix_lct_reversal_fk. ux_lct_reversal does NOT cover fk_lct_reversal —
  //   -- different second column — which is why ix_lct_reversal_fk exists.
  //
  // CHECK constraints (DB-only): ck_lct_acc_year, ck_lct_src_acc_year,
  //   ck_lct_src_doc, ck_lct_txn_type, ck_lct_amount_nonzero, ck_lct_sign,
  //   ck_lct_percent, ck_lct_bill_amount, ck_lct_tender_pair,
  //   ck_lct_reversal_pair, ck_lct_no_self_reversal, ck_lct_redeem_tender,
  //   ck_lct_no_tender, ck_lct_cancel_approval, ck_lct_row_no

  @@map("loyalty_coupon_txn")
  @@schema("sales")
}

// ----- prisma/sales/loyaltyGiftRedeem.prisma -----
/// A gift redemption slip — A DOCUMENT IN ITS OWN RIGHT.
///
/// A customer walks up with points and walks away with goods and a printed
/// slip. No money crosses the counter, so this cannot be an AccTenderDetail
/// row. And it is not a line on a sale bill either: it has its own number
/// series, its own status, its own print count, and frequently no bill at all.
///
/// Shape follows SaleBill: a partitioned header with an offline-safe number
/// pair (a per-device serial plus the printed refno that embeds it), and a
/// partitioned detail carrying the stock movement.
///
/// The POINTS side is not stored here. LoyaltyLedger holds the GIFT rows — one
/// per lot consumed, named by lldSrcDocId — and the wallet balance follows
/// from them. lgrOpeningPoints / lgrRedeemPoints / lgrClosingPoints are
/// SNAPSHOTS for the printed slip; the ledger remains the authority.
model LoyaltyGiftRedeem {
  lgrId                 String    @default(dbgenerated("uuidv7()")) @db.Uuid @map("lgr_id")
  lgrCompId             String    @db.Uuid                                 @map("lgr_comp_id")
  lgrBranchId           String    @db.Uuid                                 @map("lgr_branch_id")
  lgrTenantId           String?   @db.Uuid                                 @map("lgr_tenant_id")
  lgrAccYear            String    @db.Char(9)                              @map("lgr_acc_year")

  // ── Document identity ────────────────────────────────────────────────
  // Offline-safe, the SaleBill pattern: the DEVICE owns the series, so a till
  // with no network can still number a slip.
  lgrDeviceId           String?   @db.Uuid                                 @map("lgr_device_id")
  /// Raw per-device serial — no server round trip needed to allocate one.
  lgrRedeemSlno         BigInt                                             @map("lgr_redeem_slno")
  /// The printed number, which embeds the counter series.
  lgrRedeemRefno        String    @db.VarChar(100)                         @map("lgr_redeem_refno")
  lgrRedeemDate         DateTime  @db.Date                                 @map("lgr_redeem_date")
  lgrRedeemTime         DateTime? @db.Time(6)                              @map("lgr_redeem_time")

  // ── Who ──────────────────────────────────────────────────────────────
  lgrMemberId           String    @db.Uuid                                 @map("lgr_member_id")
  lgrCustId             String    @db.Uuid                                 @map("lgr_cust_id")
  /// Scheme it was claimed under.
  lgrLscId              String?   @db.Uuid                                 @map("lgr_lsc_id")
  /// The login that saved it.
  lgrUserId             String?   @db.Uuid                                 @map("lgr_user_id")
  /// The person who served, if different from the login.
  lgrEmpId              String?   @db.Uuid                                 @map("lgr_emp_id")

  // ── Points, as printed on the slip ───────────────────────────────────
  lgrOpeningPoints      Decimal   @default(0) @db.Decimal(18, 4)           @map("lgr_opening_points")
  lgrRedeemPoints       Decimal   @default(0) @db.Decimal(18, 4)           @map("lgr_redeem_points")
  lgrClosingPoints      Decimal   @default(0) @db.Decimal(18, 4)           @map("lgr_closing_points")

  // ── What it cost the shop ────────────────────────────────────────────
  lgrTotalQty           Decimal   @default(0) @db.Decimal(18, 3)           @map("lgr_total_qty")
  /// At MRP / issue rate.
  lgrTotalValue         Decimal   @default(0) @db.Decimal(18, 2)           @map("lgr_total_value")
  /// At cost, for the giveaway P&L.
  lgrTotalCost          Decimal   @default(0) @db.Decimal(18, 2)           @map("lgr_total_cost")

  // ── Authorisation ────────────────────────────────────────────────────
  /// One-time code that authorised the redemption. Points are bearer value;
  /// a counter able to spend them unchallenged is a fraud route.
  lgrOtpNo              String?   @db.VarChar(10)                          @map("lgr_otp_no")
  lgrApprovedBy         String?   @db.Uuid                                 @map("lgr_approved_by")
  /// DRAFT | CONFIRMED | CANCELLED. A cancelled slip must name who authorised
  /// the cancellation (ck_lgr_cancel), and may never carry a live voucher.
  lgrStatus             String    @default("DRAFT") @db.VarChar(20)        @map("lgr_status")
  lgrPrintCount         Int       @default(0)                              @map("lgr_print_count")

  // ── Accounting / Tally ───────────────────────────────────────────────
  /// The AccVoucherHeader this slip posted to, once the server has posted it.
  ///
  /// NO FOREIGN KEY, deliberately, and for the same reason
  /// sale_bill.sb_posted_voucher_id has none: this is a counter document
  /// created OFFLINE, so the row exists long before the voucher does. An FK
  /// would make the counter's insert depend on a server-side write it cannot
  /// see. The accounts-side documents (AccBillBalance, AccPdcRegister) DO
  /// carry the FK, because they are only ever written server-side after
  /// posting — a different lifecycle, a different rule.
  ///
  /// This is the ONLY route by which a gift redemption reaches Tally: export
  /// happens at the voucher layer, never from a source document. The
  /// accounting year travels with the id so the lookup hits one partition.
  lgrPostedVoucherId    String?   @db.Uuid                                 @map("lgr_posted_voucher_id")
  lgrVoucherAccYear     String?   @db.Char(9)                              @map("lgr_voucher_acc_year")

  lgrReversalOfId       String?   @db.Uuid                                 @map("lgr_reversal_of_id")
  lgrReversalOfAccYear  String?   @db.Char(9)                              @map("lgr_reversal_of_acc_year")
  lgrReversalReason     String?   @db.VarChar(250)                         @map("lgr_reversal_reason")

  lgrRemarks            String?   @db.VarChar(500)                         @map("lgr_remarks")
  lgrIsDeleted          Boolean   @default(false)                          @map("lgr_is_deleted")
  lgrSyncDate           DateTime? @db.Timestamptz(6)                       @map("lgr_sync_date")
  lgrCreatedOn          DateTime  @default(now()) @db.Timestamptz(6)       @map("lgr_created_on")
  lgrCreatedBy          String?   @db.VarChar(50)                          @map("lgr_created_by")
  lgrModifiedOn         DateTime? @db.Timestamptz(6)                       @map("lgr_modified_on")
  lgrModifiedBy         String?   @db.VarChar(50)                          @map("lgr_modified_by")

  // Relations
  company               Company        @relation("LoyaltyGiftRedeemCompany",  fields: [lgrCompId],    references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_lgr_company")
  branch                BranchMaster   @relation("LoyaltyGiftRedeemBranch",   fields: [lgrBranchId],  references: [brId],   onUpdate: Cascade, onDelete: Restrict, map: "fk_lgr_branch")
  device                DeviceMaster?  @relation("LoyaltyGiftRedeemDevice",   fields: [lgrDeviceId],  references: [devId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_lgr_device")
  member                LoyaltyMember  @relation("LoyaltyGiftRedeemMember",   fields: [lgrMemberId],  references: [lmbId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_lgr_member")
  customer              Customer       @relation("LoyaltyGiftRedeemCustomer", fields: [lgrCustId],    references: [cusId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_lgr_cust")
  scheme                LoyaltyScheme? @relation("LoyaltyGiftRedeemScheme",   fields: [lgrLscId],     references: [lscId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_lgr_scheme")
  user                  UserMaster?    @relation("LoyaltyGiftRedeemUser",     fields: [lgrUserId],    references: [usrId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_lgr_user")
  employee              EmployeeMaster? @relation("LoyaltyGiftRedeemEmployee", fields: [lgrEmpId],    references: [empId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_lgr_emp")
  approver              UserMaster?    @relation("LoyaltyGiftRedeemApprover", fields: [lgrApprovedBy], references: [usrId], onUpdate: Cascade, onDelete: Restrict, map: "fk_lgr_approved_by")

  reversalOf            LoyaltyGiftRedeem?  @relation("LoyaltyGiftRedeemReversal", fields: [lgrReversalOfId, lgrReversalOfAccYear], references: [lgrId, lgrAccYear], onUpdate: Cascade, onDelete: Restrict, map: "fk_lgr_reversal")
  reversedBy            LoyaltyGiftRedeem[] @relation("LoyaltyGiftRedeemReversal")

  items                 LoyaltyGiftRedeemItem[] @relation("LoyaltyGiftRedeemItems")

  // No relation field for lgrPostedVoucherId — the DDL declares no FK (see
  // the column comment above), and lgrTenantId has no Tenant model.

  @@id([lgrId, lgrAccYear], map: "pk_loyalty_gift_redeem")

  // Partial indexes are DB-only — Prisma ignores WHERE predicates and
  // NULLS NOT DISTINCT:
  //
  //   -- the printed number is unique per branch and year …
  //   CREATE UNIQUE INDEX ux_lgr_refno ON sales.loyalty_gift_redeem
  //       (lgr_comp_id, lgr_branch_id, lgr_acc_year, lgr_redeem_refno)
  //       WHERE lgr_is_deleted = false;
  //   -- … the raw serial is unique per DEVICE, which is what lets an offline
  //   -- till number without asking. NULLS NOT DISTINCT so the "no device"
  //   -- case is one series rather than an unconstrained free-for-all.
  //   CREATE UNIQUE INDEX ux_lgr_slno ON sales.loyalty_gift_redeem
  //       (lgr_comp_id, lgr_branch_id, lgr_acc_year, lgr_device_id, lgr_redeem_slno)
  //       NULLS NOT DISTINCT WHERE lgr_is_deleted = false;
  //
  //   CREATE INDEX ix_lgr_list ON sales.loyalty_gift_redeem
  //       (lgr_comp_id, lgr_branch_id, lgr_redeem_date)
  //       INCLUDE (lgr_redeem_refno, lgr_cust_id, lgr_redeem_points, lgr_status)
  //       WHERE lgr_is_deleted = false;
  //
  //   -- THE POSTING QUEUE: confirmed slips the server has not yet turned into
  //   -- a voucher. Partial, so it stays small however long the table grows.
  //   CREATE INDEX ix_lgr_unposted ON sales.loyalty_gift_redeem
  //       (lgr_comp_id, lgr_redeem_date)
  //       WHERE lgr_posted_voucher_id IS NULL AND lgr_status = 'CONFIRMED'
  //         AND lgr_is_deleted = false;
  //
  //   -- FK-covering and lookup: ix_lgr_member, ix_lgr_cust, ix_lgr_branch,
  //   -- ix_lgr_scheme, ix_lgr_device, ix_lgr_user, ix_lgr_emp,
  //   -- ix_lgr_approved_by, ix_lgr_voucher, ix_lgr_reversal
  //
  // CHECK constraints (DB-only): ck_lgr_acc_year, ck_lgr_status, ck_lgr_slno,
  //   ck_lgr_refno, ck_lgr_points, ck_lgr_totals, ck_lgr_print_count,
  //   ck_lgr_voucher_pair, ck_lgr_voucher_acc_year, ck_lgr_voucher_status,
  //   ck_lgr_reversal_pair, ck_lgr_no_self_reversal, ck_lgr_cancel
  //
  // STILL NEEDED elsewhere: a row in accounts.acc_voucher_types for the gift
  // redemption, with Tally export and inventory-affecting flags set. Its
  // vchr_type_id is a small integer assigned by hand, so it is left to whoever
  // owns that master rather than guessed here.

  @@map("loyalty_gift_redeem")
  @@schema("sales")
}

// ----- prisma/sales/loyaltyGiftRedeemItem.prisma -----
/// The goods issued against a redemption slip.
///
/// ONE detail table, not two. The legacy pair (loy_item_rdm_items and
/// loy_item_rdm_itm_det) held identical column sets against the same header
/// and only one was live, so only one is rebuilt.
///
/// Carries the full stock movement — godown, batch, serial, expiry — because a
/// gift relieves inventory exactly as a sale does, and a batch-tracked shop
/// cannot post the issue without them. Cost is snapshotted alongside the issue
/// rate so the giveaway can be valued afterwards without re-pricing history.
///
/// Partitioned on its own lgdAccYear, which ck_lgd_same_year pins to the
/// header's — the composite FK requires it and the CHECK makes it readable.
model LoyaltyGiftRedeemItem {
  lgdId             String    @default(dbgenerated("uuidv7()")) @db.Uuid   @map("lgd_id")
  lgdCompId         String    @db.Uuid                                     @map("lgd_comp_id")
  lgdBranchId       String    @db.Uuid                                     @map("lgd_branch_id")
  lgdTenantId       String?   @db.Uuid                                     @map("lgd_tenant_id")
  lgdAccYear        String    @db.Char(9)                                  @map("lgd_acc_year")

  lgdLgrId          String    @db.Uuid                                     @map("lgd_lgr_id")
  lgdLgrAccYear     String    @db.Char(9)                                  @map("lgd_lgr_acc_year")
  lgdRowNo          Int       @default(1)                                  @map("lgd_row_no")

  /// The catalogue row claimed, when the gift came from a scheme's list.
  lgdLsgId          String?   @db.Uuid                                     @map("lgd_lsg_id")
  lgdItemId         String    @db.Uuid                                     @map("lgd_item_id")
  /// item_unit_conversion, as on a bill line.
  lgdUnitId         String    @db.Uuid                                     @map("lgd_unit_id")
  lgdGodownId       String?   @db.Uuid                                     @map("lgd_godown_id")
  lgdBarcode        String?   @db.VarChar(30)                              @map("lgd_barcode")

  // Batch / serial. The id is the link; the rest are snapshots so a reprint of
  // last year's slip does not depend on the batch row still existing.
  lgdBatchId        String?   @db.Uuid                                     @map("lgd_batch_id")
  lgdBatchNo        String?   @db.VarChar(50)                              @map("lgd_batch_no")
  lgdSerialNo       String?   @db.VarChar(50)                              @map("lgd_serial_no")
  lgdBatchDate      DateTime? @db.Date                                     @map("lgd_batch_date")
  lgdExpiryDate     DateTime? @db.Date                                     @map("lgd_expiry_date")

  /// No database default: ck_lgd_qty demands it be positive, so a row that
  /// omits it must fail rather than silently issue nothing.
  lgdQty            Decimal   @db.Decimal(18, 3)                           @map("lgd_qty")
  /// On hand at the moment of issue.
  lgdStockQty       Decimal   @default(0) @db.Decimal(18, 3)               @map("lgd_stock_qty")
  /// Issue rate.
  lgdRate           Decimal   @default(0) @db.Decimal(18, 4)               @map("lgd_rate")
  lgdTotal          Decimal   @default(0) @db.Decimal(18, 2)               @map("lgd_total")
  /// Points this line cost.
  lgdPoints         Decimal   @default(0) @db.Decimal(18, 4)               @map("lgd_points")
  lgdMaxPrice       Decimal   @default(0) @db.Decimal(18, 4)               @map("lgd_max_price")
  /// The giveaway's cost — what a Tally Stock Journal posts against.
  lgdCostPrice      Decimal   @default(0) @db.Decimal(18, 4)               @map("lgd_cost_price")
  /// Cost excluding tax.
  lgdCostWot        Decimal   @default(0) @db.Decimal(18, 4)               @map("lgd_cost_wot")

  lgdNotes          String?   @db.VarChar(250)                             @map("lgd_notes")
  lgdIsDeleted      Boolean   @default(false)                              @map("lgd_is_deleted")
  lgdSyncDate       DateTime? @db.Timestamptz(6)                           @map("lgd_sync_date")
  lgdCreatedOn      DateTime  @default(now()) @db.Timestamptz(6)           @map("lgd_created_on")
  lgdCreatedBy      String?   @db.VarChar(50)                              @map("lgd_created_by")
  lgdModifiedOn     DateTime? @db.Timestamptz(6)                           @map("lgd_modified_on")
  lgdModifiedBy     String?   @db.VarChar(50)                              @map("lgd_modified_by")

  // Relations
  header            LoyaltyGiftRedeem @relation("LoyaltyGiftRedeemItems", fields: [lgdLgrId, lgdLgrAccYear], references: [lgrId, lgrAccYear], onUpdate: Cascade, onDelete: Cascade, map: "fk_lgd_header")
  company           Company            @relation("LoyaltyGiftItemCompany", fields: [lgdCompId],   references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_lgd_company")
  branch            BranchMaster       @relation("LoyaltyGiftItemBranch",  fields: [lgdBranchId], references: [brId],   onUpdate: Cascade, onDelete: Restrict, map: "fk_lgd_branch")
  gift              LoyaltySchemeGift? @relation("LoyaltyGiftItemGift",    fields: [lgdLsgId],    references: [lsgId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_lgd_gift")
  item              ItemMaster         @relation("LoyaltyGiftItemItem",    fields: [lgdItemId],   references: [itemId], onUpdate: Cascade, onDelete: Restrict, map: "fk_lgd_item")
  unit              ItemUnitConversion @relation("LoyaltyGiftItemUnit",    fields: [lgdUnitId],   references: [iucId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_lgd_unit")
  godown            GodownLocation?    @relation("LoyaltyGiftItemGodown",  fields: [lgdGodownId], references: [gdlId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_lgd_godown")
  batch             ItemBatchMaster?   @relation("LoyaltyGiftItemBatch",   fields: [lgdBatchId],  references: [btmId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_lgd_batch")

  @@id([lgdId, lgdAccYear], map: "pk_loyalty_gift_redeem_item")

  // Partial indexes are DB-only:
  //
  //   CREATE UNIQUE INDEX ux_lgd_row ON sales.loyalty_gift_redeem_item
  //       (lgd_lgr_id, lgd_acc_year, lgd_row_no) WHERE lgd_is_deleted = false;
  //
  //   -- what the giveaway cost, by item and period
  //   CREATE INDEX ix_lgd_item_period ON sales.loyalty_gift_redeem_item
  //       (lgd_comp_id, lgd_item_id, lgd_acc_year)
  //       INCLUDE (lgd_qty, lgd_points, lgd_total, lgd_cost_price)
  //       WHERE lgd_is_deleted = false;
  //
  //   -- FK-covering: ix_lgd_header, ix_lgd_branch, ix_lgd_item, ix_lgd_unit,
  //   -- ix_lgd_gift, ix_lgd_godown, ix_lgd_batch
  //
  // CHECK constraints (DB-only): ck_lgd_acc_year, ck_lgd_same_year,
  //   ck_lgd_row_no, ck_lgd_qty, ck_lgd_amounts, ck_lgd_batch_dates

  @@map("loyalty_gift_redeem_item")
  @@schema("sales")
}

// ----- prisma/sales/loyaltyLedger.prisma -----
/// One row per point movement against one wallet, drawn from ONE lot.
///
/// LIST-partitioned by lldAccYear — the year the EVENT happened, not the year
/// the points were earned. That is the whole trick: July's redemption of
/// April's points lands in July's partition and April's earn row never moves.
/// Hence the composite PK (lldId, lldAccYear). Partitions
/// (sales.loyalty_ledger_2026_2027) come from
/// public.ensure_acc_year_partitions('YYYY-YYYY'), which
/// 20260921140000_add_loyalty_points_engine taught about this table.
///
/// A row is never edited and never deleted. Everything is undone by a NEW row
/// of opposite sign naming the row it undoes (lldReversalOfId) — so a plain
/// SUM per txn type nets reversals out and no caller special-cases them.
///
/// EARN rows ARE the lots. They carry lldExpiresOn, lldActiveFrom and
/// lldConsumedPoints; lldLotBalance is what is left. Consuming rows
/// (REDEEM / GIFT / EXPIRE) carry lldLotId pointing back at the lot they came
/// out of, so a redemption spanning three lots is THREE rows sharing ONE
/// tender. It costs rows and buys expiry that is exact and reversible.
///
/// FIFO, defined in ONE place (LoyaltyLedgerService.lots()) and nowhere else:
///     ORDER BY lld_expires_on NULLS LAST, lld_txn_date, lld_id
/// Oldest expiry first; within one expiry date, oldest earned first; lots that
/// never expire last of all — the customer-favourable order, because it spends
/// what would otherwise lapse.
///
/// WRITE RULE: exactly one private method of LoyaltyLedgerService may INSERT,
/// UPDATE or soft-delete this table. It writes the rows, then recomputes the
/// touched LOTS and then the touched MEMBERS, in that order, before returning.
/// Nothing else touches it — not a repository, not the sync handler, not a
/// migration script. There is no trigger to fall back on.
model LoyaltyLedger {
  lldId                 String    @default(dbgenerated("uuidv7()")) @db.Uuid @map("lld_id")
  lldCompId             String    @db.Uuid                                 @map("lld_comp_id")
  /// WHERE THE EVENT HAPPENED. Points earned at one branch and spent at
  /// another are the normal case for a chain; this column is what makes
  /// "who gave them, who honoured them" answerable, and it is the whole basis
  /// of inter-branch settlement between franchisees.
  lldBranchId           String    @db.Uuid                                 @map("lld_branch_id")
  lldTenantId           String?   @db.Uuid                                 @map("lld_tenant_id")
  /// FY of the EVENT, and the partition key.
  lldAccYear            String    @db.Char(9)                              @map("lld_acc_year")

  // ── Whose points ─────────────────────────────────────────────────────
  // Single-column FK: LoyaltyMember is not partitioned, which is precisely
  // what makes earning in one year and spending in another a plain foreign key.
  lldMemberId           String    @db.Uuid                                 @map("lld_member_id")
  /// Snapshot; every report groups by it.
  lldCustId             String    @db.Uuid                                 @map("lld_cust_id")

  // ── Which rule produced this ─────────────────────────────────────────
  // The "why did I get 37 points" answer, without re-running the engine
  // against a scheme that may since have been edited.
  lldLscId              String?   @db.Uuid                                 @map("lld_lsc_id")
  lldLssId              String?   @db.Uuid                                 @map("lld_lss_id")
  lldLsiId              String?   @db.Uuid                                 @map("lld_lsi_id")

  // ── The event ────────────────────────────────────────────────────────
  /// EARN | REDEEM | GIFT | EXPIRE | ADJUST | TRANSFER | OPENING
  lldTxnType            String    @db.VarChar(20)                          @map("lld_txn_type")
  lldRowNo              Int       @default(1)                              @map("lld_row_no")
  /// SIGNED. EARN/OPENING positive, REDEEM/GIFT/EXPIRE negative,
  /// ADJUST/TRANSFER either. A reversal repeats the type with the opposite
  /// sign (ck_lld_sign enforces the pairing).
  lldPoints             Decimal   @db.Decimal(18, 4)                       @map("lld_points")
  lldTxnDate            DateTime  @db.Date                                 @map("lld_txn_date")
  /// Which side of a happy-hour boundary the till was on. Without it, a
  /// double-points window is unauditable the morning after.
  lldTxnTime            DateTime? @db.Time(6)                              @map("lld_txn_time")

  // ── FIFO lot ─────────────────────────────────────────────────────────
  /// On a consuming row: the EARN row these points came out of. Travels as a
  /// pair because this table is partitioned.
  lldLotId              String?   @db.Uuid                                 @map("lld_lot_id")
  lldLotAccYear         String?   @db.Char(9)                              @map("lld_lot_acc_year")
  /// On the LOT row only: how much of it has been spent, expired or moved
  /// away. Recomputed by LoyaltyLedgerService.recomputeLots(); there is no
  /// trigger and no other code may write it.
  lldConsumedPoints     Decimal   @default(0) @db.Decimal(18, 4)           @map("lld_consumed_points")
  /// GENERATED ALWAYS ... STORED: lldPoints - lldConsumedPoints on a lot row,
  /// ZERO (not NULL) on a consuming row — which is what keeps the "> 0" index
  /// predicates cheap and total. Read-only: never send it on a create or
  /// update, and @default(dbgenerated()) keeps migrate from emitting a default.
  lldLotBalance         Decimal?  @default(dbgenerated()) @db.Decimal(18, 4) @map("lld_lot_balance")
  /// When this lot lapses, from lsc_points_valid_days / lsc_expiry_basis at
  /// earn time. NULL = never expires, and such lots are consumed LAST.
  lldExpiresOn          DateTime? @db.Date                                 @map("lld_expires_on")
  /// When this lot becomes REDEEMABLE: bill date + lsc_activation_days. Before
  /// it, the points exist and show in the balance but cannot be spent — the
  /// return-window defence against clawing back points already spent.
  /// NULL = redeemable at once.
  lldActiveFrom         DateTime? @db.Date                                 @map("lld_active_from")

  // ── Source document ──────────────────────────────────────────────────
  // The same four-part polymorphic identifier AccTenderDetail,
  // AccBillBalance and TxnStatusLog use. All three of module/type/id or none
  // (ck_lld_src_doc).
  lldSrcModule          String?   @db.VarChar(20)                          @map("lld_src_module")
  lldSrcDocType         String?   @db.VarChar(30)                          @map("lld_src_doc_type")
  lldSrcDocId           String?   @db.Uuid                                 @map("lld_src_doc_id")
  /// The SOURCE's FY, not this row's.
  lldSrcAccYear         String?   @db.Char(9)                              @map("lld_src_acc_year")
  /// Snapshot, so a member statement prints the bill number without joining a
  /// partitioned table across every year the customer has traded.
  lldSrcDocRefno        String?   @db.VarChar(100)                         @map("lld_src_doc_refno")
  lldSrcRowNo           Int?                                               @map("lld_src_row_no")

  // ── How it was computed ──────────────────────────────────────────────
  lldBaseAmount         Decimal   @default(0) @db.Decimal(18, 2)           @map("lld_base_amount")
  lldBaseQty            Decimal   @default(0) @db.Decimal(18, 3)           @map("lld_base_qty")
  /// Points per slab on an earn, or INR per point on a redeem. Snapshotted so
  /// a historic redemption stays re-derivable whichever of
  /// lsc_redeem_value_per_point or tnd_conversion_rate was in play.
  lldRate               Decimal   @default(0) @db.Decimal(18, 4)           @map("lld_rate")
  lldFactor             Decimal   @default(1) @db.Decimal(18, 4)           @map("lld_factor")
  /// What they were worth, in INR.
  lldMoneyValue         Decimal   @default(0) @db.Decimal(18, 2)           @map("lld_money_value")

  // ── The tender ───────────────────────────────────────────────────────
  /// Redemption is a TENDER LINE: AccTenderDetail with td_tender_type_id = 10
  /// (LOYALTY), td_units_used = the points, td_conversion_rate = rupees per
  /// point. This pair is what ties the two sides together, and it is the ONLY
  /// route by which a redemption reaches the GL and then Tally — earning posts
  /// nothing at all, being statistical.
  lldTenderId           String?   @db.Uuid                                 @map("lld_tender_id")
  lldTenderAccYear      String?   @db.Char(9)                              @map("lld_tender_acc_year")

  // ── Reversal ─────────────────────────────────────────────────────────
  /// Carries a real FK, unlike abj_reversal_of_id, because this table has the
  /// year to complete the composite key with.
  lldReversalOfId       String?   @db.Uuid                                 @map("lld_reversal_of_id")
  lldReversalOfAccYear  String?   @db.Char(9)                              @map("lld_reversal_of_acc_year")
  lldReversalReason     String?   @db.VarChar(250)                         @map("lld_reversal_reason")

  // ── Who ──────────────────────────────────────────────────────────────
  /// A manual adjustment is somebody's decision, not a keying accident —
  /// ck_lld_adjust_approval makes ADJUST require this.
  lldApprovedBy         String?   @db.Uuid                                 @map("lld_approved_by")
  lldUserId             String?   @db.Uuid                                 @map("lld_user_id")
  lldSessionId          String?   @db.Uuid                                 @map("lld_session_id")
  lldDeviceId           String?   @db.Uuid                                 @map("lld_device_id")

  lldRemarks            String?   @db.VarChar(250)                         @map("lld_remarks")
  lldIsDeleted          Boolean   @default(false)                          @map("lld_is_deleted")

  // ── Audit ────────────────────────────────────────────────────────────
  lldSyncDate           DateTime? @db.Timestamptz(6)                       @map("lld_sync_date")
  lldCreatedOn          DateTime  @default(now()) @db.Timestamptz(6)       @map("lld_created_on")
  lldCreatedBy          String?   @db.VarChar(50)                          @map("lld_created_by")
  lldModifiedOn         DateTime? @db.Timestamptz(6)                       @map("lld_modified_on")
  lldModifiedBy         String?   @db.VarChar(50)                          @map("lld_modified_by")

  // Relations
  member                LoyaltyMember      @relation("LoyaltyLedgerMember",   fields: [lldMemberId], references: [lmbId], onUpdate: Cascade, onDelete: Restrict, map: "fk_lld_member")
  customer              Customer           @relation("LoyaltyLedgerCustomer", fields: [lldCustId],   references: [cusId], onUpdate: Cascade, onDelete: Restrict, map: "fk_lld_cust")
  company               Company            @relation("LoyaltyLedgerCompany",  fields: [lldCompId],   references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_lld_company")
  branch                BranchMaster       @relation("LoyaltyLedgerBranch",   fields: [lldBranchId], references: [brId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_lld_branch")
  scheme                LoyaltyScheme?     @relation("LoyaltyLedgerScheme",   fields: [lldLscId],    references: [lscId], onUpdate: Cascade, onDelete: Restrict, map: "fk_lld_scheme")
  slab                  LoyaltySchemeSlab? @relation("LoyaltyLedgerSlab",     fields: [lldLssId],    references: [lssId], onUpdate: Cascade, onDelete: Restrict, map: "fk_lld_slab")
  itemRule              LoyaltySchemeItem? @relation("LoyaltyLedgerItemRule", fields: [lldLsiId],    references: [lsiId], onUpdate: Cascade, onDelete: Restrict, map: "fk_lld_item_rule")
  user                  UserMaster?        @relation("LoyaltyLedgerUser",     fields: [lldUserId],   references: [usrId], onUpdate: Cascade, onDelete: Restrict, map: "fk_lld_user")
  approver              UserMaster?        @relation("LoyaltyLedgerApprover", fields: [lldApprovedBy], references: [usrId], onUpdate: Cascade, onDelete: Restrict, map: "fk_lld_approved_by")
  device                DeviceMaster?      @relation("LoyaltyLedgerDevice",   fields: [lldDeviceId], references: [devId], onUpdate: Cascade, onDelete: Restrict, map: "fk_lld_device")

  lot                   LoyaltyLedger?  @relation("LoyaltyLedgerLot",      fields: [lldLotId, lldLotAccYear],           references: [lldId, lldAccYear], onUpdate: Cascade, onDelete: Restrict, map: "fk_lld_lot")
  lotConsumers          LoyaltyLedger[] @relation("LoyaltyLedgerLot")
  reversalOf            LoyaltyLedger?  @relation("LoyaltyLedgerReversal", fields: [lldReversalOfId, lldReversalOfAccYear], references: [lldId, lldAccYear], onUpdate: Cascade, onDelete: Restrict, map: "fk_lld_reversal")
  reversedBy            LoyaltyLedger[] @relation("LoyaltyLedgerReversal")

  tender                AccTenderDetail? @relation("LoyaltyLedgerTender", fields: [lldTenderId, lldTenderAccYear], references: [tdId, tdAccYear], onUpdate: Cascade, onDelete: Restrict, map: "fk_lld_tender")

  // No relation field for lldSrcDocId — polymorphic by design, the target
  // table varies by lldSrcModule/lldSrcDocType. Nor for lldTenantId (no Tenant
  // model) or lldSessionId (not a unique FK target).

  @@id([lldId, lldAccYear], map: "pk_loyalty_ledger")

  // Partial indexes are DB-only — Prisma ignores WHERE predicates, so
  // declaring them here would produce phantom drift on every migrate dev:
  //
  //   -- THE IDEMPOTENCY GUARD, and the most important index of the set.
  //   -- Points earn on bill save at a counter that may be offline; that bill
  //   -- will be re-sent, possibly twice. Without this, every replay mints
  //   -- points again and nothing notices until a customer redeems money the
  //   -- shop never owed them. The expiry run leans on it too, via its
  //   -- deterministic runId.
  //   CREATE UNIQUE INDEX ux_lld_src_row ON sales.loyalty_ledger
  //       (lld_src_doc_type, lld_src_doc_id, lld_acc_year, lld_txn_type, lld_row_no)
  //       WHERE lld_src_doc_id IS NOT NULL AND lld_is_deleted = false;
  //
  //   -- THE FIFO INDEX. Both the redeem path and the expiry run live on it;
  //   -- INCLUDE keeps a till walking a member's lots off the heap.
  //   CREATE INDEX ix_lld_open_lots ON sales.loyalty_ledger
  //       (lld_member_id, lld_expires_on, lld_txn_date, lld_id)
  //       INCLUDE (lld_points, lld_consumed_points, lld_active_from, lld_lot_balance)
  //       WHERE lld_is_deleted = false AND lld_lot_balance > 0;
  //
  //   -- a row may be reversed once. CAVEAT: a unique index on a partitioned
  //   -- table must include the partition key, so this is unique per YEAR — a
  //   -- reversal in March and another in April of the same row would both be
  //   -- accepted. The posting code must check before it writes.
  //   CREATE UNIQUE INDEX ux_lld_reversal ON sales.loyalty_ledger
  //       (lld_reversal_of_id, lld_acc_year)
  //       WHERE lld_reversal_of_id IS NOT NULL AND lld_is_deleted = false;
  //
  //   -- the member statement; the nightly expiry sweep; the lot recompute's
  //   -- own path; bill -> the points it earned (the claw-back path)
  //   CREATE INDEX ix_lld_member  ON sales.loyalty_ledger (lld_member_id, lld_txn_date) …
  //   CREATE INDEX ix_lld_expiry  ON sales.loyalty_ledger (lld_comp_id, lld_expires_on) …
  //   CREATE INDEX ix_lld_lot     ON sales.loyalty_ledger (lld_lot_id, lld_lot_acc_year) …
  //   CREATE INDEX ix_lld_src_doc ON sales.loyalty_ledger (lld_src_doc_type, lld_src_doc_id) …
  //
  //   -- INTER-BRANCH SETTLEMENT: points issued by branch A, honoured by
  //   -- branch B. For a franchise chain this report is why lld_branch_id exists.
  //   CREATE INDEX ix_lld_branch_period ON sales.loyalty_ledger
  //       (lld_comp_id, lld_branch_id, lld_txn_date, lld_txn_type)
  //       INCLUDE (lld_points, lld_money_value) WHERE lld_is_deleted = false;
  //
  //   -- the other half of the reconciliation report. No per-lot over-draw
  //   -- CHECK exists: two tills offline can each draw the last of one lot and
  //   -- the batch that syncs second must be RECORDED, not refused.
  //   CREATE INDEX ix_lld_lot_overdrawn ON sales.loyalty_ledger
  //       (lld_comp_id, lld_member_id)
  //       WHERE lld_is_deleted = false AND lld_lot_balance < 0;
  //
  //   -- FK-covering: ix_lld_scheme, ix_lld_slab, ix_lld_item_rule,
  //   -- ix_lld_cust, ix_lld_user, ix_lld_device, ix_lld_tender,
  //   -- ix_lld_branch, ix_lld_approved_by, ix_lld_reversal_fk. Note that
  //   -- ux_lld_reversal does NOT cover fk_lld_reversal — different second
  //   -- column — which is why ix_lld_reversal_fk exists beside it.
  //
  // CHECK constraints (DB-only): ck_lld_acc_year, ck_lld_src_acc_year,
  //   ck_lld_txn_type, ck_lld_src_module, ck_lld_src_doc_type, ck_lld_src_doc,
  //   ck_lld_points_nonzero, ck_lld_sign, ck_lld_lot_pair,
  //   ck_lld_lot_required, ck_lld_no_self_lot, ck_lld_lot_dates,
  //   ck_lld_tender_pair, ck_lld_reversal_pair, ck_lld_no_self_reversal,
  //   ck_lld_redeem_tender, ck_lld_gift_no_tender, ck_lld_adjust_approval,
  //   ck_lld_row_no, ck_lld_factor

  @@map("loyalty_ledger")
  @@schema("sales")
}

// ----- prisma/sales/loyaltyMember.prisma -----
/// The points wallet: ONE per (company, customer).
///
/// NOT partitioned, and never carried forward at year end — this is
/// AccBillBalance applied to points. A customer who earned in 2025-2026 and
/// spends in 2027-2028 is the SAME row throughout, which is precisely what
/// makes LoyaltyLedger's reference to it a plain foreign key instead of a
/// composite one that has to carry a year around.
///
/// lmbAccYear records the year they ENROLLED and is a reporting filter only.
/// Making it a partition key is exactly the mistake the bill-balance
/// repartitioning exists to undo.
///
/// Keyed by company and customer, never by branch: that single index
/// (ux_lmb_cust) is the chain-store guarantee that points earned at one branch
/// spend at another. lmbCardNo and lmbMobile are ALTERNATE HANDLES for finding
/// this row, not identities — the identity is lmbCustId.
model LoyaltyMember {
  lmbId               String    @id(map: "pk_loyalty_member") @default(dbgenerated("uuidv7()")) @db.Uuid @map("lmb_id")
  lmbCompId           String    @db.Uuid                                   @map("lmb_comp_id")
  /// Branch that ENROLLED them. Never a scope — a wallet belongs to the company.
  lmbBranchId         String?   @db.Uuid                                   @map("lmb_branch_id")
  lmbTenantId         String?   @db.Uuid                                   @map("lmb_tenant_id")
  /// FY of enrolment. Reporting filter only, never a partition key.
  lmbAccYear          String    @db.Char(9)                                @map("lmb_acc_year")

  // ── Identity ─────────────────────────────────────────────────────────
  lmbCustId           String    @db.Uuid                                   @map("lmb_cust_id")
  /// The accounting party, snapshotted so a points-liability report can join
  /// accounts without a hop through the customer master. Nullable: a cash
  /// customer may have no ledger row yet.
  lmbPartyLedgerId    String?   @db.Uuid                                   @map("lmb_party_ledger_id")
  lmbLscId            String?   @db.Uuid                                   @map("lmb_lsc_id")
  lmbCardNo           String?   @db.VarChar(30)                            @map("lmb_card_no")
  /// Snapshot of customers.cus_phone1 — the supermarket lookup handle.
  lmbMobile           String?   @db.VarChar(20)                            @map("lmb_mobile")
  lmbEnrolledOn       DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date @map("lmb_enrolled_on")

  // ── Roll-ups ─────────────────────────────────────────────────────────
  // CACHES of LoyaltyLedger, recomputed by
  // LoyaltyLedgerService.recomputeMembers(). There is no trigger; no other
  // code may write them. All stored positive except lmbAdjustedPoints, signed.
  lmbEarnedPoints     Decimal   @default(0) @db.Decimal(18, 4)             @map("lmb_earned_points")
  lmbRedeemedPoints   Decimal   @default(0) @db.Decimal(18, 4)             @map("lmb_redeemed_points")
  lmbExpiredPoints    Decimal   @default(0) @db.Decimal(18, 4)             @map("lmb_expired_points")
  lmbGiftPoints       Decimal   @default(0) @db.Decimal(18, 4)             @map("lmb_gift_points")
  lmbAdjustedPoints   Decimal   @default(0) @db.Decimal(18, 4)             @map("lmb_adjusted_points")

  /// GENERATED ALWAYS ... STORED in the DB:
  ///   earned + adjusted - redeemed - expired - gift
  /// Read-only: never send it on a create or update — Postgres rejects it, and
  /// @default(dbgenerated()) marks it DB-owned so migrate never emits a
  /// default of its own.
  ///
  /// This is what the bill screen shows. It is NOT what the customer may spend
  /// today: cooling lots and unswept lapsed lots make those differ, and
  /// LoyaltyLedgerService.redeemable() answers that instead.
  lmbBalancePoints    Decimal?  @default(dbgenerated()) @db.Decimal(18, 4) @map("lmb_balance_points")

  /// Lifetime trading, which points alone cannot answer: lmbEarnedPoints is
  /// already "everything ever earned" (redemption never touches that bucket),
  /// so a lifetime-points column would just be a second copy of it. These two
  /// are not derivable from the point columns at all.
  lmbLifetimeBillAmt  Decimal   @default(0) @db.Decimal(18, 2)             @map("lmb_lifetime_bill_amt")
  lmbLifetimeBillCnt  Int       @default(0)                                @map("lmb_lifetime_bill_cnt")

  lmbLastEarnOn       DateTime? @db.Date                                   @map("lmb_last_earn_on")
  lmbLastRedeemOn     DateTime? @db.Date                                   @map("lmb_last_redeem_on")
  /// The dormant-member report and lsc_expiry_basis = 'LAST_TXN' have no other
  /// source once the row simply stays open across years.
  lmbLastActivityOn   DateTime? @db.Date                                   @map("lmb_last_activity_on")
  /// Earliest open lot, so the till can say "480 points expire in 9 days"
  /// without a scan of the ledger. Recomputed AFTER the lots — it reads
  /// lldLotBalance, so the other order publishes a wrong date silently.
  lmbNextExpiryOn     DateTime? @db.Date                                   @map("lmb_next_expiry_on")

  // There is deliberately NO stored "redeemable points" column. With a cooling
  // period, redeemable is not the same number as balance — but it is
  // date-dependent, and a cached copy would go stale at midnight with nobody
  // writing to it.

  // ── Status ───────────────────────────────────────────────────────────
  /// ACTIVE | SUSPENDED | CLOSED | MERGED. MERGED is two wallets that turn out
  /// to be one person: the loser is marked MERGED and its points move by a
  /// PAIR of ADJUST ledger rows — never by editing a balance, which would
  /// leave the trail with a hole in it.
  lmbStatus           String    @default("ACTIVE") @db.VarChar(20)         @map("lmb_status")
  lmbMergedIntoId     String?   @db.Uuid                                   @map("lmb_merged_into_id")
  lmbBlockReason      String?   @db.VarChar(250)                           @map("lmb_block_reason")

  lmbRemarks          String?   @db.VarChar(250)                           @map("lmb_remarks")
  lmbIsActive         Boolean   @default(true)                             @map("lmb_is_active")
  lmbIsDeleted        Boolean   @default(false)                            @map("lmb_is_deleted")

  // ── Audit ────────────────────────────────────────────────────────────
  lmbSyncDate         DateTime? @db.Timestamptz(6)                         @map("lmb_sync_date")
  lmbCreatedOn        DateTime  @default(now()) @db.Timestamptz(6)         @map("lmb_created_on")
  lmbCreatedBy        String?   @db.VarChar(50)                            @map("lmb_created_by")
  lmbModifiedOn       DateTime? @db.Timestamptz(6)                         @map("lmb_modified_on")
  lmbModifiedBy       String?   @db.VarChar(50)                            @map("lmb_modified_by")

  // Relations
  company             Company        @relation("LoyaltyMemberCompany",     fields: [lmbCompId],        references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_lmb_company")
  branch              BranchMaster?  @relation("LoyaltyMemberBranch",      fields: [lmbBranchId],      references: [brId],   onUpdate: Cascade, onDelete: Restrict, map: "fk_lmb_branch")
  customer            Customer       @relation("LoyaltyMemberCustomer",    fields: [lmbCustId],        references: [cusId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_lmb_cust")
  partyLedger         AccLedgerMaster? @relation("LoyaltyMemberPartyLedger", fields: [lmbPartyLedgerId], references: [ledId], onUpdate: Cascade, onDelete: Restrict, map: "fk_lmb_party_ledger")
  scheme              LoyaltyScheme? @relation("LoyaltyMemberScheme",      fields: [lmbLscId],         references: [lscId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_lmb_scheme")
  mergedInto          LoyaltyMember? @relation("LoyaltyMemberMerge",       fields: [lmbMergedIntoId],  references: [lmbId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_lmb_merged_into")
  mergedFrom          LoyaltyMember[] @relation("LoyaltyMemberMerge")

  ledgerRows          LoyaltyLedger[]     @relation("LoyaltyLedgerMember")
  giftRedeems         LoyaltyGiftRedeem[] @relation("LoyaltyGiftRedeemMember")

  // Partial indexes are DB-only — Prisma ignores WHERE predicates and
  // expression keys, so declaring them here would produce phantom drift on
  // every migrate dev:
  //
  //   -- ONE wallet per customer per company: the chain-store guarantee
  //   CREATE UNIQUE INDEX ux_lmb_cust ON sales.loyalty_member
  //       (lmb_comp_id, lmb_cust_id) WHERE lmb_is_deleted = false;
  //
  //   CREATE UNIQUE INDEX ux_lmb_card_no ON sales.loyalty_member
  //       (lmb_comp_id, upper(lmb_card_no::text))
  //       WHERE lmb_card_no IS NOT NULL AND lmb_is_deleted = false;
  //
  //   -- the cashier types a phone number and the balance must be on screen
  //   -- before the next item is scanned; INCLUDE makes it index-only
  //   CREATE INDEX ix_lmb_mobile ON sales.loyalty_member (lmb_comp_id, lmb_mobile)
  //       INCLUDE (lmb_cust_id, lmb_balance_points, lmb_status)
  //       WHERE lmb_mobile IS NOT NULL AND lmb_is_deleted = false;
  //
  //   -- the liability report and the top-members list
  //   CREATE INDEX ix_lmb_balance ON sales.loyalty_member
  //       (lmb_comp_id, lmb_balance_points DESC)
  //       INCLUDE (lmb_cust_id, lmb_card_no, lmb_next_expiry_on, lmb_last_activity_on)
  //       WHERE lmb_is_deleted = false AND lmb_balance_points <> 0;
  //
  //   CREATE INDEX ix_lmb_expiry ON sales.loyalty_member (lmb_comp_id, lmb_next_expiry_on)
  //       WHERE lmb_is_deleted = false AND lmb_balance_points > 0
  //         AND lmb_next_expiry_on IS NOT NULL;
  //
  //   -- THE RECONCILIATION REPORT. There is deliberately no non-negativity
  //   -- CHECK on the buckets or the balance: under offline sync a reversal can
  //   -- land before the row it reverses and a CHECK would abort the batch. The
  //   -- over-draw guard is LoyaltyLedgerService's, at post; this index is how
  //   -- an over-draw that got past it is found the next morning rather than by
  //   -- a customer.
  //   CREATE INDEX ix_lmb_overdrawn ON sales.loyalty_member
  //       (lmb_comp_id, lmb_balance_points)
  //       WHERE lmb_is_deleted = false AND lmb_balance_points < 0;
  //
  //   -- FK-covering: ix_lmb_branch, ix_lmb_scheme, ix_lmb_party_ledger,
  //   -- ix_lmb_cust_fk, ix_lmb_merged_into
  //
  // CHECK constraints (DB-only): ck_lmb_acc_year, ck_lmb_status,
  //   ck_lmb_merged, ck_lmb_no_self_merge, ck_lmb_card_shape

  // ── Coupons and gift vouchers (20260921160000) ──────────────────────────
  // A coupon holder may also be a points member. The two are separate
  // instruments — a coupon is money with a code on it — but the same person.
  coupons               LoyaltyCoupon[]           @relation("CouponMember")
  couponTxns            LoyaltyCouponTxn[]        @relation("CouponTxnMember")

  @@map("loyalty_member")
  @@schema("sales")
}

// ----- prisma/sales/loyaltyScheme.prisma -----
/// sales.loyalty_scheme — §1, the loyalty campaign header.
///
/// The RULES: who earns, on what, how fast, and what a point is worth. It holds
/// no balances and no movements — those belong to the points ledger (13) and the
/// coupon/gift tables (14), neither of which is in this schema yet.
///
/// Supersedes sales.loyalty_sch_list / _party / _points / _gift, which
/// 20260831060000_replace_loyalty_scheme_tables drops.
///
/// Declared here WITHOUT its CHECK constraints expressed in Prisma — Prisma has
/// no concept of them. The migration DOES create them, and
/// utils/loyalty-scheme-invariants.ts mirrors every one so a rejected campaign
/// comes back as a field-addressed 400 rather than a Postgres error string the
/// screen cannot place on an input.
///
/// DB-only objects the migration hand-authors, none of them expressible here:
///   ux_lsc_code       UNIQUE (lsc_comp_id, lower(lsc_code)) WHERE NOT deleted
///   ux_lsc_primary    UNIQUE (comp, branch, type) NULLS NOT DISTINCT
///                     WHERE priority = 1 AND APPROVED AND active AND NOT deleted
///   ix_lsc_resolve    the per-bill resolver, covering, partial
///   ix_lsc_branch / ix_lsc_price_level / ix_lsc_redeem_tender /
///   ix_lsc_approved_by   FK-covering, all partial
model LoyaltyScheme {
  lscId                     String    @id(map: "pk_loyalty_scheme") @default(dbgenerated("uuidv7()")) @db.Uuid @map("lsc_id")
  lscCompId                 String    @db.Uuid                                       @map("lsc_comp_id")
  /// Single-shop shorthand. NULL = every branch.
  lscBranchId               String?   @db.Uuid                                       @map("lsc_branch_id")
  lscTenantId               String?   @db.Uuid                                       @map("lsc_tenant_id")

  lscCode                   String    @db.VarChar(30)                                @map("lsc_code")
  lscName                   String    @db.VarChar(150)                               @map("lsc_name")
  lscType                   String    @default("BOTH") @db.VarChar(20)               @map("lsc_type")
  lscStatus                 String    @default("DRAFT") @db.VarChar(20)              @map("lsc_status")
  /// Which scheme wins when several match one bill. 1 = primary.
  lscPriority               Int       @default(1) @db.SmallInt                       @map("lsc_priority")
  lscAutoApply              Boolean   @default(true)                                 @map("lsc_auto_apply")

  // ── What it earns on ────────────────────────────────────────────────────
  lscApplyOn                String    @default("BILL_AMOUNT") @db.VarChar(20)        @map("lsc_apply_on")
  lscCalcOnAmountType       String    @default("NET_AMOUNT") @db.VarChar(20)         @map("lsc_calc_on_amount_type")
  lscIncludeTax             Boolean   @default(false)                                @map("lsc_include_tax")
  lscBillType               String    @default("ALL") @db.VarChar(20)                @map("lsc_bill_type")
  lscMinBillAmount          Decimal   @default(0) @db.Decimal(18, 2)                 @map("lsc_min_bill_amount")
  /// Per bill. 0 = uncapped.
  lscMaxEarnPoints          Decimal   @default(0) @db.Decimal(18, 4)                 @map("lsc_max_earn_points")
  lscEarnOnDiscounted       Boolean   @default(true)                                 @map("lsc_earn_on_discounted")
  lscEarnOnCharges          Boolean   @default(false)                                @map("lsc_earn_on_charges")
  lscEarnWithRedeem         Boolean   @default(false)                                @map("lsc_earn_with_redeem")
  lscRoundingMethod         String    @default("FLOOR") @db.VarChar(10)              @map("lsc_rounding_method")
  lscPointsDecimals         Int       @default(2) @db.SmallInt                       @map("lsc_points_decimals")

  // ── Scope switches: 'ALL' = everything, 'LIST' = read the child table ────
  lscBranchScope            String    @default("ALL") @db.VarChar(10)                @map("lsc_branch_scope")
  lscCustScope              String    @default("ALL") @db.VarChar(10)                @map("lsc_cust_scope")
  lscItemScope              String    @default("ALL") @db.VarChar(10)                @map("lsc_item_scope")
  lscPriceLevelId           Int?                                                     @map("lsc_price_level_id")

  // ── Chain store ─────────────────────────────────────────────────────────
  /// COMPANY = one wallet, earned anywhere, spent anywhere (the default, and
  /// what a chain wants). BRANCH = a franchisee honours only what it issued.
  lscPoolMode               String    @default("COMPANY") @db.VarChar(10)            @map("lsc_pool_mode")
  lscAllowCrossBranchRedeem Boolean   @default(true)                                 @map("lsc_allow_cross_branch_redeem")

  // ── Redemption ──────────────────────────────────────────────────────────
  lscAllowPointRedeem       Boolean   @default(false)                                @map("lsc_allow_point_redeem")
  lscAllowGiftRedeem        Boolean   @default(false)                                @map("lsc_allow_gift_redeem")
  /// accounts.acc_tender_master(tnd_id) — the LOYALTY tender (type 10).
  lscRedeemTenderId         String?   @db.Uuid                                       @map("lsc_redeem_tender_id")
  /// Rupees per point. WINS over acc_tender_master.tnd_conversion_rate whenever
  /// a scheme matches; the tender master is the fallback for a company running
  /// no scheme, and acc_tender_detail.td_conversion_rate snapshots whichever was
  /// used. A write-path rule the schema cannot enforce.
  lscRedeemValuePerPoint    Decimal   @default(0) @db.Decimal(18, 4)                 @map("lsc_redeem_value_per_point")
  lscMinRedeemPoints        Decimal   @default(0) @db.Decimal(18, 4)                 @map("lsc_min_redeem_points")
  /// Per bill. 0 = uncapped.
  lscMaxRedeemPoints        Decimal   @default(0) @db.Decimal(18, 4)                 @map("lsc_max_redeem_points")
  /// Per bill: the % of it points may settle.
  lscMaxRedeemPerc          Decimal   @default(100) @db.Decimal(6, 3)                @map("lsc_max_redeem_perc")
  lscRedeemMinBillAmount    Decimal   @default(0) @db.Decimal(18, 2)                 @map("lsc_redeem_min_bill_amount")
  /// 0 = any quantity.
  lscRedeemMultiple         Decimal   @default(0) @db.Decimal(18, 4)                 @map("lsc_redeem_multiple")

  // ── Expiry and the return window ────────────────────────────────────────
  lscExpiryBasis            String    @default("EARN_DATE") @db.VarChar(20)          @map("lsc_expiry_basis")
  lscPointsValidDays        Int       @default(0)                                    @map("lsc_points_valid_days")
  /// THE CLAW-BACK DEFENCE. Points earn on bill save (offline included) but are
  /// not REDEEMABLE until this many days have passed — long enough for the
  /// return window to close. 0 = redeemable immediately.
  lscActivationDays         Int       @default(0) @db.SmallInt                       @map("lsc_activation_days")
  lscReturnMode             String    @default("REVERSE") @db.VarChar(10)            @map("lsc_return_mode")

  // ── When it runs ────────────────────────────────────────────────────────
  lscStartDate              DateTime  @db.Date                                       @map("lsc_start_date")
  lscEndDate                DateTime  @db.Date                                       @map("lsc_end_date")
  /// Both bounds or neither. from > to legitimately means "spans midnight" —
  /// 22:22 to 04:44 is a late-night promotion, not a typo.
  lscValidFromTime          DateTime? @db.Time(6)                                    @map("lsc_valid_from_time")
  lscValidToTime            DateTime? @db.Time(6)                                    @map("lsc_valid_to_time")
  /// 'MON,TUE,...'; NULL = every day.
  lscValidWeekdays          String?   @db.VarChar(30)                                @map("lsc_valid_weekdays")

  lscRemarks                String?   @db.Text                                       @map("lsc_remarks")
  lscIsActive               Boolean   @default(true)                                 @map("lsc_is_active")
  lscIsDeleted              Boolean   @default(false)                                @map("lsc_is_deleted")
  lscSyncDate               DateTime? @db.Timestamptz(6)                             @map("lsc_sync_date")
  lscCreatedOn              DateTime  @default(now()) @db.Timestamptz(6)             @map("lsc_created_on")
  lscCreatedBy              String?   @db.VarChar(50)                                @map("lsc_created_by")
  lscModifiedOn             DateTime? @db.Timestamptz(6)                             @map("lsc_modified_on")
  lscModifiedBy             String?   @db.VarChar(50)                                @map("lsc_modified_by")
  lscApprovedOn             DateTime? @db.Timestamptz(6)                             @map("lsc_approved_on")
  lscApprovedBy             String?   @db.Uuid                                       @map("lsc_approved_by")

  // ── Relations ───────────────────────────────────────────────────────────
  company                   Company         @relation("LoyaltySchemeCompany",    fields: [lscCompId],          references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_lsc_company")
  branch                    BranchMaster?   @relation("LoyaltySchemeBranchRef",  fields: [lscBranchId],        references: [brId],   onUpdate: Cascade, onDelete: Restrict, map: "fk_lsc_branch")
  priceLevel                ItemPriceLevel? @relation("LoyaltySchemePriceLevel", fields: [lscPriceLevelId],    references: [iplId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_lsc_price_level")
  redeemTender              AccTenderMaster? @relation("LoyaltySchemeRedeemTender", fields: [lscRedeemTenderId], references: [tndId], onUpdate: Cascade, onDelete: Restrict, map: "fk_lsc_redeem_tender")
  approvedBy                UserMaster?     @relation("LoyaltySchemeApprovedBy", fields: [lscApprovedBy],      references: [usrId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_lsc_approved_by")

  branches                  LoyaltySchemeBranch[] @relation("LoyaltySchemeBranches")
  parties                   LoyaltySchemeParty[]  @relation("LoyaltySchemeParties")
  items                     LoyaltySchemeItem[]   @relation("LoyaltySchemeItems")
  slabs                     LoyaltySchemeSlab[]   @relation("LoyaltySchemeSlabs")
  gifts                     LoyaltySchemeGift[]   @relation("LoyaltySchemeGifts")

  // ── Loyalty points engine (20260921140000) ─────────────────────────────
  loyaltyMembers        LoyaltyMember[]           @relation("LoyaltyMemberScheme")
  loyaltyLedgerRows     LoyaltyLedger[]           @relation("LoyaltyLedgerScheme")
  loyaltyGiftRedeems    LoyaltyGiftRedeem[]       @relation("LoyaltyGiftRedeemScheme")

  @@map("loyalty_scheme")
  @@schema("sales")
}

// ----- prisma/sales/loyaltySchemeBranch.prisma -----
/// sales.loyalty_scheme_branch — §2, which branches run the campaign.
///
/// Read only when lsc_branch_scope = 'LIST'. lsbIsExclude makes "every branch
/// except two" two rows rather than thirty-eight; an EXCLUDE row always beats an
/// INCLUDE row for the same branch.
///
/// DB-only objects the migration hand-authors:
///   ux_lsb_row     UNIQUE (lsb_lsc_id, lsb_branch_id) WHERE NOT deleted
///   ix_lsb_scheme  (lsb_lsc_id), partial
///   ix_lsb_branch  (lsb_branch_id), partial
model LoyaltySchemeBranch {
  lsbId          String    @id(map: "pk_loyalty_scheme_branch") @default(dbgenerated("uuidv7()")) @db.Uuid @map("lsb_id")
  lsbLscId       String    @db.Uuid                                       @map("lsb_lsc_id")
  lsbSlno        Int       @default(1)                                    @map("lsb_slno")
  lsbBranchId    String    @db.Uuid                                       @map("lsb_branch_id")
  lsbIsExclude   Boolean   @default(false)                                @map("lsb_is_exclude")
  lsbNotes       String?   @db.Text                                       @map("lsb_notes")
  lsbIsActive    Boolean   @default(true)                                 @map("lsb_is_active")
  lsbIsDeleted   Boolean   @default(false)                                @map("lsb_is_deleted")
  lsbSyncDate    DateTime? @db.Timestamptz(6)                             @map("lsb_sync_date")
  lsbCreatedOn   DateTime  @default(now()) @db.Timestamptz(6)             @map("lsb_created_on")
  lsbCreatedBy   String?   @db.VarChar(50)                                @map("lsb_created_by")
  lsbModifiedOn  DateTime? @db.Timestamptz(6)                             @map("lsb_modified_on")
  lsbModifiedBy  String?   @db.VarChar(50)                                @map("lsb_modified_by")

  scheme         LoyaltyScheme @relation("LoyaltySchemeBranches",     fields: [lsbLscId],    references: [lscId], onUpdate: Cascade, onDelete: Cascade,  map: "fk_lsb_scheme")
  branch         BranchMaster  @relation("LoyaltySchemeBranchBranch", fields: [lsbBranchId], references: [brId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_lsb_branch")

  @@map("loyalty_scheme_branch")
  @@schema("sales")
}

// ----- prisma/sales/loyaltySchemeGift.prisma -----
/// sales.loyalty_scheme_gift — §6, points buy an ITEM.
///
/// The CATALOGUE of what MAY be claimed. What was actually handed over belongs
/// in sales.loyalty_gift_issue (13), which is not in this schema yet.
///
/// A gift redemption is NOT a tender: no money crosses the counter, stock does.
/// lsgUnitId references inventory.item_unit_conversion(iuc_id) — the same target
/// sale_bill_item.fk_sbi_item_unit uses — because the gift becomes a bill line
/// and the two must agree without a conversion lookup.
///
/// DB-only objects to hand-author:
///   ux_lsg_item    UNIQUE (lsc_id, item_id, unit_id) WHERE NOT deleted
///   ix_lsg_scheme  (lsc_id, redeem_points) INCLUDE (...), partial
///   ix_lsg_item / ix_lsg_unit, both partial
model LoyaltySchemeGift {
  lsgId             String    @id(map: "pk_loyalty_scheme_gift") @default(dbgenerated("uuidv7()")) @db.Uuid @map("lsg_id")
  lsgLscId          String    @db.Uuid                                       @map("lsg_lsc_id")
  lsgSlno           Int       @default(1)                                    @map("lsg_slno")

  lsgItemId         String    @db.Uuid                                       @map("lsg_item_id")
  lsgUnitId         String    @db.Uuid                                       @map("lsg_unit_id")
  lsgItemQty        Decimal   @default(1) @db.Decimal(18, 3)                 @map("lsg_item_qty")
  lsgRedeemPoints   Decimal   @default(0) @db.Decimal(18, 4)                 @map("lsg_redeem_points")

  /// Claimable more than once.
  lsgRepeat         Boolean   @default(false)                                @map("lsg_repeat")
  /// 0 = uncapped.
  lsgMaxQtyPerBill  Decimal   @default(0) @db.Decimal(18, 3)                 @map("lsg_max_qty_per_bill")
  /// Block the claim when the item is not in stock at the issuing branch. A
  /// gift the shop cannot hand over is worse than one it never offered.
  lsgStockCheck     Boolean   @default(true)                                 @map("lsg_stock_check")
  lsgValidFrom      DateTime? @db.Date                                       @map("lsg_valid_from")
  lsgValidUpto      DateTime? @db.Date                                       @map("lsg_valid_upto")

  lsgNotes          String?   @db.Text                                       @map("lsg_notes")
  lsgIsActive       Boolean   @default(true)                                 @map("lsg_is_active")
  lsgIsDeleted      Boolean   @default(false)                                @map("lsg_is_deleted")
  lsgSyncDate       DateTime? @db.Timestamptz(6)                             @map("lsg_sync_date")
  lsgCreatedOn      DateTime  @default(now()) @db.Timestamptz(6)             @map("lsg_created_on")
  lsgCreatedBy      String?   @db.VarChar(50)                                @map("lsg_created_by")
  lsgModifiedOn     DateTime? @db.Timestamptz(6)                             @map("lsg_modified_on")
  lsgModifiedBy     String?   @db.VarChar(50)                                @map("lsg_modified_by")

  scheme            LoyaltyScheme      @relation("LoyaltySchemeGifts", fields: [lsgLscId],  references: [lscId],  onUpdate: Cascade, onDelete: Cascade,  map: "fk_lsg_scheme")
  item              ItemMaster         @relation("LoyaltyGiftItem",    fields: [lsgItemId], references: [itemId], onUpdate: Cascade, onDelete: Restrict, map: "fk_lsg_item")
  unit              ItemUnitConversion @relation("LoyaltyGiftUnit",    fields: [lsgUnitId], references: [iucId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_lsg_unit")

  // ── Loyalty points engine (20260921140000) ─────────────────────────────
  loyaltyGiftItems      LoyaltyGiftRedeemItem[]   @relation("LoyaltyGiftItemGift")

  @@map("loyalty_scheme_gift")
  @@schema("sales")
}

// ----- prisma/sales/loyaltySchemeItem.prisma -----
/// sales.loyalty_scheme_item — §4, which stock the campaign applies to.
///
/// One kind + one scope id, with five GENERATED ALWAYS ... STORED columns
/// carrying the foreign keys — the same shape as LoyaltySchemeParty, read that
/// model's header for the write rules and the migration caveat. In short: set
/// lsiKind + lsiScopeId and never touch itemId / groupId / categoryId / brandId
/// / sectionId.
///
///     lsiKind = 'ITEM' | 'ITEM_GROUP' | 'ITEM_CATEGORY' | 'ITEM_BRAND' | 'ITEM_SECTION'
///
/// The vocabulary is the live one: loyalty_sch_list.ls_item_type already used
/// exactly these five values, so the new screen and the old data agree.
///
/// This is what makes "double points on own-brand, but nothing on tobacco"
/// expressible in ONE scheme — the predecessor could hold only one kind of
/// grouping per scheme and could not exclude at all.
///
/// lsiFactor multiplies whatever the slab computed for the line (2.0 = double
/// points); a non-zero lsiPoints replaces the slab result outright instead of
/// scaling it.
///
/// lsiMatchPriority: most specific wins. Seed ITEM 4, ITEM_BRAND 3,
/// ITEM_CATEGORY 2, ITEM_SECTION 1, ITEM_GROUP 0 — data, not a hard-coded rule.
/// An EXCLUDE row earns nothing regardless of any broader rule.
///
/// Read only when lsc_item_scope = 'LIST'.
///
/// DB-only objects to hand-author:
///   ux_lsi_row     UNIQUE (lsc_id, kind, scope_id) WHERE NOT deleted
///   ix_lsi_scheme  (lsc_id, match_priority DESC) INCLUDE (...), partial
///   ix_lsi_item / _group / _category / _brand / _section, all partial
model LoyaltySchemeItem {
  lsiId            String    @id(map: "pk_loyalty_scheme_item") @default(dbgenerated("uuidv7()")) @db.Uuid @map("lsi_id")
  lsiLscId         String    @db.Uuid                                       @map("lsi_lsc_id")
  lsiSlno          Int       @default(1)                                    @map("lsi_slno")

  // The GRID COLUMNS.
  lsiKind          String    @db.VarChar(20)                                @map("lsi_kind")
  lsiScopeId       String    @db.Uuid                                       @map("lsi_scope_id")

  // GENERATED ALWAYS ... STORED. Read-only.
  lsiItemId        String?   @default(dbgenerated()) @db.Uuid               @map("lsi_item_id")
  lsiGroupId       String?   @default(dbgenerated()) @db.Uuid               @map("lsi_group_id")
  lsiCategoryId    String?   @default(dbgenerated()) @db.Uuid               @map("lsi_category_id")
  lsiBrandId       String?   @default(dbgenerated()) @db.Uuid               @map("lsi_brand_id")
  lsiSectionId     String?   @default(dbgenerated()) @db.Uuid               @map("lsi_section_id")

  lsiIsExclude     Boolean   @default(false)                                @map("lsi_is_exclude")
  /// Multiplies whatever the slab computed for the line. 2.0 = double points.
  lsiFactor        Decimal   @default(1) @db.Decimal(18, 4)                 @map("lsi_factor")
  /// Non-zero REPLACES the slab result outright instead of scaling it.
  lsiPoints        Decimal   @default(0) @db.Decimal(18, 4)                 @map("lsi_points")
  /// 0 = uncapped, per line.
  lsiMaxPoints     Decimal   @default(0) @db.Decimal(18, 4)                 @map("lsi_max_points")
  lsiMatchPriority Int       @default(1) @db.SmallInt                       @map("lsi_match_priority")
  lsiNotes         String?   @db.Text                                       @map("lsi_notes")
  lsiIsActive      Boolean   @default(true)                                 @map("lsi_is_active")
  lsiIsDeleted     Boolean   @default(false)                                @map("lsi_is_deleted")
  lsiSyncDate      DateTime? @db.Timestamptz(6)                             @map("lsi_sync_date")
  lsiCreatedOn     DateTime  @default(now()) @db.Timestamptz(6)             @map("lsi_created_on")
  lsiCreatedBy     String?   @db.VarChar(50)                                @map("lsi_created_by")
  lsiModifiedOn    DateTime? @db.Timestamptz(6)                             @map("lsi_modified_on")
  lsiModifiedBy    String?   @db.VarChar(50)                                @map("lsi_modified_by")

  scheme           LoyaltyScheme      @relation("LoyaltySchemeItems",  fields: [lsiLscId],      references: [lscId],      onUpdate: Cascade,  onDelete: Cascade,  map: "fk_lsi_scheme")
  item             ItemMaster?        @relation("LoyaltyItemItem",     fields: [lsiItemId],     references: [itemId],     onUpdate: NoAction, onDelete: Restrict, map: "fk_lsi_item")
  itemGroup        ItemGroupMaster?   @relation("LoyaltyItemGroup",    fields: [lsiGroupId],    references: [itgId],      onUpdate: NoAction, onDelete: Restrict, map: "fk_lsi_group")
  itemCategory     categoryMaster?    @relation("LoyaltyItemCategory", fields: [lsiCategoryId], references: [categoryId], onUpdate: NoAction, onDelete: Restrict, map: "fk_lsi_category")
  itemBrand        ItemBrandMaster?   @relation("LoyaltyItemBrand",    fields: [lsiBrandId],    references: [brand_id],   onUpdate: NoAction, onDelete: Restrict, map: "fk_lsi_brand")
  itemSection      ItemSectionMaster? @relation("LoyaltyItemSection",  fields: [lsiSectionId],  references: [secId],      onUpdate: NoAction, onDelete: Restrict, map: "fk_lsi_section")

  // ── Loyalty points engine (20260921140000) ─────────────────────────────
  loyaltyLedgerRows     LoyaltyLedger[]           @relation("LoyaltyLedgerItemRule")

  @@map("loyalty_scheme_item")
  @@schema("sales")
}

// ----- prisma/sales/loyaltySchemeParty.prisma -----
/// sales.loyalty_scheme_party — §3, who the campaign applies to.
///
/// ONE KIND + ONE SCOPE ID, the shape the entry grid needs. The screen binds to
/// exactly two columns, lspKind and lspScopeId; the two *_id fields below are
/// GENERATED ALWAYS ... STORED in Postgres and exist only to carry a real
/// foreign key per kind.
///
///     lspKind = 'CUSTOMER' | 'CUSTOMER_GROUP'
///
/// Loyalty deliberately has NO AREA or CITY, unlike promotion_scheme_party: a
/// wallet follows the person, not the route. Adding them would be one generated
/// column and one FK each.
///
/// lspMatchPriority makes "a rule naming one CUSTOMER beats one naming their
/// GROUP" data rather than an assumption: CUSTOMER 2, CUSTOMER_GROUP 1. An
/// EXCLUDE row beats an INCLUDE row at equal priority.
///
/// Read only when lsc_cust_scope = 'LIST'.
///
/// ── WRITING THIS MODEL ──────────────────────────────────────────────────
/// NEVER set custId / custGroupId, and never use their nested `connect`s.
/// Postgres computes those columns and rejects any write. Set lspKind +
/// lspScopeId; read the relations back.
///
/// ── MIGRATION ───────────────────────────────────────────────────────────
/// prisma migrate cannot emit a generated column; both are hand-authored, e.g.
///   lsp_cust_id uuid GENERATED ALWAYS AS
///     (CASE WHEN lsp_kind::text = 'CUSTOMER' THEN lsp_scope_id END) STORED
/// The `@default(dbgenerated())` below is the no-argument form: it stops every
/// later `migrate dev` emitting an ALTER COLUMN ... DROP DEFAULT that Postgres
/// rejects with 42601 on a generated column.
///
/// The FKs are ON UPDATE NO ACTION, not CASCADE — Postgres forbids a cascading
/// update on a key containing a generated column. Costs nothing: every master
/// key here is a uuidv7() that is never reissued.
///
/// DB-only objects to hand-author:
///   ux_lsp_row       UNIQUE (lsc_id, kind, scope_id) WHERE NOT deleted
///   ix_lsp_scheme    (lsc_id, match_priority DESC) INCLUDE (...), partial
///   ix_lsp_cust / ix_lsp_cust_group, both partial
model LoyaltySchemeParty {
  lspId            String    @id(map: "pk_loyalty_scheme_party") @default(dbgenerated("uuidv7()")) @db.Uuid @map("lsp_id")
  lspLscId         String    @db.Uuid                                       @map("lsp_lsc_id")
  lspSlno          Int       @default(1)                                    @map("lsp_slno")

  // The GRID COLUMNS — the only two the form reads and writes.
  lspKind          String    @db.VarChar(20)                                @map("lsp_kind")
  lspScopeId       String    @db.Uuid                                       @map("lsp_scope_id")

  // GENERATED ALWAYS ... STORED. Read-only. See the note above.
  lspCustId        String?   @default(dbgenerated()) @db.Uuid               @map("lsp_cust_id")
  lspCustGroupId   String?   @default(dbgenerated()) @db.Uuid               @map("lsp_cust_group_id")

  lspIsExclude     Boolean   @default(false)                                @map("lsp_is_exclude")
  lspMatchPriority Int       @default(1) @db.SmallInt                       @map("lsp_match_priority")
  lspNotes         String?   @db.Text                                       @map("lsp_notes")
  lspIsActive      Boolean   @default(true)                                 @map("lsp_is_active")
  lspIsDeleted     Boolean   @default(false)                                @map("lsp_is_deleted")
  lspSyncDate      DateTime? @db.Timestamptz(6)                             @map("lsp_sync_date")
  lspCreatedOn     DateTime  @default(now()) @db.Timestamptz(6)             @map("lsp_created_on")
  lspCreatedBy     String?   @db.VarChar(50)                                @map("lsp_created_by")
  lspModifiedOn    DateTime? @db.Timestamptz(6)                             @map("lsp_modified_on")
  lspModifiedBy    String?   @db.VarChar(50)                                @map("lsp_modified_by")

  scheme           LoyaltyScheme @relation("LoyaltySchemeParties",  fields: [lspLscId],       references: [lscId], onUpdate: Cascade,  onDelete: Cascade,  map: "fk_lsp_scheme")
  customer         Customer?     @relation("LoyaltyPartyCustomer",  fields: [lspCustId],      references: [cusId], onUpdate: NoAction, onDelete: Restrict, map: "fk_lsp_cust")
  customerGroup    CustGroup?    @relation("LoyaltyPartyCustGroup", fields: [lspCustGroupId], references: [cgrId], onUpdate: NoAction, onDelete: Restrict, map: "fk_lsp_cust_group")

  @@map("loyalty_scheme_party")
  @@schema("sales")
}

// ----- prisma/sales/loyaltySchemeSlab.prisma -----
/// sales.loyalty_scheme_slab — §5, the earn rates.
///
/// One row = one rate band. Read as: for every lssEach units ABOVE lssExceeds,
/// award lssPoints, scaled by lssFactor.
///
/// "units" are RUPEES when lsc_apply_on is BILL_AMOUNT / ITEM_AMOUNT, and
/// QUANTITY when it is BILL_QTY / ITEM_QTY — one column pair serving both.
///
/// Bill-value slabs are ROWS, not columns: 0-999 -> 1pt/100, 1000-4999 ->
/// 2pt/100, 5000+ -> 3pt/100 is three rows.
///
/// lssItemId narrows a band to ONE item; leave it NULL for a whole-bill band.
/// Anything broader than one item (group, brand, category) belongs in
/// LoyaltySchemeItem, which multiplies what this computes.
///
/// lssUnitId references inventory.item_unit_conversion(iuc_id) — the same target
/// sale_bill_item.fk_sbi_item_unit uses, NOT item_unit_master(unit_id).
///
/// DB-only objects to hand-author:
///   ux_lss_band    UNIQUE (lsc_id, COALESCE(item_id, nil uuid), exceeds)
///                  WHERE NOT deleted
///   ix_lss_scheme  (lsc_id, exceeds) INCLUDE (...), partial
///   ix_lss_item / ix_lss_unit, both partial
model LoyaltySchemeSlab {
  lssId          String    @id(map: "pk_loyalty_scheme_slab") @default(dbgenerated("uuidv7()")) @db.Uuid @map("lss_id")
  lssLscId       String    @db.Uuid                                       @map("lss_lsc_id")
  lssSlno        Int       @default(1)                                    @map("lss_slno")

  /// NULL = applies to the whole bill.
  lssItemId      String?   @db.Uuid                                       @map("lss_item_id")
  /// item_unit_conversion, as on a bill line.
  lssUnitId      String?   @db.Uuid                                       @map("lss_unit_id")

  /// Band lower bound.
  lssExceeds     Decimal   @default(0) @db.Decimal(18, 3)                 @map("lss_exceeds")
  /// Band ceiling. NULL = open-ended.
  lssUpto        Decimal?  @db.Decimal(18, 3)                             @map("lss_upto")
  /// Granularity.
  lssEach        Decimal   @default(1) @db.Decimal(18, 3)                 @map("lss_each")
  /// Awarded per lssEach.
  lssPoints      Decimal   @default(0) @db.Decimal(18, 4)                 @map("lss_points")
  lssFactor      Decimal   @default(1) @db.Decimal(18, 4)                 @map("lss_factor")
  /// 0 = uncapped.
  lssMaxPoints   Decimal   @default(0) @db.Decimal(18, 4)                 @map("lss_max_points")

  lssNotes       String?   @db.Text                                       @map("lss_notes")
  lssIsActive    Boolean   @default(true)                                 @map("lss_is_active")
  lssIsDeleted   Boolean   @default(false)                                @map("lss_is_deleted")
  lssSyncDate    DateTime? @db.Timestamptz(6)                             @map("lss_sync_date")
  lssCreatedOn   DateTime  @default(now()) @db.Timestamptz(6)             @map("lss_created_on")
  lssCreatedBy   String?   @db.VarChar(50)                                @map("lss_created_by")
  lssModifiedOn  DateTime? @db.Timestamptz(6)                             @map("lss_modified_on")
  lssModifiedBy  String?   @db.VarChar(50)                                @map("lss_modified_by")

  scheme         LoyaltyScheme       @relation("LoyaltySchemeSlabs", fields: [lssLscId],  references: [lscId],  onUpdate: Cascade, onDelete: Cascade,  map: "fk_lss_scheme")
  item           ItemMaster?         @relation("LoyaltySlabItem",    fields: [lssItemId], references: [itemId], onUpdate: Cascade, onDelete: Restrict, map: "fk_lss_item")
  unit           ItemUnitConversion? @relation("LoyaltySlabUnit",    fields: [lssUnitId], references: [iucId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_lss_unit")

  // ── Loyalty points engine (20260921140000) ─────────────────────────────
  // The earn slab that fired, recorded on the ledger row so "why did I get
  // 37 points" survives a later edit to the scheme.
  loyaltyLedgerRows     LoyaltyLedger[]           @relation("LoyaltyLedgerSlab")

  @@map("loyalty_scheme_slab")
  @@schema("sales")
}

// ----- prisma/sales/promotionScheme.prisma -----
/// sales.promotion_scheme — §1, the campaign header.
///
/// Declared here WITHOUT any CHECK constraint: the vocabulary rules
/// (ck_prm_status, ck_prm_apply_on, ck_prm_benefit, ck_prm_stack_mode,
/// ck_prm_calc_on, ck_prm_bill_type, the three *_scope checks,
/// ck_prm_fixed_price_scope, ck_prm_dates, ck_prm_time_pair, ck_prm_weekdays,
/// ck_prm_priority, ck_prm_thresholds, ck_prm_caps, ck_prm_approved) are
/// enforced in PromotionSchemeService, not in the migration — same treatment
/// item_unit_conversion already gets.
///
/// DB-only objects Prisma cannot express, to be hand-authored in the migration:
///   ux_prm_code      UNIQUE (prm_comp_id, lower(prm_code)) WHERE NOT deleted
///   ix_prm_resolve   the per-bill resolver, covering, partial on
///                    (deleted = false AND active AND status = 'APPROVED')
///   ix_prm_company / ix_prm_branch / ix_prm_price_level /
///   ix_prm_coupon_batch / ix_prm_approved_by   FK-covering, all partial
///   ex_prm_exclusive_clash   EXCLUDE USING gist — two APPROVED, EXCLUSIVE
///                            campaigns on the same company/branch/trigger at
///                            the same priority may not overlap in date.
///                            Needs btree_gist.
model PromotionScheme {
  prmId                   String    @id(map: "pk_promotion_scheme") @default(dbgenerated("uuidv7()")) @db.Uuid @map("prm_id")
  prmCompId               String    @db.Uuid                                        @map("prm_comp_id")
  prmBranchId             String?   @db.Uuid                                        @map("prm_branch_id")
  prmTenantId             String?   @db.Uuid                                        @map("prm_tenant_id")

  prmCode                 String    @db.VarChar(30)                                 @map("prm_code")
  prmName                 String    @db.VarChar(150)                                @map("prm_name")
  prmStatus               String    @default("DRAFT") @db.VarChar(20)               @map("prm_status")

  // ── What it is ──────────────────────────────────────────────────────────
  prmApplyOn              String    @default("ITEM_QTY") @db.VarChar(20)            @map("prm_apply_on")
  prmBenefit              String    @default("DISC_PERC") @db.VarChar(20)           @map("prm_benefit")

  // ── Which one wins ──────────────────────────────────────────────────────
  prmPriority             Int       @default(1) @db.SmallInt                        @map("prm_priority")
  prmStackMode            String    @default("EXCLUSIVE") @db.VarChar(10)           @map("prm_stack_mode")
  prmAutoApply            Boolean   @default(true)                                  @map("prm_auto_apply")
  prmAllowWithManualDisc  Boolean   @default(false)                                 @map("prm_allow_with_manual_disc")

  // ── What it is measured on ──────────────────────────────────────────────
  prmCalcOnAmountType     String    @default("NET_AMOUNT") @db.VarChar(20)          @map("prm_calc_on_amount_type")
  prmIncludeTax           Boolean   @default(false)                                 @map("prm_include_tax")
  prmBillType             String    @default("ALL") @db.VarChar(20)                 @map("prm_bill_type")
  prmMinBillAmount        Decimal   @default(0) @db.Decimal(18, 2)                  @map("prm_min_bill_amount")
  prmMinQty               Decimal   @default(0) @db.Decimal(18, 3)                  @map("prm_min_qty")

  // ── Scope switches: 'ALL' = everything, 'LIST' = read the child table ────
  prmBranchScope          String    @default("ALL") @db.VarChar(10)                 @map("prm_branch_scope")
  prmCustScope            String    @default("ALL") @db.VarChar(10)                 @map("prm_cust_scope")
  prmItemScope            String    @default("ALL") @db.VarChar(10)                 @map("prm_item_scope")
  prmPriceLevelId         Int?                                                      @map("prm_price_level_id")

  // ── Caps, counted by the usage tally ────────────────────────────────────
  prmMaxBenefitPerBill    Decimal   @default(0) @db.Decimal(18, 2)                  @map("prm_max_benefit_per_bill")
  prmMaxUsesTotal         Int       @default(0)                                     @map("prm_max_uses_total")
  prmMaxUsesPerCust       Int       @default(0)                                     @map("prm_max_uses_per_cust")
  prmBudgetAmount         Decimal   @default(0) @db.Decimal(18, 2)                  @map("prm_budget_amount")

  // Points at sales.loyalty_coupon_batch(lcb_id). NO Prisma relation and no FK
  // yet: that table is not in this schema. Add fk_prm_coupon_batch and the
  // relation field when the coupon-batch model lands.
  prmCouponBatchId        String?   @db.Uuid                                        @map("prm_coupon_batch_id")

  // ── When it runs ────────────────────────────────────────────────────────
  prmStartDate            DateTime  @db.Date                                        @map("prm_start_date")
  prmEndDate              DateTime  @db.Date                                        @map("prm_end_date")
  prmValidFromTime        DateTime? @db.Time(6)                                     @map("prm_valid_from_time")
  prmValidToTime          DateTime? @db.Time(6)                                     @map("prm_valid_to_time")
  prmValidWeekdays        String?   @db.VarChar(30)                                 @map("prm_valid_weekdays")

  prmRemarks              String?   @db.Text                                        @map("prm_remarks")
  prmIsActive             Boolean   @default(true)                                  @map("prm_is_active")
  prmIsDeleted            Boolean   @default(false)                                 @map("prm_is_deleted")
  prmSyncDate             DateTime? @db.Timestamptz(6)                              @map("prm_sync_date")
  prmCreatedOn            DateTime  @default(now()) @db.Timestamptz(6)              @map("prm_created_on")
  prmCreatedBy            String?   @db.VarChar(50)                                 @map("prm_created_by")
  prmModifiedOn           DateTime? @db.Timestamptz(6)                              @map("prm_modified_on")
  prmModifiedBy           String?   @db.VarChar(50)                                 @map("prm_modified_by")
  prmApprovedOn           DateTime? @db.Timestamptz(6)                              @map("prm_approved_on")
  prmApprovedBy           String?   @db.Uuid                                        @map("prm_approved_by")

  // ── Relations ───────────────────────────────────────────────────────────
  company                 Company        @relation("PromotionSchemeCompany",    fields: [prmCompId],       references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_prm_company")
  branch                  BranchMaster?  @relation("PromotionSchemeBranchRef",  fields: [prmBranchId],     references: [brId],   onUpdate: Cascade, onDelete: Restrict, map: "fk_prm_branch")
  priceLevel              ItemPriceLevel? @relation("PromotionSchemePriceLevel", fields: [prmPriceLevelId], references: [iplId], onUpdate: Cascade, onDelete: Restrict, map: "fk_prm_price_level")
  approvedBy              UserMaster?    @relation("PromotionSchemeApprovedBy", fields: [prmApprovedBy],   references: [usrId], onUpdate: Cascade, onDelete: Restrict, map: "fk_prm_approved_by")

  branches                PromotionSchemeBranch[] @relation("PromotionSchemeBranches")
  parties                 PromotionSchemeParty[]  @relation("PromotionSchemeParties")
  items                   PromotionSchemeItem[]   @relation("PromotionSchemeItems")
  slabs                   PromotionSchemeSlab[]   @relation("PromotionSchemeSlabs")

  // Not a rule anybody needs in its own right — prmId is already unique — but
  // the target of the slab's composite FK, and therefore the only way to make
  // the database refuse a free-item band on a percentage scheme.
  @@unique([prmId, prmBenefit], map: "uq_prm_benefit")
  // ── Promotion usage (20260921180000) ────────────────────────────────────
  // What this campaign actually gave away. RESTRICT on delete: a campaign
  // that has already given something away must be closed, not deleted.
  usages                PromotionUsage[]          @relation("PromotionUsageScheme")

  @@map("promotion_scheme")
  @@schema("sales")
}

// ----- prisma/sales/promotionSchemeBranch.prisma -----
/// sales.promotion_scheme_branch — §2, which branches run the campaign.
///
/// Read only when prm_branch_scope = 'LIST'. prbIsExclude makes "every branch
/// except two" two rows rather than thirty-eight; an EXCLUDE row always beats
/// an INCLUDE row for the same branch.
///
/// CHECK ck_prb_slno (prb_slno > 0) is enforced in the service, not the DB.
///
/// DB-only objects to hand-author in the migration:
///   ux_prb_row     UNIQUE (prb_prm_id, prb_branch_id) WHERE NOT deleted
///   ix_prb_scheme  (prb_prm_id) INCLUDE (branch, is_exclude), partial
///   ix_prb_branch  (prb_branch_id), partial
model PromotionSchemeBranch {
  prbId          String    @id(map: "pk_promotion_scheme_branch") @default(dbgenerated("uuidv7()")) @db.Uuid @map("prb_id")
  prbPrmId       String    @db.Uuid                                       @map("prb_prm_id")
  prbSlno        Int       @default(1)                                    @map("prb_slno")
  prbBranchId    String    @db.Uuid                                       @map("prb_branch_id")
  prbIsExclude   Boolean   @default(false)                                @map("prb_is_exclude")
  prbNotes       String?   @db.Text                                       @map("prb_notes")
  prbIsActive    Boolean   @default(true)                                 @map("prb_is_active")
  prbIsDeleted   Boolean   @default(false)                                @map("prb_is_deleted")
  prbSyncDate    DateTime? @db.Timestamptz(6)                             @map("prb_sync_date")
  prbCreatedOn   DateTime  @default(now()) @db.Timestamptz(6)             @map("prb_created_on")
  prbCreatedBy   String?   @db.VarChar(50)                                @map("prb_created_by")
  prbModifiedOn  DateTime? @db.Timestamptz(6)                             @map("prb_modified_on")
  prbModifiedBy  String?   @db.VarChar(50)                                @map("prb_modified_by")

  scheme         PromotionScheme @relation("PromotionSchemeBranches",     fields: [prbPrmId],    references: [prmId], onUpdate: Cascade, onDelete: Cascade,  map: "fk_prb_scheme")
  branch         BranchMaster    @relation("PromotionSchemeBranchBranch", fields: [prbBranchId], references: [brId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_prb_branch")

  @@map("promotion_scheme_branch")
  @@schema("sales")
}

// ----- prisma/sales/promotionSchemeItem.prisma -----
/// sales.promotion_scheme_item — §4, which stock the campaign applies to.
///
/// One kind + one scope id, with five GENERATED ALWAYS ... STORED columns
/// carrying the foreign keys — the same shape as PromotionSchemeParty, read
/// that model's header for the write rules and the migration caveat. In short:
/// set priKind + priScopeId (+ priUnitId on an ITEM row) and never touch
/// itemId / groupId / categoryId / brandId / sectionId.
///
/// This is what makes "20% off own-brand, but nothing on tobacco" ONE scheme.
///
/// priMatchPriority: most specific wins. Seed ITEM 4, BRAND 3, CATEGORY 2,
/// SECTION 1, GROUP 0 — data, not a hard-coded rule. An EXCLUDE row kills the
/// line regardless of any broader rule.
///
/// Read only when prm_item_scope = 'LIST'.
///
/// ── The discount trio ───────────────────────────────────────────────────
/// A rate may be stated here, on the item row, instead of on a slab band —
/// that is all "Discount On Items (Offer Per Item)" ever was. Stored in the
/// bill's own idiom because they are copied straight onto
/// sbi_sch_disc_perc / _qty / _amt:
///     priDiscPerc  percentage off the line
///     priDiscQty   rupees off PER UNIT
///     priDiscAmt   flat rupees off the line
/// At most one is non-zero. All three zero = this row only says "in scope".
///
/// A unit is REQUIRED on an ITEM row and FORBIDDEN on every other kind:
/// "10 of item X" is not a quantity until you say ten of WHAT, and a unit is a
/// row of item_unit_conversion keyed to one item, so on a BRAND or CATEGORY
/// row it would claim to apply to items that never define it.
///
/// CHECK ck_pri_kind, ck_pri_unit, ck_pri_one_rate, ck_pri_exclude,
/// ck_pri_values, ck_pri_slno and ck_pri_match_priority are enforced in the
/// service, not the DB.
///
/// DB-only objects to hand-author:
///   ux_pri_row     UNIQUE (prm_id, kind, scope_id) WHERE NOT deleted
///   ix_pri_scheme  (prm_id, match_priority DESC) INCLUDE (...), partial
///   ix_pri_item / _group / _category / _brand / _section / _unit, all partial
model PromotionSchemeItem {
  priId            String    @id(map: "pk_promotion_scheme_item") @default(dbgenerated("uuidv7()")) @db.Uuid @map("pri_id")
  priPrmId         String    @db.Uuid                                       @map("pri_prm_id")
  priSlno          Int       @default(1)                                    @map("pri_slno")

  // The GRID COLUMNS.
  priKind          String    @db.VarChar(20)                                @map("pri_kind")
  priScopeId       String    @db.Uuid                                       @map("pri_scope_id")

  // GENERATED ALWAYS ... STORED. Read-only.
  priItemId        String?   @default(dbgenerated()) @db.Uuid               @map("pri_item_id")
  priGroupId       String?   @default(dbgenerated()) @db.Uuid               @map("pri_group_id")
  priCategoryId    String?   @default(dbgenerated()) @db.Uuid               @map("pri_category_id")
  priBrandId       String?   @default(dbgenerated()) @db.Uuid               @map("pri_brand_id")
  priSectionId     String?   @default(dbgenerated()) @db.Uuid               @map("pri_section_id")

  // Written normally. NOT NULL when priKind = 'ITEM', NULL for every other kind.
  priUnitId        String?   @db.Uuid                                       @map("pri_unit_id")

  priIsExclude     Boolean   @default(false)                                @map("pri_is_exclude")

  priDiscPerc      Decimal   @default(0) @db.Decimal(18, 4)                 @map("pri_disc_perc")
  priDiscQty       Decimal   @default(0) @db.Decimal(18, 4)                 @map("pri_disc_qty")
  priDiscAmt       Decimal   @default(0) @db.Decimal(18, 2)                 @map("pri_disc_amt")

  priMinQty        Decimal   @default(0) @db.Decimal(18, 3)                 @map("pri_min_qty")
  priFactor        Decimal   @default(1) @db.Decimal(18, 4)                 @map("pri_factor")
  priMaxBenefit    Decimal   @default(0) @db.Decimal(18, 2)                 @map("pri_max_benefit")
  priMatchPriority Int       @default(1) @db.SmallInt                       @map("pri_match_priority")
  priNotes         String?   @db.Text                                       @map("pri_notes")
  priIsActive      Boolean   @default(true)                                 @map("pri_is_active")
  priIsDeleted     Boolean   @default(false)                                @map("pri_is_deleted")
  priSyncDate      DateTime? @db.Timestamptz(6)                             @map("pri_sync_date")
  priCreatedOn     DateTime  @default(now()) @db.Timestamptz(6)             @map("pri_created_on")
  priCreatedBy     String?   @db.VarChar(50)                                @map("pri_created_by")
  priModifiedOn    DateTime? @db.Timestamptz(6)                             @map("pri_modified_on")
  priModifiedBy    String?   @db.VarChar(50)                                @map("pri_modified_by")

  scheme           PromotionScheme     @relation("PromotionSchemeItems",     fields: [priPrmId],      references: [prmId],      onUpdate: Cascade,  onDelete: Cascade,  map: "fk_pri_scheme")
  item             ItemMaster?         @relation("PromotionItemItem",        fields: [priItemId],     references: [itemId],     onUpdate: NoAction, onDelete: Restrict, map: "fk_pri_item")
  itemGroup        ItemGroupMaster?    @relation("PromotionItemGroup",       fields: [priGroupId],    references: [itgId],      onUpdate: NoAction, onDelete: Restrict, map: "fk_pri_group")
  itemCategory     categoryMaster?     @relation("PromotionItemCategory",    fields: [priCategoryId], references: [categoryId], onUpdate: NoAction, onDelete: Restrict, map: "fk_pri_category")
  itemBrand        ItemBrandMaster?    @relation("PromotionItemBrand",       fields: [priBrandId],    references: [brand_id],   onUpdate: NoAction, onDelete: Restrict, map: "fk_pri_brand")
  itemSection      ItemSectionMaster?  @relation("PromotionItemSection",     fields: [priSectionId],  references: [secId],      onUpdate: NoAction, onDelete: Restrict, map: "fk_pri_section")
  unit             ItemUnitConversion? @relation("PromotionItemUnit",        fields: [priUnitId],     references: [iucId],      onUpdate: Cascade,  onDelete: Restrict, map: "fk_pri_unit")

  @@map("promotion_scheme_item")
  @@schema("sales")
}

// ----- prisma/sales/promotionSchemeParty.prisma -----
/// sales.promotion_scheme_party — §3, who the campaign applies to.
///
/// ONE KIND + ONE SCOPE ID, the shape the entry grid needs. The screen binds
/// to exactly two columns, prpKind and prpScopeId; the four *_id fields below
/// are GENERATED ALWAYS ... STORED in Postgres and exist only to carry a real
/// foreign key per kind.
///
///     prpKind = 'CUSTOMER' | 'CUSTOMER_GROUP' | 'AREA' | 'CITY'
///
/// CITY reaches a customer THROUGH THEIR AREA and only that way
/// (customers.cus_area_id -> area_master.arm_city_id -> city_master.ctm_id);
/// customers.cus_city is free text and must never be matched on. A customer
/// with no area is in no city.
///
/// prpMatchPriority makes "a rule naming one CUSTOMER beats one naming their
/// CITY" data rather than an assumption: CUSTOMER 4, AREA 3, CITY 2,
/// CUSTOMER_GROUP 1 — narrowest first. EXCLUDE beats INCLUDE at equal priority.
///
/// Read only when prm_cust_scope = 'LIST'.
///
/// ── WRITING THIS MODEL ──────────────────────────────────────────────────
/// NEVER set custId / custGroupId / areaId / cityId, and never use the four
/// nested `connect`s. Postgres computes those columns and rejects any write.
/// Set prpKind + prpScopeId; read the relations back.
///
/// ── MIGRATION ───────────────────────────────────────────────────────────
/// prisma migrate cannot emit a generated column. The four must be
/// hand-authored, e.g.
///   prp_cust_id uuid GENERATED ALWAYS AS
///     (CASE WHEN prp_kind::text = 'CUSTOMER' THEN prp_scope_id END) STORED
/// The `@default(dbgenerated())` below is the no-argument form: it stops every
/// later `migrate dev` emitting an ALTER COLUMN ... DROP DEFAULT that Postgres
/// rejects with 42601 on a generated column.
///
/// The FKs are ON UPDATE NO ACTION, not CASCADE — Postgres forbids a cascading
/// update on a key containing a generated column. Costs nothing: every master
/// key here is a uuidv7() that is never reissued.
///
/// CHECK ck_prp_kind, ck_prp_slno and ck_prp_match_priority are enforced in the
/// service, not the DB.
///
/// DB-only objects to hand-author:
///   ux_prp_row       UNIQUE (prm_id, kind, scope_id) WHERE NOT deleted
///   ix_prp_scheme    (prm_id, match_priority DESC) INCLUDE (...), partial
///   ix_prp_cust / ix_prp_cust_group / ix_prp_area / ix_prp_city, all partial
model PromotionSchemeParty {
  prpId            String    @id(map: "pk_promotion_scheme_party") @default(dbgenerated("uuidv7()")) @db.Uuid @map("prp_id")
  prpPrmId         String    @db.Uuid                                       @map("prp_prm_id")
  prpSlno          Int       @default(1)                                    @map("prp_slno")

  // The GRID COLUMNS — the only two the form reads and writes.
  prpKind          String    @db.VarChar(20)                                @map("prp_kind")
  prpScopeId       String    @db.Uuid                                       @map("prp_scope_id")

  // GENERATED ALWAYS ... STORED. Read-only. See the note above.
  prpCustId        String?   @default(dbgenerated()) @db.Uuid               @map("prp_cust_id")
  prpCustGroupId   String?   @default(dbgenerated()) @db.Uuid               @map("prp_cust_group_id")
  prpAreaId        String?   @default(dbgenerated()) @db.Uuid               @map("prp_area_id")
  prpCityId        String?   @default(dbgenerated()) @db.Uuid               @map("prp_city_id")

  prpIsExclude     Boolean   @default(false)                                @map("prp_is_exclude")
  prpMatchPriority Int       @default(1) @db.SmallInt                       @map("prp_match_priority")
  prpNotes         String?   @db.Text                                       @map("prp_notes")
  prpIsActive      Boolean   @default(true)                                 @map("prp_is_active")
  prpIsDeleted     Boolean   @default(false)                                @map("prp_is_deleted")
  prpSyncDate      DateTime? @db.Timestamptz(6)                             @map("prp_sync_date")
  prpCreatedOn     DateTime  @default(now()) @db.Timestamptz(6)             @map("prp_created_on")
  prpCreatedBy     String?   @db.VarChar(50)                                @map("prp_created_by")
  prpModifiedOn    DateTime? @db.Timestamptz(6)                             @map("prp_modified_on")
  prpModifiedBy    String?   @db.VarChar(50)                                @map("prp_modified_by")

  scheme           PromotionScheme @relation("PromotionSchemeParties",   fields: [prpPrmId],       references: [prmId],      onUpdate: Cascade,  onDelete: Cascade,  map: "fk_prp_scheme")
  customer         Customer?       @relation("PromotionPartyCustomer",   fields: [prpCustId],      references: [cusId],      onUpdate: NoAction, onDelete: Restrict, map: "fk_prp_cust")
  customerGroup    CustGroup?      @relation("PromotionPartyCustGroup",  fields: [prpCustGroupId], references: [cgrId],      onUpdate: NoAction, onDelete: Restrict, map: "fk_prp_cust_group")
  area             AreaMaster?     @relation("PromotionPartyArea",       fields: [prpAreaId],      references: [armId],      onUpdate: NoAction, onDelete: Restrict, map: "fk_prp_area")
  city             CityMaster?     @relation("PromotionPartyCity",       fields: [prpCityId],      references: [ctmId],      onUpdate: NoAction, onDelete: Restrict, map: "fk_prp_city")

  @@map("promotion_scheme_party")
  @@schema("sales")
}

// ----- prisma/sales/promotionSchemeSlab.prisma -----
/// sales.promotion_scheme_slab — §5, the offer bands.
///
/// One row = one band. Read as: when the measured value is between prsExceeds
/// and prsUpto, give the benefit; and if prsIsRepeat, give it once per prsEach
/// above prsExceeds instead of once in total.
///
/// "the measured value" is RUPEES when prm_apply_on is BILL_AMOUNT or
/// ITEM_AMOUNT, and QUANTITY when it is BILL_QTY or ITEM_QTY — one column pair
/// serving both, exactly as the loyalty slabs do.
///
/// Bands are ROWS, not columns: 0-999 -> 2%, 1000-4999 -> 5%, 5000+ -> 8% is
/// three rows.
///
/// ── The benefit is ENFORCED, not merely documented ──────────────────────
/// prsBenefit is a copy of the header's prmBenefit tied to it by a COMPOSITE
/// foreign key (prs_prm_id, prs_benefit) -> (prm_id, prm_benefit), which is
/// why PromotionScheme carries the otherwise-redundant
/// @@unique([prmId, prmBenefit]). A percentage-discount scheme therefore
/// CANNOT physically hold a free-item band. This composite FK also carries the
/// ON DELETE CASCADE, so no second plain FK on prsPrmId is declared.
///
/// The other half of that pair — ck_prs_benefit_columns, "the benefit column
/// is filled and the others are empty" — is a CHECK, so it lives in the
/// service instead of the migration, along with ck_prs_band, ck_prs_each,
/// ck_prs_amounts, ck_prs_free_unit_pair and ck_prs_slno. The FK still stops
/// the header and its bands disagreeing; the service is what stops a
/// DISC_PERC band being saved with a fixed price in it.
///
/// DB-only objects to hand-author:
///   ux_prs_band      UNIQUE (prm_id, exceeds, COALESCE(free_item_id, nil uuid))
///                    WHERE NOT deleted — so "spend 5000, get a mug AND a pen"
///                    is two rows at one threshold, while two rows claiming the
///                    same band with nothing to separate them stays impossible
///   ix_prs_scheme    (prm_id, benefit, exceeds) INCLUDE (...), partial
///   ix_prs_free_item / ix_prs_free_unit, partial
model PromotionSchemeSlab {
  prsId             String    @id(map: "pk_promotion_scheme_slab") @default(dbgenerated("uuidv7()")) @db.Uuid @map("prs_id")
  prsPrmId          String    @db.Uuid                                       @map("prs_prm_id")
  prsSlno           Int       @default(1)                                    @map("prs_slno")
  prsBenefit        String    @db.VarChar(20)                                @map("prs_benefit")

  // ── The band ────────────────────────────────────────────────────────────
  prsExceeds        Decimal   @default(0) @db.Decimal(18, 3)                 @map("prs_exceeds")
  prsUpto           Decimal?  @db.Decimal(18, 3)                             @map("prs_upto")
  prsEach           Decimal   @default(1) @db.Decimal(18, 3)                 @map("prs_each")
  prsIsRepeat       Boolean   @default(false)                                @map("prs_is_repeat")
  prsMaxRepeats     Int       @default(0)                                    @map("prs_max_repeats")

  // ── FREE_ITEM ───────────────────────────────────────────────────────────
  prsFreeItemId     String?   @db.Uuid                                       @map("prs_free_item_id")
  prsFreeUnitId     String?   @db.Uuid                                       @map("prs_free_unit_id")
  prsFreeQty        Decimal   @default(0) @db.Decimal(18, 3)                 @map("prs_free_qty")
  prsFreeStockCheck Boolean   @default(true)                                 @map("prs_free_stock_check")

  // ── DISC_PERC / DISC_AMT, in the bill's idiom ───────────────────────────
  prsDiscPerc       Decimal   @default(0) @db.Decimal(18, 4)                 @map("prs_disc_perc")
  prsDiscQty        Decimal   @default(0) @db.Decimal(18, 4)                 @map("prs_disc_qty")
  prsDiscAmt        Decimal   @default(0) @db.Decimal(18, 2)                 @map("prs_disc_amt")

  // ── FIXED_PRICE ─────────────────────────────────────────────────────────
  prsFixedPrice     Decimal?  @db.Decimal(18, 4)                             @map("prs_fixed_price")

  prsMaxBenefitAmt  Decimal   @default(0) @db.Decimal(18, 2)                 @map("prs_max_benefit_amt")

  prsNotes          String?   @db.Text                                       @map("prs_notes")
  prsIsActive       Boolean   @default(true)                                 @map("prs_is_active")
  prsIsDeleted      Boolean   @default(false)                                @map("prs_is_deleted")
  prsSyncDate       DateTime? @db.Timestamptz(6)                             @map("prs_sync_date")
  prsCreatedOn      DateTime  @default(now()) @db.Timestamptz(6)             @map("prs_created_on")
  prsCreatedBy      String?   @db.VarChar(50)                                @map("prs_created_by")
  prsModifiedOn     DateTime? @db.Timestamptz(6)                             @map("prs_modified_on")
  prsModifiedBy     String?   @db.VarChar(50)                                @map("prs_modified_by")

  scheme            PromotionScheme     @relation("PromotionSchemeSlabs", fields: [prsPrmId, prsBenefit], references: [prmId, prmBenefit], onUpdate: Cascade, onDelete: Cascade, map: "fk_prs_scheme_benefit")
  freeItem          ItemMaster?         @relation("PromotionSlabFreeItem", fields: [prsFreeItemId], references: [itemId], onUpdate: Cascade, onDelete: Restrict, map: "fk_prs_free_item")
  freeUnit          ItemUnitConversion? @relation("PromotionSlabFreeUnit", fields: [prsFreeUnitId], references: [iucId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_prs_free_unit")

  @@map("promotion_scheme_slab")
  @@schema("sales")
}

// ----- prisma/sales/promotionUsage.prisma -----
/// What a promotion campaign actually GAVE AWAY — one row per (document,
/// scheme, direction).
///
/// The PromotionScheme masters say what a campaign PROMISES; nothing until now
/// recorded what it DELIVERED. Without that, two questions have no answer, and
/// both are asked at the till in the moment, before the benefit is applied:
///
///     the CAP     "has this customer already used this campaign twice?"
///                 -> ix_pru_cust_scheme
///     the BUDGET  "what has this campaign given away in total, everywhere?"
///                 -> ix_pru_scheme_total
///
/// LIST-partitioned by pruAccYear, the year of the EVENT, like LoyaltyLedger
/// and LoyaltyCouponTxn — hence the composite PK. Partitions
/// (sales.promotion_usage_2026_2027) come from
/// public.ensure_acc_year_partitions('YYYY-YYYY'), which
/// 20260921180000_add_promotion_usage taught about this table.
///
/// Scheme identity is SNAPSHOTTED (pruSchemeCode / _Name / _Benefit) so a
/// campaign report does not change meaning when the scheme is renamed or
/// retyped next season.
///
/// A reversal is a row of the same shape with NEGATIVE amounts and
/// pruIsReversal = true, naming the row it undoes — the AccBillAdjustment and
/// LoyaltyLedger discipline, and what makes every running total a plain SUM
/// with no CASE in it.
model PromotionUsage {
  pruId                 String    @default(dbgenerated("uuidv7()")) @db.Uuid @map("pru_id")
  /// FY of the EVENT, and the partition key.
  pruAccYear            String    @db.Char(9)                            @map("pru_acc_year")
  pruCompId             String    @db.Uuid                               @map("pru_comp_id")
  pruBranchId           String?   @db.Uuid                               @map("pru_branch_id")
  pruPrmId              String    @db.Uuid                               @map("pru_prm_id")
  /// NULL = walk-in / cash sale, which is also why the per-customer cap index
  /// is partial on this column: an anonymous sale has no cap to check.
  pruCustId             String?   @db.Uuid                               @map("pru_cust_id")

  // ── Snapshot of the campaign as it stood ─────────────────────────────
  // Widths match promotion_scheme.prm_code (30) and prm_name (150).
  pruSchemeCode         String?   @db.VarChar(30)                        @map("pru_scheme_code")
  pruSchemeName         String?   @db.VarChar(150)                       @map("pru_scheme_name")
  /// Snapshot of promotion_scheme.prmBenefit: FREE_ITEM | DISC_PERC |
  /// DISC_AMT | DISC_PER_ITEM | FIXED_PRICE. ck_pru_benefit must cover every
  /// value that column can hold — prmBenefit itself carries no CHECK, so a
  /// new value added there needs one added here in the same migration.
  pruBenefit            String?   @db.VarChar(20)                        @map("pru_benefit")

  // ── Source document ──────────────────────────────────────────────────
  // The same four-part polymorphic identifier AccTenderDetail,
  // AccBillBalance, TxnStatusLog and LoyaltyLedger use. No relation field for
  // pruSrcDocId: the target table varies by module/type.
  pruSrcModule          String    @default("SALES") @db.VarChar(20)      @map("pru_src_module")
  pruSrcDocType         String    @default("SALE_BILL") @db.VarChar(30)  @map("pru_src_doc_type")
  pruSrcDocId           String    @db.Uuid                               @map("pru_src_doc_id")
  /// The SOURCE's FY, not this row's.
  pruSrcAccYear         String?   @db.Char(9)                            @map("pru_src_acc_year")
  /// Snapshot, so a campaign report prints the bill number without joining a
  /// partitioned table across every year the campaign ran.
  pruSrcDocRefno        String?   @db.VarChar(100)                       @map("pru_src_doc_refno")
  pruDocDate            DateTime  @db.Date                               @map("pru_doc_date")

  // ── What it gave ─────────────────────────────────────────────────────
  /// Value the benefit came off.
  pruBaseAmount         Decimal   @default(0) @db.Decimal(18, 2)         @map("pru_base_amount")
  pruBaseQty            Decimal   @default(0) @db.Decimal(18, 3)         @map("pru_base_qty")
  /// Rupees given away. POSITIVE on a normal row, NEGATIVE on a reversal
  /// (ck_pru_sign).
  pruBenefitAmt         Decimal   @default(0) @db.Decimal(18, 2)         @map("pru_benefit_amt")
  /// Units given away, same sign rule.
  pruFreeQty            Decimal   @default(0) @db.Decimal(18, 3)         @map("pru_free_qty")
  /// Lines the scheme touched.
  pruLineCount          Int       @default(0)                            @map("pru_line_count")

  /// The coupon presented, when the campaign was coupon-gated.
  pruCouponId           String?   @db.Uuid                               @map("pru_coupon_id")

  // ── Reversal ─────────────────────────────────────────────────────────
  // Carries a real FK because this table has the year to complete the
  // composite key with.
  pruIsReversal         Boolean   @default(false)                        @map("pru_is_reversal")
  pruReversalOfId       String?   @db.Uuid                               @map("pru_reversal_of_id")
  pruReversalOfAccYear  String?   @db.Char(9)                            @map("pru_reversal_of_acc_year")
  pruReversalReason     String?   @db.VarChar(250)                       @map("pru_reversal_reason")

  pruUserId             String?   @db.Uuid                               @map("pru_user_id")
  pruDeviceId           String?   @db.Uuid                               @map("pru_device_id")
  pruRemarks            String?                                          @map("pru_remarks")

  pruIsActive           Boolean   @default(true)                         @map("pru_is_active")
  pruIsDeleted          Boolean   @default(false)                        @map("pru_is_deleted")
  pruSyncDate           DateTime? @db.Timestamptz(6)                     @map("pru_sync_date")
  pruCreatedOn          DateTime  @default(now()) @db.Timestamptz(6)     @map("pru_created_on")
  pruCreatedBy          String?   @db.VarChar(50)                        @map("pru_created_by")
  pruModifiedOn         DateTime? @db.Timestamptz(6)                     @map("pru_modified_on")
  pruModifiedBy         String?   @db.VarChar(50)                        @map("pru_modified_by")

  // Relations
  company               Company         @relation("PromotionUsageCompany",  fields: [pruCompId],   references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_pru_company")
  branch                BranchMaster?   @relation("PromotionUsageBranch",   fields: [pruBranchId], references: [brId],   onUpdate: Cascade, onDelete: Restrict, map: "fk_pru_branch")
  /// Restrict, not Cascade: a campaign that has already given something away
  /// must not be deletable. Close it instead.
  scheme                PromotionScheme @relation("PromotionUsageScheme",   fields: [pruPrmId],    references: [prmId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_pru_scheme")
  customer              Customer?       @relation("PromotionUsageCustomer", fields: [pruCustId],   references: [cusId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_pru_cust")
  coupon                LoyaltyCoupon?  @relation("PromotionUsageCoupon",   fields: [pruCouponId], references: [lcpId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_pru_coupon")
  device                DeviceMaster?   @relation("PromotionUsageDevice",   fields: [pruDeviceId], references: [devId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_pru_device")
  user                  UserMaster?     @relation("PromotionUsageUser",     fields: [pruUserId],   references: [usrId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_pru_user")

  reversalOf            PromotionUsage?  @relation("PromotionUsageReversal", fields: [pruReversalOfId, pruReversalOfAccYear], references: [pruId, pruAccYear], onUpdate: Cascade, onDelete: Restrict, map: "fk_pru_reversal")
  reversedBy            PromotionUsage[] @relation("PromotionUsageReversal")

  @@id([pruId, pruAccYear], map: "pk_promotion_usage")

  // Partial indexes are DB-only — Prisma ignores WHERE predicates and
  // INCLUDE, so declaring them here would produce phantom drift on every
  // migrate dev:
  //
  //   -- one usage row per document per scheme per DIRECTION. pru_is_reversal
  //   -- is a key column, so a bill may carry the original and its reversal
  //   -- and no more: two originals for one scheme on one bill collide, and a
  //   -- replayed offline push therefore cannot double-count a campaign's
  //   -- spend. All four key columns are NOT NULL.
  //   CREATE UNIQUE INDEX ux_pru_doc_scheme ON sales.promotion_usage
  //       (pru_src_doc_id, pru_prm_id, pru_is_reversal, pru_acc_year)
  //       WHERE pru_is_deleted = false;
  //
  //   -- THE CAP CHECK, asked at the till before the benefit is applied
  //   CREATE INDEX ix_pru_cust_scheme ON sales.promotion_usage
  //       (pru_prm_id, pru_cust_id, pru_doc_date)
  //       INCLUDE (pru_benefit_amt, pru_free_qty, pru_is_reversal)
  //       WHERE pru_is_deleted = false AND pru_cust_id IS NOT NULL;
  //
  //   -- THE BUDGET CHECK and the campaign report
  //   CREATE INDEX ix_pru_scheme_total ON sales.promotion_usage
  //       (pru_prm_id, pru_doc_date)
  //       INCLUDE (pru_branch_id, pru_benefit_amt, pru_free_qty, pru_is_reversal)
  //       WHERE pru_is_deleted = false;
  //
  //   -- branch performance; reconciliation back to the document
  //   CREATE INDEX ix_pru_branch  ON sales.promotion_usage (pru_branch_id, pru_doc_date) …
  //   CREATE INDEX ix_pru_src_doc ON sales.promotion_usage (pru_src_doc_id, pru_src_acc_year) …
  //
  //   -- FK-covering: ix_pru_company, ix_pru_scheme, ix_pru_cust,
  //   -- ix_pru_coupon, ix_pru_device, ix_pru_user, ix_pru_reversal
  //
  // CHECK constraints (DB-only): ck_pru_acc_year, ck_pru_src_acc_year,
  //   ck_pru_src_module, ck_pru_src_doc_type, ck_pru_benefit,
  //   ck_pru_gave_something, ck_pru_sign, ck_pru_reversal_pair,
  //   ck_pru_line_count, ck_pru_base

  @@map("promotion_usage")
  @@schema("sales")
}

// ----- prisma/sales/saleAgent.prisma -----
model SaleAgent {
  saId          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid @map("sa_id")
  saCompanyId   String    @db.Uuid @map("sa_company_id")
  saBranchId    String?   @db.Uuid @map("sa_branch_id")
  saGroupId     String    @db.Uuid @map("sa_group_id")
  saCode        String?   @db.VarChar(60) @map("sa_code")
  saName        String    @db.VarChar(200) @map("sa_name")
  saAlias       String?   @db.VarChar(200) @map("sa_alias")
  saMobile1     String?   @db.VarChar(20) @map("sa_mobile1")
  saMobile2     String?   @db.VarChar(20) @map("sa_mobile2")
  saAddr1       String?   @db.VarChar(250) @map("sa_addr1")
  saAddr2       String?   @db.VarChar(250) @map("sa_addr2")
  saCity        String?   @db.VarChar(120) @map("sa_city")
  saDistrict    String?   @db.VarChar(120) @map("sa_district")
  saState       String?   @db.VarChar(120) @map("sa_state")
  saPincode     String?   @db.VarChar(10) @map("sa_pincode")
  saPanNo       String?   @db.VarChar(20) @map("sa_pan_no")
  saGstin       String?   @db.VarChar(20) @map("sa_gstin")
  saRemarks     String?   @db.VarChar(500) @map("sa_remarks")
  saIsActive    Boolean   @default(true) @map("sa_is_active")
  saIsDeleted   Boolean   @default(false) @map("sa_is_deleted")
  saSyncDate    DateTime? @db.Timestamptz(6) @map("sa_sync_date")
  saCreatedBy   String?   @db.VarChar(100) @map("sa_created_by")
  saCreatedOn   DateTime  @default(now()) @db.Timestamptz(6) @map("sa_created_on")
  saModifiedBy  String?   @db.VarChar(100) @map("sa_modified_by")

  // Relations
  company       Company        @relation("CompanySaleAgents", fields: [saCompanyId], references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_sa_company_id")
  branch        BranchMaster?  @relation("BranchSaleAgents", fields: [saBranchId], references: [brId], onUpdate: Cascade, onDelete: Restrict, map: "fk_sa_branch_id")
  group         SaleAgentGroup @relation(fields: [saGroupId], references: [saGrpId], onUpdate: Cascade, onDelete: Restrict, map: "fk_sa_group_id")
  saModifiedOn  DateTime  @default(now()) @db.Timestamptz(6) @map("sa_modified_on")
  
  @@map("sale_agents")
  @@schema("sales")
  // DB-only partial index ix_sale_agents_active on (sa_is_active) WHERE
  // sa_is_deleted = false is not expressible in Prisma schema.
}

// ----- prisma/sales/saleAgentGroups.prisma -----
model SaleAgentGroup {
  saGrpId         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid @map("sa_grp_id")
  saGrpName       String    @db.VarChar(150) @map("sa_grp_name")
  saGrpCode       String    @db.VarChar(50) @map("sa_grp_code")
  saGrpPos        Int?      @default(0) @map("sa_grp_pos")
  saGrpDesc       String?   @db.VarChar(250) @map("sa_grp_desc")
  saGrpIsActive   Boolean   @default(true) @map("sa_grp_is_active")
  saGrpIsDeleted  Boolean   @default(false) @map("sa_grp_is_deleted")
  saGrpSyncDate   DateTime? @db.Timestamptz @map("sa_grp_sync_date")
  saGrpCreatedOn  DateTime  @default(now()) @db.Timestamptz @map("sa_grp_created_on")
  saGrpCreatedBy  String    @db.Uuid @map("sa_grp_created_by")
  saGrpModifiedOn DateTime? @db.Timestamptz @map("sa_grp_modified_on")
  saGrpModifiedBy String?   @db.Uuid @map("sa_grp_modified_by")

  // Relations
  saleAgents      SaleAgent[]

  @@index([saGrpId], map: "idx_sale_agent_groups_id")
  @@index([saGrpName], map: "idx_sale_agent_groups_name")
  @@index([saGrpIsActive, saGrpIsDeleted], map: "idx_sale_agent_groups_active_deleted")
  @@map("sale_agent_groups")
  @@schema("sales")
}

// ----- prisma/sales/saleBill.prisma -----
model SaleBill {
  sbId               String    @default(dbgenerated("uuidv7()")) @db.Uuid @map("sb_id")
  sbCompanyId        String    @db.Uuid @map("sb_company_id")
  sbBranchId         String    @db.Uuid @map("sb_branch_id")
  sbTenantId         String?   @db.Uuid @map("sb_tenant_id")
  sbAccYear          String    @db.Char(9) @map("sb_acc_year")
  // Where it was raised. Counter is NOT NULL: in an offline chain the
  // counter owns the document and its number series.
  sbSessionId        String?   @db.Uuid @map("sb_session_id")
  sbCounterId        String?   @db.Uuid @map("sb_counter_id")
  sbDeviceType       String    @db.VarChar(20) @map("sb_device_type")
  sbDeviceId         String    @db.Text @map("sb_device_id")
  // Document identity
  sbDocType          String    @default("TAX_INVOICE") @db.VarChar(30) @map("sb_doc_type")
  sbBillType         String    @default("CASH") @db.VarChar(20) @map("sb_bill_type") // CASH | CREDIT
  sbCategoryId       String?   @db.Uuid @map("sb_category_id")
  sbPriceLevel       Int       @map("sb_price_level")
  sbBillSlno         BigInt?    @map("sb_bill_slno") // per company/branch/year/COUNTER
  sbBillRefno        String?    @db.VarChar(100) @map("sb_bill_refno")
  sbUsrRefno         String?   @db.VarChar(100) @map("sb_usr_refno")
  sbBillDate         DateTime  @db.Date @map("sb_bill_date")
  sbBillDatetime     DateTime  @default(now()) @db.Timestamptz(6) @map("sb_bill_datetime")
  sbDueDays          Int?      @map("sb_due_days")
  sbDueDate          DateTime? @db.Date @map("sb_due_date")
  // Where it came from: quotation, sales order, delivery challan.
  sbSrcDocType       String?   @db.VarChar(30) @map("sb_src_doc_type")
  sbSrcDocId         String?   @db.Uuid @map("sb_src_doc_id")
  sbSrcDocRefno      String?   @db.VarChar(100) @map("sb_src_doc_refno")
  sbSrcDocDate       DateTime? @db.Date @map("sb_src_doc_date")
  sbSrcDocYear       String?   @db.VarChar(9) @map("sb_src_doc_year")
  // Customer, snapshotted at billing time
  sbCustId           String?   @db.Uuid @map("sb_cust_id")
  sbCustName         String    @db.VarChar(200) @map("sb_cust_name")
  sbCustAddr         String?   @db.VarChar(500) @map("sb_cust_addr")
  sbCustPlace        String?   @db.VarChar(100) @map("sb_cust_place")
  sbCustPin          String?   @db.VarChar(10) @map("sb_cust_pin")
  sbCustPhone        String?   @db.VarChar(20) @map("sb_cust_phone")
  sbCustGstin        String?   @db.VarChar(15) @map("sb_cust_gstin")
  sbCustGstType      String?   @db.VarChar(20) @map("sb_cust_gst_type")
  sbCustStcd         String?   @db.Char(2) @map("sb_cust_stcd")
  sbPosStcd          String?   @db.Char(2) @map("sb_pos_stcd") // place of supply: CGST+SGST vs IGST
  sbStateName        String?   @db.VarChar(100) @map("sb_state_name")
  // Options carried on the document
  sbHasLoad          Boolean   @default(false) @map("sb_has_load")
  sbHasUnload        Boolean   @default(false) @map("sb_has_unload")
  sbHasFreight       Boolean   @default(false) @map("sb_has_freight")
  sbHasPromo         Boolean   @default(false) @map("sb_has_promo")
  sbHasComm          Boolean   @default(false) @map("sb_has_comm")
  sbHasLoyalty       Boolean   @default(false) @map("sb_has_loyalty")
  // ── Sales plan (20260921220000) ───────────────────────────────────────
  /// POS | WHOLESALE. The MODE owns the number series: POS draws from the
  /// device series, WHOLESALE from the branch MAIN series.
  sbBillMode         String    @default("WHOLESALE") @db.VarChar(10) @map("sb_bill_mode")
  sbUsrRefdate       DateTime? @db.Date @map("sb_usr_refdate")
  /// How much of this bill came in under a challan. Stock and COGS for that
  /// part were posted AT THE DC; the bill posts them only for direct lines.
  sbHasDc            Boolean   @default(false) @map("sb_has_dc")
  sbDcTaxableAmt     Decimal   @default(0) @db.Decimal(15, 2) @map("sb_dc_taxable_amt")
  /// What THIS bill posted as COGS.
  sbCogsAmt          Decimal   @default(0) @db.Decimal(15, 2) @map("sb_cogs_amt")
  /// NA | PENDING | PACKED | DISPATCHED | DELIVERED | RETURNED. A CACHE —
  /// the events themselves are TxnStatusLog rows.
  sbDeliveryStatus   String    @default("NA") @db.VarChar(20) @map("sb_delivery_status")
  sbDeliveredOn      DateTime? @db.Timestamptz(6) @map("sb_delivered_on")
  /// The identity stamp on a cash sale over the rule 114B limit: what was
  /// shown at the counter, kept WITH the bill and never re-derived.
  sbCustPan          String?   @db.VarChar(10) @map("sb_cust_pan")
  sbForm60Ref        String?   @db.VarChar(50) @map("sb_form60_ref")
  /// TCS infrastructure, rate 0 today — 206C(1H) was removed 2025-04-01.
  sbTcsPerc          Decimal   @default(0) @db.Decimal(6, 3) @map("sb_tcs_perc")
  sbTcsAmt           Decimal   @default(0) @db.Decimal(15, 2) @map("sb_tcs_amt")
  /// Loyalty caches; the detail is the LoyaltyLedger rows keyed by this bill.
  sbLoyaltyMemberId  String?   @db.Uuid @map("sb_loyalty_member_id")
  sbLoyaltyEarned    Decimal   @default(0) @db.Decimal(15, 2) @map("sb_loyalty_earned")
  sbLoyaltyRedeemed  Decimal   @default(0) @db.Decimal(15, 2) @map("sb_loyalty_redeemed")
  sbRevisionNo       Int       @default(1) @map("sb_revision_no")
  /// The doc-register row this bill owns. Server-owned, like
  /// sbPostedVoucherId — the DTO never carries either.
  sbDocRegisterId    String?   @db.Uuid @map("sb_doc_register_id")
  // ── Loyalty points (20260921140000) ──────────────────────────────────
  // SNAPSHOTS, not caches. A sale return must reverse WHAT THIS BILL
  // ACTUALLY AWARDED, not what re-running today's scheme would award —
  // schemes get edited, bills do not. The authority for any balance remains
  // sales.loyalty_ledger; these are what the invoice printed.
  //
  // No FK on sbLscId, matching the DDL: a bill must stay readable after a
  // scheme is retired.
  sbLscId            String?   @db.Uuid @map("sb_lsc_id")
  sbLoyaltyEarnPoints   Decimal @default(0) @db.Decimal(18, 4) @map("sb_loyalty_earn_points")
  sbLoyaltyRedeemPoints Decimal @default(0) @db.Decimal(18, 4) @map("sb_loyalty_redeem_points")
  // There is deliberately no sb_loyalty_gift_points: a gift redemption is its
  // own document (LoyaltyGiftRedeem) with its own number series and stock
  // movement, so it never appears as a line on a bill.
  // People
  sbUserId           String    @db.Uuid @map("sb_user_id")
  sbSalesmanId       String[]  @db.Uuid @map("sb_salesman_id")
  sbAgentId          String?   @db.Uuid @map("sb_agent_id")
  sbAgentCommPerc    Decimal?  @db.Decimal(15, 4) @map("sb_agent_comm_perc")
  sbAgentCommAmt     Decimal?  @db.Decimal(15, 2) @map("sb_agent_comm_amt")
  // Delivery
  sbDriverId         String?   @db.Uuid @map("sb_driver_id")
  sbLoadmanId        String[]  @db.Uuid @map("sb_loadman_id")
  sbPackedId         String[]  @db.Uuid @map("sb_packed_id")
  sbSupervisorId     String?   @db.Uuid @map("sb_supervisor_id")
  sbVehicleId        String?   @db.Uuid @map("sb_vehicle_id")
  sbVehicleNo        String?   @db.VarChar(20) @map("sb_vehicle_no")
  // Quantities
  sbTotItems         Int       @default(0) @map("sb_tot_items") // printed LINES, not split rows
  sbTotWeight        Decimal   @default(0) @db.Decimal(15, 3) @map("sb_tot_weight")
  sbTotBags          Decimal   @default(0) @db.Decimal(15, 3) @map("sb_tot_bags")
  // Money
  sbGrossAmt         Decimal   @default(0) @db.Decimal(15, 2) @map("sb_gross_amt")
  sbItemDisc         Decimal   @default(0) @db.Decimal(15, 2) @map("sb_item_disc")
  sbSplDisc          Decimal   @default(0) @db.Decimal(15, 2) @map("sb_spl_disc")
  sbSchDisc          Decimal   @default(0) @db.Decimal(15, 2) @map("sb_sch_disc")
  sbBillSchDisc      Decimal   @default(0) @db.Decimal(15, 2) @map("sb_bill_sch_disc")
  sbAddlDisc1        Decimal   @default(0) @db.Decimal(15, 2) @map("sb_addl_disc1")
  sbAddlDisc2        Decimal   @default(0) @db.Decimal(15, 2) @map("sb_addl_disc2")
  sbCashDisc         Decimal   @default(0) @db.Decimal(15, 2) @map("sb_cash_disc")
  sbTaxableAmt       Decimal   @default(0) @db.Decimal(15, 2) @map("sb_taxable_amt") // POST-charge
  sbCgstAmt          Decimal   @default(0) @db.Decimal(15, 2) @map("sb_cgst_amt")
  sbSgstAmt          Decimal   @default(0) @db.Decimal(15, 2) @map("sb_sgst_amt")
  sbIgstAmt          Decimal   @default(0) @db.Decimal(15, 2) @map("sb_igst_amt")
  sbCessAmt          Decimal   @default(0) @db.Decimal(15, 2) @map("sb_cess_amt")
  sbTaxAmt           Decimal   @default(0) @db.Decimal(15, 2) @map("sb_tax_amt")
  // Roll-ups of sales.sale_doc_charge rows (reporting without a join).
  sbFreightAmt       Decimal   @default(0) @db.Decimal(15, 2) @map("sb_freight_amt")
  sbLoadAmt          Decimal   @default(0) @db.Decimal(15, 2) @map("sb_load_amt")
  sbUnloadAmt        Decimal   @default(0) @db.Decimal(15, 2) @map("sb_unload_amt")
  sbOtherAmt1        Decimal   @default(0) @db.Decimal(15, 2) @map("sb_other_amt1")
  sbOtherAmt2        Decimal   @default(0) @db.Decimal(15, 2) @map("sb_other_amt2")
  sbRoundOff         Decimal   @default(0) @db.Decimal(15, 2) @map("sb_round_off")
  sbBillAmt          Decimal   @default(0) @db.Decimal(15, 2) @map("sb_bill_amt")
  // Costing (never printed; drives margin reports)
  sbTotalCost        Decimal?  @db.Decimal(15, 2) @map("sb_total_cost")
  sbMarginAmt        Decimal?  @db.Decimal(15, 2) @map("sb_margin_amt")
  sbMarginAmtWot     Decimal?  @db.Decimal(15, 2) @map("sb_margin_amt_wot")
  sbMarginPerc       Decimal?  @db.Decimal(15, 4) @map("sb_margin_perc")
  sbMrpSavings       Decimal?  @default(0) @db.Decimal(15, 3) @map("sb_mrp_savings")
  sbMrpSavingsPerc   Decimal?  @default(0) @db.Decimal(15, 4) @map("sb_mrp_savings_perc")
  // Settlement roll-ups. Tender rows live in accounts.acc_tender_detail;
  // these are caches so a counter can balance without a join. sb_balance_amt
  // mirrors accounts.acc_voucher_bills once posted.
  sbPayMode          String?   @db.VarChar(20) @map("sb_pay_mode") // dominant mode, quick filters
  sbCreditAmt        Decimal   @default(0) @db.Decimal(15, 2) @map("sb_credit_amt")
  sbSurchargeAmt     Decimal   @default(0) @db.Decimal(15, 2) @map("sb_surcharge_amt")
  sbTenderAmt        Decimal   @default(0) @db.Decimal(15, 2) @map("sb_tender_amt")
  sbRefundAmt        Decimal   @default(0) @db.Decimal(15, 2) @map("sb_refund_amt")
  sbAdvanceAmt       Decimal   @default(0) @db.Decimal(15, 2) @map("sb_advance_amt")
  sbPaidAmt          Decimal   @default(0) @db.Decimal(15, 2) @map("sb_paid_amt")
  sbBalanceAmt       Decimal   @default(0) @db.Decimal(15, 2) @map("sb_balance_amt")
  sbPayStatus        String    @default("UNPAID") @db.VarChar(20) @map("sb_pay_status")
  // Return caches (sales.sale_return is the document)
  sbReturnedAmt      Decimal   @default(0) @db.Decimal(15, 2) @map("sb_returned_amt")
  sbReturnStatus     String?   @db.VarChar(20) @map("sb_return_status") // NULL|PARTIAL|FULL
  // Terms
  sbPaymentTerms     String?   @db.VarChar(250) @map("sb_payment_terms")
  sbDeliveryTerms    String?   @db.VarChar(250) @map("sb_delivery_terms")
  sbTermsConditions  String?   @map("sb_terms_conditions")
  sbRemarks          String?   @db.VarChar(500) @map("sb_remarks")
  // Pricing policy, snapshotted as this document was billed
  sbFreightCalcType  String?   @db.VarChar(12) @map("sb_freight_calc_type")
  sbLoadingCalcType  String?   @db.VarChar(12) @map("sb_loading_calc_type")
  sbDiscAlterBase    Boolean?  @map("sb_disc_alter_base")
  sbRoundOffStep     Decimal   @default(1) @db.Decimal(15, 2) @map("sb_round_off_step")
  // Lifecycle
  /// DRAFT | POSTED | CANCELLED (ck_sb_status).
  ///
  /// WHEN, WHO and WHY it changed are NOT here any more. TxnStatusLog holds
  /// every transition — changed-on, changed-by, the cancel reason, the
  /// from-status, the device and the session — one appended row per step.
  /// A second copy on the header meant the reason was written twice and the
  /// two could disagree, and an amendment overwrote the previous cancel
  /// instead of leaving a trail. It matters for the offline push too: two
  /// devices APPENDING cannot conflict the way two UPDATEing one header row
  /// can. sbPostedVoucherId stays because it is a RELATIONSHIP, not an event.
  sbStatus           String    @default("DRAFT") @db.VarChar(20) @map("sb_status")
  sbPostedVoucherId  String?   @db.Uuid @map("sb_posted_voucher_id") // accounts.acc_voucher_header
  sbApprovedOn       DateTime? @db.Timestamptz(6) @map("sb_approved_on")
  sbApprovedBy       String?   @db.Uuid @map("sb_approved_by")
  sbVersionNo        Int       @default(1) @map("sb_version_no")
  sbPrintCount       Int       @default(0) @map("sb_print_count")
  // Audit
  sbIsDeleted        Boolean   @default(false) @map("sb_is_deleted")
  sbSyncDate         DateTime? @db.Timestamptz(6) @map("sb_sync_date")
  sbCreatedOn        DateTime  @default(now()) @db.Timestamptz(6) @map("sb_created_on")
  sbCreatedBy        String    @db.VarChar @map("sb_created_by")
  sbModifiedOn       DateTime? @db.Timestamptz(6) @map("sb_modified_on")
  sbModifiedBy       String?   @db.VarChar @map("sb_modified_by")
  // Relations
  items      SaleBillItem[]
  customer   Customer?      @relation(fields: [sbCustId], references: [cusId], onDelete: Restrict, onUpdate: Cascade, map: "fk_sb_cust")
  posState   StateCode?     @relation(fields: [sbPosStcd], references: [stateCode], onDelete: Restrict, onUpdate: Cascade, map: "fk_sb_pos_state")
  priceLevel ItemPriceLevel @relation("SaleBillPriceLevel", fields: [sbPriceLevel], references: [iplId], onDelete: Restrict, onUpdate: Cascade, map: "fk_sb_price_level")
  // ck_sb_doc_type, ck_sb_bill_type, ck_sb_status, ck_sb_pay_status and
  // ck_sb_return_status were dropped before the migration was ever applied
  // and are enforced in the application layer instead
  // (BillService.ensureBillValuesAreAllowed).
  @@id([sbId, sbAccYear], map: "pk_sale_bill")
  // "which bills were raised from this document" — the read the quotation
  // module's conversion recompute runs on every save of a bill that names a
  // quotation. Without it that is a sequential scan of every sale_bill
  // partition. The mirror of sale_bill_item's ix_sbi_src_doc.
  @@index([sbSrcDocId, sbSrcDocYear], map: "ix_sb_src_doc")
  // ── Sales documents (20260921200000) ────────────────────────────────────
  returns               SaleReturn[]              @relation("SaleReturnBill")

  // ── Crew and vehicle (20260921220000) ─────────────────────────────────
  // These stay on the DOCUMENT rather than moving to a shared transport
  // band: they exist whenever goods move, even with no consignment — a
  // home delivery has a driver and a van and no transporter, no LR and no
  // e-way bill. sbLoadmanId is uuid[] and cannot carry an FK.
  driver             EmployeeMaster? @relation("SaleBillDriver",     fields: [sbDriverId],     references: [empId], onUpdate: Cascade, onDelete: Restrict, map: "fk_sb_driver")
  supervisor         EmployeeMaster? @relation("SaleBillSupervisor", fields: [sbSupervisorId], references: [empId], onUpdate: Cascade, onDelete: Restrict, map: "fk_sb_supervisor")
  vehicle            VehicleMaster?  @relation("SaleBillVehicle",    fields: [sbVehicleId],    references: [vehId], onUpdate: Cascade, onDelete: Restrict, map: "fk_sb_vehicle")

  // ── Temp credit (20260922000000) ────────────────────────────────────────
  tempCredits        AccTempCredit[] @relation("TempCreditBill")

  @@map("sale_bill")
  @@schema("sales")
}

// ----- prisma/sales/saleBillItem.prisma -----
// Lines -- one row per BATCH ALLOCATION. Printed line = GROUP BY sbi_line_no;
// stock/GST reads rows as they are.
model SaleBillItem {
  sbiId              String    @default(dbgenerated("uuidv7()")) @db.Uuid @map("sbi_id")
  sbiBillId          String    @db.Uuid @map("sbi_bill_id")
  sbiCompanyId       String    @db.Uuid @map("sbi_company_id")
  sbiBranchId        String    @db.Uuid @map("sbi_branch_id")
  sbiTenantId        String?   @db.Uuid @map("sbi_tenant_id")
  sbiAccYear         String    @db.Char(9) @map("sbi_acc_year")
  // The printed line, and which allocation within it. Non-batch items are
  // always (line, 1).
  sbiLineNo          Int       @map("sbi_line_no")
  sbiSplitNo         Int       @default(1) @map("sbi_split_no")
  // Which line of which source document this came from (order/quotation).
  sbiSrcDocType      String?   @db.VarChar(30) @map("sbi_src_doc_type")
  sbiSrcDocId        String?   @db.Uuid @map("sbi_src_doc_id")
  sbiSrcDocYear      String?   @db.Char(9) @map("sbi_src_doc_year")
  sbiSrcDocRefno     String?   @db.VarChar(100) @map("sbi_src_doc_refno")
  sbiSrcDocLineNo    Int?      @map("sbi_src_doc_line_no")
  sbiSrcItemQty      Decimal?  @db.Decimal(15, 3) @map("sbi_src_item_qty")
  sbiSrcFreeQty      Decimal?  @db.Decimal(15, 3) @map("sbi_src_free_qty")
  // What is being sold
  sbiItemId          String    @db.Uuid @map("sbi_item_id")
  sbiItemUnitId      String    @db.Uuid @map("sbi_item_unit_id")
  sbiToBaseFactor    Decimal   @default(0) @db.Decimal(15, 6) @map("sbi_to_base_factor")
  sbiHsnCode         String?   @db.VarChar(8) @map("sbi_hsn_code")
  sbiPriceLevel      Int       @map("sbi_price_level")
  sbiEanCode         String?   @db.VarChar(100) @map("sbi_ean_code")
  // Free-text dimension the operator typed, e.g. a timber shop's "12*6*2*10"
  // (length ft * width in * thickness in * pieces), which is what sbiBillQty
  // was derived from. Stored verbatim so a reprint shows the size the customer
  // agreed to, not just the cubic feet it became. Mirrors soi_size/soi_size_uom
  // on sale_order_item.
  sbiSize            String?   @db.VarChar(50) @map("sbi_size")
  sbiSizeUom         String?   @db.VarChar(20) @map("sbi_size_uom")
  // Where the stock came from. sbi_stock_id points at the inventory
  // batch/stock row the quantity was taken from, so a reversal knows exactly
  // what to put back.
  sbiGodownId        String    @db.Uuid @map("sbi_godown_id")
  sbiStockId         String?   @db.Uuid @map("sbi_stock_id")
  // ── Sales plan (20260921220000) ───────────────────────────────────────
  /// The stock engine keys on the LOT, not the legacy sbiStockId.
  sbiLotId           String?   @db.Uuid @map("sbi_lot_id")
  /// SALEABLE | DAMAGED | QUARANTINE | EXPIRED | SAMPLE
  sbiBucket          String    @default("SALEABLE") @db.VarChar(20) @map("sbi_bucket")
  /// The source LINE (soiId or sdiId). sbiSrcDocId is the HEADER, and
  /// sbiSrcDocLineNo is not a key across an amend.
  sbiSrcItemId       String?   @db.Uuid @map("sbi_src_item_id")
  /// What this line posted as COGS — ZERO on a line that came via a DC,
  /// because the challan already posted it.
  sbiCogsAmt         Decimal   @default(0) @db.Decimal(15, 2) @map("sbi_cogs_amt")
  /// Which promotion gave a free item, so the claw-back knows what to undo.
  sbiPromoUsageId    String?   @db.Uuid @map("sbi_promo_usage_id")
  sbiBatchNo         String?   @db.VarChar(100) @map("sbi_batch_no")
  sbiBatchDate       DateTime? @db.Date @map("sbi_batch_date")
  sbiExpiryDate      DateTime? @db.Date @map("sbi_expiry_date")
  sbiSerialNo        String?   @db.VarChar(100) @map("sbi_serial_no")
  // Flags
  sbiIsTaxIncl       Boolean   @default(false) @map("sbi_is_tax_incl")
  sbiIsPromo         Boolean   @default(false) @map("sbi_is_promo")
  sbiIsFree          Boolean   @default(false) @map("sbi_is_free")
  sbiFreeType        String?   @db.VarChar(20) @map("sbi_free_type") // NULL / SCHEME / SAMPLE / REPLACEMENT (app-layer only, ck_sbi_free_type dropped)
  sbiIsService       Boolean   @default(false) @map("sbi_is_service")
  sbiHasFreight      Boolean   @default(false) @map("sbi_has_freight")
  // Quantities (of THIS allocation)
  sbiCaseQty         Decimal   @default(0) @db.Decimal(15, 3) @map("sbi_case_qty")
  sbiBillQty         Decimal   @default(0) @db.Decimal(15, 3) @map("sbi_bill_qty")
  sbiLengthQty       Decimal?  @default(0) @db.Decimal(15, 3) @map("sbi_length_qty")
  sbiNetQty          Decimal   @default(0) @db.Decimal(15, 3) @map("sbi_net_qty")
  sbiWeightQty       Decimal?  @default(0) @db.Decimal(15, 3) @map("sbi_weight_qty")
  sbiAvailableStock  Decimal   @default(0) @db.Decimal(15, 3) @map("sbi_available_stock")
  sbiReturnQty       Decimal   @default(0) @db.Decimal(15, 3) @map("sbi_return_qty") // cache from sale_return
  // Rates
  sbiRate            Decimal   @default(0) @db.Decimal(15, 4) @map("sbi_rate")
  sbiRatePreTax      Decimal   @default(0) @db.Decimal(15, 4) @map("sbi_rate_pre_tax")
  sbiRateDiff        Decimal   @default(0) @db.Decimal(15, 4) @map("sbi_rate_diff")
  sbiActPrice        Decimal?  @db.Decimal(15, 4) @map("sbi_act_price")
  sbiMaxPrice        Decimal?  @db.Decimal(15, 4) @map("sbi_max_price") // MRP
  sbiMinPrice        Decimal?  @db.Decimal(15, 4) @map("sbi_min_price")
  sbiCostPrice       Decimal?  @db.Decimal(15, 4) @map("sbi_cost_price")
  sbiCostPreTax      Decimal?  @db.Decimal(15, 2) @map("sbi_cost_pre_tax")
  // Discounts
  sbiItemDiscPerc    Decimal   @default(0) @db.Decimal(15, 4) @map("sbi_item_disc_perc")
  sbiItemDiscQty     Decimal   @default(0) @db.Decimal(15, 3) @map("sbi_item_disc_qty")
  sbiItemDiscAmt     Decimal   @default(0) @db.Decimal(15, 2) @map("sbi_item_disc_amt")
  sbiSplDiscPerc     Decimal   @default(0) @db.Decimal(15, 4) @map("sbi_spl_disc_perc")
  sbiSplDiscQty      Decimal   @default(0) @db.Decimal(15, 3) @map("sbi_spl_disc_qty")
  sbiSplDiscAmt      Decimal   @default(0) @db.Decimal(15, 2) @map("sbi_spl_disc_amt")
  sbiSchDiscPerc     Decimal   @default(0) @db.Decimal(15, 4) @map("sbi_sch_disc_perc")
  sbiSchDiscQty      Decimal   @default(0) @db.Decimal(15, 3) @map("sbi_sch_disc_qty")
  sbiSchDiscAmt      Decimal   @default(0) @db.Decimal(15, 2) @map("sbi_sch_disc_amt")
  sbiBillSchPerc     Decimal   @default(0) @db.Decimal(15, 4) @map("sbi_bill_sch_perc")
  sbiBillSchQty      Decimal   @default(0) @db.Decimal(15, 3) @map("sbi_bill_sch_qty")
  sbiBillSchAmt      Decimal   @default(0) @db.Decimal(15, 2) @map("sbi_bill_sch_amt")
  sbiAddlDisc1Perc   Decimal   @default(0) @db.Decimal(15, 4) @map("sbi_addl_disc1_perc")
  sbiAddlDisc1Amt    Decimal   @default(0) @db.Decimal(15, 2) @map("sbi_addl_disc1_amt")
  sbiAddlDisc2Perc   Decimal   @default(0) @db.Decimal(15, 4) @map("sbi_addl_disc2_perc")
  sbiAddlDisc2Amt    Decimal   @default(0) @db.Decimal(15, 2) @map("sbi_addl_disc2_amt")
  sbiCashDiscPerc    Decimal   @default(0) @db.Decimal(15, 4) @map("sbi_cash_disc_perc")
  sbiCashDiscAmt     Decimal   @default(0) @db.Decimal(15, 2) @map("sbi_cash_disc_amt")
  // The charge-distribution trio. Goods value after line discounts
  // (pre-charge, pre-tax), then this line's signed share of the
  // before/after-tax charges.
  sbiGrossAmt        Decimal   @default(0) @db.Decimal(15, 2) @map("sbi_gross_amt")
  sbiNetGross        Decimal?  @db.Decimal(14, 4) @map("sbi_net_gross")
  sbiChrgBeforeTax   Decimal?  @db.Decimal(14, 4) @map("sbi_chrg_before_tax")
  sbiChrgAfterTax    Decimal?  @db.Decimal(14, 4) @map("sbi_chrg_after_tax")
  // Tax (on the POST-charge taxable)
  // Which tax_rate_master row this line was taxed under, snapshotted at save.
  // Not re-read from item_master at posting time: the item default is mutable
  // and two tax rows can share a percentage.
  sbiTaxId           String?   @db.Uuid @map("sbi_tax_id")
  sbiTaxableAmt      Decimal   @default(0) @db.Decimal(15, 2) @map("sbi_taxable_amt")
  sbiTaxPerc         Decimal   @default(0) @db.Decimal(15, 4) @map("sbi_tax_perc")
  sbiTaxAmt          Decimal   @default(0) @db.Decimal(15, 2) @map("sbi_tax_amt")
  sbiCgstPerc        Decimal   @default(0) @db.Decimal(15, 4) @map("sbi_cgst_perc")
  sbiCgstAmt         Decimal   @default(0) @db.Decimal(15, 2) @map("sbi_cgst_amt")
  sbiSgstPerc        Decimal   @default(0) @db.Decimal(15, 4) @map("sbi_sgst_perc")
  sbiSgstAmt         Decimal   @default(0) @db.Decimal(15, 2) @map("sbi_sgst_amt")
  sbiIgstPerc        Decimal   @default(0) @db.Decimal(15, 4) @map("sbi_igst_perc")
  sbiIgstAmt         Decimal   @default(0) @db.Decimal(15, 2) @map("sbi_igst_amt")
  sbiCessPerc        Decimal   @default(0) @db.Decimal(15, 4) @map("sbi_cess_perc")
  sbiCessPerUnit     Decimal   @default(0) @db.Decimal(15, 4) @map("sbi_cess_per_unit")
  sbiCessAmt         Decimal   @default(0) @db.Decimal(15, 2) @map("sbi_cess_amt")
  sbiAcessPerc       Decimal   @default(0) @db.Decimal(15, 4) @map("sbi_acess_perc")
  sbiAcessPerUnit    Decimal   @default(0) @db.Decimal(15, 4) @map("sbi_acess_per_unit")
  sbiAcessAmt        Decimal   @default(0) @db.Decimal(15, 2) @map("sbi_acess_amt")
  sbiBatchConfig     Int       @default(0) @map("sbi_batch_config")
  // Per-line charges
  sbiFreightQty      Decimal   @default(0) @db.Decimal(15, 3) @map("sbi_freight_qty")
  sbiFreightAmt      Decimal   @default(0) @db.Decimal(15, 2) @map("sbi_freight_amt")
  sbiLoadQty         Decimal   @default(0) @db.Decimal(15, 3) @map("sbi_load_qty")
  sbiLoadAmt         Decimal   @default(0) @db.Decimal(15, 2) @map("sbi_load_amt")
  sbiUnloadQty       Decimal   @default(0) @db.Decimal(15, 3) @map("sbi_unload_qty")
  sbiUnloadAmt       Decimal   @default(0) @db.Decimal(15, 2) @map("sbi_unload_amt")
  sbiRoundOff        Decimal   @default(0) @db.Decimal(15, 2) @map("sbi_round_off")
  sbiNetAmt          Decimal   @default(0) @db.Decimal(15, 2) @map("sbi_net_amt")
  // Costing / margin, PER UNIT
  sbiSoldPrice       Decimal?  @db.Decimal(15, 4) @map("sbi_sold_price")
  sbiSoldPreTax      Decimal?  @db.Decimal(15, 2) @map("sbi_sold_pre_tax")
  sbiItemProfit      Decimal?  @db.Decimal(15, 2) @map("sbi_item_profit")
  sbiProfitPreTax    Decimal?  @db.Decimal(15, 2) @map("sbi_profit_pre_tax")
  sbiMrpSavings      Decimal?  @db.Decimal(15, 3) @map("sbi_mrp_savings")
  sbiMrpSavingsPerc  Decimal?  @db.Decimal(15, 4) @map("sbi_mrp_savings_perc")
  // Attribution
  sbiSalesmanId      String?   @db.Uuid @map("sbi_salesman_id")
  sbiSchemeId        String?   @db.Uuid @map("sbi_scheme_id")
  sbiSchemeName      String?   @db.VarChar(150) @map("sbi_scheme_name")
  // ── Loyalty points (20260921140000) ──────────────────────────────────
  // The client already computed these per line and threw them away for want
  // of a column. Snapshots of the rule that ran, so a later scheme edit
  // cannot rewrite history.
  //
  // sbiSchemeId / sbiSchemeName above belong to the PROMOTION scheme and are
  // deliberately NOT reused here — welding the two features together is how
  // one of them becomes impossible to change.
  sbiLoyaltyPv       Decimal   @default(0) @db.Decimal(18, 4) @map("sbi_loyalty_pv")
  sbiLoyaltyPoints   Decimal   @default(0) @db.Decimal(18, 4) @map("sbi_loyalty_points")
  sbiRemarks         String?   @db.VarChar(250) @map("sbi_remarks")
  // Audit
  sbiIsDeleted       Boolean   @default(false) @map("sbi_is_deleted")
  sbiSyncDate        DateTime? @db.Timestamptz(6) @map("sbi_sync_date")
  sbiCreatedOn       DateTime  @default(now()) @db.Timestamptz(6) @map("sbi_created_on")
  sbiCreatedBy       String    @db.Text @map("sbi_created_by")
  sbiModifiedOn      DateTime? @db.Timestamptz(6) @map("sbi_modified_on")
  sbiModifiedBy      String?   @db.Text @map("sbi_modified_by")
  // Relations
  bill               SaleBill           @relation(fields: [sbiBillId, sbiAccYear], references: [sbId, sbAccYear], onDelete: Cascade, onUpdate: Cascade, map: "fk_sbi_bill")
  item               ItemMaster         @relation(fields: [sbiItemId], references: [itemId], onDelete: Restrict, onUpdate: Cascade, map: "fk_sbi_item")
  tax                TaxRateMaster?     @relation(fields: [sbiTaxId], references: [taxId], onDelete: Restrict, onUpdate: Cascade, map: "fk_sbi_tax")
  priceLevel         ItemPriceLevel     @relation("SaleBillItemPriceLevel", fields: [sbiPriceLevel], references: [iplId], onDelete: Restrict, onUpdate: Cascade, map: "fk_sbi_price_level")
  // sbiItemUnitId references item_unit_conversion(iuc_id), NOT item_unit_master(unit_id)
  itemUnitConversion ItemUnitConversion @relation("SaleBillItemUnitConversion", fields: [sbiItemUnitId], references: [iucId], onDelete: Restrict, onUpdate: Cascade, map: "fk_sbi_item_unit")
  // ck_sbi_free_type, ck_sbi_split_no and ck_sbi_batch_split were dropped
  // before the migration was ever applied and are enforced in the
  // application layer instead (BillService.ensureBillItemValuesAreAllowed).
  @@id([sbiId, sbiAccYear], map: "pk_sale_bill_item")
  // Migration 20260813050000. The sale-order module re-derives soi_delivered_qty
  // by summing these rows for one order — across every partition, since an order
  // taken in one year is routinely billed in the next — so the src-doc reference
  // needs an index of its own. Plain and non-unique, so unlike the DB-only
  // partial indexes on sale_order_item it is safe to declare here.
  @@index([sbiSrcDocId, sbiSrcDocYear, sbiSrcDocLineNo], map: "ix_sbi_src_doc")
  // ix_sbi_tax (sbi_tax_id) WHERE sbi_tax_id IS NOT NULL is a DB-only partial index
  // (migration 20260912050000). Prisma cannot express the predicate and
  // would re-create it without one. Do NOT add @@index for it.
  // ── Sales documents (20260921200000) ────────────────────────────────────
  returnItems           SaleReturnItem[]          @relation("SaleReturnItemBill")

  // ── Sales plan (20260921220000) ───────────────────────────────────────
  lot                StockLot? @relation("SaleBillItemLot", fields: [sbiLotId], references: [sltId], onUpdate: Cascade, onDelete: Restrict, map: "fk_sbi_lot")

  @@map("sale_bill_item")
  @@schema("sales")
}

// ----- prisma/sales/saleDc.prisma -----
/// Delivery challan: goods OUT before the invoice.
///
///  * a STOCK document — posting writes DC_ISSUE stock rows and, under
///    perpetual costing, DR COGS / CR INVENTORY at cost;
///  * a GST document with NO TAX LIABILITY. It carries prices and GST columns
///    only because rule 138(1) reads the VALUE of the goods for the e-way
///    bill, and because the challan has to print. Never an IRN;
///  * the SOURCE of a bill — a bill against a DC consumes sdiBilledQty and
///    posts revenue only, because the stock already left. Many DCs to one
///    bill, one DC to many bills, and mixed DC + direct lines on one bill are
///    all allowed.
///
/// sdcPurpose decides its GST reading: SUPPLY converts into a bill; the others
/// (JOB_WORK, APPROVAL, EXHIBITION, OWN_USE, LINE_SALES, OTHER) may only come
/// back via a DC return or be converted after the fact.
///
/// LIST-partitioned by sdcAccYear, PK (sdcId, sdcAccYear).
model SaleDc {
  sdcId                 String    @default(dbgenerated("uuidv7()")) @db.Uuid @map("sdc_id")
  sdcCompanyId          String    @db.Uuid                             @map("sdc_company_id")
  sdcBranchId           String    @db.Uuid                             @map("sdc_branch_id")
  sdcTenantId           String?   @db.Uuid                             @map("sdc_tenant_id")
  sdcAccYear            String    @db.Char(9)                          @map("sdc_acc_year")

  sdcSessionId          String?   @db.Uuid                             @map("sdc_session_id")
  sdcCounterId          String    @db.Uuid                             @map("sdc_counter_id")
  sdcDeviceType         String?   @db.VarChar(20)                      @map("sdc_device_type")
  sdcDeviceId           String?                                        @map("sdc_device_id")

  // ── Identity ─────────────────────────────────────────────────────────
  sdcDocType            String    @default("DELIVERY_CHALLAN") @db.VarChar(30) @map("sdc_doc_type")
  /// SUPPLY | JOB_WORK | APPROVAL | EXHIBITION | OWN_USE | LINE_SALES | OTHER
  sdcPurpose            String    @default("SUPPLY") @db.VarChar(20)   @map("sdc_purpose")
  sdcDcSlno             BigInt                                         @map("sdc_dc_slno")
  sdcDcRefno            String    @db.VarChar(100)                     @map("sdc_dc_refno")
  sdcUsrRefno           String?   @db.VarChar(100)                     @map("sdc_usr_refno")
  sdcUsrRefdate         DateTime? @db.Date                             @map("sdc_usr_refdate")
  sdcDcDate             DateTime  @db.Date                             @map("sdc_dc_date")
  sdcDcDatetime         DateTime  @default(now()) @db.Timestamptz(6)   @map("sdc_dc_datetime")
  sdcPriceLevel         Int       @default(1)                          @map("sdc_price_level")

  // ── Source: a sales order (line-level in SaleDcItem) ─────────────────
  sdcSrcDocType         String?   @db.VarChar(30)                      @map("sdc_src_doc_type")
  sdcSrcDocId           String?   @db.Uuid                             @map("sdc_src_doc_id")
  sdcSrcDocAccYear      String?   @db.Char(9)                          @map("sdc_src_doc_acc_year")
  sdcSrcDocRefno        String?   @db.VarChar(100)                     @map("sdc_src_doc_refno")
  sdcSrcDocDate         DateTime? @db.Date                             @map("sdc_src_doc_date")

  // ── Customer, snapshotted (bill-to) ──────────────────────────────────
  sdcCustId             String    @db.Uuid                             @map("sdc_cust_id")
  sdcCustName           String    @db.VarChar(200)                     @map("sdc_cust_name")
  sdcCustAddr           String?   @db.VarChar(500)                     @map("sdc_cust_addr")
  sdcCustPlace          String?   @db.VarChar(100)                     @map("sdc_cust_place")
  sdcCustPin            String?   @db.VarChar(10)                      @map("sdc_cust_pin")
  sdcCustPhone          String?   @db.VarChar(20)                      @map("sdc_cust_phone")
  sdcCustGstin          String?   @db.VarChar(15)                      @map("sdc_cust_gstin")
  sdcCustGstType        String?   @db.VarChar(20)                      @map("sdc_cust_gst_type")
  sdcCustStcd           String?   @db.Char(2)                          @map("sdc_cust_stcd")
  sdcPosStcd            String?   @db.Char(2)                          @map("sdc_pos_stcd")
  sdcStateName          String?   @db.VarChar(100)                     @map("sdc_state_name")

  // ── Delivery crew and vehicle — OURS, on the document on purpose ─────
  sdcDriverId           String?   @db.Uuid                             @map("sdc_driver_id")
  sdcSupervisorId       String?   @db.Uuid                             @map("sdc_supervisor_id")
  sdcLoadmanId          String[]  @db.Uuid                             @map("sdc_loadman_id")
  sdcVehicleId          String?   @db.Uuid                             @map("sdc_vehicle_id")
  sdcVehicleNo          String?   @db.VarChar(20)                      @map("sdc_vehicle_no")

  // ── People ───────────────────────────────────────────────────────────
  sdcUserId             String    @db.Uuid                             @map("sdc_user_id")
  /// uuid[] — no FK on array elements; the service validates each id.
  sdcSalesmanId         String[]  @db.Uuid                             @map("sdc_salesman_id")
  sdcAgentId            String?   @db.Uuid                             @map("sdc_agent_id")

  // ── Quantities / money. The prices are for the e-way bill and the print;
  //    NO tax liability is posted from them. ─────────────────────────────
  sdcTotItems           Int       @default(0)                          @map("sdc_tot_items")
  sdcTotWeight          Decimal   @default(0) @db.Decimal(15, 3)       @map("sdc_tot_weight")
  sdcTotBags            Decimal   @default(0) @db.Decimal(15, 3)       @map("sdc_tot_bags")
  sdcGrossAmt           Decimal   @default(0) @db.Decimal(15, 2)       @map("sdc_gross_amt")
  sdcDiscAmt            Decimal   @default(0) @db.Decimal(15, 2)       @map("sdc_disc_amt")
  sdcTaxableAmt         Decimal   @default(0) @db.Decimal(15, 2)       @map("sdc_taxable_amt")
  sdcCgstAmt            Decimal   @default(0) @db.Decimal(15, 2)       @map("sdc_cgst_amt")
  sdcSgstAmt            Decimal   @default(0) @db.Decimal(15, 2)       @map("sdc_sgst_amt")
  sdcIgstAmt            Decimal   @default(0) @db.Decimal(15, 2)       @map("sdc_igst_amt")
  sdcCessAmt            Decimal   @default(0) @db.Decimal(15, 2)       @map("sdc_cess_amt")
  sdcTaxAmt             Decimal   @default(0) @db.Decimal(15, 2)       @map("sdc_tax_amt")
  sdcOtherAmt           Decimal   @default(0) @db.Decimal(15, 2)       @map("sdc_other_amt")
  sdcRoundOff           Decimal   @default(0) @db.Decimal(15, 2)       @map("sdc_round_off")
  sdcDcAmt              Decimal   @default(0) @db.Decimal(15, 2)       @map("sdc_dc_amt")
  /// The COGS posted AT the challan, under perpetual costing.
  sdcTotalCost          Decimal   @default(0) @db.Decimal(15, 2)       @map("sdc_total_cost")

  // ── Fulfilment caches (detail on the lines) ──────────────────────────
  sdcBilledAmt          Decimal   @default(0) @db.Decimal(15, 2)       @map("sdc_billed_amt")
  sdcReturnedAmt        Decimal   @default(0) @db.Decimal(15, 2)       @map("sdc_returned_amt")
  /// OPEN | PARTIAL | BILLED | RETURNED | CLOSED
  sdcFulfilStatus       String    @default("OPEN") @db.VarChar(20)     @map("sdc_fulfil_status")

  // ── Roll-ups from the bill that a challan carries ────────────────────
  sdcHasLoad            Boolean   @default(false)                      @map("sdc_has_load")
  sdcHasUnload          Boolean   @default(false)                      @map("sdc_has_unload")
  sdcHasFreight         Boolean   @default(false)                      @map("sdc_has_freight")
  sdcHasPromo           Boolean   @default(false)                      @map("sdc_has_promo")
  sdcPackedId           String[]  @db.Uuid                             @map("sdc_packed_id")
  sdcItemDisc           Decimal   @default(0) @db.Decimal(15, 2)       @map("sdc_item_disc")
  sdcSplDisc            Decimal   @default(0) @db.Decimal(15, 2)       @map("sdc_spl_disc")
  sdcSchDisc            Decimal   @default(0) @db.Decimal(15, 2)       @map("sdc_sch_disc")
  sdcFreightAmt         Decimal   @default(0) @db.Decimal(15, 2)       @map("sdc_freight_amt")
  sdcLoadAmt            Decimal   @default(0) @db.Decimal(15, 2)       @map("sdc_load_amt")
  sdcUnloadAmt          Decimal   @default(0) @db.Decimal(15, 2)       @map("sdc_unload_amt")
  sdcFreightCalcType    String?   @db.VarChar(12)                      @map("sdc_freight_calc_type")
  sdcLoadingCalcType    String?   @db.VarChar(12)                      @map("sdc_loading_calc_type")
  sdcDiscAlterBase      Boolean?                                       @map("sdc_disc_alter_base")
  sdcRoundOffStep       Decimal   @default(1) @db.Decimal(15, 2)       @map("sdc_round_off_step")

  sdcPaymentTerms       String?   @db.VarChar(250)                     @map("sdc_payment_terms")
  sdcDeliveryTerms      String?   @db.VarChar(250)                     @map("sdc_delivery_terms")
  sdcRemarks            String?   @db.VarChar(500)                     @map("sdc_remarks")

  // ── Lifecycle ────────────────────────────────────────────────────────
  /// DRAFT | POSTED | CANCELLED. WHEN / WHO / WHY a status changed is NOT
  /// here: TxnStatusLog holds every transition, one row per step, appended
  /// and never updated — which is also the only shape that survives an
  /// offline push, because two devices appending cannot conflict the way two
  /// devices UPDATEing one header row can.
  sdcStatus             String    @default("DRAFT") @db.VarChar(20)    @map("sdc_status")
  /// The COGS voucher. No FK: SERVER-owned and written long after an offline
  /// counter created this row.
  sdcPostedVoucherId    String?   @db.Uuid                             @map("sdc_posted_voucher_id")
  sdcRevisionNo         Int       @default(1)                          @map("sdc_revision_no")
  sdcPrintCount         Int       @default(0)                          @map("sdc_print_count")

  sdcIsDeleted          Boolean   @default(false)                      @map("sdc_is_deleted")
  sdcSyncDate           DateTime? @db.Timestamptz(6)                   @map("sdc_sync_date")
  sdcCreatedOn          DateTime  @default(now()) @db.Timestamptz(6)   @map("sdc_created_on")
  sdcCreatedBy          String    @db.VarChar(50)                      @map("sdc_created_by")
  sdcModifiedOn         DateTime? @db.Timestamptz(6)                   @map("sdc_modified_on")
  sdcModifiedBy         String?   @db.VarChar(50)                      @map("sdc_modified_by")

  // Relations
  customer              Customer        @relation("SaleDcCustomer",   fields: [sdcCustId],       references: [cusId],     onUpdate: Cascade, onDelete: Restrict, map: "fk_sdc_cust")
  posState              StateCode?      @relation("SaleDcPosState",   fields: [sdcPosStcd],      references: [stateCode], onUpdate: Cascade, onDelete: Restrict, map: "fk_sdc_pos_state")
  driver                EmployeeMaster? @relation("SaleDcDriver",     fields: [sdcDriverId],     references: [empId],     onUpdate: Cascade, onDelete: Restrict, map: "fk_sdc_driver")
  supervisor            EmployeeMaster? @relation("SaleDcSupervisor", fields: [sdcSupervisorId], references: [empId],     onUpdate: Cascade, onDelete: Restrict, map: "fk_sdc_supervisor")
  vehicle               VehicleMaster?  @relation("SaleDcVehicle",    fields: [sdcVehicleId],    references: [vehId],     onUpdate: Cascade, onDelete: Restrict, map: "fk_sdc_vehicle")

  items                 SaleDcItem[]    @relation("SaleDcItems")
  dcReturns             SaleDcReturn[]  @relation("SaleDcReturnDc")

  @@id([sdcId, sdcAccYear], map: "pk_sale_dc")

  @@unique([sdcCompanyId, sdcBranchId, sdcAccYear, sdcDcRefno], map: "ux_sdc_refno")
  @@unique([sdcCompanyId, sdcBranchId, sdcAccYear, sdcCounterId, sdcDcSlno], map: "ux_sdc_counter_slno")

  // Partial indexes are DB-only:
  //   ix_sdc_company_branch_date
  //   ix_sdc_cust_open  -- "what is still out on challan for this customer",
  //                        which is what the billing screen asks before it
  //                        offers DC lines to pull in:
  //       (sdc_cust_id, sdc_fulfil_status) WHERE NOT deleted
  //         AND sdc_status = 'POSTED' AND sdc_fulfil_status IN ('OPEN','PARTIAL')
  //   FK-covering: ix_sdc_pos_state, ix_sdc_driver, ix_sdc_supervisor,
  //                ix_sdc_vehicle
  //
  // CHECK constraints (DB-only): ck_sdc_doc_type, ck_sdc_purpose,
  //   ck_sdc_status, ck_sdc_fulfil_status

  @@map("sale_dc")
  @@schema("sales")
}

// ----- prisma/sales/saleDcItem.prisma -----
/// A challan line. The LOT leaves here, and the bill inherits it.
///
/// sdiItemUnitId is inventory.item_unit_conversion(iuc_id), exactly as
/// SaleBillItem.sbiItemUnitId — the bill line inherits this value unchanged,
/// so the two must share an id space.
///
/// Fulfilment is tracked on the LINE: sdiBilledQty and sdiReturnedQty are
/// written by OTHER documents (a bill and a DC return), which is why the
/// remainder is generated rather than guarded.
model SaleDcItem {
  sdiId                 String    @default(dbgenerated("uuidv7()")) @db.Uuid @map("sdi_id")
  sdiDcId               String    @db.Uuid                             @map("sdi_dc_id")
  sdiCompanyId          String    @db.Uuid                             @map("sdi_company_id")
  sdiBranchId           String    @db.Uuid                             @map("sdi_branch_id")
  sdiTenantId           String?   @db.Uuid                             @map("sdi_tenant_id")
  sdiAccYear            String    @db.Char(9)                          @map("sdi_acc_year")
  sdiLineNo             Int                                            @map("sdi_line_no")
  sdiSplitNo            Int       @default(1)                          @map("sdi_split_no")

  // ── Source order line (partial delivery of an order) ─────────────────
  sdiSrcDocType         String?   @db.VarChar(30)                      @map("sdi_src_doc_type")
  sdiSrcDocId           String?   @db.Uuid                             @map("sdi_src_doc_id")
  sdiSrcDocAccYear      String?   @db.Char(9)                          @map("sdi_src_doc_acc_year")
  sdiSrcDocRefno        String?   @db.VarChar(100)                     @map("sdi_src_doc_refno")
  sdiSrcLineNo          Int?                                           @map("sdi_src_line_no")
  /// sale_order_item.soi_id. No FK: polymorphic with sdiSrcDocType.
  sdiSrcItemId          String?   @db.Uuid                             @map("sdi_src_item_id")

  sdiItemId             String    @db.Uuid                             @map("sdi_item_id")
  sdiItemUnitId         String    @db.Uuid                             @map("sdi_item_unit_id")
  sdiToBaseFactor       Decimal   @default(0) @db.Decimal(15, 6)       @map("sdi_to_base_factor")
  sdiHsnCode            String?   @db.VarChar(8)                       @map("sdi_hsn_code")
  sdiTaxId              String?   @db.Uuid                             @map("sdi_tax_id")
  sdiPriceLevel         Int?                                           @map("sdi_price_level")
  sdiEanCode            String?   @db.VarChar(100)                     @map("sdi_ean_code")
  sdiSize               String?   @db.VarChar(50)                      @map("sdi_size")
  sdiSizeUom            String?   @db.VarChar(20)                      @map("sdi_size_uom")

  // ── Stock identity ───────────────────────────────────────────────────
  sdiGodownId           String    @db.Uuid                             @map("sdi_godown_id")
  sdiLotId              String?   @db.Uuid                             @map("sdi_lot_id")
  /// SALEABLE | DAMAGED | QUARANTINE | EXPIRED | SAMPLE
  sdiBucket             String    @default("SALEABLE") @db.VarChar(20) @map("sdi_bucket")
  sdiBatchNo            String?   @db.VarChar(100)                     @map("sdi_batch_no")
  sdiBatchDate          DateTime? @db.Date                             @map("sdi_batch_date")
  sdiExpiryDate         DateTime? @db.Date                             @map("sdi_expiry_date")
  sdiSerialNo           String?   @db.VarChar(100)                     @map("sdi_serial_no")

  sdiIsFree             Boolean   @default(false)                      @map("sdi_is_free")
  sdiFreeType           String?   @db.VarChar(20)                      @map("sdi_free_type")
  sdiIsService          Boolean   @default(false)                      @map("sdi_is_service")

  sdiCaseQty            Decimal   @default(0) @db.Decimal(15, 3)       @map("sdi_case_qty")
  sdiDcQty              Decimal   @default(0) @db.Decimal(15, 3)       @map("sdi_dc_qty")
  sdiFreeQty            Decimal   @default(0) @db.Decimal(15, 3)       @map("sdi_free_qty")
  sdiNetQty             Decimal   @default(0) @db.Decimal(15, 3)       @map("sdi_net_qty")
  sdiWeightQty          Decimal?  @default(0) @db.Decimal(15, 3)       @map("sdi_weight_qty")

  // ── Fulfilment, line level ───────────────────────────────────────────
  sdiBilledQty          Decimal   @default(0) @db.Decimal(15, 3)       @map("sdi_billed_qty")
  sdiReturnedQty        Decimal   @default(0) @db.Decimal(15, 3)       @map("sdi_returned_qty")
  /// GENERATED ALWAYS ... STORED: dcQty - billedQty - returnedQty. Read-only —
  /// never send it on a create or update.
  ///
  /// Allowed to go NEGATIVE. The challan's own quantities may be guarded, but
  /// billed and returned are written by other documents — a bill and a DC
  /// return, either of which may have been raised offline — so an over-draw
  /// is RECORDED (ix_sdi_overdrawn) rather than refused, because refusing it
  /// would abort a sync batch for goods that already moved.
  sdiOpenQty            Decimal?  @default(dbgenerated()) @db.Decimal(15, 3) @map("sdi_open_qty")
  /// OPEN | PARTIAL | BILLED | RETURNED | CLOSED
  sdiLineStatus         String    @default("OPEN") @db.VarChar(20)     @map("sdi_line_status")

  // ── Prices (e-way bill + print; the bill may re-price, with a warning) ─
  sdiRate               Decimal   @default(0) @db.Decimal(15, 4)       @map("sdi_rate")
  sdiRatePreTax         Decimal   @default(0) @db.Decimal(15, 4)       @map("sdi_rate_pre_tax")
  sdiMaxPrice           Decimal?  @db.Decimal(15, 4)                   @map("sdi_max_price")
  /// Resolved lot cost at post: the COGS rate.
  sdiCostPrice          Decimal?  @db.Decimal(15, 4)                   @map("sdi_cost_price")
  sdiIsTaxIncl          Boolean   @default(false)                      @map("sdi_is_tax_incl")
  sdiDiscPerc           Decimal   @default(0) @db.Decimal(15, 4)       @map("sdi_disc_perc")
  sdiDiscAmt            Decimal   @default(0) @db.Decimal(15, 2)       @map("sdi_disc_amt")
  sdiGrossAmt           Decimal   @default(0) @db.Decimal(15, 2)       @map("sdi_gross_amt")
  sdiTaxableAmt         Decimal   @default(0) @db.Decimal(15, 2)       @map("sdi_taxable_amt")
  sdiTaxPerc            Decimal   @default(0) @db.Decimal(15, 4)       @map("sdi_tax_perc")
  sdiCgstPerc           Decimal   @default(0) @db.Decimal(15, 4)       @map("sdi_cgst_perc")
  sdiCgstAmt            Decimal   @default(0) @db.Decimal(15, 2)       @map("sdi_cgst_amt")
  sdiSgstPerc           Decimal   @default(0) @db.Decimal(15, 4)       @map("sdi_sgst_perc")
  sdiSgstAmt            Decimal   @default(0) @db.Decimal(15, 2)       @map("sdi_sgst_amt")
  sdiIgstPerc           Decimal   @default(0) @db.Decimal(15, 4)       @map("sdi_igst_perc")
  sdiIgstAmt            Decimal   @default(0) @db.Decimal(15, 2)       @map("sdi_igst_amt")
  sdiCessPerc           Decimal   @default(0) @db.Decimal(15, 4)       @map("sdi_cess_perc")
  sdiCessAmt            Decimal   @default(0) @db.Decimal(15, 2)       @map("sdi_cess_amt")
  sdiTaxAmt             Decimal   @default(0) @db.Decimal(15, 2)       @map("sdi_tax_amt")
  sdiNetAmt             Decimal   @default(0) @db.Decimal(15, 2)       @map("sdi_net_amt")

  // ── Pricing: the essentials of SaleBillItem, same name/type/default, so
  //    the bill line inherits them ────────────────────────────────────────
  sdiIsPromo            Boolean   @default(false)                      @map("sdi_is_promo")
  sdiActPrice           Decimal?  @db.Decimal(15, 4)                   @map("sdi_act_price")
  sdiMinPrice           Decimal?  @db.Decimal(15, 4)                   @map("sdi_min_price")
  sdiItemDiscPerc       Decimal   @default(0) @db.Decimal(15, 4)       @map("sdi_item_disc_perc")
  sdiItemDiscAmt        Decimal   @default(0) @db.Decimal(15, 2)       @map("sdi_item_disc_amt")
  sdiSplDiscPerc        Decimal   @default(0) @db.Decimal(15, 4)       @map("sdi_spl_disc_perc")
  sdiSplDiscAmt         Decimal   @default(0) @db.Decimal(15, 2)       @map("sdi_spl_disc_amt")
  sdiSchDiscPerc        Decimal   @default(0) @db.Decimal(15, 4)       @map("sdi_sch_disc_perc")
  sdiSchDiscAmt         Decimal   @default(0) @db.Decimal(15, 2)       @map("sdi_sch_disc_amt")
  sdiChrgBeforeTax      Decimal?  @db.Decimal(14, 4)                   @map("sdi_chrg_before_tax")
  sdiChrgAfterTax       Decimal?  @db.Decimal(14, 4)                   @map("sdi_chrg_after_tax")
  sdiCessPerUnit        Decimal   @default(0) @db.Decimal(15, 4)       @map("sdi_cess_per_unit")
  sdiSalesmanId         String?   @db.Uuid                             @map("sdi_salesman_id")
  sdiSchemeId           String?   @db.Uuid                             @map("sdi_scheme_id")
  sdiSchemeName         String?   @db.VarChar(150)                     @map("sdi_scheme_name")

  sdiRemarks            String?   @db.VarChar(250)                     @map("sdi_remarks")

  sdiIsDeleted          Boolean   @default(false)                      @map("sdi_is_deleted")
  sdiSyncDate           DateTime? @db.Timestamptz(6)                   @map("sdi_sync_date")
  sdiCreatedOn          DateTime  @default(now()) @db.Timestamptz(6)   @map("sdi_created_on")
  sdiCreatedBy          String    @db.VarChar(50)                      @map("sdi_created_by")
  sdiModifiedOn         DateTime? @db.Timestamptz(6)                   @map("sdi_modified_on")
  sdiModifiedBy         String?   @db.VarChar(50)                      @map("sdi_modified_by")

  // Relations
  dc                    SaleDc             @relation("SaleDcItems",    fields: [sdiDcId, sdiAccYear], references: [sdcId, sdcAccYear], onUpdate: Cascade, onDelete: Restrict, map: "fk_sdi_dc")
  item                  ItemMaster         @relation("SaleDcItemItem", fields: [sdiItemId],     references: [itemId], onUpdate: Cascade, onDelete: Restrict, map: "fk_sdi_item")
  unit                  ItemUnitConversion @relation("SaleDcItemUnit", fields: [sdiItemUnitId], references: [iucId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_sdi_item_unit")
  godown                GodownLocation     @relation("SaleDcItemGodown", fields: [sdiGodownId], references: [gdlId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_sdi_godown")
  lot                   StockLot?          @relation("SaleDcItemLot",  fields: [sdiLotId],      references: [sltId],  onUpdate: Cascade, onDelete: Restrict, map: "fk_sdi_lot")

  dcReturnItems         SaleDcReturnItem[] @relation("SaleDcReturnItemDcItem")

  @@id([sdiId, sdiAccYear], map: "pk_sale_dc_item")

  // Partial indexes are DB-only:
  //   ix_sdi_dc, ix_sdi_src_item
  //   ix_sdi_open      -- the billing screen's own read: challan lines with
  //                       something still open, index-only
  //   ix_sdi_overdrawn -- the reconciliation report, and what the dropped
  //                       clause of ck_sdi_qty became
  //   FK-covering: ix_sdi_item, ix_sdi_item_unit, ix_sdi_godown, ix_sdi_lot
  //
  // CHECK constraints (DB-only): ck_sdi_split_no, ck_sdi_qty, ck_sdi_bucket,
  //   ck_sdi_line_status

  @@map("sale_dc_item")
  @@schema("sales")
}

// ----- prisma/sales/saleDcReturn.prisma -----
/// Un-billed goods coming back off a challan.
///
/// Only the DC's OPEN quantity (sdiOpenQty) may return here; BILLED goods come
/// back through a SaleReturn. Posting writes DC_RETURN stock rows, reverses
/// COGS at the DC line's cost, writes an INWARD challan register row and an
/// e-way bill when the goods travel by a transporter.
///
/// NO party leg — nothing was ever owed, so there is nothing to credit.
///
/// ONE challan per DC return, which is why sdrDcId is a plain NOT NULL pair
/// rather than a per-line reference.
model SaleDcReturn {
  sdrId                 String    @default(dbgenerated("uuidv7()")) @db.Uuid @map("sdr_id")
  sdrCompanyId          String    @db.Uuid                             @map("sdr_company_id")
  sdrBranchId           String    @db.Uuid                             @map("sdr_branch_id")
  sdrTenantId           String?   @db.Uuid                             @map("sdr_tenant_id")
  sdrAccYear            String    @db.Char(9)                          @map("sdr_acc_year")

  sdrSessionId          String?   @db.Uuid                             @map("sdr_session_id")
  sdrCounterId          String    @db.Uuid                             @map("sdr_counter_id")
  sdrDeviceType         String?   @db.VarChar(20)                      @map("sdr_device_type")
  sdrDeviceId           String?                                        @map("sdr_device_id")

  sdrDocType            String    @default("DC_RETURN") @db.VarChar(30) @map("sdr_doc_type")
  sdrReturnSlno         BigInt                                         @map("sdr_return_slno")
  sdrReturnRefno        String    @db.VarChar(100)                     @map("sdr_return_refno")
  sdrUsrRefno           String?   @db.VarChar(100)                     @map("sdr_usr_refno")
  sdrUsrRefdate         DateTime? @db.Date                             @map("sdr_usr_refdate")
  sdrReturnDate         DateTime  @db.Date                             @map("sdr_return_date")
  sdrReturnDatetime     DateTime  @default(now()) @db.Timestamptz(6)   @map("sdr_return_datetime")

  // ── The challan it reverses ──────────────────────────────────────────
  sdrDcId               String    @db.Uuid                             @map("sdr_dc_id")
  sdrDcAccYear          String    @db.Char(9)                          @map("sdr_dc_acc_year")
  sdrDcRefno            String?   @db.VarChar(100)                     @map("sdr_dc_refno")
  sdrDcDate             DateTime? @db.Date                             @map("sdr_dc_date")
  sdrReasonId           String?   @db.Uuid                             @map("sdr_reason_id")
  sdrReturnReason       String?   @db.VarChar(250)                     @map("sdr_return_reason")

  sdrCustId             String    @db.Uuid                             @map("sdr_cust_id")
  sdrCustName           String    @db.VarChar(200)                     @map("sdr_cust_name")
  sdrCustGstin          String?   @db.VarChar(15)                      @map("sdr_cust_gstin")
  sdrCustStcd           String?   @db.Char(2)                          @map("sdr_cust_stcd")
  sdrPosStcd            String?   @db.Char(2)                          @map("sdr_pos_stcd")

  // ── Delivery crew and vehicle — OURS, on the document on purpose ─────
  sdrDriverId           String?   @db.Uuid                             @map("sdr_driver_id")
  sdrSupervisorId       String?   @db.Uuid                             @map("sdr_supervisor_id")
  sdrLoadmanId          String[]  @db.Uuid                             @map("sdr_loadman_id")
  sdrVehicleId          String?   @db.Uuid                             @map("sdr_vehicle_id")
  sdrVehicleNo          String?   @db.VarChar(20)                      @map("sdr_vehicle_no")

  sdrUserId             String    @db.Uuid                             @map("sdr_user_id")
  /// The challan this reverses carries sdcSalesmanId, so the return of it
  /// carries the same team — otherwise a delivery and its reversal cannot be
  /// put side by side in any salesman report. uuid[], no FK on elements.
  sdrSalesmanId         String[]  @db.Uuid                             @map("sdr_salesman_id")

  sdrTotItems           Int       @default(0)                          @map("sdr_tot_items")
  sdrTotWeight          Decimal   @default(0) @db.Decimal(15, 3)       @map("sdr_tot_weight")
  sdrGrossAmt           Decimal   @default(0) @db.Decimal(15, 2)       @map("sdr_gross_amt")
  sdrTaxableAmt         Decimal   @default(0) @db.Decimal(15, 2)       @map("sdr_taxable_amt")
  sdrTaxAmt             Decimal   @default(0) @db.Decimal(15, 2)       @map("sdr_tax_amt")
  sdrReturnAmt          Decimal   @default(0) @db.Decimal(15, 2)       @map("sdr_return_amt")
  /// The COGS reversed.
  sdrTotalCost          Decimal   @default(0) @db.Decimal(15, 2)       @map("sdr_total_cost")

  sdrRemarks            String?   @db.VarChar(500)                     @map("sdr_remarks")

  /// DRAFT | POSTED | CANCELLED. Transitions live in TxnStatusLog.
  sdrStatus             String    @default("DRAFT") @db.VarChar(20)    @map("sdr_status")
  /// No FK: SERVER-owned, written after an offline counter created this row.
  sdrPostedVoucherId    String?   @db.Uuid                             @map("sdr_posted_voucher_id")
  sdrPrintCount         Int       @default(0)                          @map("sdr_print_count")

  sdrIsDeleted          Boolean   @default(false)                      @map("sdr_is_deleted")
  sdrSyncDate           DateTime? @db.Timestamptz(6)                   @map("sdr_sync_date")
  sdrCreatedOn          DateTime  @default(now()) @db.Timestamptz(6)   @map("sdr_created_on")
  sdrCreatedBy          String    @db.VarChar(50)                      @map("sdr_created_by")
  sdrModifiedOn         DateTime? @db.Timestamptz(6)                   @map("sdr_modified_on")
  sdrModifiedBy         String?   @db.VarChar(50)                      @map("sdr_modified_by")

  // Relations
  dc                    SaleDc             @relation("SaleDcReturnDc",         fields: [sdrDcId, sdrDcAccYear], references: [sdcId, sdcAccYear], onUpdate: Cascade, onDelete: Restrict, map: "fk_sdr_dc")
  customer              Customer           @relation("SaleDcReturnCustomer",   fields: [sdrCustId],       references: [cusId], onUpdate: Cascade, onDelete: Restrict, map: "fk_sdr_cust")
  reason                StockReasonMaster? @relation("SaleDcReturnReason",     fields: [sdrReasonId],     references: [srmId], onUpdate: Cascade, onDelete: Restrict, map: "fk_sdr_reason")
  driver                EmployeeMaster?    @relation("SaleDcReturnDriver",     fields: [sdrDriverId],     references: [empId], onUpdate: Cascade, onDelete: Restrict, map: "fk_sdr_driver")
  supervisor            EmployeeMaster?    @relation("SaleDcReturnSupervisor", fields: [sdrSupervisorId], references: [empId], onUpdate: Cascade, onDelete: Restrict, map: "fk_sdr_supervisor")
  vehicle               VehicleMaster?     @relation("SaleDcReturnVehicle",    fields: [sdrVehicleId],    references: [vehId], onUpdate: Cascade, onDelete: Restrict, map: "fk_sdr_vehicle")

  items                 SaleDcReturnItem[] @relation("SaleDcReturnItems")

  @@id([sdrId, sdrAccYear], map: "pk_sale_dc_return")

  @@unique([sdrCompanyId, sdrBranchId, sdrAccYear, sdrReturnRefno], map: "ux_sdr_refno")

  // Partial indexes are DB-only: ix_sdr_dc, ix_sdr_company_branch_date, and
  // FK-covering ix_sdr_cust / ix_sdr_reason / ix_sdr_driver /
  // ix_sdr_supervisor / ix_sdr_vehicle.
  //
  // CHECK constraints (DB-only): ck_sdr_doc_type, ck_sdr_status

  @@map("sale_dc_return")
  @@schema("sales")
}

// ----- prisma/sales/saleDcReturnItem.prisma -----
/// A DC-return line. The DC line is MANDATORY — a DC return is never free, so
/// unlike SaleReturnItem there is no nullable source.
///
/// The lot goes back where it came from, which is why sdriLotId is the DC
/// line's lot rather than a fresh one.
///
/// The money columns are the DC line's figures, carried for the INWARD e-way
/// bill: goods coming back still have a value the portal wants.
model SaleDcReturnItem {
  sdriId                String    @default(dbgenerated("uuidv7()")) @db.Uuid @map("sdri_id")
  sdriReturnId          String    @db.Uuid                             @map("sdri_return_id")
  sdriCompanyId         String    @db.Uuid                             @map("sdri_company_id")
  sdriBranchId          String    @db.Uuid                             @map("sdri_branch_id")
  sdriTenantId          String?   @db.Uuid                             @map("sdri_tenant_id")
  sdriAccYear           String    @db.Char(9)                          @map("sdri_acc_year")
  sdriLineNo            Int                                            @map("sdri_line_no")

  // ── The DC line (mandatory) ──────────────────────────────────────────
  sdriDcItemId          String    @db.Uuid                             @map("sdri_dc_item_id")
  sdriDcAccYear         String    @db.Char(9)                          @map("sdri_dc_acc_year")
  sdriDcLineNo          Int?                                           @map("sdri_dc_line_no")

  sdriItemId            String    @db.Uuid                             @map("sdri_item_id")
  /// item_unit_conversion, matching the DC line it reverses.
  sdriItemUnitId        String    @db.Uuid                             @map("sdri_item_unit_id")
  sdriToBaseFactor      Decimal   @default(0) @db.Decimal(15, 6)       @map("sdri_to_base_factor")
  sdriHsnCode           String?   @db.VarChar(8)                       @map("sdri_hsn_code")

  sdriGodownId          String    @db.Uuid                             @map("sdri_godown_id")
  /// The DC line's lot: it goes back where it came from.
  sdriLotId             String?   @db.Uuid                             @map("sdri_lot_id")
  /// RESTOCK | DAMAGED | EXPIRED | SCRAP
  sdriCondition         String    @default("RESTOCK") @db.VarChar(20)  @map("sdri_condition")
  /// SALEABLE | DAMAGED | QUARANTINE | EXPIRED | SAMPLE
  sdriBucket            String    @default("SALEABLE") @db.VarChar(20) @map("sdri_bucket")
  sdriBatchNo           String?   @db.VarChar(100)                     @map("sdri_batch_no")
  sdriExpiryDate        DateTime? @db.Date                             @map("sdri_expiry_date")
  sdriSerialNo          String?   @db.VarChar(100)                     @map("sdri_serial_no")

  sdriReturnQty         Decimal   @default(0) @db.Decimal(15, 3)       @map("sdri_return_qty")
  sdriFreeQty           Decimal   @default(0) @db.Decimal(15, 3)       @map("sdri_free_qty")
  sdriNetQty            Decimal   @default(0) @db.Decimal(15, 3)       @map("sdri_net_qty")
  sdriWeightQty         Decimal?  @default(0) @db.Decimal(15, 3)       @map("sdri_weight_qty")

  sdriRate              Decimal   @default(0) @db.Decimal(15, 4)       @map("sdri_rate")
  /// The DC line's cost: what COGS reverses at.
  sdriCostPrice         Decimal?  @db.Decimal(15, 4)                   @map("sdri_cost_price")
  sdriTaxableAmt        Decimal   @default(0) @db.Decimal(15, 2)       @map("sdri_taxable_amt")
  sdriTaxPerc           Decimal   @default(0) @db.Decimal(15, 4)       @map("sdri_tax_perc")
  sdriTaxAmt            Decimal   @default(0) @db.Decimal(15, 2)       @map("sdri_tax_amt")
  sdriNetAmt            Decimal   @default(0) @db.Decimal(15, 2)       @map("sdri_net_amt")

  // ── Value of the goods coming back (inward e-way bill) ───────────────
  sdriPriceLevel        Int                                            @map("sdri_price_level")
  sdriEanCode           String?   @db.VarChar(100)                     @map("sdri_ean_code")
  sdriIsTaxIncl         Boolean   @default(false)                      @map("sdri_is_tax_incl")
  sdriIsService         Boolean   @default(false)                      @map("sdri_is_service")
  sdriRatePreTax        Decimal   @default(0) @db.Decimal(15, 4)       @map("sdri_rate_pre_tax")
  sdriMaxPrice          Decimal?  @db.Decimal(15, 4)                   @map("sdri_max_price")
  sdriItemDiscPerc      Decimal   @default(0) @db.Decimal(15, 4)       @map("sdri_item_disc_perc")
  sdriItemDiscAmt       Decimal   @default(0) @db.Decimal(15, 2)       @map("sdri_item_disc_amt")
  sdriSchDiscAmt        Decimal   @default(0) @db.Decimal(15, 2)       @map("sdri_sch_disc_amt")
  sdriGrossAmt          Decimal   @default(0) @db.Decimal(15, 2)       @map("sdri_gross_amt")
  sdriCgstPerc          Decimal   @default(0) @db.Decimal(15, 4)       @map("sdri_cgst_perc")
  sdriCgstAmt           Decimal   @default(0) @db.Decimal(15, 2)       @map("sdri_cgst_amt")
  sdriSgstPerc          Decimal   @default(0) @db.Decimal(15, 4)       @map("sdri_sgst_perc")
  sdriSgstAmt           Decimal   @default(0) @db.Decimal(15, 2)       @map("sdri_sgst_amt")
  sdriIgstPerc          Decimal   @default(0) @db.Decimal(15, 4)       @map("sdri_igst_perc")
  sdriIgstAmt           Decimal   @default(0) @db.Decimal(15, 2)       @map("sdri_igst_amt")
  sdriCessPerc          Decimal   @default(0) @db.Decimal(15, 4)       @map("sdri_cess_perc")
  sdriCessPerUnit       Decimal   @default(0) @db.Decimal(15, 4)       @map("sdri_cess_per_unit")
  sdriCessAmt           Decimal   @default(0) @db.Decimal(15, 2)       @map("sdri_cess_amt")
  sdriSize              String?   @db.VarChar(50)                      @map("sdri_size")
  sdriSizeUom           String?   @db.VarChar(20)                      @map("sdri_size_uom")
  sdriTaxId             String?   @db.Uuid                             @map("sdri_tax_id")

  sdriRemarks           String?   @db.VarChar(250)                     @map("sdri_remarks")

  sdriIsDeleted         Boolean   @default(false)                      @map("sdri_is_deleted")
  sdriSyncDate          DateTime? @db.Timestamptz(6)                   @map("sdri_sync_date")
  sdriCreatedOn         DateTime  @default(now()) @db.Timestamptz(6)   @map("sdri_created_on")
  sdriCreatedBy         String    @db.VarChar(50)                      @map("sdri_created_by")
  sdriModifiedOn        DateTime? @db.Timestamptz(6)                   @map("sdri_modified_on")
  sdriModifiedBy        String?   @db.VarChar(50)                      @map("sdri_modified_by")

  // Relations
  dcReturn              SaleDcReturn       @relation("SaleDcReturnItems",       fields: [sdriReturnId, sdriAccYear], references: [sdrId, sdrAccYear], onUpdate: Cascade, onDelete: Restrict, map: "fk_sdri_return")
