  // ── Loyalty points engine (20260921140000) ─────────────────────────────
  loyaltyGiftItems      LoyaltyGiftRedeemItem[]   @relation("LoyaltyGiftItemGodown")

  // ── Sales documents (20260921200000) ────────────────────────────────────
