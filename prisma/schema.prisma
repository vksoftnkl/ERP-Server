  ulsAppVersion String? @map("uls_app_version") @db.VarChar(40)

  // =========================================================
  // 5) Derived / Status
  // =========================================================
  ulsIsActiveSession Boolean @default(true) @map("uls_is_active_session")
  ulsIsActive        Boolean @default(true) @map("uls_is_active")
  ulsIsDeleted       Boolean @default(false) @map("uls_is_deleted")

  // =========================================================
  // 6) Audit / Sync
  // =========================================================
  ulsSyncDate   DateTime? @map("uls_sync_date") @db.Timestamptz(6)
  ulsCreatedOn  DateTime  @default(now()) @map("uls_created_on") @db.Timestamptz(6)
  ulsCreatedBy  String?   @map("uls_created_by") @db.VarChar(100)
  ulsModifiedOn DateTime  @default(now()) @map("uls_modified_on") @db.Timestamptz(6)
  ulsModifiedBy String?   @map("uls_modified_by") @db.VarChar(100)

  // =========================================================
  // 7) Relations
  // =========================================================
  company Company? @relation(fields: [ulsCompanyId], references: [compId], onUpdate: Cascade, onDelete: Restrict)

  // =========================================================
  // 8) Indexes (partial)
  // =========================================================

  // CREATE INDEX idx_uls_active_session
  // ON (uls_company_id, uls_user_id, uls_login_on DESC)
  // WHERE uls_is_deleted = false AND uls_is_active_session = true;
  @@index([ulsCompanyId, ulsUserId, ulsLoginOn(sort: Desc)], map: "idx_uls_active_session")
  // CREATE INDEX idx_uls_device_date
  // ON (uls_device_id, uls_login_on DESC)
  // WHERE uls_is_deleted = false;
  @@index([ulsDeviceId, ulsLoginOn(sort: Desc)], map: "idx_uls_device_date")
  @@map("user_login_sessions")
  @@schema("audit")
}

