 // @@index([gdlBranchId], map: "idx_gdl_branch")
  @@index([gdlParentId], map: "idx_gdl_parent")
  @@index([gdlBranchId, gdlParentId, gdlSort], map: "idx_gdl_sort")
  // This is the UNIQUE constraint you defined
  @@unique([gdlBranchId, gdlParentId, gdlName], map: "uq_gdl_unique_name_per_parent")
