  stmCreatedBy   String?   @map("stm_created_by") @db.VarChar(100)
  stmModifiedOn  DateTime  @default(now()) @map("stm_modified_on") @db.Timestamptz
  stmModifiedBy  String?   @map("stm_modified_by") @db.VarChar(100)

