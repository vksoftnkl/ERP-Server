  ledCompanyId             String?   @db.Uuid                                        @map("led_company_id")
  ledBranchId              String?   @db.Uuid                                        @map("led_branch_id")
  ledGroupId               String    @db.Uuid                                        @map("led_group_id")
  // 1) Identity / Reference
  ledName                  String    @db.VarChar(200)                                 @map("led_name")
  ledAlias                 String?   @db.VarChar(100)                                 @map("led_alias")
  ledShort                 String?   @db.VarChar(50)                                  @map("led_short")
  ledTallyName             String?   @db.VarChar(200)                                 @map("led_tally_name")
  ledTallyGroupName        String?   @db.VarChar(150)                                 @map("led_tally_group_name")
  ledTallyGuid             String?   @db.VarChar(64)                                  @map("led_tally_guid")
  ledTallyMasterId         BigInt?   @db.BigInt                                       @map("led_tally_master_id")
  ledTallyAlterId          BigInt?   @db.BigInt                                       @map("led_tally_alter_id")
  // 2) Ledger category / behaviour
  ledCategory              String    @default("GENERAL") @db.VarChar(30)              @map("led_category")
  ledLedgerType            String?   @db.VarChar(20)                                  @map("led_ledger_type")
  ledMailingName           String?   @db.VarChar(200)                                 @map("led_mailing_name")
  ledIsBillByBill          Boolean   @default(false)                                   @map("led_is_bill_by_bill")
  ledIsCostCenterReq       Boolean   @default(false)                                   @map("led_is_cost_center_req")
  ledIsInterestApplicable  Boolean   @default(false)                                   @map("led_is_interest_applicable")
  ledInterestRate          Decimal?  @db.Decimal                                       @map("led_interest_rate")
  // 3) Contact
  ledContactPerson         String?   @db.VarChar(150)                                 @map("led_contact_person")
  ledEmail                 String?   @db.VarChar(150)                                 @map("led_email")
  ledTel                   String?   @db.VarChar(20)                                  @map("led_tel")
  ledPhone1                String?   @db.VarChar(20)                                  @map("led_phone1")
  ledPhone2                String?   @db.VarChar(20)                                  @map("led_phone2")
  ledWhatsappNo            String?   @db.VarChar(20)                                  @map("led_whatsapp_no")
  // 4) Address (Mailing)
  ledAddr1                 String?   @db.VarChar(200)                                 @map("led_addr1")
  ledAddr2                 String?   @db.VarChar(200)                                 @map("led_addr2")
  ledAddr3                 String?   @db.VarChar(200)                                 @map("led_addr3")
  ledCity                  String?   @db.VarChar(100)                                 @map("led_city")
  ledDistrict              String?   @db.VarChar(100)                                 @map("led_district")
  ledStateName             String?   @db.VarChar(100)                                 @map("led_state_name")
  ledStateCode             String?   @db.Char(2)                                      @map("led_state_code")
  ledPin                   String?   @db.VarChar(10)                                  @map("led_pin")
  ledCountry               String?   @default("India") @db.VarChar(60)                @map("led_country")
  // 5) Regional (Mailing)
  ledRegionName            String?   @db.Text                                          @map("led_region_name")
  ledRegionAddr1           String?   @db.VarChar(200)                                 @map("led_region_addr1")
  ledRegionAddr2           String?   @db.VarChar(200)                                 @map("led_region_addr2")
  ledRegionAddr3           String?   @db.VarChar(200)                                 @map("led_region_addr3")
  ledRegionCity            String?   @db.VarChar(100)                                 @map("led_region_city")
  ledRegionDistrict        String?   @db.VarChar(100)                                 @map("led_region_district")
  ledRegionStateName       String?   @db.VarChar(100)                                 @map("led_region_state_name")
  ledRegionCountry         String?   @default("India") @db.VarChar(60)                @map("led_region_country")
  // 6) GST / Statutory
  // Allowed values (REGULAR/COMPOSITION/UNREGISTERED) validated in the app layer
  // (accountLedgerMasters LedGstPartyRegType enum), not a DB enum type.
  ledGstPartyRegType       String?   @db.VarChar(20)                                  @map("led_gst_party_reg_type")
  ledGstinNo               String?   @db.VarChar(15)                                  @map("led_gstin_no")
  ledPanNo                 String?   @db.VarChar(10)                                  @map("led_pan_no")
  ledAadharNo              String?   @db.VarChar(20)                                  @map("led_aadhar_no")
  ledEcommerceGstin        String?   @db.VarChar(15)                                  @map("led_ecommerce_gstin")
  ledIsSez                 Boolean   @default(false)                                   @map("led_is_sez")
  ledTypeOfSupply          String?   @db.VarChar(10)                                  @map("led_type_of_supply")
  ledHsnSac                String?   @db.VarChar(10)                                  @map("led_hsn_sac")
  ledGstRate               Decimal?  @db.Decimal                                       @map("led_gst_rate")
  ledTaxability            String?   @db.VarChar(15)                                  @map("led_taxability")
  ledGstPartyType          String?   @db.VarChar(30)                                  @map("led_gst_party_type")
  ledTanNo                 String?   @db.VarChar(10)                                  @map("led_tan_no")
  ledCin                   String?   @db.VarChar(21)                                  @map("led_cin")
  ledUdyamNo               String?   @db.VarChar(25)                                  @map("led_udyam_no")
  ledMsmeType              String?   @db.VarChar(10)                                  @map("led_msme_type")
  // 7) Tax / duty ledger (CGST/SGST/IGST/Cess + round-off)
  ledGstDutyHead           String?   @db.VarChar(20)                                  @map("led_gst_duty_head")
  ledTaxRate               Decimal?  @db.Decimal                                       @map("led_tax_rate")
  ledRoundingMethod        String?   @db.VarChar(15)                                  @map("led_rounding_method")
  ledRoundingLimit         Decimal?  @db.Decimal                                       @map("led_rounding_limit")
  // 8) TDS / TCS
  ledIsTdsApplicable       Boolean   @default(false)                                   @map("led_is_tds_applicable")
  ledTdsDeducteeType       String?   @db.VarChar(40)                                  @map("led_tds_deductee_type")
  ledTdsNatureOfPayment    String?   @db.VarChar(80)                                  @map("led_tds_nature_of_payment")
  ledIsTcsApplicable       Boolean   @default(false)                                   @map("led_is_tcs_applicable")
  // 9) Opening / Running Balance
  ledObAmount              Decimal   @default(0) @db.Decimal                          @map("led_ob_amount")
  // Allowed values (DR/CR) validated in the app layer (accountLedgerMasters
  // LedObType enum), not a DB enum type.
  ledObType                String    @default("DR") @db.VarChar(2)                     @map("led_ob_type")
  ledObAsOn                DateTime? @db.Date                                          @map("led_ob_as_on")
  ledTotalDr               Decimal   @default(0) @db.Decimal                          @map("led_total_dr")
  ledTotalCr               Decimal   @default(0) @db.Decimal                          @map("led_total_cr")
  ledTotalBalance          Decimal   @default(0) @db.Decimal                          @map("led_total_balance")
  // 10) Status / Notes / Display
  ledSortOrder             Int?      @db.Integer                                       @map("led_sort_order")
  ledIsActive              Boolean   @default(true)                                    @map("led_is_active")
  ledIsDeleted             Boolean   @default(false)                                   @map("led_is_deleted")
  ledAllowEdit             Boolean   @default(false)                                   @map("led_allow_edit")
  ledIsEntry               Boolean   @default(false)                                   @map("led_is_entry")
  ledAllowSms              Boolean   @default(false)                                   @map("led_allow_sms")
  ledRemarks               String?   @db.VarChar(250)                                 @map("led_remarks")
  // 11) Audit / Sync
  ledSyncDate              DateTime? @db.Timestamptz                                  @map("led_sync_date")
  ledCreatedOn             DateTime  @default(now()) @db.Timestamptz                  @map("led_created_on")
  ledCreatedBy             String?   @db.VarChar(100)                                 @map("led_created_by")
  ledModifiedOn            DateTime  @default(now()) @db.Timestamptz                  @map("led_modified_on")
  ledModifiedBy            String?   @db.VarChar(100)                                 @map("led_modified_by")
  // Relations
  company                  Company?               @relation(fields: [ledCompanyId], references: [compId], onUpdate: Cascade, onDelete: Restrict)
  accGroupMaster           AccGroupMaster         @relation(fields: [ledGroupId], references: [accGroupId], onUpdate: Cascade, onDelete: Restrict)
  branches                 BranchMaster?          @relation(fields: [ledBranchId], references: [brId], onUpdate: Cascade, onDelete: Restrict)
  bankAccounts             AccLedgerBankAccount[]
  shipAddrs                AccShipAddr[]
  tenderLedgers            AccTenderMaster[]      @relation("TenderLedger")
  tenderSettlementLedgers  AccTenderMaster[]      @relation("TenderSettlementLedger")
  tenderSurchargeLedgers   AccTenderMaster[]      @relation("TenderSurchargeLedger")
  tenderDetailLedgers      AccTenderDetail[]      @relation("TenderDetailLedger")
  tenderDetailSettleLedgers AccTenderDetail[]     @relation("TenderDetailSettleLedger")
  tenderDetailPartyLedgers AccTenderDetail[]      @relation("TenderDetailPartyLedger")
  tenderDetailSurchargeLedgers AccTenderDetail[]  @relation("TenderDetailSurchargeLedger")
  voucherDocRegisterParties AccVoucherDocRegister[]
  voucherHeaderParties     AccVoucherHeader[]     @relation("VoucherHeaderParty")
  voucherHeaderOppLedgers  AccVoucherHeader[]     @relation("VoucherHeaderOppLedger")
  accountingEntries        AccVoucher[]           @relation("AccVoucherLedger")
  oppositeAccountingEntries AccVoucher[]          @relation("AccVoucherOppLedger")
  billParties              AccBillBalance[]       @relation("BillParty")
  billAdjustmentParties    AccBillAdjustment[]    @relation("BillAdjustmentParty")
  billAdjustmentSettleLedgers AccBillAdjustment[] @relation("BillAdjustmentSettleLedger")
  pdcParties               AccPdcRegister[]       @relation("PdcParty")
  pdcBankLedgers           AccPdcRegister[]       @relation("PdcBankLedger")
  chargeMasters            ChargeMaster[]
  chargeDetails            TransactionChargeDetail[]
  saleOrderAdvanceLedgers  SaleOrder[]              @relation("SaleOrderAdvanceLedger")
  @@unique([ledCompanyId, ledName], name: "uq_led_name_per_company")
  @@unique([ledCompanyId, ledTallyName], name: "uq_led_tally_name_per_company")
  @@index([ledCompanyId], name: "idx_led_company_id")
  @@index([ledBranchId], name: "idx_led_branch_id")
  @@index([ledGroupId], name: "idx_led_group_id")
  @@index([ledIsActive], name: "idx_led_active")
  @@index([ledGstinNo], name: "idx_led_gstin")
  @@index([ledLedgerType], name: "idx_led_ledger_type")
  // Partial unique indexes — enforced via raw SQL migration, not expressible in Prisma schema:
  //   uq_led_tally_guid       UNIQUE (led_tally_guid)                       WHERE led_tally_guid IS NOT NULL
  //   uq_led_tally_master_id  UNIQUE (led_company_id, led_tally_master_id)  WHERE led_tally_master_id IS NOT NULL
  @@map("acc_ledger_master")
  @@schema("accounts")
}

// ----- prisma/accounts/AccountOpeningBalance.prisma -----
/// Opening balance per ledger per financial year. Balance-sheet ledgers
/// only; P&L ledgers always start at zero. Partitioned by opAccYear, so the
/// primary key is the composite (opId, opAccYear).
model AccOpeningBalance {
  opId            String    @default(dbgenerated("uuidv7()")) @db.Uuid @map("op_id")
  opCompanyId     String    @db.Uuid @map("op_company_id")
  // NULL = company level
  opBranchId      String?   @db.Uuid @map("op_branch_id")
  // FY label in YYYY-YYYY form, matching fiscal_years.fy_code. The partition
  // key.
  opAccYear       String    @db.Char(9) @map("op_acc_year")
  opLedgerId      String    @db.Uuid @map("op_ledger_id")

  opAmount        Decimal   @default(0) @db.Decimal(18, 2) @map("op_amount")
  // ck_op_dr_cr: D | C
  opDrCr          String    @db.Char(1) @map("op_dr_cr")

  // ck_op_source: CARRY_FORWARD | MANUAL | MIGRATION.
  // Regeneration updates CARRY_FORWARD rows only — MANUAL and MIGRATION rows
  // are owned by a human and must never be overwritten.
  opSource        String    @default("CARRY_FORWARD") @db.VarChar(20) @map("op_source")

  opIsStale       Boolean   @default(false) @map("op_is_stale")
  opStaleSince    DateTime? @db.Timestamptz(6) @map("op_stale_since")
  opGeneratedAt   DateTime? @db.Timestamptz(6) @map("op_generated_at")
  opGeneratedBy   String?   @db.VarChar(50) @map("op_generated_by")
  opRemarks       String?   @map("op_remarks")

  opIsDeleted     Boolean   @default(false) @map("op_is_deleted")
  opCreatedAt     DateTime  @default(now()) @db.Timestamptz(6) @map("op_created_at")
  opCreatedBy     String?   @db.VarChar(50) @map("op_created_by")
  opModifiedAt    DateTime? @db.Timestamptz(6) @map("op_modified_at")
  opModifiedBy    String?   @db.VarChar(50) @map("op_modified_by")

  @@id([opId, opAccYear], map: "pk_acc_opening")
  @@map("acc_opening_balance")
  @@schema("accounts")
  // DB-only objects not expressible in the Prisma schema (see migrations
  // 20260806090000_add_voucher_header_bills_pdc and
  // 20260811060000_partition_account_bill_tables_by_acc_year):
  //   - PARTITION BY LIST (op_acc_year); one partition per accounting year,
  //     created by public.ensure_acc_year_partitions('YYYY-YYYY').
  //   - Partial UNIQUE index ux_op_scope on
  //     (op_company_id, COALESCE(op_branch_id, all-zero uuid), op_acc_year,
  //     op_ledger_id) WHERE op_is_deleted = false. Branch NULL must still
  //     collide with branch NULL, hence the COALESCE — not expressible as
  //     @@unique.
  //   - Partial/covering indexes ix_op_lookup, ix_op_stale.
  //   - CHECK constraints ck_op_dr_cr, ck_op_amount, ck_op_source,
  //     ck_op_acc_year.
  //   - No FK on op_company_id / op_branch_id / op_ledger_id: the source DDL
  //     declares none.
}

// ----- prisma/accounts/AccountPdcRegister.prisma -----
/// Post-dated cheques and mandates, in both directions. Partitioned by
/// apdAccYear, the FY the instrument was received in, so the primary key is
/// the composite (apdId, apdAccYear). An instrument routinely matures, clears
/// or bounces in a later financial year than the one it was received in; it
/// stays in the partition of the year it arrived in, and the later events
/// carry their own voucher-year columns.
///
/// Two posting modes, per apdPostingMode:
///   ON_RECEIPT  — a receipt voucher is raised the day the cheque arrives,
///                 crediting the party and debiting a 'Cheques in Hand'
///                 control ledger. Bills settle immediately.
///   ON_CLEARING — nothing is posted until the bank clears it. The party
///                 stays outstanding and this register row is the only
///                 record.
///
/// Lifecycle: HELD -> DEPOSITED -> CLEARED
///                              -> BOUNCED -> (re-present or REPLACED)
///            HELD -> RETURNED / CANCELLED / REPLACED
model AccPdcRegister {
  apdId                String    @default(dbgenerated("uuidv7()")) @db.Uuid @map("apd_id")
  apdCompanyId         String    @db.Uuid @map("apd_company_id")
  // Branch that took the instrument in
  apdBranchId          String    @db.Uuid @map("apd_branch_id")
  apdTenantId          String?   @db.Uuid @map("apd_tenant_id")
  // FY it was received in, and the partition key
  apdAccYear           String    @db.Char(9) @map("apd_acc_year")
  // ck_apd_tra_type: R = receivable (a customer's cheque we hold),
  //                  P = payable (our cheque handed to a supplier)
  apdTraType           String    @db.Char(1) @map("apd_tra_type")
  apdPartyId           String    @db.Uuid @map("apd_party_id")
  apdSalesmanId        String?   @db.Uuid @map("apd_salesman_id")
  // The instrument — ck_apd_instrument:
  //   CHEQUE | DD | PAY_ORDER | ECS | NACH | UPI_MANDATE
  apdInstrumentType    String    @default("CHEQUE") @db.VarChar(20) @map("apd_instrument_type")
  apdInstrumentNo      String    @db.VarChar(30) @map("apd_instrument_no")
  // The post-date written on the cheque — the maturity date the due-list
  // works from, not the date it was received.
  apdInstrumentDate    DateTime  @db.Date @map("apd_instrument_date")
  apdAmount            Decimal   @db.Decimal(18, 2) @map("apd_amount")
  apdBankName          String?   @db.VarChar(100) @map("apd_bank_name")
  apdBankBranch        String?   @db.VarChar(100) @map("apd_bank_branch")
  apdIfsc              String?   @db.VarChar(11) @map("apd_ifsc")
  apdMicr              String?   @db.VarChar(9) @map("apd_micr")
  apdDrawerName        String?   @db.VarChar(150) @map("apd_drawer_name")
  apdReceivedOn        DateTime  @db.Date @map("apd_received_on")
  // Our own bank ledger: where it will be deposited (R) or drawn on (P)
  apdBankLedgerId      String?   @db.Uuid @map("apd_bank_ledger_id")
  // Accounting linkage — ck_apd_posting_mode: ON_RECEIPT | ON_CLEARING
  apdPostingMode       String    @default("ON_CLEARING") @db.VarChar(15) @map("apd_posting_mode")
  apdVoucherId         String?   @db.Uuid @map("apd_voucher_id")
  apdVoucherAccYear    String?   @db.Char(9) @map("apd_voucher_acc_year")
  // acc_tender_detail row. No FK: that table is partitioned on a composite
  // key this column cannot address on its own.
  apdTenderId          String?   @db.Uuid @map("apd_tender_id")
  // Lifecycle — ck_apd_status:
  //   HELD | DEPOSITED | CLEARED | BOUNCED | RETURNED | CANCELLED | REPLACED
  apdStatus            String    @default("HELD") @db.VarChar(15) @map("apd_status")
  apdStatusOn          DateTime? @db.Timestamptz(6) @map("apd_status_on")
  apdStatusBy          String?   @db.VarChar(50) @map("apd_status_by")
  // How many times it has been sent to the bank — what distinguishes a first
  // bounce from a repeat.
  apdPresentCount      Int       @default(0) @map("apd_present_count")
  apdDepositDate       DateTime? @db.Date @map("apd_deposit_date")
  apdDepositSlipNo     String?   @db.VarChar(50) @map("apd_deposit_slip_no")
  apdClearDate         DateTime? @db.Date @map("apd_clear_date")
  apdClearVoucherId    String?   @db.Uuid @map("apd_clear_voucher_id")
  apdClearAccYear      String?   @db.Char(9) @map("apd_clear_acc_year")
  apdBounceDate        DateTime? @db.Date @map("apd_bounce_date")
  apdBounceReason      String?   @db.VarChar(150) @map("apd_bounce_reason")
  apdBounceCharges     Decimal   @default(0) @db.Decimal(18, 2) @map("apd_bounce_charges")
  apdBounceVoucherId   String?   @db.Uuid @map("apd_bounce_voucher_id")
  apdBounceAccYear     String?   @db.Char(9) @map("apd_bounce_acc_year")
  apdChargeVoucherId   String?   @db.Uuid @map("apd_charge_voucher_id")
  apdChargeAccYear     String?   @db.Char(9) @map("apd_charge_acc_year")
  // apdReplacedByAccYear completes the reference to the replacement's
  // composite key; it is set exactly when apdReplacedById is.
  apdReplacedById      String?   @db.Uuid @map("apd_replaced_by_id")
  apdReplacedByAccYear String?   @db.Char(9) @map("apd_replaced_by_acc_year")
  apdCancelDate        DateTime? @db.Date @map("apd_cancel_date")
  apdCancelReason      String?   @db.VarChar(250) @map("apd_cancel_reason")
  apdRemarks           String?   @map("apd_remarks")
  // Audit
  apdIsActive          Boolean   @default(true) @map("apd_is_active")
  apdIsDeleted         Boolean   @default(false) @map("apd_is_deleted")
  apdSyncDate          DateTime? @db.Timestamptz(6) @map("apd_sync_date")
  apdCreatedOn         DateTime  @default(now()) @db.Timestamptz(6) @map("apd_created_on")
  apdCreatedBy         String?   @db.VarChar(50) @map("apd_created_by")
  apdModifiedOn        DateTime? @db.Timestamptz(6) @map("apd_modified_on")
  apdModifiedBy        String?   @db.VarChar(50) @map("apd_modified_by")
  // Relations
  party                AccLedgerMaster   @relation("PdcParty", fields: [apdPartyId], references: [ledId], onUpdate: Cascade, onDelete: Restrict, map: "fk_apd_party")
  bankLedger           AccLedgerMaster?  @relation("PdcBankLedger", fields: [apdBankLedgerId], references: [ledId], onUpdate: Cascade, onDelete: Restrict, map: "fk_apd_bank_ledger")
  receiptVoucher       AccVoucherHeader? @relation("PdcReceiptVoucher", fields: [apdVoucherId, apdVoucherAccYear], references: [avhVoucherId, avhAccYear], onUpdate: Cascade, onDelete: Restrict, map: "fk_apd_voucher")
  clearVoucher         AccVoucherHeader? @relation("PdcClearVoucher", fields: [apdClearVoucherId, apdClearAccYear], references: [avhVoucherId, avhAccYear], onUpdate: Cascade, onDelete: Restrict, map: "fk_apd_clear_voucher")
  bounceVoucher        AccVoucherHeader? @relation("PdcBounceVoucher", fields: [apdBounceVoucherId, apdBounceAccYear], references: [avhVoucherId, avhAccYear], onUpdate: Cascade, onDelete: Restrict, map: "fk_apd_bounce_voucher")
  chargeVoucher        AccVoucherHeader? @relation("PdcChargeVoucher", fields: [apdChargeVoucherId, apdChargeAccYear], references: [avhVoucherId, avhAccYear], onUpdate: Cascade, onDelete: Restrict, map: "fk_apd_charge_voucher")
  replacedBy           AccPdcRegister?   @relation("PdcReplacement", fields: [apdReplacedById, apdReplacedByAccYear], references: [apdId, apdAccYear], onUpdate: Cascade, onDelete: Restrict, map: "fk_apd_replaced_by")
  replaces             AccPdcRegister[]  @relation("PdcReplacement")
  @@id([apdId, apdAccYear], map: "pk_acc_pdc_register")
  @@map("acc_pdc_register")
  @@schema("accounts")
  // DB-only objects not expressible in the Prisma schema (see migrations
  // 20260806090000_add_voucher_header_bills_pdc and
  // 20260811060000_partition_account_bill_tables_by_acc_year):
  //   - PARTITION BY LIST (apd_acc_year); one partition per accounting year,
  //     created by public.ensure_acc_year_partitions('YYYY-YYYY').
  //   - Partial UNIQUE index ux_apd_instrument — the same cheque number
  //     cannot be registered twice for one party in one FY.
  //   - Partial/covering indexes ix_apd_due, ix_apd_party, ix_apd_bank,
  //     ix_apd_bounced, ix_apd_branch, ix_apd_voucher, ix_apd_replaced.
  //   - CHECK constraints ck_apd_tra_type, ck_apd_instrument, ck_apd_status,
  //     ck_apd_posting_mode, ck_apd_amount, ck_apd_charges, ck_apd_present,
  //     ck_apd_acc_year, ck_apd_dates, ck_apd_deposited, ck_apd_cleared,
  //     ck_apd_bounced, ck_apd_replaced, ck_apd_replaced_pair (the
  //     replacement id and its year move together), ck_apd_cancelled,
  //     ck_apd_self, ck_apd_posting, ck_apd_seq.
  //   - No FK on apd_company_id / apd_branch_id / apd_salesman_id /
  //     apd_tender_id.
}

// ----- prisma/accounts/accountTenderDetail.prisma -----
// Tender rows for a document (works for DRAFT docs too, before posting).
// LIST-partitioned by tdAccYear — partitions (e.g. acc_tender_detail_2026_2027)
// are created separately per accounting year; see the migration for details.
model AccTenderDetail {
  tdId                  String    @default(dbgenerated("uuidv7()")) @db.Uuid @map("td_id")
  tdCompanyId           String    @db.Uuid                                   @map("td_company_id")
  tdBranchId            String    @db.Uuid                                   @map("td_branch_id")
  tdTenantId            String?   @db.Uuid                                   @map("td_tenant_id")
  tdAccYear             String    @db.Char(9)                                @map("td_acc_year")
  // The document this money belongs to (works for DRAFT docs too).
  tdSrcModule           String    @db.VarChar(20)                            @map("td_src_module")
  tdSrcDocType          String    @db.VarChar(30)                            @map("td_src_doc_type")
  tdSrcDocId            String    @db.Uuid                                   @map("td_src_doc_id")
  tdRowNo               Int                                                  @map("td_row_no")
  tdDocDate             DateTime  @db.Date                                   @map("td_doc_date")
  tdPartyLedgerId       String    @db.Uuid                                   @map("td_party_ledger_id")
  // Filled at posting; same accounting year as the tender's document.
  tdVoucherId           String?   @db.Uuid                                   @map("td_voucher_id")
  // ── What was tendered ────────────────────────────────────────────────
  tdTenderId            String    @db.Uuid                                   @map("td_tender_id")
  tdTenderTypeId        Int                                                  @map("td_tender_type_id")
  tdTenderLedgerId      String    @db.Uuid                                   @map("td_tender_ledger_id")
  tdDrCr                String    @db.Char(2)                                @map("td_dr_cr")
  tdAmount              Decimal   @default(0) @db.Decimal(18, 2)             @map("td_amount")
  tdSurchargePerc       Decimal   @default(0) @db.Decimal(6, 3)              @map("td_surcharge_perc")
  tdSurchargeAmt        Decimal   @default(0) @db.Decimal(18, 2)             @map("td_surcharge_amt")
  tdSurchargeLedgerId   String?   @db.Uuid                                   @map("td_surcharge_ledger_id")
  tdTotalAmt            Decimal   @default(0) @db.Decimal(18, 2)             @map("td_total_amt")
  // ── Cash over-tender / change ────────────────────────────────────────
  tdReceivedAmt         Decimal   @default(0) @db.Decimal(18, 2)             @map("td_received_amt")
  tdChangeAmt           Decimal   @default(0) @db.Decimal(18, 2)             @map("td_change_amt")
  // ── Non-cash equivalents (loyalty / voucher) ─────────────────────────
  tdUnitsUsed           Decimal   @default(0) @db.Decimal(18, 4)             @map("td_units_used")
  tdConversionRate      Decimal   @default(1) @db.Decimal(10, 4)             @map("td_conversion_rate")
  // ── Instrument / gateway reference (day reconciliation) ──────────────
  tdRefNo               String?   @db.VarChar(100)                          @map("td_ref_no")
  tdAuthCode            String?   @db.VarChar(50)                           @map("td_auth_code")
  tdCardLast4           String?   @db.VarChar(4)                            @map("td_card_last4")
  tdBankName            String?   @db.VarChar(150)                          @map("td_bank_name")
  tdPayerVpa            String?   @db.VarChar(100)                          @map("td_payer_vpa")
  tdInstrumentDate      DateTime? @db.Date                                   @map("td_instrument_date")
  tdIsPdc               Boolean   @default(false)                            @map("td_is_pdc")
  // ── Settlement ───────────────────────────────────────────────────────
  tdSettleStatus        String    @default("NA") @db.VarChar(20)             @map("td_settle_status")
  tdSettleLedgerId      String?   @db.Uuid                                   @map("td_settle_ledger_id")
  tdExpectedSettleOn    DateTime? @db.Date                                   @map("td_expected_settle_on")
  tdSettledOn           DateTime? @db.Date                                   @map("td_settled_on")
  tdSettleAmount        Decimal?  @db.Decimal(18, 2)                        @map("td_settle_amount")
  tdMdrAmt              Decimal   @default(0) @db.Decimal(18, 2)             @map("td_mdr_amt")
  tdSettleRefNo         String?   @db.VarChar(100)                          @map("td_settle_ref_no")
  tdSettleVoucherId     String?   @db.Uuid                                   @map("td_settle_voucher_id")
  // ── Where / who ──────────────────────────────────────────────────────
  tdSessionId           String?   @db.Uuid                                   @map("td_session_id")
  tdDeviceId            String?   @db.VarChar(250)                          @map("td_device_id")
  tdUserId              String    @db.Uuid                                   @map("td_user_id")
  tdNotes               String?   @db.VarChar(250)                          @map("td_notes")
  // ── Audit ────────────────────────────────────────────────────────────
  tdIsDeleted           Boolean   @default(false)                            @map("td_is_deleted")
  tdSyncDate            DateTime? @db.Timestamptz                            @map("td_sync_date")
  tdCreatedOn           DateTime  @default(now()) @db.Timestamptz            @map("td_created_on")
  tdCreatedBy           String    @db.VarChar(50)                           @map("td_created_by")
  tdModifiedOn          DateTime? @db.Timestamptz                            @map("td_modified_on")
  tdModifiedBy          String?   @db.VarChar(50)                           @map("td_modified_by")
  // Relations
  company               Company          @relation(fields: [tdCompanyId], references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_td_company")
  branch                BranchMaster     @relation(fields: [tdBranchId], references: [brId], onUpdate: Cascade, onDelete: Restrict, map: "fk_td_branch")
  user                  UserMaster       @relation(fields: [tdUserId], references: [usrId], onUpdate: Cascade, onDelete: Restrict, map: "fk_td_user")
  tender                AccTenderMaster  @relation(fields: [tdTenderId], references: [tndId], onUpdate: Cascade, onDelete: Restrict, map: "fk_td_tender")
  tenderType            AccTenderType    @relation(fields: [tdTenderTypeId], references: [ttmTypeId], onUpdate: Cascade, onDelete: Restrict, map: "fk_td_tender_type")
  ledger                AccLedgerMaster  @relation("TenderDetailLedger", fields: [tdTenderLedgerId], references: [ledId], onUpdate: Cascade, onDelete: Restrict, map: "fk_td_ledger")
  settleLedger          AccLedgerMaster? @relation("TenderDetailSettleLedger", fields: [tdSettleLedgerId], references: [ledId], onUpdate: Cascade, onDelete: Restrict, map: "fk_td_settle_ledger")
  partyLedger           AccLedgerMaster  @relation("TenderDetailPartyLedger", fields: [tdPartyLedgerId], references: [ledId], onUpdate: Cascade, onDelete: Restrict, map: "fk_td_party_ledger")
  surchargeLedger       AccLedgerMaster? @relation("TenderDetailSurchargeLedger", fields: [tdSurchargeLedgerId], references: [ledId], onUpdate: Cascade, onDelete: Restrict, map: "fk_td_surcharge_ledger")
  // Applications of this tender when it was taken as an order advance.
  // What this tender settled — one bill adjustment per tender row, which is
  // what lets a bounced cheque reopen only its own share.
  billAdjustments        AccBillAdjustment[]
  // No relation fields for:
  //   tdVoucherId / tdSettleVoucherId
  //                 — acc_voucher_header was dropped; both stay plain UUID columns.
  //   tdTenantId    — no Tenant model exists in this schema (same as sb_tenant_id / sq_tenant_id).
  //   tdSessionId   — user_login_sessions.uls_session_id is nullable and not unique,
  //                   so it is not a valid FK target (avh_session_id is likewise unmapped).
  //   tdDeviceId    — VarChar(250) free text, not a device_master id.
  //   tdSrcDocId    — polymorphic; the target table varies by tdSrcModule/tdSrcDocType.
  @@id([tdId, tdAccYear], map: "pk_acc_tender_detail")
  // No CREATE INDEX statements were specified for this table beyond the PK —
  // matching the given DDL exactly (unlike acc_tender_master, which listed
  // explicit lookup indexes).
  // CHECK constraints (DB-only): ck_td_src_module, ck_td_src_doc_type, ck_td_dr_cr,
  //   ck_td_settle_status, ck_td_amounts, ck_td_row_no, ck_td_total_amt,
  //   ck_td_cash_change, ck_td_units, ck_td_settle_amount, ck_td_mdr,
  //   ck_td_settled_on, ck_td_pdc, ck_td_card_last4
  @@map("acc_tender_detail")
  @@schema("accounts")
}

// ----- prisma/accounts/accountTenderMaster.prisma -----
// Tenant-scoped concrete tender a cashier picks (e.g. "HDFC Card", "GPay"), mapped to its posting ledger.
model AccTenderMaster {
  tndId                   String    @id(map: "pk_acc_tender_master") @default(dbgenerated("uuidv7()")) @db.Uuid @map("tnd_id")

  // tenant scope
  tndCompanyId            String    @db.Uuid                                       @map("tnd_company_id")
  tndBranchId             String?   @db.Uuid                                       @map("tnd_branch_id")

  // identity
  tndTypeId               Int                                                      @map("tnd_type_id")
  tndName                 String    @db.VarChar(100)                               @map("tnd_name")
  tndShortName            String    @db.VarChar(30)                                @map("tnd_short_name")

  // accounting
  tndLedgerId             String    @db.Uuid                                       @map("tnd_ledger_id")
  tndSettlementLedgerId   String?   @db.Uuid                                       @map("tnd_settlement_ledger_id")
  tndSettlementDays       Int       @default(0) @db.SmallInt                       @map("tnd_settlement_days")
  tndBankAccountId        String?   @db.Uuid                                       @map("tnd_bank_account_id")

  // limits
  tndMinAmount            Decimal   @default(0) @db.Decimal(14, 2)                 @map("tnd_min_amount")
  tndMaxAmount            Decimal?  @db.Decimal(14, 2)                             @map("tnd_max_amount")
  tndDailyLimit           Decimal?  @db.Decimal(14, 2)                             @map("tnd_daily_limit")

  // surcharge / MDR
  tndSurchargePerc        Decimal   @default(0) @db.Decimal(6, 3)                  @map("tnd_surcharge_perc")
  tndSurchargeAmount      Decimal   @default(0) @db.Decimal(14, 2)                 @map("tnd_surcharge_amount")
  tndSurchargeLedgerId    String?   @db.Uuid                                       @map("tnd_surcharge_ledger_id")
  tndEditSurcharge        Boolean   @default(false)                                @map("tnd_edit_surcharge")
  tndEditLedger           Boolean   @default(false)                                @map("tnd_edit_ledger")

  // payment instrument details
  tndUpiVpa               String?   @db.VarChar(100)                               @map("tnd_upi_vpa")
  tndUpiQrPayload         String?                                                  @map("tnd_upi_qr_payload")
  tndMerchantId           String?   @db.VarChar(50)                                @map("tnd_merchant_id")
  tndTerminalId           String?   @db.VarChar(50)                                @map("tnd_terminal_id")
  tndConversionRate       Decimal   @default(1) @db.Decimal(10, 4)                 @map("tnd_conversion_rate")

  // behaviour overrides (NULL = inherit from tender type)
  tndNeedsRef             Boolean?                                                 @map("tnd_needs_ref")
  tndAllowChange          Boolean?                                                 @map("tnd_allow_change")
  tndAllowInReturn        Boolean?                                                 @map("tnd_allow_in_return")
  tndOpenCashDrawer       Boolean   @default(false)                                @map("tnd_open_cash_drawer")
  tndIsDefault            Boolean   @default(false)                                @map("tnd_is_default")

  // POS presentation
  tndDisplayPosition      Int       @default(0)                                    @map("tnd_display_position")
  tndHotkey               String?   @db.VarChar(10)                                @map("tnd_hotkey")
  tndColour               String?   @db.VarChar(9)                                 @map("tnd_colour")

  // validity
  tndEffectiveFrom        DateTime? @db.Date                                       @map("tnd_effective_from")
  tndEffectiveTo          DateTime? @db.Date                                       @map("tnd_effective_to")

  tndRemarks              String?   @db.VarChar(250)                               @map("tnd_remarks")
  tndIsActive             Boolean   @default(true)                                 @map("tnd_is_active")
  tndIsDeleted            Boolean   @default(false)                                @map("tnd_is_deleted")

  // audit
  tndSyncDate             DateTime? @db.Timestamptz                                @map("tnd_sync_date")
  tndCreatedOn            DateTime  @default(now()) @db.Timestamptz                @map("tnd_created_on")
  tndCreatedBy            String?   @db.VarChar(50)                                @map("tnd_created_by")
  tndModifiedOn           DateTime? @db.Timestamptz                                @map("tnd_modified_on")
  tndModifiedBy           String?   @db.VarChar(50)                                @map("tnd_modified_by")

  // Relations
  company                 Company               @relation(fields: [tndCompanyId], references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_tnd_company")
  branch                  BranchMaster?         @relation(fields: [tndBranchId], references: [brId], onUpdate: Cascade, onDelete: Restrict, map: "fk_tnd_branch")
  tenderType              AccTenderType         @relation(fields: [tndTypeId], references: [ttmTypeId], onUpdate: Cascade, onDelete: Restrict, map: "fk_tnd_type")
  ledger                  AccLedgerMaster       @relation("TenderLedger", fields: [tndLedgerId], references: [ledId], onUpdate: Cascade, onDelete: Restrict, map: "fk_tnd_ledger")
  settlementLedger        AccLedgerMaster?      @relation("TenderSettlementLedger", fields: [tndSettlementLedgerId], references: [ledId], onUpdate: Cascade, onDelete: Restrict, map: "fk_tnd_settlement_ledger")
  surchargeLedger         AccLedgerMaster?      @relation("TenderSurchargeLedger", fields: [tndSurchargeLedgerId], references: [ledId], onUpdate: Cascade, onDelete: Restrict, map: "fk_tnd_surcharge_ledger")
  bankAccount             AccLedgerBankAccount? @relation(fields: [tndBankAccountId], references: [lbaId], onUpdate: Cascade, onDelete: Restrict, map: "fk_tnd_bank_account")
  tenderDetails           AccTenderDetail[]

  @@index([tndTypeId], map: "ix_tnd_type")
  @@index([tndLedgerId], map: "ix_tnd_ledger")
  // Partial indexes — enforced via raw SQL migration, not expressible in Prisma schema:
  //   ux_tnd_name               UNIQUE (tnd_company_id, COALESCE(tnd_branch_id, zero-uuid), lower(tnd_name))      WHERE tnd_is_deleted = false
  //   ux_tnd_short_name         UNIQUE (tnd_company_id, COALESCE(tnd_branch_id, zero-uuid), lower(tnd_short_name)) WHERE tnd_is_deleted = false
  //   ux_tnd_default            UNIQUE (tnd_company_id, COALESCE(tnd_branch_id, zero-uuid))                        WHERE tnd_is_default = true AND tnd_is_active = true AND tnd_is_deleted = false
  //   ux_tnd_hotkey             UNIQUE (tnd_company_id, COALESCE(tnd_branch_id, zero-uuid), tnd_hotkey)            WHERE tnd_hotkey IS NOT NULL AND tnd_is_deleted = false
  //   ix_tnd_company_branch     btree (tnd_company_id, tnd_branch_id)         WHERE tnd_is_deleted = false
  //   ix_tnd_settlement_ledger  btree (tnd_settlement_ledger_id)              WHERE tnd_settlement_ledger_id IS NOT NULL
  //   ix_tnd_position           btree (tnd_company_id, tnd_display_position)  WHERE tnd_is_active = true AND tnd_is_deleted = false
  // CHECK constraints (DB-only): ck_tnd_amount_range, ck_tnd_min_amount, ck_tnd_daily_limit,
  //   ck_tnd_surcharge_perc, ck_tnd_surcharge_amt, ck_tnd_settlement_days, ck_tnd_conversion_rate,
  //   ck_tnd_effective_range, ck_tnd_colour
  @@map("acc_tender_master")
  @@schema("accounts")
}

// ----- prisma/accounts/accountTenderTypes.prisma -----
// Fixed catalogue of tender behaviours (CASH, CARD, UPI, ...). Tenant-agnostic.
model AccTenderType {
  ttmTypeId         Int       @id(map: "pk_acc_tender_types")                  @map("ttm_type_id")
  ttmTypeName       String    @unique(map: "ux_ttm_name") @db.VarChar(50)      @map("ttm_type_name")
  ttmDisplayName    String    @db.VarChar(50)                                  @map("ttm_display_name")
  ttmIsCash         Boolean   @default(false)                                  @map("ttm_is_cash")
  ttmNeedsRef       Boolean   @default(false)                                  @map("ttm_needs_ref")
  ttmRefLabel       String?   @db.VarChar(30)                                  @map("ttm_ref_label")
  ttmSaleOnly       Boolean   @default(false)                                  @map("ttm_sale_only")
  ttmAllowChange    Boolean   @default(false)                                  @map("ttm_allow_change")
  ttmAllowInReturn  Boolean   @default(true)                                   @map("ttm_allow_in_return")
  ttmDisplayOrder   Int       @default(0)                                      @map("ttm_display_order")
  ttmIsActive       Boolean   @default(true)                                   @map("ttm_is_active")
  ttmIsDeleted      Boolean   @default(false)                                  @map("ttm_is_deleted")
  ttmSyncDate       DateTime? @db.Timestamptz                                  @map("ttm_sync_date")
  ttmCreatedOn      DateTime  @default(now()) @db.Timestamptz                  @map("ttm_created_on")
  ttmCreatedBy      String?   @db.VarChar(50)                                  @map("ttm_created_by")
  ttmModifiedOn     DateTime? @db.Timestamptz                                  @map("ttm_modified_on")
  ttmModifiedBy     String?   @db.VarChar(50)                                  @map("ttm_modified_by")
  // Relations
  tenders           AccTenderMaster[]
  tenderDetails     AccTenderDetail[]
  // Partial index — enforced via raw SQL migration, not expressible in Prisma schema:
  //   ix_ttm_display_order  btree (ttm_display_order)  WHERE ttm_is_active = true AND ttm_is_deleted = false
  // CHECK constraint (DB-only): ck_ttm_ref_label — ttm_needs_ref = false OR ttm_ref_label IS NOT NULL
  @@map("acc_tender_types")
  @@schema("accounts")
}

// ----- prisma/accounts/AccountVoucherCheques.prisma -----
enum ChequeTraType {
  R
  P
  @@schema("accounts")
}

enum ChequeInstrumentType {
  CHEQUE
  PDC
  @@schema("accounts")
}

enum ChequeStatus {
  PENDING
  IN_HAND
  ISSUED
  DEPOSITED
  CLEARED
  BOUNCED
  RETURNED
  CANCELLED
  @@schema("accounts")
}

model AccVoucherCheque {
  // Primary
  chqId                String                @id @default(dbgenerated("uuidv7()")) @db.Uuid @map("chq_id")

  // Links
  chqVoucherId         String                @db.Uuid @map("chq_voucher_id")
  chqVoucherLineId     String?               @db.Uuid @map("chq_voucher_line_id")
  chqBillId            String?               @db.Uuid @map("chq_bill_id")

  // Multi-branch snapshot
  chqAccYear           String                @db.VarChar(9) @map("chq_acc_year")
  chqCompanyId         String                @db.Uuid @map("chq_company_id")
  chqBranchId          String                @db.Uuid @map("chq_branch_id")

  // Voucher snapshot
  chqVoucherTypeId     Int                   @map("chq_voucher_type_id")
  chqVoucherNo         BigInt                @map("chq_voucher_no")
  chqVoucherDate       DateTime              @db.Date @map("chq_voucher_date")
  chqVoucherRefno      String?               @db.VarChar(50) @map("chq_voucher_refno")

  // Party / ownership
  chqPartyId           String                @db.Uuid @map("chq_party_id")
  chqSalesmanId        String?               @db.Uuid @map("chq_salesman_id")
  chqUserId            String?               @db.Uuid @map("chq_user_id")
  chqSessionId         String?               @db.Uuid @map("chq_session_id")

  // Instrument classification
  chqTraType           ChequeTraType         @map("chq_tra_type")
  chqInstrumentType    ChequeInstrumentType  @default(CHEQUE) @map("chq_instrument_type")
  chqIsPostDated       Boolean               @default(false) @map("chq_is_post_dated")
  chqIsAccountPayee    Boolean               @default(false) @map("chq_is_account_payee")

  // Cheque details
  chqChequeNo          String                @db.VarChar(30) @map("chq_cheque_no")
  chqChequeDate        DateTime              @db.Date @map("chq_cheque_date")
  chqChequeAmount      Decimal               @default(0) @db.Decimal(15, 2) @map("chq_cheque_amount")

  // Bank / payee snapshot
  chqBankLedgerId      String?               @db.Uuid @map("chq_bank_ledger_id")
  chqBankName          String?               @db.VarChar(500) @map("chq_bank_name")
  chqBankBranch        String?               @db.VarChar(150) @map("chq_bank_branch")
  chqBankIfsc          String?               @db.VarChar(20) @map("chq_bank_ifsc")
  chqPayeeName         String?               @db.VarChar(500) @map("chq_payee_name")
  chqDrawerName        String?               @db.VarChar(500) @map("chq_drawer_name")

  // Printing
  chqIsPrinted         Boolean               @default(false) @map("chq_is_printed")
  chqPrintedOn         DateTime?             @db.Timestamptz(6) @map("chq_printed_on")

  // Lifecycle dates
  chqReceivedOn        DateTime?             @db.Date @map("chq_received_on")
  chqIssuedOn          DateTime?             @db.Date @map("chq_issued_on")
  chqDepositDate       DateTime?             @db.Date @map("chq_deposit_date")
  chqClearDate         DateTime?             @db.Date @map("chq_clear_date")
  chqBounceDate        DateTime?             @db.Date @map("chq_bounce_date")
  chqReturnDate        DateTime?             @db.Date @map("chq_return_date")
  chqCancelledOn       DateTime?             @db.Date @map("chq_cancelled_on")

  // Status
  chqStatus            ChequeStatus          @map("chq_status")

  // Notes
  chqNotes             String?               @map("chq_notes")
  chqLogText           String?               @map("chq_log_text")

  // Common status
  chqIsActive          Boolean               @default(true) @map("chq_is_active")
  chqIsDeleted         Boolean               @default(false) @map("chq_is_deleted")

  // Audit
  chqSyncDate          DateTime?             @db.Timestamptz(6) @map("chq_sync_date")
  chqCreatedOn         DateTime              @default(now()) @db.Timestamptz(6) @map("chq_created_on")
  chqCreatedBy         String?               @db.Uuid @map("chq_created_by")
  chqUpdatedOn         DateTime?             @db.Timestamptz(6) @map("chq_updated_on")
  chqUpdatedBy         String?               @db.Uuid @map("chq_updated_by")

  // Relations
  // chqVoucherId stays a plain UUID column — acc_voucher_header was dropped.
  voucherType          AccVoucherType        @relation(fields: [chqVoucherTypeId], references: [vchrTypeId], map: "fk_acc_cheques_voucher_type")
  company              Company               @relation(fields: [chqCompanyId], references: [compId], map: "fk_acc_cheques_voucher_company")
  branch               BranchMaster          @relation(fields: [chqBranchId], references: [brId], map: "fk_acc_cheques_voucher_branch")
  // The settlement rows this instrument carried. A bounce here writes the
  // reversal row there.
  billAdjustments      AccBillAdjustment[]

  // Target for fk_abj_cheque, which names the cheque by (id, year) the same
  // way a settlement names its tender. Redundant with the primary key on
  // chqId — it exists only so the pair can be referenced.
  @@unique([chqId, chqAccYear], map: "ux_chq_id_acc_year")
  @@index([chqCompanyId, chqBranchId, chqPartyId], map: "idx_acc_cheques_party")
  @@index([chqCompanyId, chqBranchId, chqStatus], map: "idx_acc_cheques_status")
  @@index([chqCompanyId, chqBranchId, chqChequeDate, chqDepositDate, chqClearDate], map: "idx_acc_cheques_dates")
  @@index([chqVoucherId], map: "idx_acc_cheques_voucher")
  @@map("acc_voucher_cheques")
  @@schema("accounts")
  // Partial unique index uq_acc_cheques_branch_cheque
  // WHERE chq_is_deleted = false is not expressible in Prisma schema.
}

