// ----- prisma/inventory/itemMaster.prisma -----
model ItemMaster {
  itemId                    String                     @id @default(dbgenerated("uuidv7()")) @map("item_id") @db.Uuid
  itemCompanyId             String?                    @map("item_company_id") @db.Uuid
  itemBranchId              String?                    @map("item_branch_id") @db.Uuid
  // Names / Codes
  itemCode                  String?                    @map("item_code") @db.VarChar(50)
  itemSku                   String?                    @map("item_sku") @db.VarChar(60)
  itemNameEn                String                     @map("item_name_en") @db.VarChar(200)
  itemNameTa                String?                    @map("item_name_ta") @db.VarChar(200)
  itemAlias                 String?                    @map("item_alias") @db.VarChar(200)
  itemStockType             String                     @default("FG") @map("item_stock_type") @db.VarChar(20)
  itemDefaultBarcode        String?                    @map("item_default_barcode") @db.VarChar(200)
  // Classification
  itemGroupId               String                     @map("item_group_id") @db.Uuid
  itemCategoryId            String?                    @map("item_category_id") @db.Uuid
  itemBrandId               String?                    @map("item_brand_id") @db.Uuid
  itemSectionId             String?                    @map("item_section_id") @db.Uuid
  itemCompanyCategoryId     String?                    @map("item_company_category_id") @db.Uuid
  itemMfgrId                String?                    @map("item_mfgr_id") @db.Uuid
  itemSupplierId            String?                    @map("item_supplier_id") @db.Uuid
  itemCustGroup             String?                    @map("item_cust_group") @db.Uuid
  // Units / Batch / Expiry
  itemBaseUnitId            String?                    @map("item_base_unit_id") @db.Uuid
  itemIsService             Boolean                    @default(false) @map("item_is_service")
  itemIsBatchBased          Boolean                    @default(false) @map("item_is_batch_based")
  itemIsExpiryItem          Boolean                    @default(false) @map("item_is_expiry_item")
  itemExpiryDays            Int?                       @map("item_expiry_days")
  itemIntimateBeforeDays    Int?                       @map("item_intimate_before_days")
  // Sales / Purchase flags
  itemAllowSales            Boolean                    @default(true) @map("item_allow_sales")
  itemAllowSalesReturn      Boolean                    @default(true) @map("item_allow_sales_return")
  itemAllowPurchase         Boolean                    @default(true) @map("item_allow_purchase")
  itemAllowPo               Boolean                    @default(true) @map("item_allow_po")
  itemAllowSo               Boolean                    @default(true) @map("item_allow_so")
  itemAllowNegStock         Boolean                    @default(true) @map("item_allow_neg_stock")
  itemAllowNegativeSo       Boolean                    @default(true) @map("item_allow_negative_so")
  // Pricing / POS / Features
  itemPriceList             Boolean                    @default(false) @map("item_price_list")
  itemWeighScale            Boolean                    @default(false) @map("item_weigh_scale")
  itemRetailItem            Boolean                    @default(true) @map("item_retail_item")
  itemIsKit                 Boolean                    @default(false) @map("item_is_kit")
  itemAutoBreak             Boolean                    @default(false) @map("item_auto_break")
  itemAutoMake              Boolean                    @default(false) @map("item_auto_make")
  itemAllowLoyalty          Boolean                    @default(false) @map("item_allow_loyalty")
  itemAllowPromo            Boolean                    @default(false) @map("item_allow_promo")
  itemHasOffer              Boolean                    @default(false) @map("item_has_offer")
  itemDamagableProduct      Boolean                    @default(false) @map("item_damagable_product")
  itemIsDemand              Boolean                    @default(false) @map("item_is_demand")
  itemAllowLoading          Boolean                    @default(false) @map("item_allow_loading")
  itemAllowFreight          Boolean                    @default(false) @map("item_allow_freight")
  itemRandomStock           Boolean                    @default(false) @map("item_random_stock")
  itemBarcodeSticker        Boolean                    @default(false) @map("item_barcode_sticker")
  itemBarcodeStickerId      String?                    @map("item_barcode_sticker_id") @db.Uuid
  // Tax / HSN
  itemDefaultTaxId          String?                    @map("item_default_tax_id") @db.Uuid
  itemHsnCode               String?                    @map("item_hsn_code") @db.VarChar(10)
  // UI / misc
  itemBatchConfig           Int                        @default(0) @map("item_batch_config")
  itemSortOrder             Int?                       @map("item_sort_order")
  itemPhoto                 Bytes?                     @map("item_photo")
  itemImageUrl              String?                    @map("item_image_url") @db.Text
  itemNotes                 String?                    @map("item_notes") @db.VarChar(250)
  itemStorageLocation       String?                    @map("item_storage_location") @db.VarChar(250)
  itemPackingItemIds        String[]                   @map("item_packing_item_ids") @db.Uuid
  // Status / Audit
  itemIsActive              Boolean                    @default(true) @map("item_is_active")
  itemIsDeleted             Boolean                    @default(false) @map("item_is_deleted")
  itemCreatedOn             DateTime                   @default(now()) @map("item_created_on") @db.Timestamptz(6)
  itemCreatedBy             String?                    @map("item_created_by") @db.VarChar(100)
  itemModifiedOn            DateTime                   @default(now()) @map("item_modified_on") @db.Timestamptz(6)
  itemModifiedBy            String?                    @map("item_modified_by") @db.VarChar(100)
  // Relations
  group                     ItemGroupMaster            @relation(fields: [itemGroupId], references: [itgId], onUpdate: Cascade, onDelete: Restrict)
  category                  categoryMaster?            @relation(fields: [itemCategoryId], references: [categoryId], onUpdate: Cascade, onDelete: SetNull)
  baseUnit                  Unit?                      @relation(fields: [itemBaseUnitId], references: [unit_id], onUpdate: Cascade, onDelete: Restrict)
  defaultTax                ItemTaxMaster?             @relation(fields: [itemDefaultTaxId], references: [taxId], onUpdate: Cascade, onDelete: Restrict)
  prices                    ItemPriceMaster[]          @relation("ItemPrices")
  qtyPrices                 ItemQtyPrice[]             @relation("ItemQtyPrices")
  unitConversions           ItemUnitConversion[]       @relation("ItemUnitConversions")
  openingStockDetails       OpeningStockDetail[]       @relation("OpeningStockDetailItem")
  physicalStockDetails      PhysicalStockDetail[]      @relation("PhysicalStockDetailItem")
  physicalStockBatchDetails PhysicalStockBatchDetail[] @relation("PhysicalStockBatchDetailItem")
  reorders                  ItemReorder[]
  taxHistory                ItemTaxHistory[]
  company                   Company?                   @relation(fields: [itemCompanyId], references: [compId], onUpdate: Cascade, onDelete: Restrict)
  loyaltySchemeGifts        LoyaltySchemeGift[]
  saleQuotationItems        SaleQuotationItem[]

  // UNIQUE item_name_en globally (since company removed)
  @@unique([itemNameEn], map: "uq_item_name_en_global")
  @@index([itemGroupId], map: "idx_item_group")
  @@index([itemNameEn], map: "idx_item_name_en")
  @@index([itemDefaultBarcode], map: "idx_item_barcode")
  @@map("item_master")
  @@schema("inventory")
}

// ----- prisma/inventory/itemPriceLevels.prisma -----
