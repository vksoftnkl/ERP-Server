// ----- prisma/accounts/AccountVoucherHeader.prisma -----
/// Voucher head. Partitioned by acc_year, so the primary key is the
/// composite (avhVoucherId, avhAccYear) and every FK into this table must
/// carry both columns.
///
/// Status / device / message / tally values are VARCHAR + CHECK in the DB,
/// not PG enums — the app layer owns the value sets.
///
/// Lifecycle: DRAFT -> APPROVED -> POSTED, or -> CANCELLED. A DRAFT holds no
/// voucher number and contributes nothing to any balance.
model AccVoucherHeader {
  avhVoucherId           String    @default(dbgenerated("uuidv7()")) @db.Uuid @map("avh_voucher_id")
  avhCompanyId           String    @db.Uuid @map("avh_company_id")
  avhBranchId            String    @db.Uuid @map("avh_branch_id")
  avhTenantId            String?   @db.Uuid @map("avh_tenant_id")
  avhAccYear             String    @db.Char(9) @map("avh_acc_year")
  avhVoucherTypeId       Int       @map("avh_voucher_type_id")
  // Nullable on purpose: a draft must not consume a number, or an abandoned
  // entry leaves a permanent gap in the series.
  avhVoucherNo           BigInt?   @map("avh_voucher_no")
  avhVoucherSlno         BigInt?   @map("avh_voucher_slno")
  avhVoucherRefno        String?   @db.VarChar(50) @map("avh_voucher_refno")
  avhVoucherDate         DateTime  @db.Timestamptz(6) @map("avh_voucher_date")
  // Source document. src_* is the machine link (posting idempotency,
  // ux_avh_src); doc_* is the human-readable face of the same document.
  avhSrcModule           String?   @db.VarChar(20) @map("avh_src_module")
  avhSrcDocType          String?   @db.VarChar(30) @map("avh_src_doc_type")
  avhSrcDocId            String?   @db.Uuid @map("avh_src_doc_id")
  avhUsrRefno            String?   @db.VarChar(100) @map("avh_usr_refno")
  avhDocRefno            String?   @db.VarChar(100) @map("avh_doc_refno")
  avhDocDate             DateTime? @db.Date @map("avh_doc_date")
  avhDocAmount           Decimal   @default(0) @db.Decimal(18, 2) @map("avh_doc_amount")
  avhAdjustAmount        Decimal   @default(0) @db.Decimal(18, 2) @map("avh_adjust_amount")
  avhRoundOff            Decimal   @default(0) @db.Decimal(18, 2) @map("avh_round_off")
  avhTotalDebit          Decimal   @default(0) @db.Decimal(18, 2) @map("avh_total_debit")
  avhTotalCredit         Decimal   @default(0) @db.Decimal(18, 2) @map("avh_total_credit")
  avhPartyId             String    @db.Uuid @map("avh_party_id")
  avhOppositeLedgerId    String?   @db.Uuid @map("avh_opposite_ledger_id")
  // Scalar list: Prisma rejects null here, so normalise to [] in the DTO.
  avhEmployeeId          String[]  @db.Uuid @map("avh_employee_id")
  avhRemarks             String?   @map("avh_remarks")
  // Document lineage: credit note -> original invoice, debit note ->
  // original bill; reversal is the contra voucher raised on cancellation.
  avhAgainstVoucherId    String?   @db.Uuid @map("avh_against_voucher_id")
  avhAgainstAccYear      String?   @db.Char(9) @map("avh_against_acc_year")
  avhReversalVoucherId   String?   @db.Uuid @map("avh_reversal_voucher_id")
  avhReversalAccYear     String?   @db.Char(9) @map("avh_reversal_acc_year")
  // Lifecycle — ck_avh_status: DRAFT | APPROVED | POSTED | CANCELLED
  avhVoucherStatus       String    @default("DRAFT") @db.VarChar(20) @map("avh_voucher_status")
  avhStatusOn            DateTime? @db.Timestamptz(6) @map("avh_status_on")
  avhStatusBy            String?   @db.Uuid @map("avh_status_by")
  avhPostedOn            DateTime? @db.Timestamptz(6) @map("avh_posted_on")
  avhCancelReason        String?   @db.VarChar(250) @map("avh_cancel_reason")
  // Where / who — ck_avh_device_type: PC | WEB | MOBILE | POS | DESKTOP
  // (DESKTOP added by 20260806120000_widen_avh_device_type)
  avhUserId              String    @db.Uuid @map("avh_user_id")
  avhSessionId           String?   @db.Uuid @map("avh_session_id")
  avhDeviceType          String?   @db.VarChar(20) @map("avh_device_type")
  avhDeviceId            String?   @map("avh_device_id")
  avhPrintCount          Int       @default(0) @map("avh_print_count")
  // Outbound / export — ck_avh_msg_status: NA | PENDING | SENT | FAILED
  //                     ck_avh_tally_status: NA | PENDING | EXPORTED | FAILED
  avhWhatsappStatus      String    @default("NA") @db.VarChar(10) @map("avh_whatsapp_status")
  avhSmsStatus           String    @default("NA") @db.VarChar(10) @map("avh_sms_status")
  avhTallyExportStatus   String    @default("PENDING") @db.VarChar(10) @map("avh_tally_export_status")
  avhTallyExportedOn     DateTime? @db.Timestamptz(6) @map("avh_tally_exported_on")
  avhTallyGuid           String?   @db.VarChar(100) @map("avh_tally_guid")
  avhTallyErrorMsg       String?   @map("avh_tally_error_msg")
  // Audit
  avhIsActive            Boolean   @default(true) @map("avh_is_active")
  avhIsDeleted           Boolean   @default(false) @map("avh_is_deleted")
  avhSyncDate            DateTime? @db.Timestamptz(6) @map("avh_sync_date")
  avhCreatedOn           DateTime  @default(now()) @db.Timestamptz(6) @map("avh_created_on")
  avhCreatedBy           String?   @db.VarChar(50) @map("avh_created_by")
  avhModifiedOn          DateTime? @db.Timestamptz(6) @map("avh_modified_on")
  avhModifiedBy          String?   @db.VarChar(50) @map("avh_modified_by")
  // Relations
  company                Company         @relation(fields: [avhCompanyId], references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_avh_company")
  branch                 BranchMaster    @relation(fields: [avhBranchId], references: [brId], onUpdate: Cascade, onDelete: Restrict, map: "fk_avh_branch")
  voucherType            AccVoucherType  @relation(fields: [avhVoucherTypeId], references: [vchrTypeId], onUpdate: Cascade, onDelete: Restrict, map: "fk_avh_voucher_type")
  party                  AccLedgerMaster @relation("VoucherHeaderParty", fields: [avhPartyId], references: [ledId], onUpdate: Cascade, onDelete: Restrict, map: "fk_avh_party")
  oppositeLedger         AccLedgerMaster? @relation("VoucherHeaderOppLedger", fields: [avhOppositeLedgerId], references: [ledId], onUpdate: Cascade, onDelete: Restrict, map: "fk_avh_opp_ledger")
  user                   UserMaster      @relation(fields: [avhUserId], references: [usrId], onUpdate: Cascade, onDelete: Restrict, map: "fk_avh_user")
  againstVoucher         AccVoucherHeader?  @relation("VoucherHeaderAgainst", fields: [avhAgainstVoucherId, avhAgainstAccYear], references: [avhVoucherId, avhAccYear], onUpdate: Cascade, onDelete: Restrict, map: "fk_avh_against")
  againstVouchers        AccVoucherHeader[] @relation("VoucherHeaderAgainst")
  reversalVoucher        AccVoucherHeader?  @relation("VoucherHeaderReversal", fields: [avhReversalVoucherId, avhReversalAccYear], references: [avhVoucherId, avhAccYear], onUpdate: Cascade, onDelete: Restrict, map: "fk_avh_reversal")
  reversalVouchers       AccVoucherHeader[] @relation("VoucherHeaderReversal")
  vouchers               AccVoucher[]
  bills                  AccBillBalance[]
  billAdjustments        AccBillAdjustment[]
  pdcReceipts            AccPdcRegister[]   @relation("PdcReceiptVoucher")
  pdcClearings           AccPdcRegister[]   @relation("PdcClearVoucher")
  pdcBounces             AccPdcRegister[]   @relation("PdcBounceVoucher")
  pdcCharges             AccPdcRegister[]   @relation("PdcChargeVoucher")
  @@id([avhVoucherId, avhAccYear], map: "pk_acc_voucher_header")
  @@map("acc_voucher_header")
  @@schema("accounts")
  // DB-only objects not expressible in the Prisma schema (see migration
  // 20260806090000_add_voucher_header_bills_pdc) — do NOT declare them here
  // or `migrate dev` will regenerate/drift them:
  //   - PARTITION BY LIST (avh_acc_year); partition acc_voucher_header_2026_2027.
  //     There is deliberately no DEFAULT partition: a bad acc_year must fail
  //     loudly rather than land in a catch-all.
  //   - Partial UNIQUE indexes ux_avh_voucher_no, ux_avh_voucher_slno,
  //     ux_avh_src, ux_avh_doc_refno.
  //   - Partial/covering indexes ix_avh_daybook, ix_avh_party,
  //     ix_avh_doc_lookup, ix_avh_my_draft, ix_avh_pending,
  //     ix_avh_tally_pending, ix_avh_msg_pending, ix_avh_against.
  //   - GIN index ix_avh_employee on the avh_employee_id array.
  //   - CHECK constraints ck_avh_status, ck_avh_device_type, ck_avh_msg_status,
  //     ck_avh_tally_status, ck_avh_amounts, ck_avh_tally_consistency,
  //     ck_avh_acc_year, ck_avh_against_year, ck_avh_reversal_year, ck_avh_no,
  //     ck_avh_balanced, ck_avh_posted_on, ck_avh_status_on, ck_avh_cancel,
  //     ck_avh_src, ck_avh_self.
}

// ----- prisma/accounts/AccountVouchers.prisma -----
/// Double-entry ledger rows. Partitioned by acc_year like the header, so the
/// primary key is the composite (avId, avAccYear) and the link back to the
/// header carries both columns.
model AccVoucher {
  avId               String    @default(dbgenerated("uuidv7()")) @db.Uuid @map("av_id")
  avVoucherId        String    @db.Uuid @map("av_voucher_id")
  avCompanyId        String    @db.Uuid @map("av_company_id")
  avBranchId         String    @db.Uuid @map("av_branch_id")
  avTenantId         String?   @db.Uuid @map("av_tenant_id")
  avAccYear          String    @db.Char(9) @map("av_acc_year")
  avVoucherTypeId    Int       @map("av_voucher_type_id")
  avVoucherNo        BigInt    @map("av_voucher_no")
  avRowNo            Int       @map("av_row_no")
  avVoucherDate      DateTime  @db.Timestamptz(6) @map("av_voucher_date")
  avVoucherRefno     String?   @db.VarChar(50) @map("av_voucher_refno")
  avDocDate         DateTime? @db.Timestamptz(6) @map("av_doc_date")
  avDocRefno        String?   @db.VarChar(100) @map("av_doc_refno")
  // avDocAccYear is the FY of the BILL in avDocId — the bill's own year, not
  // avAccYear. Set exactly when avDocId is (ck_av_doc_pair), and the second
  // half of fk_av_doc: acc_bill_balance is partitioned on abl_acc_year, so the
  // bill is addressed by the pair (20260811090000).
  avDocId           String?   @db.Uuid @map("av_doc_id")
  avDocAccYear      String?   @db.Char(9) @map("av_doc_acc_year")
  // Accounting line — ck_av_dr_cr: DR | CR
  avDrCr             String    @db.Char(2) @map("av_dr_cr")
  avLedgerId         String    @db.Uuid @map("av_ledger_id")
  avOppLedgerId      String    @db.Uuid @map("av_opp_ledger_id")
  avAmount           Decimal   @default(0) @db.Decimal(18, 2) @map("av_amount")
  // GENERATED ALWAYS ... STORED in the DB. Read-only: never send it on a
  // create or update, the write will be rejected by Postgres.
  avSignedAmount     Decimal?  @default(dbgenerated()) @db.Decimal(18, 2) @map("av_signed_amount")
  avCostCentreId     String?   @db.Uuid @map("av_cost_centre_id")
  avRemarks          String?   @map("av_remarks")
  avSessionId        String?   @db.Uuid @map("av_session_id")
  avUserId           String    @db.Uuid @map("av_user_id")
  // Bank / cash reconciliation
  avReconDate        DateTime? @db.Date @map("av_recon_date")
  avReconRefno       String?   @db.VarChar(50) @map("av_recon_refno")
  // GENERATED ALWAYS ... STORED in the DB. Read-only, as above.
  avIsReconciled     Boolean?  @default(dbgenerated()) @map("av_is_reconciled")
  // Audit
  avIsActive         Boolean   @default(true) @map("av_is_active")
  avIsDeleted        Boolean   @default(false) @map("av_is_deleted")
  avSyncDate         DateTime? @db.Timestamptz(6) @map("av_sync_date")
  avCreatedOn        DateTime  @default(now()) @db.Timestamptz(6) @map("av_created_on")
  avCreatedBy        String?   @db.Text @map("av_created_by")
  avModifiedOn       DateTime? @db.Timestamptz(6) @map("av_modified_on")
  avModifiedBy       String?   @db.Text @map("av_modified_by")
  // Relations
  voucherHeader      AccVoucherHeader @relation(fields: [avVoucherId, avAccYear], references: [avhVoucherId, avhAccYear], onUpdate: Cascade, onDelete: Cascade, map: "fk_av_header")
  ledger             AccLedgerMaster  @relation("AccVoucherLedger", fields: [avLedgerId], references: [ledId], onUpdate: Cascade, onDelete: Restrict, map: "fk_av_ledger")
  oppositeLedger     AccLedgerMaster  @relation("AccVoucherOppLedger", fields: [avOppLedgerId], references: [ledId], onUpdate: Cascade, onDelete: Restrict, map: "fk_av_opp_ledger")
  voucherType        AccVoucherType   @relation(fields: [avVoucherTypeId], references: [vchrTypeId], onUpdate: Cascade, onDelete: Restrict, map: "fk_av_voucher_type")
  bill               AccBillBalance?  @relation(fields: [avDocId, avDocAccYear], references: [ablId, ablAccYear], onUpdate: Cascade, onDelete: Restrict, map: "fk_av_doc")
  @@id([avId, avAccYear], map: "pk_acc_vouchers")
  @@index([avVoucherId, avAccYear], map: "ix_av_voucher")
  @@map("acc_vouchers")
  @@schema("accounts")
  // DB-only objects not expressible in the Prisma schema (see migration
  // 20260806090000_add_voucher_header_bills_pdc):
  //   - PARTITION BY LIST (av_acc_year); partition acc_vouchers_2026_2027.
  //   - Generated columns av_signed_amount (DR positive, CR negative) and
  //     av_is_reconciled (av_recon_date IS NOT NULL).
  //   - Partial UNIQUE index ux_av_voucher_row.
  //   - Partial/covering indexes ix_av_ledger, ix_av_daybook, ix_av_opp_ledger,
  //     ix_av_bill, ix_av_unrecon.
  //   - CHECK constraints ck_av_dr_cr, ck_av_amount, ck_av_row_no,
  //     ck_av_acc_year, ck_av_self, ck_av_recon, and ck_av_doc_pair (av_doc_id
  //     and av_doc_acc_year move together — see
  //     20260811060000_partition_account_bill_tables_by_acc_year).
  //   - No FK on av_company_id / av_branch_id / av_user_id / av_cost_centre_id:
  //     the source DDL declares none.
}

// ----- prisma/accounts/AccountVoucherSequence.prisma -----
model AccVoucherSeq {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid @map("seq_id")
  // Link to voucher type master
  vchrTypeId    Int      @map("seq_vchr_type_id")
  // Multi branch scope
  companyId     String   @db.Uuid @map("seq_company_id")
  branchId      String   @db.Uuid @map("seq_branch_id")
  accYear       String   @db.VarChar(9) @map("seq_acc_year")
  // Device/counter scope
  deviceId      String?  @db.Uuid @map("seq_device_id")
  deviceCode    String   @default("MAIN") @db.VarChar(20) @map("seq_device_code")
  // Reset period key: 2026-27 / 2026-04 / 2026-04-27 / ALL
  periodKey     String   @db.VarChar(20) @map("seq_period_key")
  // Running number
  lastNo        BigInt   @default(0) @map("seq_last_no")
  // Applied format snapshot
  voucherPrefix String?  @db.VarChar(20) @map("seq_voucher_prefix")
  companyCode   String?  @db.VarChar(20) @map("seq_company_code")
  branchCode    String?  @db.VarChar(20) @map("seq_branch_code")
  voucherSuffix String?  @db.VarChar(20) @map("seq_voucher_suffix")
  noWidth       Int      @default(5) @map("seq_no_width")
  // Last generated printable number
  lastRefno     String?  @db.VarChar(100) @map("seq_last_refno")
  // Status
  isActive      Boolean  @default(true) @map("seq_is_active")
  // Add this only if SQL table also has seq_is_deleted
  isDeleted     Boolean  @default(false) @map("seq_is_deleted")
  // Audit
  createdOn     DateTime  @default(now()) @db.Timestamptz @map("seq_created_on")
  createdBy     String?   @db.Uuid @map("seq_created_by")
  modifiedOn    DateTime? @db.Timestamptz @map("seq_modified_on")
  modifiedBy    String?   @db.Uuid @map("seq_modified_by")
  // Relations
  voucherType   AccVoucherType @relation(fields: [vchrTypeId], references: [vchrTypeId], map: "fk_acc_voucher_seq_type")
  company       Company        @relation(fields: [companyId], references: [compId], map: "fk_acc_voucher_seq_company")
  branch        BranchMaster   @relation(fields: [branchId], references: [brId], map: "fk_acc_voucher_seq_branch")
  // Main duplicate prevention constraint
  @@unique([vchrTypeId, companyId, branchId, accYear, deviceCode, periodKey], map: "uq_acc_voucher_seq_scope")
  // Useful indexes
  @@index([companyId, branchId, accYear], map: "idx_acc_voucher_seq_company_branch_year")
  @@index([vchrTypeId], map: "idx_acc_voucher_seq_vchr_type")
  @@index([deviceId], map: "idx_acc_voucher_seq_device")
  @@index([periodKey], map: "idx_acc_voucher_seq_period_key")
  @@index([isActive, isDeleted], map: "idx_acc_voucher_seq_status")
  @@map("acc_voucher_seq")
  @@schema("accounts")
}

