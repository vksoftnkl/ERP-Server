  sbiSchDiscQty      Decimal   @default(0) @db.Decimal(15, 3) @map("sbi_sch_disc_qty")
  sbiSchDiscAmt      Decimal   @default(0) @db.Decimal(15, 2) @map("sbi_sch_disc_amt")
  sbiBillSchPerc     Decimal   @default(0) @db.Decimal(15, 4) @map("sbi_bill_sch_perc")
  sbiBillSchQty      Decimal   @default(0) @db.Decimal(15, 3) @map("sbi_bill_sch_qty")
  sbiBillSchAmt      Decimal   @default(0) @db.Decimal(15, 2) @map("sbi_bill_sch_amt")
  sbiAddlDisc1Perc   Decimal   @default(0) @db.Decimal(15, 4) @map("sbi_addl_disc1_perc")
  sbiAddlDisc1Amt    Decimal   @default(0) @db.Decimal(15, 2) @map("sbi_addl_disc1_amt")
  sbiAddlDisc2Perc   Decimal   @default(0) @db.Decimal(15, 4) @map("sbi_addl_disc2_perc")
  sbiAddlDisc2Amt    Decimal   @default(0) @db.Decimal(15, 2) @map("sbi_addl_disc2_amt")
  sbiCashDiscPerc    Decimal   @default(0) @db.Decimal(15, 4) @map("sbi_cash_disc_perc")
