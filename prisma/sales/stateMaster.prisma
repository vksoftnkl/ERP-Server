model StateMaster {
  // PK is assigned explicitly to the parent acc_group_id (1:1 shared-PK link). No uuidv7()
  // default — a default would make Prisma generate its own id and ignore the assigned value.
  stmId         String    @id @db.Uuid                                     @map("stm_id")
  stmName       String                                                      @map("stm_name")
  stmAlias      String?                                                     @map("stm_alias")
  stmShort      String?   @db.VarChar(20)                                  @map("stm_short")
  stmOrder      Decimal   @default(0.0) @db.Decimal                        @map("stm_order")
  stmDescription    String?   @db.Text                                 @map("stm_description")
  stmIsActive   Boolean   @default(true)                                    @map("stm_is_active")
  stmIsDeleted  Boolean   @default(false)                                   @map("stm_is_deleted")
  stmSyncDate   DateTime? @db.Timestamptz                                  @map("stm_sync_date")
  stmCreatedOn  DateTime  @default(now()) @db.Timestamptz                  @map("stm_created_on")
  stmCreatedBy  String?   @db.VarChar(100)                                 @map("stm_created_by")
  stmModifiedOn DateTime  @default(now()) @db.Timestamptz                  @map("stm_modified_on")
  stmModifiedBy String?   @db.VarChar(100)                                 @map("stm_modified_by")

  // Relations
  cities        CityMaster[]

  @@index([stmIsActive], name: "idx_stm_active")
  @@map("state_master")
  @@schema("sales")
}