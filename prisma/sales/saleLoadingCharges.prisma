model SaleLoadingCharge {
  ilcId         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid   @map("ilc_id")
  ilcCompId     String?   @db.Uuid                                         @map("ilc_comp_id")
  ilcBranchId   String?   @db.Uuid                                         @map("ilc_branch_id")
  ilcFromWeight Decimal?  @default(0.0) @db.Decimal                        @map("ilc_from_weight")
  ilcToWeight   Decimal?  @default(0.0) @db.Decimal                        @map("ilc_to_weight")
  ilcLoadChrg   Decimal?  @default(0.0) @db.Decimal                        @map("ilc_load_chrg")
  ilcUnloadChrg Decimal?  @default(0.0) @db.Decimal                        @map("ilc_unload_chrg")
  ilcIsActive   Boolean   @default(true)                                   @map("ilc_is_active")
  ilcIsDeleted  Boolean   @default(false)                                  @map("ilc_is_deleted")
  ilcSyncDate   DateTime? @db.Timestamptz                                  @map("ilc_sync_date")
  ilcCreatedOn  DateTime  @default(now()) @db.Timestamptz                  @map("ilc_created_on")
  ilcCreatedBy  String?   @db.VarChar(100)                                 @map("ilc_created_by")
  ilcModifiedOn DateTime  @default(now()) @db.Timestamptz                  @map("ilc_modified_on")
  ilcModifiedBy String?   @db.VarChar(100)                                 @map("ilc_modified_by")

  // Relations
  company       Company?      @relation("CompanyLoadingCharges", fields: [ilcCompId], references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_ilc_comp_id")
  branch        BranchMaster? @relation("BranchLoadingCharges", fields: [ilcBranchId], references: [brId], onUpdate: Cascade, onDelete: Restrict, map: "fk_ilc_branch_id")

  @@index([ilcIsActive], name: "idx_ilc_active")
  @@map("sale_loading_charges")
  @@schema("sales")
}