model SaleFreightCharge {
  frId          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid   @map("fr_id")
  frBranchId    String?   @db.Uuid                                         @map("fr_branch_id")
  frCompanyId   String?   @db.Uuid                                         @map("fr_company_id")
  frFromKm      Int?      @default(0)                                     @map("fr_from_km")
  frToKm        Int?      @default(0)                                     @map("fr_to_km")
  frFromWeight  Decimal?  @default(0.0) @db.Decimal                        @map("fr_from_weight")
  frToWeight    Decimal?  @default(0.0) @db.Decimal                        @map("fr_to_weight")
  frFreightChrg Decimal?  @default(0.0) @db.Decimal                        @map("fr_freight_chrg")
  frIsActive    Boolean   @default(true)                                   @map("fr_is_active")
  frIsDeleted   Boolean   @default(false)                                  @map("fr_is_deleted")
  frSyncDate    DateTime? @db.Timestamptz                                  @map("fr_sync_date")
  frCreatedOn   DateTime  @default(now()) @db.Timestamptz                  @map("fr_created_on")
  frCreatedBy   String?   @db.VarChar(100)                                 @map("fr_created_by")
  frModifiedOn  DateTime  @default(now()) @db.Timestamptz                  @map("fr_modified_on")
  frModifiedBy  String?   @db.VarChar(100)                                 @map("fr_modified_by")

  // Relations
  company       Company?      @relation("CompanyFreightCharges", fields: [frCompanyId], references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_fr_company_id")
  branch        BranchMaster? @relation("BranchFreightCharges", fields: [frBranchId], references: [brId], onUpdate: Cascade, onDelete: Restrict, map: "fk_fr_branch_id")

  @@index([frIsActive], name: "idx_fr_active")
  // DB-only partial unique index uq_fr_slab_scope (migration 20260721140000):
  // (frCompanyId, frBranchId, frFromKm, frToKm, frFromWeight, frToWeight),
  // NULLS NOT DISTINCT, WHERE fr_is_deleted = false. Prisma cannot express the
  // WHERE predicate; declaring it as @@unique here would make `migrate dev`
  // regenerate it without the predicate and fail on the existing name.
  // Do NOT add @@unique for it.
  @@map("sale_freight_charges")
  @@schema("sales")
}
