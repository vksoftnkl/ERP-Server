model Customer {
  cusId                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid  @map("cus_id")
  // 1) Identity / Code
  cusTitle             String?   @db.VarChar(5)                                   @map("cus_title")
  cusShort             String?   @db.VarChar(50)                                  @map("cus_short")
  cusCode              String?   @db.VarChar(50)                                  @map("cus_code")
  cusName              String?   @db.VarChar(200)                                 @map("cus_name")
  // 2) Address / Contact
  cusAddr1             String?   @db.VarChar(250)                                 @map("cus_addr1")
  cusAddr2             String?   @db.VarChar(250)                                 @map("cus_addr2")
  cusAddr3             String?   @db.VarChar(250)                                 @map("cus_addr3")
  cusCity              String?   @db.VarChar(250)                                 @map("cus_city")
  cusDistrict          String?   @db.VarChar(250)                                 @map("cus_district")
  cusStateName         String    @db.VarChar(100)                                 @map("cus_state_name")
  cusCountry           String?   @default("India") @db.VarChar(60)               @map("cus_country")
  cusStateCode         String    @db.Char(2)                                      @map("cus_state_code")
  cusLandmark          String?   @db.VarChar(200)                                 @map("cus_landmark")
  cusPin               String?   @db.VarChar(10)                                  @map("cus_pin")
  cusTel               String?   @db.VarChar(20)                                  @map("cus_tel")
  cusPhone1            String?   @db.VarChar(20)                                  @map("cus_phone1")
  cusPhone2            String?   @db.VarChar(20)                                  @map("cus_phone2")
  cusWhatsappNo        String?   @db.VarChar(20)                                  @map("cus_whatsapp_no")
  cusEmail             String?   @db.VarChar(120)                                 @map("cus_email")
  cusAadharNo          String?   @db.VarChar(12)                                  @map("cus_aadhar_no")
  cusContactPerson     String?   @db.VarChar(150)                                 @map("cus_contact_person")
  cusDistanceKm        Int?                                                        @map("cus_distance_km")
  // 3) Credit / Billing Control
  cusCreditAllowed     Boolean   @default(false)                                   @map("cus_credit_allowed")
  cusCreditBillLimit   Int       @default(0)                                       @map("cus_credit_bill_limit")
  cusCreditAmtLimit    Decimal   @default(0) @db.Decimal(15, 4)                    @map("cus_credit_amt_limit")
  cusCreditDays        Int       @default(0)                                       @map("cus_credit_days")
  cusDebitBalance      Decimal   @default(0) @db.Decimal(15, 4)                    @map("cus_debit_balance")
  cusDiscPerc          Decimal   @default(0) @db.Decimal(7, 3)                     @map("cus_disc_perc")
  cusDebitGraceDays    Int       @default(0)                                       @map("cus_debit_grace_days")
  cusEnableSms         Boolean   @default(false)                                   @map("cus_enable_sms")
  cusOverdueSms        Boolean   @default(false)                                   @map("cus_overdue_sms")
  cusOverdueBilling    Boolean   @default(false)                                   @map("cus_overdue_billing")
  cusAllowPromotion    Boolean   @default(false)                                   @map("cus_allow_promotion")
  cusAllowLoyalty      Boolean   @default(false)                                   @map("cus_allow_loyalty")
  cusAllowDiscount     Boolean   @default(true)                                    @map("cus_allow_discount")
  cusSortOrder         Int       @default(0)                                       @map("cus_sort_order")
  // 4) Region / Tally Ledger style
  cusRegionName        String?   @db.VarChar(200)                                 @map("cus_region_name")
  cusRegionAddr1       String?   @db.VarChar(250)                                 @map("cus_region_addr1")
  cusRegionAddr2       String?   @db.VarChar(250)                                 @map("cus_region_addr2")
  cusRegionAddr3       String?   @db.VarChar(250)                                 @map("cus_region_addr3")
  cusRegionCity        String?   @db.VarChar(250)                                 @map("cus_region_city")
  cusRegionDistrict    String?   @db.VarChar(250)                                 @map("cus_region_district")
  cusRegionStateName   String?   @db.VarChar(100)                                 @map("cus_region_state_name")
  cusRegionCountry     String?   @default("India") @db.VarChar(60)                @map("cus_region_country")
  // 5) Dates / Logistics / Charges
  cusBirthDate         DateTime? @db.Date                                          @map("cus_birth_date")
  cusMarriageDate      DateTime? @db.Date                                          @map("cus_marriage_date")
  cusTransportName     String?   @db.VarChar(200)                                  @map("cus_transport_name")
  cusFreightCharge     Boolean   @default(false)                                   @map("cus_freight_charge")
  cusLoadingCharge     Boolean   @default(false)                                   @map("cus_loading_charge")
  cusUnloadingCharge   Boolean   @default(false)                                   @map("cus_unloading_charge")
  // 6) GST / Tax
  cusGstNo             String?   @db.VarChar(15)                                   @map("cus_gst_no")
  cusPanNo             String?   @db.VarChar(10)                                   @map("cus_pan_no")
  cusGstType           String?   @db.VarChar(30)                                   @map("cus_gst_type")
  cusEcommerceGstin    String?   @db.VarChar(15)                                   @map("cus_ecommerce_gstin")
  cusTcsApplicable     Boolean   @default(false)                                   @map("cus_tcs_applicable")
  cusItcollExempted    Boolean   @default(false)                                   @map("cus_itcoll_exempted")
  cusItcollType        String?   @db.VarChar(30)                                    @map("cus_itcoll_type")
  // 7) Geo / Salesman / Price Level
  cusGeoLocation       String?   @db.VarChar(200)                                  @map("cus_geo_location")
  cusCollectionDays    Int[]                                                       @map("sup_collection_days")
  cusDefaultSalesman   String?   @db.Uuid                                          @map("cus_default_salesman")
  cusPriceLevelId      Int                                                         @map("cus_price_level_id")
  // 8) Billing Stats / Notes
  cusBilledDate        DateTime? @db.Date                                          @map("cus_billed_date")
  cusBilledCount       Int       @default(0)                                       @map("cus_billed_count")
  cusNotes             String?   @db.VarChar(250)                                  @map("cus_notes")
  // 9) Scope / Status / Sync / Audit
  cusCompanyId         String?   @db.Uuid                                          @map("cus_company_id")
  cusBranchId          String?   @db.Uuid                                          @map("cus_branch_id")
  cusAreaId            String    @db.Uuid                                          @map("cus_area_id")
  cusGroupId           String    @db.Uuid                                          @map("cus_group_id")
  cusIsActive          Boolean   @default(true)                                    @map("cus_is_active")
  cusIsDeleted         Boolean   @default(false)                                   @map("cus_is_deleted")
  cusSyncDate          DateTime? @db.Timestamptz                                  @map("cus_sync_date")
  cusCreatedOn         DateTime  @default(now()) @db.Timestamptz                  @map("cus_created_on")
  cusCreatedBy         String?   @db.VarChar(100)                                 @map("cus_created_by")
  cusModifiedOn        DateTime  @default(now()) @db.Timestamptz                  @map("cus_modified_on")
  cusModifiedBy        String?   @db.VarChar(100)                                 @map("cus_modified_by")
  // Relations
  area                 AreaMaster     @relation(fields: [cusAreaId],  references: [armId])
  custGroup            CustGroup      @relation(fields: [cusGroupId], references: [cgrId])
  company              Company?       @relation(fields: [cusCompanyId], references: [compId])
  priceLevel           ItemPriceLevel @relation("CustomerPriceLevel", fields: [cusPriceLevelId], references: [iplId])
  saleQuotations       SaleQuotation[]
  saleBills            SaleBill[]
  saleOrders           SaleOrder[]
  itemQtyPrices        ItemQtyPrice[] @relation("CustomerItemQtyPrices")
  promotionSchemeParties PromotionSchemeParty[] @relation("PromotionPartyCustomer")
  loyaltySchemeParties   LoyaltySchemeParty[]   @relation("LoyaltyPartyCustomer")
  @@index([cusAreaId],   name: "idx_cus_area")
  @@index([cusPhone1],   name: "idx_cus_phone1")
  @@index([cusGstNo],    name: "idx_cus_gst_no")
  @@index([cusIsActive], name: "idx_cus_active")
  @@map("customers")
  @@schema("sales")
}