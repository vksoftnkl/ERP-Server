model LoyaltyScheme {
  lsId                           String              @id @default(dbgenerated("uuidv7()")) @db.Uuid @map("ls_id")
  lsCode                         String?             @db.VarChar(30)                         @map("ls_code")
  lsName                         String              @db.VarChar(150)                        @map("ls_name")
  lsType                         String              @db.VarChar(20)                         @map("ls_type")
  lsStatus                       String              @default("DRAFT") @db.VarChar(20)      @map("ls_status")
  lsAutoApply                    Boolean             @default(true)                          @map("ls_auto_apply")
  lsApplyOn                      String              @default("BILL_AMOUNT") @db.VarChar(20) @map("ls_apply_on")
  lsCalcOnAmountType             String              @default("NET_AMOUNT") @db.VarChar(20) @map("ls_calc_on_amount_type")
  lsBillType                     String              @default("ALL") @db.VarChar(20)        @map("ls_bill_type")
  lsCustType                     String              @default("ALL") @db.VarChar(20)        @map("ls_cust_type")
  lsItemType                     String              @default("ALL") @db.VarChar(20)        @map("ls_item_type")
  lsStartDate                    DateTime            @db.Date                                @map("ls_start_date")
  lsEndDate                      DateTime            @db.Date                                @map("ls_end_date")
  lsValidFromTime                DateTime?           @db.Time(6)                             @map("ls_valid_from_time")
  lsValidToTime                  DateTime?           @db.Time(6)                             @map("ls_valid_to_time")
  lsValidWeekdays                String?             @db.VarChar(30)                         @map("ls_valid_weekdays")
  lsCompId                       String              @db.Uuid                                @map("ls_comp_id")
  lsBranchId                     String?             @db.Uuid                                @map("ls_branch_id")
  lsIncludeTaxForPoints          Boolean             @default(false)                         @map("ls_include_tax_for_points")
  lsRoundingMethod               String              @default("FLOOR") @db.VarChar(10)      @map("ls_rounding_method")
  lsRecurApl                     Boolean             @default(false)                         @map("ls_recur_apl")
  lsBalApl                       Boolean             @default(false)                         @map("ls_bal_apl")
  lsAllowPointRedeem             Boolean             @default(false)                         @map("ls_allow_point_redeem")
  lsAllowGiftRedeem              Boolean             @default(false)                         @map("ls_allow_gift_redeem")
  lsRedeemValuePerPoint          Decimal             @default(0) @db.Decimal(18, 4)         @map("ls_redeem_value_per_point")
  lsMinRedeemPoints              Decimal             @default(0) @db.Decimal(18, 4)         @map("ls_min_redeem_points")
  lsMaxRedeemPointsPerBill       Decimal             @default(0) @db.Decimal(18, 4)         @map("ls_max_redeem_points_per_bill")
  lsMaxRedeemPercentPerBill      Decimal             @default(0) @db.Decimal(18, 4)         @map("ls_max_redeem_percent_per_bill")
  lsRedeemMinBillAmount          Decimal             @default(0) @db.Decimal(18, 2)         @map("ls_redeem_min_bill_amount")
  lsPointsValidDays              Int                 @default(0)                             @map("ls_points_valid_days")
  lsExpiryBasis                  String              @default("EARN_DATE") @db.VarChar(20)  @map("ls_expiry_basis")
  lsRemarks                      String?             @db.Text                                @map("ls_remarks")
  lsIsActive                     Boolean             @default(true)                          @map("ls_is_active")
  lsIsDeleted                    Boolean             @default(false)                         @map("ls_is_deleted")
  lsSyncDate                     DateTime?           @db.Timestamptz(6)                      @map("ls_sync_date")
  lsCreatedOn                    DateTime            @default(now()) @db.Timestamptz(6)     @map("ls_created_on")
  lsCreatedBy                    String?             @db.Uuid                                @map("ls_created_by")
  lsUpdatedOn                    DateTime?           @db.Timestamptz(6)                      @map("ls_updated_on")
  lsUpdatedBy                    String?             @db.Uuid                                @map("ls_updated_by")
  lsApprovedOn                   DateTime?           @db.Timestamptz(6)                      @map("ls_approved_on")
  lsApprovedBy                   String?             @db.Uuid                                @map("ls_approved_by")

  company                        Company             @relation(fields: [lsCompId], references: [compId], onUpdate: Cascade, onDelete: Restrict, map: "fk_loyalty_sch_list_company")
  branch                         BranchMaster?       @relation(fields: [lsBranchId], references: [brId], onUpdate: Cascade, onDelete: Restrict, map: "fk_loyalty_sch_list_branch")
  parties                        LoyaltySchemeParty[]
  points                         LoyaltySchemePoint[]
  gifts                          LoyaltySchemeGift[]

  @@index([lsCompId, lsBranchId, lsIsActive, lsIsDeleted, lsStartDate, lsEndDate], map: "ix_loyalty_sch_list_active_dates")
  @@map("loyalty_sch_list")
  @@schema("sales")
}
