model QuotationDetail {
  quotationDetailId          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid @map("quotation_detail_id")
  quotationId String    @db.Uuid @map("quotation_id")
  quotation   Quotation @relation(fields: [quotationId], references: [quotationId], onDelete: Cascade)
  quotationDetailLineNo      Int       @map("quotation_detail_line_no")

  quotationDetailItemId        String     @db.Uuid @map("item_id")
  quotationDetailItem          ItemMaster @relation(fields: [quotationDetailItemId], references: [itemId])
  quotationDetailDescription   String   @db.VarChar(200) @map("quotation_detail_description")
  quotationDetailStockSnapshot Decimal? @map("stock_snapshot") @db.Decimal(18, 3)

  quotationDetailQty   Decimal @db.Decimal(18, 3) @map("quotation_detail_qty")
  quotationDetailUomId String  @db.Uuid @map("uom_id")
  quotationDetailUom   Unit    @relation(fields: [quotationDetailUomId], references: [unit_id])
  quotationDetailRate  Decimal @db.Decimal(18, 4) @map("quotation_detail_rate")

  quotationDetailDiscountPercent Decimal @default(0) @map("quotation_detail_discount_percent") @db.Decimal(6, 3)
  quotationDetailDiscountAmount  Decimal @default(0) @map("quotation_detail_discount_amount") @db.Decimal(18, 2)
  quotationDetailTaxableValue    Decimal @map("quotation_detail_taxable_value") @db.Decimal(18, 2)

  quotationDetailTaxCodeId  String?        @db.Uuid @map("quotation_detail_tax_code_id")
  quotationDetailTaxCode    ItemTaxMaster? @relation(fields: [quotationDetailTaxCodeId], references: [taxId])
  quotationDetailGstPercent Decimal  @default(0) @map("quotation_detail_gst_percent") @db.Decimal(6, 3)
  quotationDetailCgstAmount Decimal  @default(0) @map("quotation_detail_cgst_amount") @db.Decimal(18, 2)
  quotationDetailSgstAmount Decimal  @default(0) @map("quotation_detail_sgst_amount") @db.Decimal(18, 2)
  quotationDetailIgstAmount Decimal  @default(0) @map("quotation_detail_igst_amount") @db.Decimal(18, 2)
  quotationDetailCessAmount Decimal  @default(0) @map("quotation_detail_cess_amount") @db.Decimal(18, 2)

  quotationDetailLineTotal Decimal @map("quotation_detail_line_total") @db.Decimal(18, 2)

  @@unique([quotationId, quotationDetailLineNo], name: "uq_quotation_line")
  @@index([quotationDetailItemId])
  @@map("quotation_detail")
  @@schema("sales")
}
