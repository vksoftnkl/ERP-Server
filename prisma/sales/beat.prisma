model Beat {
  beatId         Int         @id @default(autoincrement()) @map("beat_id")
  beatName       String      @unique @map("beat_name") @db.VarChar(80)
  beatSiteId     Int?        @map("beat_site_id")
  beatIsActive   Boolean     @default(true) @map("beat_is_active")
  beatIsDeleted  Boolean     @default(false) @map("beat_is_deleted")
  beatCreatedOn  DateTime    @default(now()) @db.Timestamptz(6) @map("beat_created_on")
  beatCreatedBy  String?     @db.Uuid @map("beat_created_by")
  beatUpdatedOn  DateTime?   @db.Timestamptz(6) @map("beat_updated_on")
  beatUpdatedBy  String?     @db.Uuid @map("beat_updated_by")
  beatSyncDate   DateTime?   @db.Timestamptz(6) @map("beat_sync_date")
  quotations     Quotation[]
  @@map("beat_master")
  @@schema("sales")
}