// Advance allocation — where the money taken up front actually went.
//
// One row per application of one advance tender. The tender row
// (accounts.acc_tender_detail) is the money coming IN; this is the money being
// USED. Both sides carry their own accounting year because an advance taken in
// March is routinely adjusted into an April invoice.
//
// Sum(soaAmount) per order, grouped by soaAllocType, reproduces the four
// SaleOrder advance roll-ups exactly — that is the point of the table.
//
// LIST-partitioned by soa_acc_year — see the note on SaleOrder.
model SaleOrderAdvanceAlloc {
  soaId             String    @default(dbgenerated("uuidv7()")) @db.Uuid @map("soa_id")
  soaCompanyId      String    @db.Uuid @map("soa_company_id")
  soaBranchId       String    @db.Uuid @map("soa_branch_id") // branch that applied it
  soaTenantId       String?   @db.Uuid @map("soa_tenant_id")
  soaAccYear        String    @db.Char(9) @map("soa_acc_year") // year of the APPLICATION
  // The order the advance was taken against.
  soaOrderId        String    @db.Uuid @map("soa_order_id")
  soaOrderAccYear   String    @db.Char(9) @map("soa_order_acc_year")
  soaOrderRefno     String?   @db.VarChar(100) @map("soa_order_refno")
  // The tender row that brought the money in. Nullable only for opening
  // balances migrated from the legacy system, which have no tender history.
  soaTenderId       String?   @db.Uuid @map("soa_tender_id")
  soaTenderAccYear  String?   @db.Char(9) @map("soa_tender_acc_year")
  soaAllocType      String    @db.VarChar(20) @map("soa_alloc_type") // ADJUSTED | REFUNDED | FORFEITED | TRANSFERRED (ck_soa_alloc_type in DB)
  soaAllocDate      DateTime  @db.Date @map("soa_alloc_date")
  soaAmount         Decimal   @default(0) @db.Decimal(15, 2) @map("soa_amount")
  // ADJUSTED → the invoice it was set against (cross-year FK).
  soaBillId         String?   @db.Uuid @map("soa_bill_id")
  soaBillAccYear    String?   @db.Char(9) @map("soa_bill_acc_year")
  soaBillRefno      String?   @db.VarChar(100) @map("soa_bill_refno")
  // TRANSFERRED → the order it was moved to (chain stores move a booking from
  // one order to another rather than refunding and re-taking cash).
  soaTargetOrderId  String?   @db.Uuid @map("soa_target_order_id")
  soaTargetAccYear  String?   @db.Char(9) @map("soa_target_acc_year")
  // REFUNDED → how the money went back out. The refund is itself a tender row
  // (CR); this is its reference.
  soaRefundTenderId String?   @db.Uuid @map("soa_refund_tender_id")
  soaRefundMode     String?   @db.VarChar(20) @map("soa_refund_mode") // CASH | BANK | UPI | CARD | CREDIT_NOTE | ADJUSTMENT (ck_soa_refund_mode in DB)
  // Filled at posting, server-side, like every other accounts link here.
  soaVoucherId      String?   @db.Uuid @map("soa_voucher_id")
  soaLedgerId       String?   @db.Uuid @map("soa_ledger_id") // advance ledger relieved
  soaRemarks        String?   @db.VarChar(250) @map("soa_remarks")
  soaApprovedBy     String?   @db.Uuid @map("soa_approved_by") // refunds/forfeits need a sign-off
  // Audit
  soaIsDeleted      Boolean   @default(false) @map("soa_is_deleted")
  soaSyncDate       DateTime? @db.Timestamptz(6) @map("soa_sync_date")
  soaCreatedOn      DateTime  @default(now()) @db.Timestamptz(6) @map("soa_created_on")
  soaCreatedBy      String    @db.VarChar(50) @map("soa_created_by")
  soaModifiedOn     DateTime? @db.Timestamptz(6) @map("soa_modified_on")
  soaModifiedBy     String?   @db.VarChar(50) @map("soa_modified_by")
  // Relations
  order       SaleOrder        @relation("SaleOrderAdvanceAllocOrder", fields: [soaOrderId, soaOrderAccYear], references: [soId, soAccYear], onDelete: Restrict, onUpdate: Cascade, map: "fk_soa_order")
  targetOrder SaleOrder?       @relation("SaleOrderAdvanceAllocTargetOrder", fields: [soaTargetOrderId, soaTargetAccYear], references: [soId, soAccYear], onDelete: Restrict, onUpdate: Cascade, map: "fk_soa_target_order")
  bill        SaleBill?        @relation(fields: [soaBillId, soaBillAccYear], references: [sbId, sbAccYear], onDelete: Restrict, onUpdate: Cascade, map: "fk_soa_bill")
  tender      AccTenderDetail? @relation(fields: [soaTenderId, soaTenderAccYear], references: [tdId, tdAccYear], onDelete: Restrict, onUpdate: Cascade, map: "fk_soa_tender")
  ledger      AccLedgerMaster? @relation("SaleOrderAdvanceAllocLedger", fields: [soaLedgerId], references: [ledId], onDelete: Restrict, onUpdate: Cascade, map: "fk_soa_ledger")
  // No relation fields for soaVoucherId / soaRefundTenderId / soaApprovedBy /
  // soaCompanyId / soaBranchId / soaTenantId — the DDL declares no FKs for them.
  //
  // Every index on this table is partial (ix_soa_order, ix_soa_bill,
  // ix_soa_tender, ix_soa_type_date, migration 20260808132323) and therefore
  // DB-only: Prisma cannot express their WHERE predicates, and declaring them
  // here makes `migrate dev` regenerate them without the predicate and fail on
  // the existing names. Do NOT add @@index for them.
  //
  // CHECK constraints (DB-only): ck_soa_alloc_type, ck_soa_amount,
  // ck_soa_refund_mode, ck_soa_target, ck_soa_no_self_transfer,
  // ck_soa_tender_pair.
  @@id([soaId, soaAccYear], map: "pk_sale_order_advance_alloc")
  @@map("sale_order_advance_alloc")
  @@schema("sales")
}
