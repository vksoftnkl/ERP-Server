model TenderTypeMaster {
  ttmTypeId     String    @id @default(dbgenerated("uuidv7()")) @db.Uuid  @map("ttm_type_id")
  ttmTypeName   String                                                      @map("ttm_type_name")
  ttmIsActive   Boolean   @default(true)                                    @map("ttm_is_active")
  ttmIsDeleted  Boolean   @default(false)                                   @map("ttm_is_deleted")
  ttmSyncDate   DateTime? @db.Timestamptz                                  @map("ttm_sync_date")
  ttmCreatedOn  DateTime  @default(now()) @db.Timestamptz                  @map("ttm_created_on")
  ttmCreatedBy  String?   @db.VarChar(100)                                 @map("ttm_created_by")
  ttmModifiedOn DateTime  @default(now()) @db.Timestamptz                  @map("ttm_modified_on")
  ttmModifiedBy String?   @db.VarChar(100)                                 @map("ttm_modified_by")

  // Relations
  tenders       TenderMaster[]

  @@index([ttmIsActive], name: "idx_ttm_type_active")
  @@map("tender_type_master")
  @@schema("accounts")
}