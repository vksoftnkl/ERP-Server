enum GdwStatus {
  NA
  PENDING
  GENERATED
  FAILED
  CANCELED
  EXPIRED
  @@schema("accounts")
}

enum GdwTransportMode {
  ROAD
  RAIL
  AIR
  SHIP
  OTHER
  @@schema("accounts")
}

enum GdwVehicleType {
  REGULAR
  ODC
  OTHER
  @@schema("accounts")
}

model AccVoucherDocEwaybill {
  gdwId               String            @default(dbgenerated("uuidv7()")) @db.Uuid @map("gdw_id")
  gdwGdrId            String            @db.Uuid @map("gdw_gdr_id")
  gdwVoucherId        String            @db.Uuid @map("gdw_voucher_id")

  // Multi-branch snapshot
  gdwAccYear          String            @db.VarChar(9) @map("gdw_acc_year")
  gdwCompanyId        String            @db.Uuid @map("gdw_company_id")
  gdwBranchId         String            @db.Uuid @map("gdw_branch_id")

  gdwStatus           GdwStatus         @default(NA) @map("gdw_status")
  gdwNo               String?           @db.VarChar(100) @map("gdw_no")
  gdwGeneratedOn      DateTime?         @db.Timestamptz(6) @map("gdw_generated_on")
  gdwValidUpto        DateTime?         @db.Timestamptz(6) @map("gdw_valid_upto")

  gdwCancelReason     String?           @db.VarChar(200) @map("gdw_cancel_reason")
  /// TWO l's, as of 20260922020000. The deployed table used to spell it
  /// with one while every other table in this schema used two; a rename
  /// here is also a DATA change in gst_provider_field_map, which stores
  /// this name as a target column.
  gdwCancelledOn      DateTime?         @db.Timestamptz(6) @map("gdw_cancelled_on")

  gdwVehicleNo        String?           @db.VarChar(20) @map("gdw_vehicle_no")
  gdwTransportMode    GdwTransportMode? @map("gdw_transport_mode")
  /// The PORTAL's transporterId, which IS a 15-character GSTIN — not our
  /// TransporterMaster uuid. The document's transporter uuid maps to its
  /// GSTIN, and THAT is what lands here.
  gdwTransporterId    String?           @db.VarChar(15) @map("gdw_transporter_id")
  gdwTransporterName  String?           @db.VarChar(150) @map("gdw_transporter_name")
  gdwDistanceKm       Int?              @map("gdw_distance_km")
  gdwDocNo            String?           @db.VarChar(50) @map("gdw_doc_no")
  gdwDocDate          DateTime?         @db.Date @map("gdw_doc_date")
  gdwVehicleType      GdwVehicleType?   @map("gdw_vehicle_type")
  gdwTransactionType  String?           @db.VarChar(30) @map("gdw_transaction_type")
  gdwSubSupplyType    String?           @db.VarChar(50) @map("gdw_sub_supply_type")

  gdwLastErrorCode    String?           @db.VarChar(50) @map("gdw_last_error_code")
  gdwLastMessage      String?           @db.VarChar(500) @map("gdw_last_message")

  // ── Provenance (20260921120000_add_gst_provider_integration) ──────────
  /// public.gst_company_credential that generated this e-way bill. Part-B
  /// updates, extensions and cancellation must go through the same provider.
  /// No FK, for the same reason as gde_gcc_id.
  gdwGccId            String?           @db.Uuid @map("gdw_gcc_id")
  /// Frozen provider code beside the id, readable after the credential is
  /// rotated or retired.
  gdwGpvCode          String?           @db.VarChar(20) @map("gdw_gpv_code")
  /// EWB_PORTAL | IRP_WITH_IRN | IRP_BY_IRN — where it was raised. An e-way
  /// bill generated at the IRP alongside the IRN cannot have its Part-B
  /// updated at the IRP; that goes to the e-way portal. The route out is not
  /// derivable from the number.
  gdwGeneratedVia     String?           @db.VarChar(20) @map("gdw_generated_via")
  /// When to try again; drives the ix_gdw_retry worklist.
  gdwNextAttemptOn    DateTime?         @db.Timestamptz(6) @map("gdw_next_attempt_on")

  gdwIsActive         Boolean           @default(true) @map("gdw_is_active")
  gdwIsDeleted        Boolean           @default(false) @map("gdw_is_deleted")
  gdwSyncDate         DateTime?         @db.Timestamptz(6) @map("gdw_sync_date")
  gdwCreatedOn        DateTime          @default(now()) @db.Timestamptz(6) @map("gdw_created_on")
  gdwCreatedBy        String?           @db.Uuid @map("gdw_created_by")
  // The house audit pair, renamed from gdw_updated_* by 20260922020000.
  gdwModifiedOn       DateTime?         @db.Timestamptz(6) @map("gdw_modified_on")
  gdwModifiedBy       String?           @db.Uuid @map("gdw_modified_by")

  // ── Reconciled with the doc-register design (20260922020000) ─────────
  gdwTenantId         String?           @db.Uuid @map("gdw_tenant_id")
  gdwAttemptCount     Int               @default(0) @map("gdw_attempt_count")
  gdwLastAttemptOn    DateTime?         @db.Timestamptz(6) @map("gdw_last_attempt_on")
  gdwRequestPayload   Json?             @map("gdw_request_payload")
  gdwResponsePayload  Json?             @map("gdw_response_payload")
  /// Part-B transDocNo / transDocDate — the LR or consignment note, sent to
  /// the portal on every vehicle update. What was DECLARED, so it is not
  /// re-derived from a document that may since have been amended.
  gdwTransportDocNo   String?           @db.VarChar(50) @map("gdw_transport_doc_no")
  gdwTransportDocDate DateTime?         @db.Date @map("gdw_transport_doc_date")
  /// The vehicle as OUR master knows it, beside gdwVehicleNo which is the
  /// plate exactly as the portal received it.
  gdwVehicleId        String?           @db.Uuid @map("gdw_vehicle_id")
  /// An e-way bill may be extended; the portal returns a new validity.
  gdwExtendedUpto     DateTime?         @db.Timestamptz(6) @map("gdw_extended_upto")

  // Relations
  docRegister         AccVoucherDocRegister @relation(fields: [gdwGdrId, gdwAccYear], references: [gdrId, gdrAccYear], onDelete: Cascade, map: "fk_gdw_gdr")
  vehicle             VehicleMaster?        @relation("EwayBillVehicle", fields: [gdwVehicleId], references: [vehId], onUpdate: Cascade, onDelete: Restrict, map: "fk_gdw_vehicle")

  // LIST-partitioned on gdw_acc_year as of 20260922100000; both keys carry the
  // partition key. Still one e-way bill row per document.
  @@id([gdwId, gdwAccYear], map: "pk_acc_voucher_doc_ewaybill")
  @@unique([gdwGdrId, gdwAccYear], map: "uq_gdw_gdr")
  @@map("acc_voucher_doc_ewaybill")
  @@schema("accounts")
  // Partial unique index uq_acc_voucher_doc_ewaybill_no -- (gdw_no,
  // gdw_acc_year) since 20260922100000, the year trailing so a lookup by the
  // e-way bill number alone still uses it -- and partial index
  // idx_gdw_status are not expressible in Prisma schema. Nor is the retry
  // worklist added by 20260921120000:
  //
  //   CREATE INDEX ix_gdw_retry
  //       ON accounts.acc_voucher_doc_ewaybill (gdw_company_id, gdw_next_attempt_on)
  //       WHERE gdw_is_deleted = false AND gdw_status = 'FAILED';
}
