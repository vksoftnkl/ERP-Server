enum VoucherCategory {
  ACCOUNTING
  INVENTORY
  BOTH
  @@schema("accounts")
}
enum VoucherNature {
  SALES
  PURCHASE
  RECEIPT
  PAYMENT
  JOURNAL
  CONTRA
  DEBIT_NOTE
  CREDIT_NOTE
  STOCK_JOURNAL
  @@schema("accounts")
}
enum VoucherNumberingMode {
  AUTO
  MANUAL
  AUTO_MANUAL
  @@schema("accounts")
}
enum VoucherResetFreq {
  NEVER
  DAILY
  MONTHLY
  YEARLY
  @@schema("accounts")
}
model AccVoucherType {
  vchrTypeId                 Int                  @id @default(autoincrement()) @map("vchr_type_id")
  vchrTypeCode               String               @db.VarChar(20) @map("vchr_type_code")
  vchrTypeName               String               @db.VarChar(100) @map("vchr_type_name")
  vchrTypeShort              String?              @db.VarChar(30) @map("vchr_type_short")
  // Classification
  vchrCategory               VoucherCategory      @default(ACCOUNTING) @map("vchr_category")
  vchrNature                 VoucherNature        @map("vchr_nature")
  vchrNumberingMode          VoucherNumberingMode @default(AUTO) @map("vchr_numbering_mode")
  // Numbering
  vchrNoPrefix               String?              @db.VarChar(20) @map("vchr_no_prefix")
  vchrNoSuffix               String?              @db.VarChar(20) @map("vchr_no_suffix")
  vchrNoWidth                Int                  @default(5) @map("vchr_no_width")
  vchrResetFreq              VoucherResetFreq     @default(YEARLY) @map("vchr_reset_freq")
  // vchr_allow_manual_no was dropped (20261116100000_voucher_types_master, VT-11):
  // vchrNumberingMode AUTO_MANUAL is "automatic, may be typed over".
  // Functional behavior
  vchrAffectsAccounts        Boolean              @default(true) @map("vchr_affects_accounts")
  vchrAffectsInventory       Boolean              @default(false) @map("vchr_affects_inventory")
  vchrIsCashVoucher          Boolean              @default(false) @map("vchr_is_cash_voucher")
  vchrIsBankVoucher          Boolean              @default(false) @map("vchr_is_bank_voucher")
  // UI / print
  vchrPrintTitle             String?              @db.VarChar(100) @map("vchr_print_title")
  vchrSortOrder              Int                  @default(0) @map("vchr_sort_order")
  vchrIsActive               Boolean              @default(true) @map("vchr_is_active")
  // Tally mapping
  vchrTallyExportEnabled     Boolean              @default(true) @map("vchr_tally_export_enabled")
  vchrTallyVoucherTypeName   String?              @db.VarChar(100) @map("vchr_tally_voucher_type_name")
  vchrTallyBaseVoucherType   String?              @db.VarChar(50) @map("vchr_tally_base_voucher_type")
  // Voucher Register rules (20260925160000_voucher_register) — the TYPE carries the
  // rules the register's posting routine enforces (share/accounts/voucher_register.md §5).
  // The value sets below are CHECK constraints ck_vchr_* in the database.
  /// NONE | ONE | MANY — how many parties a voucher of this type carries
  vchrPartyMode              String               @default("NONE") @db.VarChar(4) @map("vchr_party_mode")
  /// DR | CR | ANY — the side the party leg sits on
  vchrPartySide              String               @default("ANY") @db.VarChar(3) @map("vchr_party_side")
  /// OFF | DEMAND | RAISE | OPTIONAL — what the party leg does bill-wise
  vchrBillwiseMode           String               @default("OFF") @db.VarChar(8) @map("vchr_billwise_mode")
  /// The abl_bill_type a RAISE / OPTIONAL type writes: SALES | PURCHASE | JOURNAL | INTEREST
  vchrRaiseBillType          String?              @db.VarChar(20) @map("vchr_raise_bill_type")
  /// Account groups (acc_group_master ids) a debit leg may use; empty = any. A sub-group of a listed group counts.
  vchrDrGroups               String[]             @default([]) @db.Uuid @map("vchr_dr_groups")
  /// Same, for the credit legs
  vchrCrGroups               String[]             @default([]) @db.Uuid @map("vchr_cr_groups")
  /// NULL | GSTR1 | GSTR1_9B | GSTR2 | GSTR2_NOTE — the GST register the document feeds
  vchrGstRegister            String?              @db.VarChar(10) @map("vchr_gst_register")
  /// INPUT | OUTPUT — which tax roles the GST band generates; set exactly when vchrGstRegister is
  vchrGstSide                String?              @db.VarChar(6) @map("vchr_gst_side")
  /// OFF | DEDUCT
  vchrTdsMode                String               @default("OFF") @db.VarChar(8) @map("vchr_tds_mode")
  /// Rights are checked on THIS menu (decision E). NULL for Rev: a cancel is judged on the original's menu.
  vchrMenuId                 Int?                 @map("vchr_menu_id")
  /// Offered on the register's type band
  vchrInRegister             Boolean              @default(false) @map("vchr_in_register")
  /// notes (54): the typed lines carry INSTRUMENTS (tenders); the money legs are generated
  /// from the tenders' ledgers and a cheque becomes a HELD register row (menu 51)
  vchrInstruments            Boolean              @default(false) @map("vchr_instruments")
  // ── Voucher Types master (20261116100000_voucher_types_master, plan
  // share/accounts/plan-voucher-types-2026-11-14.md §6.1) ─────────────────────
  // A BASE type has no parent and no company and is shared by every company.
  // A CHILD type (one level, under Sales Bill only, Q1) names its base and
  // belongs to one company (ck_vchr_child_company). It carries only name,
  // abbreviation, numbering, print, Tally name and active; its accounting
  // columns are a server-written mirror of the base's (decision 31), and a
  // migration that changes a base's accounting changes its children too.
  /// The base this child type sits under; NULL = a base type
  vchrParentId               Int?                 @map("vchr_parent_id")
  /// The company a child type belongs to; NULL = a base type ("All companies")
  vchrCompanyId              String?              @db.Uuid @map("vchr_company_id")
  /// First number of every NEW counter (lastNo = start - 1 at creation); >= 1
  vchrStartNo                Int                  @default(1) @map("vchr_start_no")
  /// The print design (public.print_purpose) this type prints with; NULL = the base's, else SALE_INVOICE
  vchrPrintPurposeId         String?              @db.Uuid @map("vchr_print_purpose_id")
  /// Print right after posting (Ctrl+Enter), never after a draft save
  vchrPrintAfterPost         Boolean              @default(false) @map("vchr_print_after_post")
  /// Delivery tracking (20261117100000, Q3): INSTANT | PICKUP | DISPATCH, the default
  /// delivery mode of a new bill of this type (ck_vchr_delivery_mode). INSTANT on the base
  /// Sales Bill; a child keeps NULL (= the base's) until saved; NULL on every other type
  vchrDeliveryMode           String?              @db.VarChar(10) @map("vchr_delivery_mode")
  /// DC / DC return (20261118100000, decision 32): the number is a GST document number
  /// (Rules 46 / 53 / 55): at most 16 characters, A–Z a–z 0–9 - /. Checked at counter
  /// creation, at the type's save and at each draw. true on DCh / DCR (and any child of them)
  vchrGstDocNo               Boolean              @default(false) @map("vchr_gst_doc_no")
  // Audit
  vchrSyncDate               DateTime?            @db.Timestamptz(6) @map("vchr_sync_date")
  vchrCreatedOn              DateTime             @default(now()) @db.Timestamptz(6) @map("vchr_created_on")
  vchrCreatedBy              String?              @db.VarChar(100) @map("vchr_created_by")
  vchrUpdatedOn              DateTime?            @db.Timestamptz(6) @map("vchr_updated_on")
  vchrUpdatedBy              String?              @db.VarChar(100) @map("vchr_updated_by")
  voucherDocRegisters        AccVoucherDocRegister[]
  voucherSequences           AccVoucherSeq[]
  voucherHeaders             AccVoucherHeader[]
  vouchers                   AccVoucher[]
  bills                      AccBillBalance[]
  menu                       Menu?                @relation(fields: [vchrMenuId], references: [menuId], onDelete: Restrict, onUpdate: Cascade, map: "fk_vchr_menu")
  parent                     AccVoucherType?      @relation("VoucherTypeChildren", fields: [vchrParentId], references: [vchrTypeId], onDelete: Restrict, onUpdate: Cascade, map: "fk_vchr_parent")
  children                   AccVoucherType[]     @relation("VoucherTypeChildren")
  company                    Company?             @relation("VoucherTypeCompany", fields: [vchrCompanyId], references: [compId], onDelete: Restrict, onUpdate: Cascade, map: "fk_vchr_company")
  printPurpose               PrintPurpose?        @relation("VoucherTypePrintPurpose", fields: [vchrPrintPurposeId], references: [ppoId], onDelete: Restrict, onUpdate: Cascade, map: "fk_vchr_print_purpose")
  saleBills                  SaleBill[]           @relation("SaleBillVoucherType")
  @@unique([vchrTypeCode], map: "uq_acc_voucher_types_code")
  // Names are unique per company for children and among the bases. DB-only
  // (partial, so never declared here; Prisma ignores them):
  //   CREATE UNIQUE INDEX ux_vchr_base_name    ON (vchr_type_name)                  WHERE vchr_company_id IS NULL;
  //   CREATE UNIQUE INDEX ux_vchr_company_name ON (vchr_company_id, vchr_type_name)  WHERE vchr_company_id IS NOT NULL;
  //   CREATE UNIQUE INDEX ux_vchr_company_short ON (vchr_company_id, upper(vchr_type_short)) WHERE vchr_company_id IS NOT NULL;
  // CHECKs (DB-only): ck_vchr_child_company, ck_vchr_parent_not_self, ck_vchr_start_no.
  @@index([vchrParentId], map: "ix_vchr_parent")
  @@index([vchrIsActive, vchrSortOrder, vchrTypeName], map: "idx_acc_voucher_types_active_sort")
  @@index([vchrNature], map: "idx_acc_voucher_types_nature")
  @@index([vchrCategory], map: "idx_acc_voucher_types_category")
  @@map("acc_voucher_types")
  @@schema("accounts")
}