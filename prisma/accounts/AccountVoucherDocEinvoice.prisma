enum GdeStatus {
  NA
  PENDING
  GENERATED
  FAILED
  CANCELED
  @@schema("accounts")
}

model AccVoucherDocEinvoice {
  gdeId             String               @default(dbgenerated("uuidv7()")) @db.Uuid @map("gde_id")
  gdeGdrId          String               @db.Uuid @map("gde_gdr_id")
  gdeVoucherId      String               @db.Uuid @map("gde_voucher_id")

  // Multi-branch snapshot
  gdeAccYear        String               @db.VarChar(9) @map("gde_acc_year")
  gdeCompanyId      String               @db.Uuid @map("gde_company_id")
  gdeBranchId       String               @db.Uuid @map("gde_branch_id")

  gdeStatus         GdeStatus            @default(NA) @map("gde_status")
  gdeIrn            String?              @db.VarChar(200) @map("gde_irn")
  gdeAckNo          String?              @db.VarChar(100) @map("gde_ack_no")
  gdeAckOn          DateTime?            @db.Timestamptz(6) @map("gde_ack_on")
  gdeQrcode         String?              @map("gde_qrcode")

  gdeSignedInvoice  String?              @map("gde_signed_invoice")
  gdeSignedQrcode   String?              @map("gde_signed_qrcode")

  gdeCancelReason   String?              @db.VarChar(200) @map("gde_cancel_reason")
  /// TWO l's, as of 20260922020000. The deployed table used to spell it
  /// with one while every other table in this schema used two; a rename
  /// here is also a DATA change in gst_provider_field_map, which stores
  /// this name as a target column.
  gdeCancelledOn    DateTime?            @db.Timestamptz(6) @map("gde_cancelled_on")

  gdeLastErrorCode  String?              @db.VarChar(50) @map("gde_last_error_code")
  gdeLastMessage    String?              @db.VarChar(500) @map("gde_last_message")

  // ── Provenance (20260921120000_add_gst_provider_integration) ──────────
  /// public.gst_company_credential that generated this IRN. A cancellation
  /// must be sent through the same provider and GSTIN, and with two providers
  /// configured there is no way to work out which one it was after the fact.
  /// No FK: the credential is a master that may legitimately be retired while
  /// old documents keep pointing at it.
  gdeGccId          String?              @db.Uuid @map("gde_gcc_id")
  /// Frozen snapshot beside the id, the way the doc register freezes party
  /// name and GSTIN next to theirs: an id pointing at a row somebody deleted
  /// answers no questions at all.
  gdeGpvCode        String?              @db.VarChar(20) @map("gde_gpv_code")
  /// The Invoice Registration Portal that issued the IRN (NIC1, NIC2, CLEAR,
  /// CYGNET, EY, IRIS) — NOT the same thing as the GSP. A cancellation must
  /// reach this portal; the GSP used to reach it may differ. On a NIC-style
  /// reply the first character of AckNo gives it away: 1 = NIC1, 2 = NIC2.
  gdeIrpCode        String?              @db.VarChar(10) @map("gde_irp_code")
  /// When to try again. Without it a failed IRN either retries in a tight
  /// loop against a portal that is rate limiting us, or waits for a person to
  /// notice. Drives the ix_gde_retry worklist.
  gdeNextAttemptOn  DateTime?            @db.Timestamptz(6) @map("gde_next_attempt_on")

  gdeIsActive       Boolean              @default(true) @map("gde_is_active")
  gdeIsDeleted      Boolean              @default(false) @map("gde_is_deleted")
  gdeSyncDate       DateTime?            @db.Timestamptz(6) @map("gde_sync_date")
  gdeCreatedOn      DateTime             @default(now()) @db.Timestamptz(6) @map("gde_created_on")
  gdeCreatedBy      String?              @db.Uuid @map("gde_created_by")
  // The house audit pair, renamed from gde_updated_* by 20260922020000.
  gdeModifiedOn     DateTime?            @db.Timestamptz(6) @map("gde_modified_on")
  gdeModifiedBy     String?              @db.Uuid @map("gde_modified_by")

  // ── Reconciled with the doc-register design (20260922020000) ─────────
  gdeTenantId       String?              @db.Uuid @map("gde_tenant_id")
  /// How many times the IRP has been asked for this IRN, and when last.
  gdeAttemptCount   Int                  @default(0) @map("gde_attempt_count")
  gdeLastAttemptOn  DateTime?            @db.Timestamptz(6) @map("gde_last_attempt_on")
  /// Exactly what was sent to the IRP, and exactly what it said back. Once
  /// the document has been amended these two are the ONLY answer to "what
  /// did we declare on that date".
  gdeRequestPayload  Json?               @map("gde_request_payload")
  gdeResponsePayload Json?               @map("gde_response_payload")

  // Relations
  docRegister       AccVoucherDocRegister @relation(fields: [gdeGdrId, gdeAccYear], references: [gdrId, gdrAccYear], onDelete: Cascade, map: "fk_gde_gdr")

  // LIST-partitioned on gde_acc_year as of 20260922100000; both keys carry the
  // partition key, as Postgres requires. Still one IRN row per document.
  @@id([gdeId, gdeAccYear], map: "pk_acc_voucher_doc_einvoice")
  @@unique([gdeGdrId, gdeAccYear], map: "uq_gde_gdr")
  @@map("acc_voucher_doc_einvoice")
  @@schema("accounts")
  // Partial unique index uq_acc_voucher_doc_einvoice_irn -- (gde_irn,
  // gde_acc_year) since 20260922100000, the year trailing so a lookup by IRN
  // alone still uses it -- and partial index
  // idx_gde_status are not expressible in Prisma schema. Nor is the retry
  // worklist added by 20260921120000:
  //
  //   CREATE INDEX ix_gde_retry
  //       ON accounts.acc_voucher_doc_einvoice (gde_company_id, gde_next_attempt_on)
  //       WHERE gde_is_deleted = false AND gde_status = 'FAILED';
}
