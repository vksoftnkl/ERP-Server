/// TILL SESSION — one cashier, one drawer, one stretch of time (share file 47
/// §3, migration 20261008100000).
///
/// This is the row every *_session_id in the product was always meant to point
/// at (sale_bill/return/dc/quotation/order, acc_tender_detail,
/// acc_voucher_header, acc_bill_adjustment, acc_temp_credit, txn_hold,
/// loyalty_ledger, txn_status_log …). Those columns stay FK-less: they are on
/// partitioned tables of other years and an offline push must never fail on
/// ordering. TillSessionService validates the id at post time instead.
///
/// LIFECYCLE (TILL_DESIGN.md §5.2)
///   OPEN ⇄ SUSPENDED → COUNTING → PENDING_APPROVAL → CLOSED
///     └→ VOIDED (opened in error, nothing written in it)
///   CLOSED → OPEN again only by SESSION_REOPEN (approval), counted again.
///
/// One live session per COUNTER (ux_tss_counter_live) — single-writer, so safe
/// offline. One open session per OPERATOR is a service rule, NOT an index.
model TillSession {
  tssId               String    @default(dbgenerated("uuidv7()")) @db.Uuid @map("tss_id")
  tssCompanyId        String    @db.Uuid                             @map("tss_company_id")
  tssBranchId         String    @db.Uuid                             @map("tss_branch_id")
  tssTenantId         String?   @db.Uuid                             @map("tss_tenant_id")
  tssAccYear          String    @db.Char(9)                          @map("tss_acc_year")
  tssDayId            String    @db.Uuid                             @map("tss_day_id")
  tssBusinessDate     DateTime  @db.Date                             @map("tss_business_date")
  tssCounterId        String    @db.Uuid                             @map("tss_counter_id")
  /// The device that opened it; money posts only from it (plan-till-counter-claim.md).
  tssDeviceId         String    @db.Uuid                             @map("tss_device_id")
  /// user_master.usr_id of the accountable cashier.
  tssOperatorId       String    @db.Uuid                             @map("tss_operator_id")
  /// C01-260407-02 (counter-date-seq), printed.
  tssSessionNo        String    @db.VarChar(30)                      @map("tss_session_no")
  /// nth session of this counter on this business date.
  tssDaySeq           Int                                            @map("tss_day_seq")
  /// OPEN | SUSPENDED | COUNTING | PENDING_APPROVAL | CLOSED | VOIDED
  tssStatus           String    @default("OPEN") @db.VarChar(16)     @map("tss_status")

  // ── Open ─────────────────────────────────────────────────────────────
  tssOpenedOn         DateTime  @default(now()) @db.Timestamptz(6)   @map("tss_opened_on")
  /// ISSUED (from the safe) | CARRIED (left in the drawer) | NONE
  tssFloatMode        String    @db.VarChar(8)                       @map("tss_float_mode")
  /// CARRIED / handover: whose drawer this was.
  tssPrevSessionId    String?   @db.Uuid                             @map("tss_prev_session_id")
  /// What the safe / previous close says is in it.
  tssFloatIssued      Decimal   @default(0) @db.Decimal(15, 2)       @map("tss_float_issued")
  /// What the cashier counted at open.
  tssFloatCounted     Decimal   @default(0) @db.Decimal(15, 2)       @map("tss_float_counted")
  tssOpenCountId      String?   @db.Uuid                             @map("tss_open_count_id")
  /// FLOAT_MISMATCH.
  tssFloatApprovalId  String?   @db.Uuid                             @map("tss_float_approval_id")

  // ── During ───────────────────────────────────────────────────────────
  tssSuspendCount     Int       @default(0)                          @map("tss_suspend_count")
  /// Set while SUSPENDED (ck_tss_suspended).
  tssSuspendedOn      DateTime? @db.Timestamptz(6)                   @map("tss_suspended_on")

  // ── Close ────────────────────────────────────────────────────────────
  /// The moment it stopped taking money.
  tssBillingEndedOn   DateTime? @db.Timestamptz(6)                   @map("tss_billing_ended_on")
  /// BLIND | OPEN
  tssCountMode        String?   @db.VarChar(6)                       @map("tss_count_mode")
  /// COUNTER | CASH_OFFICE
  tssCountPlace       String?   @db.VarChar(12)                      @map("tss_count_place")
  /// The FINAL count (attempts are all kept).
  tssCloseCountId     String?   @db.Uuid                             @map("tss_close_count_id")
  tssCountAttempts    Int       @default(0) @db.SmallInt             @map("tss_count_attempts")
  tssCountedOn        DateTime? @db.Timestamptz(6)                   @map("tss_counted_on")
  tssCountedBy        String?   @db.Uuid                             @map("tss_counted_by")
  /// Second person at the count (setting till.close_witness).
  tssWitnessBy        String?   @db.Uuid                             @map("tss_witness_by")
  tssClosedOn         DateTime? @db.Timestamptz(6)                   @map("tss_closed_on")
  tssClosedBy         String?   @db.Uuid                             @map("tss_closed_by")
  /// CASH_VARIANCE / NONCASH_VARIANCE / FORCE_CLOSE.
  tssCloseApprovalId  String?   @db.Uuid                             @map("tss_close_approval_id")
  tssForceClosed      Boolean   @default(false)                      @map("tss_force_closed")
  tssForceReasonId    String?   @db.Uuid                             @map("tss_force_reason_id")
  tssReopenCount      Int       @default(0) @db.SmallInt             @map("tss_reopen_count")
  /// = the counter's tcn_z_last_no + 1 at close.
  tssZNo              Int?                                           @map("tss_z_no")

  // ── Frozen at close by TillLedgerService; never recomputed ───────────
  tssBillCount        Int       @default(0)                          @map("tss_bill_count")
  tssReturnCount      Int       @default(0)                          @map("tss_return_count")
  tssReceiptCount     Int       @default(0)                          @map("tss_receipt_count")
  tssNoSaleCount      Int       @default(0)                          @map("tss_no_sale_count")
  tssVoidCount        Int       @default(0)                          @map("tss_void_count")
  tssVoidLineCount    Int       @default(0)                          @map("tss_void_line_count")
  tssNetSales         Decimal   @default(0) @db.Decimal(15, 2)       @map("tss_net_sales")
  tssCashExpected     Decimal   @default(0) @db.Decimal(15, 2)       @map("tss_cash_expected")
  tssCashCounted      Decimal   @default(0) @db.Decimal(15, 2)       @map("tss_cash_counted")
  tssNoncashExpected  Decimal   @default(0) @db.Decimal(15, 2)       @map("tss_noncash_expected")
  tssNoncashCounted   Decimal   @default(0) @db.Decimal(15, 2)       @map("tss_noncash_counted")
  /// Cash that went to the safe at close.
  tssHandedOver       Decimal   @default(0) @db.Decimal(15, 2)       @map("tss_handed_over")
  /// Cash left in the drawer for the next session. CLOSED: handed_over + float_left = cash_counted.
  tssFloatLeft        Decimal   @default(0) @db.Decimal(15, 2)       @map("tss_float_left")
  /// NONE | WITHIN_TOLERANCE | PENDING | ACCEPTED | RECOVER | INVESTIGATE
  tssVarianceStatus   String    @default("NONE") @db.VarChar(16)     @map("tss_variance_status")

  tssPrintCount       Int       @default(0) @db.SmallInt             @map("tss_print_count")
  tssNotes            String?   @db.VarChar(500)                     @map("tss_notes")
  tssIsDeleted        Boolean   @default(false)                      @map("tss_is_deleted")
  tssSyncDate         DateTime? @db.Timestamptz(6)                   @map("tss_sync_date")
  tssCreatedOn        DateTime  @default(now()) @db.Timestamptz(6)   @map("tss_created_on")
  tssCreatedBy        String?   @db.VarChar(50)                      @map("tss_created_by")
  tssModifiedOn       DateTime? @db.Timestamptz(6)                   @map("tss_modified_on")
  tssModifiedBy       String?   @db.VarChar(50)                      @map("tss_modified_by")

  // ── GENERATED ALWAYS … STORED — never write them ─────────────────────
  /// tss_float_counted - tss_float_issued
  tssFloatVariance    Decimal?  @default(dbgenerated()) @db.Decimal(15, 2) @map("tss_float_variance")
  /// tss_cash_counted - tss_cash_expected
  tssCashVariance     Decimal?  @default(dbgenerated()) @db.Decimal(15, 2) @map("tss_cash_variance")
  /// tss_noncash_counted - tss_noncash_expected
  tssNoncashVariance  Decimal?  @default(dbgenerated()) @db.Decimal(15, 2) @map("tss_noncash_variance")

  // ── Added by 20261008110000 (file 48) — physically last on the table ──
  //  Frozen at close with the other counts: receipts (tssReceiptCount),
  //  bill-wise payments and expense vouchers posted in the session.
  tssPaymentCount     Int       @default(0)                          @map("tss_payment_count")
  tssExpenseCount     Int       @default(0)                          @map("tss_expense_count")

  // Relations
  day                 TillBusinessDay @relation("TillSessionDay",     fields: [tssDayId, tssAccYear, tssBusinessDate], references: [tbdId, tbdAccYear, tbdBusinessDate], onUpdate: Cascade, onDelete: Restrict, map: "fk_tss_day")
  counter             TillCounter     @relation("TillSessionCounter", fields: [tssCounterId], references: [tcnId], onUpdate: Cascade, onDelete: Restrict, map: "fk_tss_counter")
  variances           TillVariance[]  @relation("TillVarianceSession")

  @@id([tssId, tssAccYear], map: "pk_till_session")

  // DB-only (all partial; acc_year is in each unique key because a unique
  // index on a partitioned table must carry the partition key):
  //   CREATE UNIQUE INDEX ux_tss_counter_live ON accounts.till_session (tss_counter_id, tss_acc_year)
  //       WHERE tss_is_deleted = false AND tss_status IN ('OPEN','SUSPENDED','COUNTING');
  //   CREATE UNIQUE INDEX ux_tss_no ON accounts.till_session (tss_company_id, tss_branch_id, tss_session_no, tss_acc_year)
  //       WHERE tss_is_deleted = false;
  //   ix_tss_day, ix_tss_operator, ix_tss_live, ix_tss_variance_open.
  // CHECKs: ck_tss_year, ck_tss_status, ck_tss_float_mode, ck_tss_carried, ck_tss_count_mode,
  //         ck_tss_count_place, ck_tss_variance_status, ck_tss_suspended, ck_tss_closed,
  //         ck_tss_counted, ck_tss_force, ck_tss_amounts, ck_tss_disposal,
  //         ck_tss_doc_counts (receipt / payment / expense counts >= 0).
  @@map("till_session")
  @@schema("accounts")
}
