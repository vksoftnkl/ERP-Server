/// One row per bill. Never partitioned and never carried forward at year
/// end — the same row simply stays open across financial years.
///
/// ablAllocAmount / ablDiscAmount / ablWriteoffAmount are maintained from
/// AccBillAdjustment and must never be written from application code.
model AccBill {
  ablId               String    @id(map: "pk_acc_bills") @default(dbgenerated("uuidv7()")) @db.Uuid @map("abl_id")
  ablCompanyId        String    @db.Uuid @map("abl_company_id")
  // Branch that RAISED the bill. Settlement may happen at a different branch;
  // that is recorded on AccBillAdjustment.
  ablBranchId         String    @db.Uuid @map("abl_branch_id")
  ablTenantId         String?   @db.Uuid @map("abl_tenant_id")
  // FY of origin. Reporting filter only, never a partition key.
  ablAccYear          String    @db.Char(9) @map("abl_acc_year")

  // Party
  ablPartyId          String    @db.Uuid @map("abl_party_id")
  ablSalesmanId       String?   @db.Uuid @map("abl_salesman_id")
  ablAgentId          String?   @db.Uuid @map("abl_agent_id")

  // Source document — ck_abl_bill_type:
  //   SALES | PURCHASE : a real document
  //   OPENING          : lump-sum legacy outstanding brought in at migration
  //   ADVANCE          : money received or paid with no bill yet
  //   INTEREST         : overdue interest raised against a parent bill
  ablBillType         String    @db.VarChar(20) @map("abl_bill_type")
  ablVoucherId        String?   @db.Uuid @map("abl_voucher_id")
  ablVoucherLineId    String?   @db.Uuid @map("abl_voucher_line_id")
  ablVoucherTypeId    Int       @map("abl_voucher_type_id")
  ablVoucherNo        BigInt?   @map("abl_voucher_no")
  ablDocDate          DateTime? @db.Date @map("abl_doc_date")
  ablDocRefno         String?   @db.VarChar(50) @map("abl_doc_refno")

  // Bill identity — ck_abl_dr_cr: DR = receivable, CR = payable
  ablBillRefno        String    @db.VarChar(100) @map("abl_bill_refno")
  ablBillDate         DateTime  @db.Date @map("abl_bill_date")
  ablDueDate          DateTime? @db.Date @map("abl_due_date")
  ablCreditDays       Int       @default(0) @db.SmallInt @map("abl_credit_days")
  ablGraceDays        Int       @default(0) @db.SmallInt @map("abl_grace_days")
  ablDrCr             String    @db.Char(2) @map("abl_dr_cr")
  ablNarration        String?   @map("abl_narration")

  // Amounts
  ablBillAmount       Decimal   @db.Decimal(18, 2) @map("abl_bill_amount")
  ablAllocAmount      Decimal   @default(0) @db.Decimal(18, 2) @map("abl_alloc_amount")
  ablDiscAmount       Decimal   @default(0) @db.Decimal(18, 2) @map("abl_disc_amount")
  ablWriteoffAmount   Decimal   @default(0) @db.Decimal(18, 2) @map("abl_writeoff_amount")
  // GENERATED ALWAYS ... STORED in the DB. Read-only: never send it on a
  // create or update, the write will be rejected by Postgres.
  // @default(dbgenerated()) marks the value as DB-owned so migrate never emits
  // an ALTER ... DROP DEFAULT against the generation expression.
  ablPendingAmount    Decimal?  @default(dbgenerated()) @db.Decimal(18, 2) @map("abl_pending_amount")

  // Audit
  ablIsActive         Boolean   @default(true) @map("abl_is_active")
  ablIsDeleted        Boolean   @default(false) @map("abl_is_deleted")
  ablSyncDate         DateTime? @db.Timestamptz(6) @map("abl_sync_date")
  ablCreatedOn        DateTime  @default(now()) @db.Timestamptz(6) @map("abl_created_on")
  ablCreatedBy        String?   @db.VarChar(50) @map("abl_created_by")
  ablModifiedOn       DateTime? @db.Timestamptz(6) @map("abl_modified_on")
  ablModifiedBy       String?   @db.VarChar(50) @map("abl_modified_by")

  // Relations
  voucherHeader       AccVoucherHeader? @relation(fields: [ablVoucherId, ablAccYear], references: [avhVoucherId, avhAccYear], onUpdate: Cascade, onDelete: Restrict, map: "fk_abl_voucher")
  voucherType         AccVoucherType    @relation(fields: [ablVoucherTypeId], references: [vchrTypeId], onUpdate: Cascade, onDelete: Restrict, map: "fk_abl_voucher_type")
  party               AccLedgerMaster   @relation("BillParty", fields: [ablPartyId], references: [ledId], onUpdate: Cascade, onDelete: Restrict, map: "fk_abl_party")
  adjustments         AccBillAdjustment[]
  voucherLines        AccVoucher[]

  @@map("acc_bills")
  @@schema("accounts")
  // DB-only objects not expressible in the Prisma schema (see migration
  // 20260806090000_add_voucher_header_bills_pdc):
  //   - Generated column abl_pending_amount
  //     (bill - alloc - disc - writeoff).
  //   - Partial UNIQUE index ux_abl_bill_refno.
  //   - Partial/covering indexes ix_abl_open, ix_abl_overdue, ix_abl_salesman,
  //     ix_abl_voucher.
  //   - CHECK constraints ck_abl_bill_type, ck_abl_dr_cr, ck_abl_acc_year,
  //     ck_abl_voucher (OPENING has no source voucher, every other type must
  //     have one), ck_abl_amount, ck_abl_due_date, and ck_abl_settled — the
  //     over-settlement guard: a bill can never be edited down below what has
  //     already been settled, discounted or written off against it.
  //   - No FK on abl_company_id / abl_branch_id / abl_salesman_id /
  //     abl_agent_id: the source DDL declares none.
}
