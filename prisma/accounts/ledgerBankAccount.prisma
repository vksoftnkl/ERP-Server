model AccLedgerBankAccount {
  lbaId               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid  @map("lba_id")
  lbaCompanyId        String?  @db.Uuid                                          @map("lba_company_id")
  lbaLedgerId         String    @db.Uuid                                          @map("lba_ledger_id")

  // Bank Details
  lbaAccountHolder    String    @db.VarChar(200)                                 @map("lba_account_holder")
  lbaBankName         String    @db.VarChar(200)                                 @map("lba_bank_name")
  lbaBranchName       String?   @db.VarChar(200)                                 @map("lba_branch_name")
  lbaAccountNo        String    @db.VarChar(50)                                  @map("lba_account_no")
  lbaIfscCode         String?   @db.VarChar(11)                                  @map("lba_ifsc_code")
  lbaMicrCode         String?   @db.VarChar(15)                                  @map("lba_micr_code")
  lbaAccountType      String?   @db.VarChar(20)                                  @map("lba_account_type")
  lbaUpiId            String?   @db.VarChar(100)                                 @map("lba_upi_id")
  lbaChequeName       String?   @db.VarChar(200)                                 @map("lba_cheque_name")

  // Flags
  lbaIsDefault        Boolean   @default(false)                                   @map("lba_is_default")
  lbaIsActive         Boolean   @default(true)                                    @map("lba_is_active")
  lbaIsDeleted        Boolean   @default(false)                                   @map("lba_is_deleted")

  // Audit
  lbaSyncDate         DateTime? @db.Timestamptz                                  @map("lba_sync_date")
  lbaCreatedOn        DateTime  @default(now()) @db.Timestamptz                  @map("lba_created_on")
  lbaCreatedBy        String?   @db.VarChar(100)                                 @map("lba_created_by")
  lbaModifiedOn       DateTime  @default(now()) @db.Timestamptz                  @map("lba_modified_on")
  lbaModifiedBy       String?   @db.VarChar(100)                                 @map("lba_modified_by")
  lbaRemarks          String?   @db.VarChar(250)                                 @map("lba_remarks")

  // Relations
  company             Company?         @relation(fields: [lbaCompanyId], references: [compId], onUpdate: Cascade, onDelete: Restrict)
  ledger              AccLedgerMaster @relation(fields: [lbaLedgerId], references: [ledId])
  tenderMasters       AccTenderMaster[]

  @@index([lbaLedgerId],  name: "idx_lba_ledger")
  @@index([lbaCompanyId], name: "idx_lba_company")
  @@map("acc_ledger_bank_accounts")
  @@schema("accounts")
}
