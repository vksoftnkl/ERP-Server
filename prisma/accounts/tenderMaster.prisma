model TenderMaster {
  tndId                String          @id @default(dbgenerated("uuidv7()")) @db.Uuid  @map("tnd_id")
  tndTypeId            String          @db.Uuid                                          @map("tnd_type_id")
  tndName              String                                                            @map("tnd_name")
  tndLedgerId          String          @db.Uuid                                          @map("tnd_ledger_id")
  tndMinAmount         Decimal         @default(0) @db.Decimal(14, 2)                   @map("tnd_min_amount")
  tndMaxAmount         Decimal?        @db.Decimal(14, 2)                               @map("tnd_max_amount")
  tndDisplayPosition   Int             @default(0)                                       @map("tnd_display_position")
  tndSurchargePerc     Decimal         @default(0) @db.Decimal(6, 3)                    @map("tnd_surcharge_perc")
  tndIsActive          Boolean         @default(true)                                    @map("tnd_is_active")
  tndIsDeleted         Boolean         @default(false)                                   @map("tnd_is_deleted")
  tndRemarks           String?                                                           @map("tnd_remarks")
  tndEditSurcharge     Boolean         @default(false)                                   @map("tnd_edit_surcharge")
  tndEditLedger        Boolean         @default(false)                                   @map("tnd_edit_ledger")

  // Audit
  tndSyncDate          DateTime?       @db.Timestamptz                                  @map("tnd_sync_date")
  tndCreatedOn         DateTime        @default(now()) @db.Timestamptz                  @map("tnd_created_on")
  tndCreatedBy         String?         @db.VarChar(100)                                 @map("tnd_created_by")
  tndModifiedOn        DateTime        @default(now()) @db.Timestamptz                  @map("tnd_modified_on")
  tndModifiedBy        String?         @db.VarChar(100)                                 @map("tnd_modified_by")

  // Relations
  tenderType           TenderTypeMaster @relation(fields: [tndTypeId],   references: [ttmTypeId])
  ledger               AccLedgerMaster @relation(fields: [tndLedgerId], references: [ledId])

  @@index([tndTypeId],          name: "idx_tnd_master_type")
  @@index([tndLedgerId],        name: "idx_tnd_master_ledger")
  @@index([tndDisplayPosition], name: "idx_tnd_master_position")
  @@map("tender_master")
  @@schema("accounts")
}
