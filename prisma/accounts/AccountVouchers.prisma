enum DrCrType {
  DR
  CR
  @@schema("accounts")
}

model AccVoucher {
  // Primary
  avId               String           @id @default(dbgenerated("uuidv7()")) @db.Uuid @map("av_id")

  // Header link
  avVoucherId        String           @db.Uuid @map("av_voucher_id")

  // Multi-branch snapshot
  avAccYear          String           @db.VarChar(20) @map("av_acc_year")
  avCompanyId        String           @db.Uuid @map("av_company_id")
  avBranchId         String           @db.Uuid @map("av_branch_id")

  // Voucher snapshot
  avVoucherTypeId    Int              @map("av_voucher_type_id")
  avVoucherNo        BigInt           @map("av_voucher_no")
  avRowNo            Int              @map("av_row_no")

  // Business dates / refs
  avVoucherDate      DateTime         @db.Timestamptz(6) @map("av_voucher_date")
  avVoucherRefno     String?          @db.VarChar(50) @map("av_voucher_refno")
  avBillDate         DateTime?        @db.Timestamptz(6) @map("av_bill_date")
  avBillRefno        String?          @db.VarChar(100) @map("av_bill_refno")

  // Accounting line
  avDrCr             DrCrType         @map("av_dr_cr")
  avLedgerId         String           @db.Uuid @map("av_ledger_id")
  avOppLedgerId      String           @db.Uuid @map("av_opp_ledger_id")
  avAmount           Decimal          @default(0) @db.Decimal(18, 2) @map("av_amount")

  // Narration
  avRemarks          String?          @map("av_remarks")

  // User / session
  avSessionId        String?          @db.Uuid @map("av_session_id")
  avUserId           String           @db.Uuid @map("av_user_id")

  // Status
  avIsActive         Boolean          @default(true) @map("av_is_active")
  avIsDeleted        Boolean          @default(false) @map("av_is_deleted")

  // Audit
  avSyncDate         DateTime?        @db.Timestamptz(6) @map("av_sync_date")
  avCreatedOn        DateTime         @default(now()) @db.Timestamptz(6) @map("av_created_on")
  avCreatedBy        String?          @db.Uuid @map("av_created_by")
  avUpdatedOn        DateTime?        @db.Timestamptz(6) @map("av_updated_on")
  avUpdatedBy        String?          @db.Uuid @map("av_updated_by")
  // Relations
  voucherHeader      AccVoucherHeader @relation(fields: [avVoucherId], references: [avhVoucherId], onDelete: Cascade, map: "fk_acc_vouchers_header")
  voucherType        AccVoucherType   @relation(fields: [avVoucherTypeId], references: [vchrTypeId], map: "fk_acc_vouchers_voucher_type")
  company            Company          @relation(fields: [avCompanyId], references: [compId], map: "fk_acc_vouchers_voucher_company")
  branch             BranchMaster     @relation(fields: [avBranchId], references: [brId], map: "fk_acc_vouchers_voucher_branch")
  ledger             AccLedgerMaster  @relation("AccVoucherLedger", fields: [avLedgerId], references: [ledId], map: "fk_acc_vouchers_voucher_ledger")
  oppositeLedger     AccLedgerMaster  @relation("AccVoucherOppLedger", fields: [avOppLedgerId], references: [ledId], map: "fk_acc_vouchers_voucher_opp_ledger")
  user               User             @relation(fields: [avUserId], references: [user_id], map: "fk_acc_vouchers_voucher_user")
  @@map("acc_vouchers")
  @@schema("accounts")
}
