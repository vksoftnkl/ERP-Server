model DropdownColumns {
  dropColumnsSerialId BigInt @id @default(autoincrement()) @map("dropColumns_serial_id")

  // FK -> dropdown_details.dropdown_id
  dropColumnsDropdownId Int            @map("dropColumns_dropdown_id")
  dropdown              DropdownDetails @relation(fields: [dropColumnsDropdownId], references: [dropdownId], onDelete: Cascade, onUpdate: Cascade)

  dropColumnsColumnNo Int    @map("dropColumns_column_no")
  dropColumnsDataType String @db.VarChar(50) @map("dropColumns_data_type")

  dropColumnsColumnName      String  @db.VarChar(200) @map("dropColumns_column_name")
  dropColumnsColumnAlias     String? @db.VarChar(200) @map("dropColumns_column_alias")
  dropColumnsColumnWidth     Decimal? @db.Decimal(12, 2) @map("dropColumns_column_width")
  dropColumnsColumnVisiblity Boolean @default(true) @map("dropColumns_column_visiblity") // kept your spelling
  dropColumnsColumnAllignment String? @db.VarChar(30) @map("dropColumns_column_allignment")
  dropColumnsColumnFilter     Boolean @default(false) @map("dropColumns_column_filter")

  dropColumnsCreatedOn  DateTime  @default(now()) @db.Timestamptz(6) @map("dropColumns_created_on")
  dropColumnsModifiedOn DateTime? @updatedAt      @db.Timestamptz(6) @map("dropColumns_modified_on")

  @@index([dropColumnsDropdownId])
  @@index([dropColumnsDropdownId, dropColumnsColumnNo])
  @@map("dropdown_columns")
  @@schema("fixed")
}
