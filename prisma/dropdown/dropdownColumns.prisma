model DropdownColumns {
  dropdownColumnsId   String   @id @default(dbgenerated("uuidv7()")) @db.Uuid @map("dropdown_columns_id")

  // FK -> dropdown_details.dropdown_id
  dropdownColumnsDropdownId Int            @map("dropdown_columns_dropdown_id")
  dropdown              DropdownDetails @relation(fields: [dropdownColumnsDropdownId], references: [dropdownId], onDelete: Cascade, onUpdate: Cascade)

  dropdownColumnsNo Int    @map("dropdown_columns_no")
  dropdownColumnsDataType String @db.VarChar(50) @map("dropdown_columns_data_type")

  dropdownColumnsName      String  @db.VarChar(200) @map("dropdown_columns_name")
  dropdownColumnsAlias     String? @db.VarChar(200) @map("dropdown_columns_alias")
  dropdownColumnsWidth     Decimal? @db.Decimal(12, 2) @map("dropdown_columns_width")
  dropdownColumnsVisiblity Boolean @default(true) @map("dropdown_columns_visiblity") // kept your spelling
  dropdownColumnsAllignment String? @db.VarChar(30) @map("dropdown_columns_allignment")
  dropdownColumnsFilter     Boolean @default(false) @map("dropdown_columns_filter")
  dropdownColumnsSqlName   String? @db.Text @map("dropdown_columns_sql_name")
  dropdownColumnsCreatedOn  DateTime  @default(now()) @db.Timestamptz(6) @map("dropdown_columns_created_on")
  dropdownColumnsModifiedOn DateTime? @updatedAt      @db.Timestamptz(6) @map("dropdown_columns_modified_on")
  dropdownColumnsCreatedBy String? @db.Text @map("dropdown_columns_created_by")
  dropdownColumnsModifiedBy String? @db.Text @map("dropdown_columns_modified_by")

  @@index([dropdownColumnsDropdownId])
  @@index([dropdownColumnsDropdownId, dropdownColumnsNo])
  @@map("dropdown_columns")
  @@schema("fixed")
}